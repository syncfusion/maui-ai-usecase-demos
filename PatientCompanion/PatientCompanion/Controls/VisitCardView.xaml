<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="PatientCompanion.Controls.VisitCardView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PatientCompanion"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core">

    <cards:SfCardView
        Margin="0,0,0,16"
        BackgroundColor="White"
        HeightRequest="{Binding CardHeight}"
        CornerRadius="16">

        <VerticalStackLayout
            Padding="14"
            Spacing="16">

            <!-- Header -->

            <Grid
    ColumnDefinitions="52,*,Auto"
    ColumnSpacing="14"
    VerticalOptions="Start">

                <!-- Avatar -->

                <core:SfAvatarView
        WidthRequest="56"
        HeightRequest="56"
        CornerRadius="32"
            ContentType="Custom"
            ImageSource="{Binding DoctorImage}"
        VerticalOptions="Start" />

                <!-- Doctor Details -->

                <VerticalStackLayout
        Grid.Column="1"
        VerticalOptions="Start"
        Spacing="2">

                    <Label
            FontAttributes="Bold"
            FontSize="14"
            LineBreakMode="TailTruncation"
            MaxLines="2"
            Text="{Binding DoctorName}"
            TextColor="#1F2937" />

                    <Label
            FontSize="14"
            LineBreakMode="TailTruncation"
            MaxLines="1"
            Text="{Binding Specialization}"
            TextColor="#5F6B68" />

                </VerticalStackLayout>

                <!-- Status Badge -->

                <Border
        Grid.Column="2"
        Padding="14,6"
        BackgroundColor="{Binding StatusBackgroundColor}"
        StrokeThickness="0"
        StrokeShape="RoundRectangle 14"
        VerticalOptions="Start">

                    <Label
            FontAttributes="Bold"
            FontSize="11"
            Text="{Binding Status}"
            TextColor="{Binding StatusTextColor}" />

                </Border>

            </Grid>

            <!-- Date -->

            <HorizontalStackLayout Spacing="12">

                <Label
                    FontFamily="MaterialIcons"
                    FontSize="18"
                    Text="{x:Static local:MaterialIcons.CalendarMonth}"
                    TextColor="#00685F"
                    VerticalOptions="Center"
                    VerticalTextAlignment="Center" />

                <Label
                    FontSize="14"
                    Text="{Binding DisplayDateTime}"
                    TextColor="#1F2937"
                    VerticalOptions="Center" />

            </HorizontalStackLayout>

            <!-- Visit Type -->

            <HorizontalStackLayout Spacing="12">

                <Label
                    FontFamily="MaterialIcons"
                    FontSize="18"
                    Text="{x:Static local:MaterialIcons.Videocam}"
                    TextColor="#00685F"
                    VerticalOptions="Center"
                    VerticalTextAlignment="Center" />

                <Label
                    FontSize="14"
                    Text="{Binding VisitType}"
                    TextColor="#1F2937"
                    VerticalOptions="Center" />

            </HorizontalStackLayout>

            <!-- Upcoming Actions Only -->

            <VerticalStackLayout
                IsVisible="{Binding ShowActions}"
                Spacing="16">

                <BoxView
                    HeightRequest="1"
                    Color="#E5E7EB" />

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12"
                    Padding="0,0,0,4">

                    <Border
                        HeightRequest="48"
                        BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="0.3"
                        StrokeShape="RoundRectangle 24">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RescheduleCommand}"
                                CommandParameter="{Binding}" />
                        </Border.GestureRecognizers>
                        <Label
                            Text="Reschedule"
                            FontSize="15"
                            TextColor="#00685F"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                    </Border>

                    <Border
                        Grid.Column="1"
                        HeightRequest="48"
                        BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="0.3"
                        StrokeShape="RoundRectangle 24">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CancelCommand}"
                                CommandParameter="{Binding}" />
                        </Border.GestureRecognizers>
                        <Label
                            Text="Cancel"
                            FontSize="15"
                            TextColor="#D92D20"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                    </Border>

                </Grid>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </cards:SfCardView>

</ContentView>