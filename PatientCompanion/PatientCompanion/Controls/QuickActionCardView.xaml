<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="PatientCompanion.Controls.QuickActionCardView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PatientCompanion"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards">

    <cards:SfCardView
        HeightRequest="110"
        CornerRadius="16"
        Background="#FFFFFF">

        <cards:SfCardView.GestureRecognizers>
            <TapGestureRecognizer Tapped="QuickActionTapped" />
        </cards:SfCardView.GestureRecognizers>

        <Grid
            Padding="16"
            ColumnDefinitions="48,*"
            ColumnSpacing="16">

            <!-- Icon Circle -->

            <Border
                WidthRequest="48"
                HeightRequest="48"
                BackgroundColor="#DDE8E6"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 24"
                VerticalOptions="Center">

                <Label
                    FontFamily="MaterialIcons"
                    FontSize="20"
                    Text="{Binding Icon}"
                    TextColor="#00685F"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    VerticalTextAlignment="Center" />

            </Border>

            <!-- Title -->

            <Label
                Grid.Column="1"
                Text="{Binding Title}"
                FontSize="12"
                FontAttributes="Bold"
                TextColor="#191C1E"
                VerticalTextAlignment="Center"
                LineBreakMode="WordWrap" />

        </Grid>

    </cards:SfCardView>

</ContentView>