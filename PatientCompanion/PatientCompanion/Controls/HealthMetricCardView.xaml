<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="PatientCompanion.Controls.HealthMetricCardView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PatientCompanion"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards">

    <cards:SfCardView
        BackgroundColor="{Binding CardBackgroundColor}"
        CornerRadius="20">

        <cards:SfCardView.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding SelectCommand}" />
        </cards:SfCardView.GestureRecognizers>

        <Grid Padding="12">

            <VerticalStackLayout
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="8">

                <Label
                    FontFamily="MaterialIcons"
                    FontSize="26"
                    Text="{Binding Icon}"
                    TextColor="{Binding ValueColor}"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center" />

                <Label
                    Text="{Binding Title}"
                    FontSize="14"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    TextColor="{Binding TitleColor}" />

                <Label
                    Text="{Binding DisplayValue}"
                    FontSize="18"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    TextColor="{Binding ValueColor}" />

            </VerticalStackLayout>

        </Grid>

    </cards:SfCardView>

</ContentView>