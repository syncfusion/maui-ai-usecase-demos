<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="PatientCompanion.Controls.MedicationCardView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PatientCompanion"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons">

    <cards:SfCardView
        Margin="0,0,0,16"
        BackgroundColor="White"
        HeightRequest="{Binding CardHeight}"
        CornerRadius="16">

        <VerticalStackLayout
            Padding="14"
            Spacing="14">

            <!-- Header -->

            <Grid
                ColumnDefinitions="40,*,Auto"
                ColumnSpacing="12"
                VerticalOptions="Start">

                <!-- Medicine Icon -->

                <Label
                    WidthRequest="32"
                    HeightRequest="32"
                    FontFamily="MaterialIcons"
                    FontSize="24"
                    HorizontalTextAlignment="Center"
                    Text="{x:Static local:MaterialIcons.LocalPharmacy}"
                    TextColor="#00685F"
                    VerticalOptions="Start"
                    VerticalTextAlignment="Center" />

                <!-- Medicine Details -->

                <VerticalStackLayout
                    Grid.Column="1"
                    VerticalOptions="Start"
                    Spacing="2">

                    <Label
                        FontAttributes="Bold"
                        FontSize="14"
                        LineBreakMode="TailTruncation"
                        MaxLines="1"
                        Text="{Binding Name}"
                        TextColor="#111827" />

                    <Label
                        FontSize="13"
                        LineBreakMode="TailTruncation"
                        MaxLines="1"
                        Text="{Binding ScheduleDisplay}"
                        TextColor="#475569" />

                </VerticalStackLayout>

                <!-- Status Badge -->

                <Border
                    Grid.Column="2"
                    Padding="10,4"
                    BackgroundColor="{Binding StatusBackgroundColor}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    VerticalOptions="Start">

                    <Label
                        FontAttributes="Bold"
                        FontSize="9"
                        Text="{Binding StatusText}"
                        TextColor="{Binding StatusColor}" />

                </Border>

            </Grid>

            <!-- Instructions -->

            <Border
                BackgroundColor="#F3F4F6"
                Padding="10"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 6">

                <Grid
                    ColumnDefinitions="18,*"
                    ColumnSpacing="6">

                    <Label
                        FontFamily="MaterialIcons"
                        Text="{Binding InstructionIconGlyph}"
                        FontSize="12"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Column="1"
                        FontSize="13"
                        Text="{Binding NotificationContent}"
                        TextColor="#374151"
                        VerticalOptions="Center" />

                </Grid>

            </Border>

            <!-- Actions -->

            <VerticalStackLayout
    IsVisible="{Binding ShowActions}"
    Spacing="0">

                <!-- Top Separator -->

                <BoxView
        HeightRequest="1"
        Color="#E5E7EB" />

                <!-- Buttons Row -->

                <Grid
        ColumnDefinitions="*,*"
        HeightRequest="44">

                    <!-- Skip -->

                    <buttons:SfButton
            Text="Skip"
            Grid.Column="0"
                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SkipMedicationCommand}"
                    CommandParameter="{Binding}"
            Background="Transparent"
            TextColor="#475569"
            FontSize="12"
            CornerRadius="0"
            StrokeThickness="0" />

                    <!-- Vertical Divider -->

                    <BoxView
            Grid.Column="0"
            HorizontalOptions="End"
            WidthRequest="1"
            Color="#E5E7EB" />

                    <!-- Mark as Taken -->

                    <buttons:SfButton
            Grid.Column="1"
            Text="✔ Mark as Taken"
                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.MarkMedicationAsTakenCommand}"
                    CommandParameter="{Binding}"
            Background="Transparent"
            TextColor="#00685F"
            FontSize="12"
            CornerRadius="0"
            StrokeThickness="0" />

                </Grid>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </cards:SfCardView>

</ContentView>