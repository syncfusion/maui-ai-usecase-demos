<?xml version="1.0" encoding="UTF-8" ?>
<!--
    App.xaml - Application-level resource dictionary
    Merges the design-system dictionaries (Task 1-04):
        Resources/Styles/Colors.xaml  - colour tokens
        Resources/Styles/Sizes.xaml   - spacing / dimensions / corner radius
        Resources/Styles/Fonts.xaml   - typography tokens
        Resources/Styles/Styles.xaml  - component styles (default + custom)
    The syncTheme:SyncfusionThemeResourceDictionary provides the Syncfusion
    MAUI theme variables (used by the Syncfusion controls installed in
    Task 1-02) and is kept at the end of the merge list so it can override
    any default values it needs to.

    Task 1-08 also registers the four value converters shipped with the
    foundation layer (BoolToVisibility, DateTimeToString, InvertedBool,
    EnumToString).  They are declared below the merged dictionaries so they
    can be referenced from any page with
    {StaticResource <Key>}.
-->
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Todo"
             xmlns:converters="clr-namespace:Todo.Converters"
             xmlns:syncTheme="clr-namespace:Syncfusion.Maui.Themes;assembly=Syncfusion.Maui.Core"
             x:Class="Todo.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Sizes.xaml" />
                <ResourceDictionary Source="Resources/Styles/Fonts.xaml" />
                <!--<ResourceDictionary Source="Resources/Styles/Styles.xaml" />-->
                <syncTheme:SyncfusionThemeResourceDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- ============================================================ -->
            <!-- Value Converters (Task 1-08: Create Utility Classes)         -->
            <!-- ============================================================ -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:DateTimeToStringConverter x:Key="DateTimeToStringConverter" />
            <converters:EnumToStringConverter x:Key="EnumToStringConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
