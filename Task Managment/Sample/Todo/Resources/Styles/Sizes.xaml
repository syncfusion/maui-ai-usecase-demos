<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Sizes.xaml - Task 1-04: Create Resource Dictionaries
    Centralised spacing, dimension and stroke tokens.
    All values are stored as x:Double so they can be used in any property
    that accepts a double (Width, Height, Spacing, etc.).
    CornerRadius tokens are also exposed as typed CornerRadius so they can
    be used both in CornerRadius and StrokeShape-style properties.
    Units are MAUI device-independent units (DIU). At the default 160 DPI
    1 DIU equals 1 dp equals 1 pt.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Spacing Scale -->
    <x:Double x:Key="SpacingXxs">4</x:Double>
    <x:Double x:Key="SpacingXs">8</x:Double>
    <x:Double x:Key="SpacingS">12</x:Double>
    <x:Double x:Key="SpacingM">16</x:Double>
    <x:Double x:Key="SpacingL">24</x:Double>
    <x:Double x:Key="SpacingXl">32</x:Double>

    <!-- Common Thickness (Padding / Margin) shorthands -->
    <Thickness x:Key="PaddingXxs">4</Thickness>
    <Thickness x:Key="PaddingXs">8</Thickness>
    <Thickness x:Key="PaddingS">12</Thickness>
    <Thickness x:Key="PaddingM">16</Thickness>
    <Thickness x:Key="PaddingL">24</Thickness>
    <Thickness x:Key="PaddingXl">32</Thickness>

    <!-- Component Dimensions -->
    <x:Double x:Key="HeaderHeight">56</x:Double>
    <x:Double x:Key="BottomInputHeight">64</x:Double>
    <x:Double x:Key="SidebarWidth">230</x:Double>
    <x:Double x:Key="TaskItemPadding">12</x:Double>
    <x:Double x:Key="TaskItemMargin">8</x:Double>

    <!-- Icon Sizes -->
    <x:Double x:Key="IconSizeSmall">20</x:Double>
    <x:Double x:Key="IconSizeMedium">24</x:Double>
    <x:Double x:Key="IconSizeLarge">32</x:Double>

    <!-- Corner Radius (numeric form - useful for CornerRadius properties) -->
    <x:Double x:Key="CornerRadiusSmall">4</x:Double>
    <x:Double x:Key="CornerRadiusMedium">8</x:Double>
    <x:Double x:Key="CornerRadiusLarge">16</x:Double>
    <x:Double x:Key="CornerRadiusFull">50</x:Double>

    <!-- Corner Radius (typed form - useful for StrokeShape, etc.) -->
    <CornerRadius x:Key="CornerRadiusSmallShape">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMediumShape">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLargeShape">16</CornerRadius>

    <!-- Stroke Thickness -->
    <x:Double x:Key="StrokeThicknessThin">1</x:Double>
    <x:Double x:Key="StrokeThicknessMedium">2</x:Double>
    <x:Double x:Key="StrokeThicknessThick">4</x:Double>

</ResourceDictionary>
