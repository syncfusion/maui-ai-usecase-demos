<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Colors.xaml - Task 1-04: Create Resource Dictionaries
    Centralised colour palette for the entire application.
    See SPECIFICATION.md Section 12.2 for the full design-system palette.
    The default MAUI template colour keys (Primary, White, Black, Gray*,
    etc.) are preserved at the bottom so the default Styles.xaml
    AppThemeBinding values still resolve.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Design System Tokens -->

    <!-- Primary brand palette -->
    <Color x:Key="PrimaryColor">#FF5C4EAE</Color>
    <Color x:Key="PrimaryDarkColor">#FF453685</Color>
    <Color x:Key="PrimaryLightColor">#FF8A7FD9</Color>

    <!-- Category colours -->
    <Color x:Key="ImportantColor">#FF9C27B0</Color>
    <Color x:Key="ReminderColor">#FF2196F3</Color>
    <Color x:Key="BinColor">#FFF44336</Color>
    <Color x:Key="MyNotesColor">#FFE8E8E8</Color>

    <!-- Semantic colours -->
    <Color x:Key="BackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceColor">#FFF5F5F5</Color>
    <Color x:Key="TextPrimaryColor">#FF212121</Color>
    <Color x:Key="TextSecondaryColor">#FF757575</Color>
    <Color x:Key="DividerColor">#FFBDBDBD</Color>
    <Color x:Key="ErrorColor">#FFD32F2F</Color>
    <Color x:Key="SuccessColor">#FF388E3C</Color>
    <Color x:Key="WarningColor">#FFF57C00</Color>

    <!-- MAUI Template Colours (preserved for default Styles.xaml) -->
    <Color x:Key="Primary">#FF512BD4</Color>
    <Color x:Key="PrimaryDark">#FFac99ea</Color>
    <Color x:Key="PrimaryDarkText">#FF242424</Color>
    <Color x:Key="Secondary">#FFDFD8F7</Color>
    <Color x:Key="SecondaryDarkText">#FF9880e5</Color>
    <Color x:Key="Tertiary">#FF2B0B98</Color>

    <Color x:Key="White">#FFFFFFFF</Color>
    <Color x:Key="Black">#FF000000</Color>
    <Color x:Key="Magenta">#FFD600AA</Color>
    <Color x:Key="MidnightBlue">#FF190649</Color>
    <Color x:Key="OffBlack">#FF1f1f1f</Color>

    <Color x:Key="Gray100">#FFE1E1E1</Color>
    <Color x:Key="Gray200">#FFC8C8C8</Color>
    <Color x:Key="Gray300">#FFACACAC</Color>
    <Color x:Key="Gray400">#FF919191</Color>
    <Color x:Key="Gray500">#FF6E6E6E</Color>
    <Color x:Key="Gray600">#FF404040</Color>
    <Color x:Key="Gray900">#FF212121</Color>
    <Color x:Key="Gray950">#FF141414</Color>

    <!-- Solid-colour brushes - convenient shorthand for one-off bindings. -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="PrimaryColorBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDark}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}" />
    <SolidColorBrush x:Key="ImportantBrush" Color="{StaticResource ImportantColor}" />
    <SolidColorBrush x:Key="ReminderBrush" Color="{StaticResource ReminderColor}" />
    <SolidColorBrush x:Key="BinBrush" Color="{StaticResource BinColor}" />
    <SolidColorBrush x:Key="MyNotesBrush" Color="{StaticResource MyNotesColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}" />
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}" />
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}" />
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}" />
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}" />
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}" />
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}" />
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}" />

</ResourceDictionary>
