<?xml version="1.0" encoding="UTF-8" ?>
<!--
    ForgotPasswordPage — Task 2-05 (Create Forgot Password Screen / ForgotPasswordPage).

    Layout matches the design in Task Managment/images/forgot.png
    (see also §8.4 of SPECIFICATION.md):

        ┌─────────────────────────────────────┐
        │            [todo logo]              │   <- visual identity from Splash
        │        Forgot password              │   <- title
        │  Enter the e-mail associated with  │   <- subtitle
        │        your account                 │
        │                                     │
        │   Email                  ← field    │
        │   Please enter your …     ← error   │
        │                                     │
        │   [ Send reset link ]               │   <- primary, pill button
        │                                     │
        │   Remember your password? Sign in   │   <- link back to SignIn
        └─────────────────────────────────────┘

    The page hides the Shell navigation bar so the user lands on a
    dedicated, distraction-free recovery surface — mirroring the splash,
    sign-in and sign-up pages.  The XAML is fully data-bound to
    <see cref="ViewModels.ForgotPasswordPageViewModel"/>; the code-behind
    (<c>ForgotPasswordPage.xaml.cs</c> / <c>ForgotPasswordPage.cs</c>) is
    only responsible for inflating the XAML and binding it to the
    injected ViewModel.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Todo.ViewModels"
             x:Class="Todo.Views.Authentication.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordPageViewModel"
             Title="Forgot password"
             BackgroundColor="{StaticResource BackgroundColor}"
             Shell.NavBarIsVisible="False">

    <!-- Whole page scrolls when the keyboard is up so the form stays
         usable on a phone-sized screen. -->
    <ScrollView>
        <VerticalStackLayout
            Padding="32,48,32,32"
            Spacing="0"
            VerticalOptions="Center"
            HorizontalOptions="Fill"
            MaximumWidthRequest="480">

            <!-- ============================================================ -->
            <!-- Brand mark — mirrors the splash, sign-in and sign-up        -->
            <!-- screens so the user has a consistent visual identity       -->
            <!-- throughout the authentication flow.                        -->
            <!-- ============================================================ -->
            <Grid
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Margin="0,0,0,24"
                WidthRequest="96"
                HeightRequest="48"
                ColumnSpacing="4"
                RowSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <BoxView Grid.Row="0" Grid.Column="0"
                         Color="{StaticResource PrimaryDarkColor}"
                         CornerRadius="4" />
                <BoxView Grid.Row="0" Grid.Column="1"
                         Color="{StaticResource PrimaryColor}"
                         CornerRadius="4" />
                <BoxView Grid.Row="0" Grid.Column="2"
                         Color="{StaticResource PrimaryLightColor}"
                         CornerRadius="4" />
                <BoxView Grid.Row="0" Grid.Column="3"
                         Color="{StaticResource PrimaryDarkColor}"
                         CornerRadius="4" />

                <BoxView Grid.Row="1" Grid.Column="0"
                         Color="{StaticResource PrimaryColor}"
                         CornerRadius="4" />
                <BoxView Grid.Row="1" Grid.Column="1"
                         Color="{StaticResource PrimaryLightColor}"
                         CornerRadius="4" />
                <BoxView Grid.Row="1" Grid.Column="2"
                         Color="{StaticResource PrimaryColor}"
                         CornerRadius="4" />
                <BoxView Grid.Row="1" Grid.Column="3"
                         Color="{StaticResource PrimaryLightColor}"
                         CornerRadius="4" />
            </Grid>

            <!-- Title. -->
            <Label
                Text="Forgot password"
                Style="{StaticResource LabelHeading1}"
                HorizontalOptions="Center"
                Margin="0,0,0,8" />

            <!-- Subtitle. -->
            <Label
                Text="Enter the e-mail associated with your account and we'll send you a link to reset your password."
                Style="{StaticResource LabelSubtitle}"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,32" />

            <!-- ============================================================ -->
            <!-- E-mail field.                                                -->
            <!-- ============================================================ -->
            <Label
                Text="Email"
                Style="{StaticResource LabelCaption}"
                Margin="4,0,0,4" />

            <Border
                Stroke="{StaticResource DividerColor}"
                StrokeThickness="{StaticResource StrokeThicknessThin}"
                StrokeShape="RoundRectangle 8"
                BackgroundColor="{StaticResource SurfaceColor}"
                Padding="0">
                <Entry
                    x:Name="EmailEntry"
                    Text="{Binding Email, Mode=TwoWay}"
                    Placeholder="Email"
                    Keyboard="Email"
                    IsSpellCheckEnabled="False"
                    IsTextPredictionEnabled="False"
                    ReturnType="Done"
                    ReturnCommand="{Binding SendResetLinkCommand}"
                    BackgroundColor="Transparent" />
            </Border>

            <Label
                Text="{Binding EmailError}"
                Style="{StaticResource LabelError}"
                Margin="4,4,0,0"
                IsVisible="{Binding HasEmailError}" />

            <!-- ============================================================ -->
            <!-- Send reset link button — full width, pill-shaped, shows a   -->
            <!-- busy spinner inline while IsLoading is true.                -->
            <!-- ============================================================ -->
            <Grid Margin="0,24,0,0">
                <Button
                    Text="Send reset link"
                    Style="{StaticResource ButtonPrimary}"
                    Command="{Binding SendResetLinkCommand}"
                    HorizontalOptions="Fill" />

                <ActivityIndicator
                    IsRunning="{Binding IsLoading}"
                    IsVisible="{Binding IsLoading}"
                    Color="{StaticResource BackgroundColor}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="24"
                    HeightRequest="24" />
            </Grid>

            <!-- Form-level error banner.  Shown when the underlying service
                 call fails (network error, unexpected exception) or the
                 supplied e-mail address is not associated with an account. -->
            <Label
                Text="{Binding ErrorMessage}"
                Style="{StaticResource LabelError}"
                Margin="4,12,4,0"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                IsVisible="{Binding HasError}" />

            <!-- ============================================================ -->
            <!-- Confirmation message.  Shown after a successful             -->
            <!-- request: the user is told that, if the e-mail exists,       -->
            <!-- they've been sent instructions — without leaking whether   -->
            <!-- the e-mail is registered (privacy best practice).           -->
            <!-- ============================================================ -->
            <Label
                Text="{Binding ConfirmationMessage}"
                Style="{StaticResource LabelSubtitle}"
                Margin="4,12,4,0"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                TextColor="{StaticResource SuccessColor}"
                IsVisible="{Binding HasConfirmation}" />

            <!-- ============================================================ -->
            <!-- Sign-in navigation footer.                                   -->
            <!-- ============================================================ -->
            <Grid
                Margin="0,32,0,0"
                ColumnSpacing="4"
                HorizontalOptions="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Label
                    Grid.Column="0"
                    Text="Remember your password?"
                    Style="{StaticResource LabelBody}"
                    VerticalOptions="Center" />

                <Button
                    Grid.Column="1"
                    Text="Sign in"
                    Command="{Binding NavigateToSignInCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource PrimaryColor}"
                    FontSize="14"
                    MinimumHeightRequest="44"
                    Padding="0"
                    BorderWidth="0"
                    CornerRadius="0" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
