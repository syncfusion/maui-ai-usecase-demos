<?xml version="1.0" encoding="UTF-8" ?>
<!--
    NotesPage
    =========
    The single, shared page that hosts My Notes, Important, Reminder and
    Bin filter views. The page is structured exactly as the specification
    requires:

        Row 0 : Shared HeaderTemplate    (full width)
        Row 1 :
            Col 0 : Sidebar (SidebarView)
            Col 1 : Main content area
                    - content header (title + 3-dot menu)
                    - background image + SfListView + empty state
                    - floating + FAB (visible when empty)

    A second row hosts the shared BottomInputBar that spans both columns.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Todo.Features.Notes.ViewModels"
             xmlns:templates="clr-namespace:Todo.Features.Notes.Views.Templates"
             xmlns:common="clr-namespace:Todo.Common"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             x:Class="Todo.Features.Notes.Views.NotesPage"
             x:Name="Notes"
             x:DataType="vm:NotesListViewModel"
             Padding="0">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Reusable DataTemplate subclasses -->
            <templates:SidebarItemTemplate x:Key="SidebarItemTemplate" />
            <templates:NoteItemTemplate x:Key="NoteItemTemplate" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <!--
        Outer Grid layout:
        Row 0 : HeaderTemplate (shared, full width)   (Auto height)
        Row 1 : Sidebar | Main content                (fills remaining)
        Row 2 : BottomInputBar (shared)               (Auto height)
    -->
    <Grid RowDefinitions="Auto,*,Auto"
          BackgroundColor="{StaticResource BackgroundColor}">

        <!-- ====================================================== -->
        <!-- ROW 0  —  Shared HeaderTemplate                         -->
        <!-- ====================================================== -->
        <templates:HeaderTemplate Grid.Row="0" />

        <!-- ====================================================== -->
        <!-- ROW 1  —  Sidebar (col 0)  |  Main content (col 1)      -->
        <!-- ====================================================== -->
        <Grid Grid.Row="1"
              ColumnDefinitions="{OnIdiom Phone='0,*', Default='230,*'}"
              RowDefinitions="*">

            <!-- Sidebar (col 0) -->
            <templates:SidebarView Grid.Column="0"
                                   IsVisible="{Binding IsSidebarVisible}" />

            <!-- Main content (col 1) -->
            <Grid Grid.Column="1"
                  RowDefinitions="Auto,*"
                  BackgroundColor="{StaticResource BackgroundColor}">

                <!-- Content header — list title + 3-dot menu (hidden when empty to match mynotes.png) -->
                <Grid Grid.Row="0"
                      Padding="20,12,12,8"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="8"
                      IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}">
                    <Label Grid.Column="0"
                           Text="{Binding HeaderTitle}"
                           Style="{StaticResource ContentTitleStyle}" />
                    <Button Grid.Column="1"
                            Text="&#8943;"
                            FontSize="20"
                            FontAttributes="Bold"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource TextOnDarkColor}"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0" />
                </Grid>

                <!-- Content area: background image + SfListView + empty state + FAB -->
                <Grid Grid.Row="1">

                    <!-- 1. Full-bleed background image (matches design) -->
                    <Image Aspect="AspectFill"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill">
                        <Image.Triggers>
                            <DataTrigger TargetType="Image" Binding="{Binding SelectedCategory}" Value="{x:Static common:NotesListCategory.MyNotes}">
                                <Setter Property="Source" Value="mynotes_bg.png" />
                            </DataTrigger>
                            <DataTrigger TargetType="Image" Binding="{Binding SelectedCategory}" Value="{x:Static common:NotesListCategory.Important}">
                                <Setter Property="Source" Value="important_bg.png" />
                            </DataTrigger>
                            <DataTrigger TargetType="Image" Binding="{Binding SelectedCategory}" Value="{x:Static common:NotesListCategory.Reminder}">
                                <Setter Property="Source" Value="remainder_bg.png" />
                            </DataTrigger>
                            <DataTrigger TargetType="Image" Binding="{Binding SelectedCategory}" Value="{x:Static common:NotesListCategory.Bin}">
                                <Setter Property="Source" Value="bin_bg.png" />
                            </DataTrigger>
                        </Image.Triggers>
                    </Image>

                    <!-- 2. List of note cards (SfListView with the card template) -->
                    <syncfusion:SfListView x:Name="NotesList"
                                           ItemsSource="{Binding FilteredNotes}"
                                           ItemSize="76"
                                           SelectionMode="Single"
                                           ItemSpacing="6"
                                           BackgroundColor="Transparent"
                                           ItemTemplate="{StaticResource NoteItemTemplate}"
                                           IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}">
                    </syncfusion:SfListView>

                    <!-- 3. Empty state (visible when FilteredNotes is empty) -->
                    <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="12">
                        <Label Text="&#128203;"
                               FontSize="64"
                               TextColor="{StaticResource TextTertiaryColor}"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding EmptyStateTitle}"
                               Style="{StaticResource EmptyStateTitleStyle}" />
                        <Label Text="{Binding EmptyStateMessage}"
                               Style="{StaticResource EmptyStateMessageStyle}" />
                    </VerticalStackLayout>

                    <!-- 4. FAB (floating + to add a task quickly when empty) -->
                    <Button Text="&#65291;"
                            FontSize="28"
                            WidthRequest="56"
                            HeightRequest="56"
                            CornerRadius="28"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            TextColor="{StaticResource OnPrimaryColor}"
                            HorizontalOptions="End"
                            VerticalOptions="End"
                            Margin="0,0,24,24"
                            IsVisible="{Binding IsEmpty}" />
                </Grid>
            </Grid>
        </Grid>

        <!-- ====================================================== -->
        <!-- ROW 2  —  Shared BottomInputBar                         -->
        <!-- ====================================================== -->
        <templates:BottomInputBar Grid.Row="2" />
    </Grid>
</ContentPage>
