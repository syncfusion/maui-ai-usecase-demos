<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Todo.Features.Notes.ViewModels"
             xmlns:common="clr-namespace:Todo.Common"
             xmlns:conv="clr-namespace:Todo.Converters"
             x:Class="Todo.Features.Notes.Views.SidebarView"
             x:Name="SidebarRoot"
             x:DataType="vm:NotesListViewModel"
             BackgroundColor="{StaticResource SidebarBackgroundColor}">

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="0,12,0,16">

        <!-- Sidebar header (app title) — only shown when expanded -->
        <Label Grid.Row="0"
               Text="To Do List"
               FontSize="16"
               FontAttributes="Bold"
               TextColor="{StaticResource TextPrimaryColor}"
               Padding="20,8,16,12"
               IsVisible="{Binding IsSidebarCollapsed, Converter={StaticResource InvertedBoolConverter}}" />

        <!-- Sidebar entries (My Notes, Important, Reminder, Bin) -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding AvailableCategories}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedCategory, Mode=TwoWay, Converter={StaticResource ObjectToCategoryConverter}}"
                        BackgroundColor="Transparent"
                        VerticalOptions="Fill"
                        SelectionChanged="OnSidebarSelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="common:NotesListCategory">
                    <Border Margin="10,2"
                            Padding="14,0"
                            BackgroundColor="Transparent"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8"
                            HeightRequest="44">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="{StaticResource SidebarSelectionColor}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="14"
                              VerticalOptions="Center">
                            <Button Grid.Column="0"
                                    FontSize="20" Background="Transparent"
                                    VerticalOptions="Center"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    Padding="0"
                                    IsEnabled="False"
                                    TextColor="{Binding ., Converter={StaticResource CategoryToColorConverter}}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding .}" Value="{x:Static common:NotesListCategory.MyNotes}">
                                        <Setter Property="ImageSource" Value="profileicon.png" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Button" Binding="{Binding .}" Value="{x:Static common:NotesListCategory.Important}">
                                        <Setter Property="ImageSource" Value="importanticon.png" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Button" Binding="{Binding .}" Value="{x:Static common:NotesListCategory.Reminder}">
                                        <Setter Property="ImageSource" Value="belliconsidebar.png" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Button" Binding="{Binding .}" Value="{x:Static common:NotesListCategory.Bin}">
                                        <Setter Property="ImageSource" Value="binicon.png" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Label Grid.Column="1"
                                   Text="{Binding ., Converter={StaticResource EnumDisplayNameConverter}, FallbackValue=''}"
                                   Style="{StaticResource SidebarItemLabelStyle}"
                                   IsVisible="{Binding Source={x:Reference SidebarRoot}, Path=BindingContext.IsSidebarCollapsed, Converter={StaticResource InvertedBoolConverter}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- "+" button to create a new list (placeholder for Module-05) -->
        <Button Grid.Row="2"
                Text="&#65291;"
                FontSize="26"
                WidthRequest="52"
                HeightRequest="52"
                CornerRadius="26"
                Padding="0"
                Margin="16,12,0,0"
                HorizontalOptions="End"
                BackgroundColor="{StaticResource PrimaryColor}"
                TextColor="{StaticResource OnPrimaryColor}"
                SemanticProperties.Description="Create a to-do list" />
    </Grid>

</ContentView>
