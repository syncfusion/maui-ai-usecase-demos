<?xml version="1.0" encoding="UTF-8" ?>
<DataTemplate x:Class="Todo.Features.Notes.Views.Templates.NoteItemTemplate"
              xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
              xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:conv="clr-namespace:Todo.Converters"
              xmlns:models="clr-namespace:Todo.Features.Notes.Models">

    <!--
        Note card template – matches the design in mynotes.png / important.png /
        remainder.png / bin.png.

        Anatomy (from IMAGE_ANALYSIS §3.5):
        [ 20dp ] [   flex          ] [ 24 ] [ 24 ]
        [ chk  ] [ Title (16sp)    ] [ ⭐ ] [ ⋮  ]
        [       ] [ 📅 date 🕒 time 🔁 ] [    ] [    ]
    -->
    <Border Margin="0,4"
            Padding="{StaticResource TaskItemPadding}"
            BackgroundColor="{StaticResource SurfaceColor}"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 10">
        <Border.Shadow>
            <Shadow Brush="#22000000" Radius="3" Offset="0,1" Opacity="0.20" />
        </Border.Shadow>

        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
              ColumnSpacing="10"
              RowDefinitions="Auto,Auto"
              RowSpacing="2">

            <!-- Checkbox (toggle complete) -->
            <CheckBox Grid.Row="0" Grid.Column="0"
                      Grid.RowSpan="2"
                      IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                      Color="{StaticResource PrimaryColor}"
                      VerticalOptions="Center"
                      WidthRequest="22"
                      HeightRequest="22"
                      SemanticProperties.Description="Mark note complete" />

            <!-- Title -->
            <Label Grid.Row="0" Grid.Column="1"
                   Text="{Binding Title}"
                   Style="{StaticResource NoteTitleStyle}"
                   TextDecorations="{Binding IsCompleted, Converter={StaticResource BoolToTextDecorationConverter}}" />

            <!-- Star (toggle important) -->
            <Button Grid.Row="0" Grid.Column="2"
                    Text="{Binding IsImportant, Converter={StaticResource BoolToStarGlyphConverter}}"
                    FontSize="20"
                    WidthRequest="32"
                    HeightRequest="32"
                    Padding="0"
                    BackgroundColor="Transparent"
                    TextColor="{Binding IsImportant, Converter={StaticResource BoolToStarColorConverter}}"
                    Clicked="OnStarClicked"
                    VerticalOptions="Center"
                    SemanticProperties.Description="Mark note important" />

            <!-- Three-dot more menu (per design §5.3) -->
            <Button Grid.Row="0" Grid.Column="3"
                    Text="&#8943;"
                    FontSize="20"
                    WidthRequest="32"
                    HeightRequest="32"
                    Padding="0"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource TextSecondaryColor}"
                    Clicked="OnMoreClicked"
                    VerticalOptions="Center"
                    SemanticProperties.Description="More note options" />

            <!-- Metadata row (due date / reminder time) -->
            <HorizontalStackLayout Grid.Row="1" Grid.Column="1"
                                   Grid.ColumnSpan="3"
                                   Spacing="10"
                                   IsVisible="{Binding HasReminder}">
                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label Text="📅"
                           FontSize="11"
                           TextColor="{StaticResource TextSecondaryColor}"
                           VerticalOptions="Center" />
                    <Label Text="{Binding DueDate, Converter={StaticResource DateTimeFormatConverter}, ConverterParameter=date, FallbackValue=''}"
                           Style="{StaticResource NoteMetaStyle}" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label Text="🔔"
                           FontSize="11"
                           TextColor="{StaticResource TextSecondaryColor}"
                           VerticalOptions="Center" />
                    <Label Text="{Binding ReminderDate, Converter={StaticResource DateTimeFormatConverter}, ConverterParameter=time, FallbackValue=''}"
                           Style="{StaticResource NoteMetaStyle}" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>

        </Grid>
    </Border>

</DataTemplate>
