<?xml version="1.0" encoding="UTF-8" ?>
<!--
    BottomInputBar
    ==============
    Reusable pill input row used at the bottom of every list view. The
    bar is fixed to the bottom of the page; it contains the "Add a
    note" input plus three utility icons and the primary submit
    button, all bound to the shared NotesListViewModel.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Todo.Features.Notes.ViewModels"
             x:Class="Todo.Features.Notes.Views.Templates.BottomInputBar"
             x:DataType="vm:NotesListViewModel">

    <Grid HeightRequest="{StaticResource BottomInputHeight}"
          BackgroundColor="{StaticResource BottomBarBackgroundColor}"
          Padding="16,8"
          ColumnDefinitions="*,Auto"
          ColumnSpacing="8">

        <Grid.Shadow>
            <Shadow Brush="#15000000" Radius="6" Offset="0,-1" Opacity="0.10" />
        </Grid.Shadow>

        <!-- Pill-shaped input -->
        <Border Grid.Column="0"
                BackgroundColor="{StaticResource InputPillBackgroundColor}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 24"
                Padding="14,0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                  ColumnSpacing="6"
                  VerticalOptions="Center">
                <Label Grid.Column="0"
                       Text="&#65291;"
                       FontSize="14"
                       TextColor="{StaticResource TextSecondaryColor}"
                       VerticalOptions="Center" />
                <Entry Grid.Column="1"
                       Text="{Binding NewNoteTitle, Mode=TwoWay}"
                       Placeholder="Add a note"
                       Style="{StaticResource InputPillEntryStyle}"
                       ReturnCommand="{Binding AddNoteCommand}" />
                <Button Grid.Column="2"
                        Text="&#128197;"
                        FontSize="14"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource TextSecondaryColor}"
                        WidthRequest="32"
                        HeightRequest="32"
                        Padding="0" />
                <Button Grid.Column="3"
                        Text="&#128276;"
                        FontSize="14"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource TextSecondaryColor}"
                        WidthRequest="32"
                        HeightRequest="32"
                        Padding="0" />
                <Button Grid.Column="4"
                        Text="&#127991;"
                        FontSize="14"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource TextSecondaryColor}"
                        WidthRequest="32"
                        HeightRequest="32"
                        Padding="0" />
            </Grid>
        </Border>

        <!-- Submit button (purple circle) -->
        <Button Grid.Column="1"
                Text="&#10003;"
                FontSize="20"
                FontAttributes="Bold"
                WidthRequest="44"
                HeightRequest="44"
                CornerRadius="22"
                Padding="0"
                BackgroundColor="{StaticResource PrimaryColor}"
                TextColor="{StaticResource OnPrimaryColor}"
                Command="{Binding AddNoteCommand}" />
    </Grid>

</ContentView>
