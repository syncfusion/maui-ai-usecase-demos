<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Spacing scale -->
    <x:Double x:Key="SpacingXxs">4</x:Double>
    <x:Double x:Key="SpacingXs">8</x:Double>
    <x:Double x:Key="SpacingS">12</x:Double>
    <x:Double x:Key="SpacingM">16</x:Double>
    <x:Double x:Key="SpacingL">24</x:Double>
    <x:Double x:Key="SpacingXl">32</x:Double>
    <x:Double x:Key="SpacingXxl">48</x:Double>

    <!--<Thickness x:Key="PaddingXxs">SpacingXxs</Thickness>
    <Thickness x:Key="PaddingXs">SpacingXs</Thickness>
    <Thickness x:Key="PaddingS">SpacingS</Thickness>
    <Thickness x:Key="PaddingM">SpacingM</Thickness>
    <Thickness x:Key="PaddingL">SpacingL</Thickness>-->

    <!-- Component dimensions (matches the spec) -->
    <x:Double x:Key="HeaderHeight">48</x:Double>
    <x:Double x:Key="BottomInputHeight">64</x:Double>
    <x:Double x:Key="SidebarWidth">190</x:Double>
    <x:Double x:Key="SidebarCollapsedWidth">64</x:Double>

    <x:Double x:Key="TaskItemPadding">12</x:Double>
    <x:Double x:Key="TaskItemMargin">8</x:Double>
    <x:Double x:Key="TaskItemSpacing">6</x:Double>

    <x:Double x:Key="ListItemIconSize">20</x:Double>
    <x:Double x:Key="ListItemIconSizeLarge">24</x:Double>
    <x:Double x:Key="AvatarSize">40</x:Double>
    <x:Double x:Key="FabSize">56</x:Double>
    <x:Double x:Key="CheckboxTouchTarget">48</x:Double>
    <x:Double x:Key="StarTouchTarget">40</x:Double>

    <!-- Border radius -->
    <CornerRadius x:Key="CornerRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">12</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">16</CornerRadius>
    <CornerRadius x:Key="CornerRadiusPill">24</CornerRadius>

    <!-- Stroke thickness -->
    <x:Double x:Key="StrokeThicknessThin">1</x:Double>
    <x:Double x:Key="StrokeThicknessMedium">2</x:Double>
    <x:Double x:Key="StrokeThicknessThick">4</x:Double>

    <!-- Elevation (Shadow) -->
    <Shadow x:Key="Elevation1">
        <Shadow.Brush>#20000000</Shadow.Brush>
        <Shadow.Radius>3</Shadow.Radius>
        <Shadow.Offset>0,1</Shadow.Offset>
        <Shadow.Opacity>0.12</Shadow.Opacity>
    </Shadow>
    <Shadow x:Key="Elevation2">
        <Shadow.Brush>#33000000</Shadow.Brush>
        <Shadow.Radius>6</Shadow.Radius>
        <Shadow.Offset>0,3</Shadow.Offset>
        <Shadow.Opacity>0.16</Shadow.Opacity>
    </Shadow>

</ResourceDictionary>