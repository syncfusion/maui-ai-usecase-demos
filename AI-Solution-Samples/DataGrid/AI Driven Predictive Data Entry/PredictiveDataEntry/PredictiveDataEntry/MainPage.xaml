<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PredictiveDataEntry"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
             xmlns:button="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             x:Class="PredictiveDataEntry.MainPage">

    <ContentPage.BindingContext>
        <local:GenerateDataCollection x:Name="generateDataCollection" />
    </ContentPage.BindingContext>

    <ContentPage.Behaviors>
        <local:DataPredictionBehaviour />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <local:DataPredictionConverter x:Key="converter" />
        <Style TargetType="syncfusion:DataGridHeaderCell">
            <Setter Property="FontFamily"
                 Value="Roboto-Medium" />
        </Style>
        <Style TargetType="syncfusion:DataGridCell">
            <Setter Property="FontFamily"
                 Value="Roboto-Regular" />
            <Setter Property="Background"
                    Value="{Binding Source={RelativeSource Mode=Self}, Converter={StaticResource converter}}" />
        </Style>
    </ContentPage.Resources>

    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Label Text="AI Predictive Data Entry"
                    VerticalTextAlignment="Center"
                    Padding="16,0,16,0"
                    FontSize="15"
                    Grid.Column="0"
                    FontAttributes="Bold" />

                <button:SfButton x:Name="button"
                              Text="Predictive Data"
                              Grid.Column="2"
                              Margin="16,0,16,0"
                              HeightRequest="40"
                              CornerRadius="5" />
            </Grid>

            <syncfusion:SfDataGrid x:Name="dataGrid" Grid.Row="1" ItemsSource="{Binding Predictivedatas}"
                             AutoGenerateColumnsMode="None">
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:DataGridTextColumn HeaderText="ID"
                                     Width="120"
                                     MappingName="StudentID" />
                    <syncfusion:DataGridTextColumn HeaderText="Name"
                                     Width="120"
                                     MappingName="StudentName" />
                    <syncfusion:DataGridTextColumn HeaderText="First Year GPA"
                                     Width="150"
                                     MappingName="FirstYearGPA" />
                    <syncfusion:DataGridTextColumn HeaderText="Second Year GPA"
                                     Width="150"
                                     MappingName="SecondYearGPA" />
                    <syncfusion:DataGridTextColumn HeaderText="Third Year GPA"
                                     Width="150"
                                     MappingName="ThirdYearGPA" />

                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>

            <ActivityIndicator IsRunning="False"
                            x:Name="Indicator"
                            Grid.Row="1"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            Color="Black" />
        </Grid>
    </ContentPage.Content>
</ContentPage>
