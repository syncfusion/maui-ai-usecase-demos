<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:input="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
			 xmlns:dataForm="clr-namespace:Syncfusion.Maui.DataForm;assembly=Syncfusion.Maui.DataForm"
			 xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
			 xmlns:indicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
			 xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
			 x:Class="DataFormAISolution.MainPage">

	<Grid>
		<ScrollView>
			<VerticalStackLayout MaximumWidthRequest="760"
								 HorizontalOptions="Center"
								 Padding="{OnIdiom Default='24,28,24,20', Phone='12,14,12,20'}"
								 Spacing="10">

				<!-- YOUR CONTENT CARD -->
				<Border BackgroundColor="{StaticResource CardBackground}"
						Stroke="{StaticResource BorderColor}"
						StrokeThickness="1"
						Padding="22">

					<Border.StrokeShape>
						<RoundRectangle CornerRadius="14" />
					</Border.StrokeShape>

					<VerticalStackLayout Spacing="14">

						<core:SfTextInputLayout ContainerType="Filled"
												ShowHint="False"
												HeightRequest="180"
												Padding="0,-16,0,0"
												ContainerBackground="#F5F6FF"
												OutlineCornerRadius="8">

							<Editor Text="{Binding UserInput}"
									HeightRequest="160"
									Placeholder="Paste or type your content here..."
									VerticalOptions="Start"
									FontSize="13"
									TextColor="#101828" />

						</core:SfTextInputLayout>

						<!-- Helper information -->
						<Grid Margin="0"
							  ColumnDefinitions="{OnIdiom Default='*,Auto', Phone='*'}"
							  RowDefinitions="{OnIdiom Default='*', Phone='Auto,*'}">

							<HorizontalStackLayout Spacing="7"
												   Margin="0,-14,0,0">
								<Label Text="ⓘ"
									   FontSize="16"
									   TextColor="#0878D1"
									   VerticalOptions="Center" />

								<Label Text="Paste or type any free-form text."
									   Style="{StaticResource HelperLabelStyle}"
									   VerticalOptions="Center" />
							</HorizontalStackLayout>

							<!-- GENERATE BUTTON -->
							<buttons:SfButton Text="Generate Form"
											  Grid.Column="{OnIdiom Default='1', Phone='0'}"
											  Grid.Row="{OnIdiom Default='0', Phone='1'}"
											  Command="{Binding GenerateFormCommand}"
											  Margin="{OnIdiom Default='0,-12,0,0', Phone='0,16,0,0'}"
											  WidthRequest="200"
											  Background="#0878D1"
											  HorizontalOptions="Center"
											  TextColor="White"
											  FontAttributes="Bold"
											  FontSize="16"
											  HeightRequest="48"
											  CornerRadius="9" />

						</Grid>

					</VerticalStackLayout>

				</Border>

				<!-- BUSY OVERLAY -->
				<Grid IsVisible="{Binding IsBusy}">

					<core:SfBusyIndicator IsRunning="{Binding IsBusy}"
										  HeightRequest="100"
										  WidthRequest="100"
										  AnimationType="CircularMaterial"
										  HorizontalOptions="Center"
										  VerticalOptions="Start" />

				</Grid>

				<!-- GENERATED FORM CARD  -->
				<Border IsVisible="{Binding ShowForm}"
						BackgroundColor="{StaticResource CardBackground}"
						Stroke="{StaticResource BorderColor}"
						StrokeThickness="1"
						Padding="22">

					<Border.StrokeShape>
						<RoundRectangle CornerRadius="14" />
					</Border.StrokeShape>

					<VerticalStackLayout Spacing="18">

						<!-- Header -->
						<Grid ColumnDefinitions="*,Auto">

							<Label Grid.Column="0"
								   Text=" "
								   Style="{StaticResource SectionTitleStyle}" />

							<Label Grid.Column="1"
								   Text="AI Generated"
								   FontSize="10"
								   TextColor="#0878D1"
								   VerticalOptions="Center" />

						</Grid>

						<!-- Syncfusion DataForm -->
						<dataForm:SfDataForm x:Name="GeneratedDataForm"
											 AutoGenerateItems="False"
											 WidthRequest="360"
											 HorizontalOptions="Fill">
							<dataForm:SfDataForm.DefaultLayoutSettings>
								<dataForm:DataFormDefaultLayoutSettings LabelPosition="{OnIdiom Default='Left', Phone='Top'}" />
							</dataForm:SfDataForm.DefaultLayoutSettings>
						</dataForm:SfDataForm>

					</VerticalStackLayout>
				</Border>
			</VerticalStackLayout>
		</ScrollView>
	</Grid>
</ContentPage>
