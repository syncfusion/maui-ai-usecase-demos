	public partial class MainPage : ContentPage
	{
		private readonly FormViewModel _viewModel;

		public MainPage()
		{
			InitializeComponent();
			_viewModel = new FormViewModel();

			BindingContext = _viewModel;

			_viewModel.PropertyChanged +=
				ViewModel_PropertyChanged;
		}

		private void ViewModel_PropertyChanged(
object? sender,
PropertyChangedEventArgs e)
		{
			if (e.PropertyName ==
			nameof(FormViewModel.FormGenerationVersion))
			{
				MainThread.BeginInvokeOnMainThread(
				GenerateDataForm);
			}
		}

		private void GenerateDataForm()
		{
			GeneratedDataForm.Items.Clear();

			// Create a dynamic object to hold AI values.
			IDictionary<string, object?> formData =
				new ExpandoObject();

			foreach (var field in _viewModel.GeneratedFields)
			{
				string fieldName = GetValidPropertyName(field.FieldName);

				// Add the actual AI value to DataObject.
				formData[fieldName] =
					ConvertFieldValue(field);

				// Create the corresponding DataForm item.
				DataFormItem item =
					CreateDataFormItem(
						field,
						fieldName);

				GeneratedDataForm.Items.Add(item);
			}

			// IMPORTANT:
			// SfDataForm gets editor values from DataObject.
			//GeneratedDataForm.DataObject = formData;
		}

		private static string GetValidPropertyName(
		string fieldName)
		{
			if (string.IsNullOrWhiteSpace(fieldName))
			{
				return "Field";
			}

			var characters =
				fieldName.Where(char.IsLetterOrDigit);

			string propertyName =
				string.Concat(characters);

			if (string.IsNullOrWhiteSpace(propertyName))
			{
				return "Field";
			}

			if (char.IsDigit(propertyName[0]))
			{
				propertyName =
					"Field" + propertyName;
			}

			return propertyName;
		}

		private static DataFormItem CreateDataFormItem(
		AIField field,
		string fieldName)
		{
			switch (field.FieldType?.ToLowerInvariant())
			{
				case "number":

					return new DataFormNumericItem
					{
						FieldName = fieldName,
						LabelText = field.FieldName,						
						PlaceholderText =
							$"Enter {field.FieldName}",
					};

				case "phone":

					return new DataFormMaskedTextItem
					{
						FieldName = fieldName,
						LabelText = field.FieldName,
						PlaceholderText =
							$"Enter {field.FieldName}"
					};

				case "email":

					return new DataFormTextItem
					{
						FieldName = fieldName,
						LabelText = field.FieldName,
						PlaceholderText =
							$"Enter {field.FieldName}"
					};

				case "text":

				default:

					return new DataFormTextItem
					{
						FieldName = fieldName,
						LabelText = field.FieldName,
						PlaceholderText =
							$"Enter {field.FieldName}"
					};
			}
		}

		private static object? ConvertFieldValue(
	AIField field)
		{
			string value =
				field.Value ?? string.Empty;

			switch (field.FieldType?.ToLowerInvariant())
			{
				case "number":

					if (double.TryParse(
						value,
						out double number))
					{
						return number;
					}

					return 0d;

				case "phone":
				case "email":
				case "text":

				default:

					return value;
			}
		}


