<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartAITags.TagGeneratorPage"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:vm="clr-namespace:SmartAITags.ViewModel"
             xmlns:model="clr-namespace:SmartAITags.Model"
              >

    <ContentPage.BindingContext>
        <vm:TagViewModel/>
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <!-- Brand accent + container backgrounds (palette used across the page) -->
        <Color x:Key="BrandAccent">#6750A4</Color>
        <Color x:Key="SurfaceLight">#FFFFFF</Color>
        <Color x:Key="SurfaceDark">#1E1B1F</Color>
        <Color x:Key="BorderLight">#E0E0E0</Color>
        <Color x:Key="BorderDark">#3A3A3A</Color>
        <Color x:Key="DisabledText">#9E9E9E</Color>
        <Color x:Key="SecondaryTextLight">#5F6368</Color>
        <Color x:Key="SecondaryTextDark">#BDBDBD</Color>
    </ContentPage.Resources>

    <ScrollView>
        <!-- Centered column with a controlled max width so desktop screenshots look balanced. -->
        <VerticalStackLayout x:Name="RootLayout"
                     Margin="24"
                     HorizontalOptions="Center"
                     VerticalOptions="Center"
                     Spacing="0"
                     MinimumWidthRequest="320"
                     MaximumWidthRequest="640">

            <!-- ===== Header block: title + supporting text (24 px below) ===== -->
            <Label Text="AI-Powered Auto Tag Generator"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#1C1B1F, Dark=#E6E1E5}"/>

            <Label Text="Describe your content and generate relevant tags using AI."
                   FontSize="13"
                   Margin="0,6,0,0"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"/>

            <BoxView HeightRequest="24" Color="Transparent"/>

            <!-- ===== Field label (persistent, 8 px above input) ===== -->
            <Label Text="Content description"
                   FontSize="12"
                   FontAttributes="Bold"
                   Margin="4,0,0,8"
                   TextColor="{AppThemeBinding Light=#1C1B1F, Dark=#E6E1E5}"/>

            <!-- ===== Multiline input inside SfTextInputLayout ===== -->
            <!-- The TrailingView now hosts ONLY the compact Clear (×) icon,
                 shown only when there is text. It no longer pretends to be a
                 search affordance — the labelled Generate Tags button below
                 is the unambiguous primary action. -->
            <syncfusion:SfTextInputLayout x:Name="queryInputLayout"
                                          Hint="Example: Develop an audit logging system for security events"
                                          HeightRequest="92"
                                          ContainerType="Outlined"
                                          ContainerBackground="Transparent"
                                          Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                          ShowHint="True">
                <syncfusion:SfTextInputLayout.HintLabelStyle>
                    <syncfusion:LabelStyle TextColor="{StaticResource DisabledText}" FontSize="13"/>
                </syncfusion:SfTextInputLayout.HintLabelStyle>

                <syncfusion:SfTextInputLayout.TrailingView>
                    <Grid WidthRequest="28" HeightRequest="28"
                          VerticalOptions="Center" HorizontalOptions="Center"
                          x:Name="ClearIconButton"
                          IsVisible="False"
                          InputTransparent="False"
                          Margin="0,10,2,0">
                        <Path Data="M29.916016,0L31.999023,2.0700073 17.988037,16 32,29.930054 29.91803,32 15.905029,18.070007 2.0820313,31.812012 0,29.742004 13.822998,16 0.0010375977,2.2590332 2.0840454,0.18902588 15.905029,13.929016z"
                              Background="Transparent"
                              Fill="{AppThemeBinding Light=#5F6368, Dark=#BDBDBD}"
                              Margin="0,0,0,0">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <TransformGroup.Children>
                                        <RotateTransform Angle="0" />
                                        <ScaleTransform ScaleX="0.45" ScaleY="0.45" />
                                    </TransformGroup.Children>
                                </TransformGroup>
                            </Path.RenderTransform>
                        </Path>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnClearClicked"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                </syncfusion:SfTextInputLayout.TrailingView>

                <Editor x:Name="queryEditor"
                        Text="{Binding UserQuery, Mode=TwoWay}"
                        AutoSize="TextChanges"
                        PlaceholderColor="{StaticResource DisabledText}"
                        TextChanged="OnQueryTextChanged"
                        Completed="OnQueryCompleted"/>
            </syncfusion:SfTextInputLayout>

            <BoxView HeightRequest="16" Color="Transparent"/>

            <!-- ===== Primary action: labelled Generate Tags button ===== -->
            <!-- Visible + Disabled states are bound directly to VM:
                 disabled while IsBusy; offers obvious action terminology. -->
            <Button x:Name="GenerateButton"
                    Text="Generate tags"
                    Command="{Binding GenerateTagsCommand}"
                    BackgroundColor="{StaticResource BrandAccent}"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="14"
                    HeightRequest="48"
                    CornerRadius="10"
                    SemanticProperties.Hint="Generate AI tags from the content description"
                    HorizontalOptions="Fill"/>

            <BoxView HeightRequest="20" Color="Transparent"/>

            <!-- ===== Results label (section header, outside the panel) ===== -->
            <Label Text="Generated tags"
                   FontSize="13"
                   FontAttributes="Bold"
                   Margin="4,0,0,8"
                   TextColor="{AppThemeBinding Light=#1C1B1F, Dark=#E6E1E5}"/>

            <!-- ===== Results panel — neutral surface, subtle border =====
                 Four mutually exclusive states, each driven by a real INPC
                 bool on the ViewModel:
                   - EmptyState    : pre-search / empty hint
                   - IsLoading     : centered loader + "Generating tags"
                   - HasTags       : wrapping SfChipGroup with stronger styling
                   - ErrorState    : red text + Try again button -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
        StrokeThickness="1"
        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
        StrokeShape="RoundRectangle 12"
        Padding="14,12,14,12"
        MinimumHeightRequest="96"
        HorizontalOptions="Fill"
        VerticalOptions="Start">

                <Grid RowDefinitions="*">

                    <!-- State 1 — Empty: visible ONLY before any search. -->
                    <Label Grid.Row="0"
                           Text="Add a content description, then select Generate tags."
                           IsVisible="{Binding ShowEmptyState}"
                           TextColor="{StaticResource DisabledText}"
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           InputTransparent="True"/>

                    <!-- State 2 — Loading: centered loader + "Generating tags".
                         Full ring is visible — no clipped indicator. -->
                    <HorizontalStackLayout Grid.Row="0"
                                           Spacing="8"
                                           IsVisible="{Binding IsLoading}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           InputTransparent="True">
                        <ActivityIndicator WidthRequest="18"
                                           HeightRequest="18"
                                           Color="{StaticResource BrandAccent}"
                                           IsRunning="True"
                                           VerticalOptions="Center"/>
                        <Label Text="Generating tags"
                               TextColor="{StaticResource BrandAccent}"
                               FontSize="13"
                               FontAttributes="Italic"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <syncfusion:SfChipGroup Grid.Row="0"
    x:Name="chipsControl"
    ItemsSource="{Binding Tags}"
    DisplayMemberPath="Name"
    ChipType="Action"
    ChipBackground="{StaticResource BrandAccent}"
    ChipTextColor="White"
    ChipStrokeThickness="0"
    ChipPadding="6,4,0,4" 
    HorizontalOptions="Fill"
    VerticalOptions="Start"
    SemanticProperties.Description="AI generated tag chips">
                        <!--
        Wrap chips to multiple rows by replacing the default horizontal
        StackLayout with a FlexLayout. Without this, the chip group defaults
        to a single-line horizontal StackLayout, and any chip that doesn't fit
        is clipped (which is the "single line + missing tags" issue).
    -->
                        <syncfusion:SfChipGroup.ChipLayout>
                            <FlexLayout HorizontalOptions="Start"
                    VerticalOptions="Start"
                    Direction="Row"
                    Wrap="Wrap"
                    JustifyContent="Start"
                    AlignItems="Start"
                    AlignContent="Start"/>
                        </syncfusion:SfChipGroup.ChipLayout>
                        <syncfusion:SfChipGroup.ItemTemplate>
                            <DataTemplate x:DataType="model:TagModel">
                                <Label Text="{Binding Name}"
                   FontSize="13"
                   Padding="4"
                   TextColor="White"
                   MaxLines="2"
                   LineBreakMode="WordWrap"
                   HorizontalOptions="Start"
                   VerticalOptions="Center"/>
                            </DataTemplate>
                        </syncfusion:SfChipGroup.ItemTemplate>
                    </syncfusion:SfChipGroup>
                </Grid>
            </Border>

             

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>