<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:inputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             xmlns:local="clr-namespace:SmartColorPaletteGenerator"
             x:Class="SmartColorPaletteGenerator.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F3F4F6">

    <ContentPage.Resources>
        <ResourceDictionary>
            <local:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <ScrollView IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
            <VerticalStackLayout Padding="40" Spacing="24">
                <Label Text="AI Powered Color Palette"
                       FontSize="48"
                       HorizontalOptions="Center"
                       TextColor="#111827"
                       FontAttributes="Bold" />

                <Label Text="Generate stunning application themes using AI-powered color recommendations and integrate seamlessly with .NET MAUI."
                       FontSize="20"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center"
                       TextColor="#6B7280"
                       MaximumWidthRequest="700" />

                <Border MaximumWidthRequest="1000"
                        HorizontalOptions="Center"
                        Padding="20"
                        BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16">
                    <Grid ColumnDefinitions="*,180" ColumnSpacing="20">
                        <Entry Text="{Binding StyleInput}"
                               Placeholder="Describe your app, e.g., A calm healthcare dashboard..."
                               FontSize="18"
                               VerticalOptions="Center"
                               IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                               BackgroundColor="Transparent" />
                        <Button Grid.Column="1"
                                Text="Generate"
                                HeightRequest="54"
                                CornerRadius="12"
                                BackgroundColor="#1665F5"
                                TextColor="White"
                                FontAttributes="Bold"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                Clicked="Button_Clicked" />
                    </Grid>
                </Border>

                <Label Text="{Binding GenerationStatus}"
                       FontSize="14"
                       HorizontalOptions="Center"
                       TextColor="#6B7280" />

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   HorizontalOptions="Center"
                                   Color="#1665F5" />

                <Label Text="Palette Variations"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="#1F2937" />

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="25">
                    <Border Grid.Column="0"
                            Padding="20"
                            BackgroundColor="White"
                            Stroke="#E5E7EB"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="20">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding FirstPalette.ThemeName}"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="#1F2937" />
                                <Border Grid.Column="1"
                                        BackgroundColor="#F3F4F6"
                                        Stroke="#E5E7EB"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 5"
                                        Padding="8,4"
                                        HorizontalOptions="End">
                                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                        <Image Source="star.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                                        <Label FontSize="12" TextColor="#6B7280" VerticalTextAlignment="Center">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding FirstPalette.MatchPercentage}" FontAttributes="Bold" />
                                                    <Span Text=" % Match" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                            <Border Stroke="#E5E7EB" StrokeShape="RoundRectangle 10">
                                <inputs:SfColorPicker x:Name="FirstColorPicker"
                                                      ColorMode="Palette"
                                                      IsInline="True"
                                                      IsOpen="True"
                                                      PaletteColumnCount="5"
                                                      PaletteRowCount="1"
                                                      PaletteCellSize="80"
                                                      HeightRequest="100"
                                                      ShowRecentColors="False"
                                                      IsActionButtonsVisible="False"
                                                      IsColorModeSwitcherVisible="False"
                                                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                            </Border>
                            <Button Text="Select"
                                    HeightRequest="50"
                                    CornerRadius="10"
                                    BorderColor="#D1D5DB"
                                    BorderWidth="1"
                                    BackgroundColor="White"
                                    TextColor="#374151"
                                    IsEnabled="False" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1"
                            Padding="20"
                            BackgroundColor="White"
                            Stroke="#E5E7EB"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="20">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding SecondPalette.ThemeName}"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="#1F2937" />
                                <Border Grid.Column="1"
                                        BackgroundColor="#F3F4F6"
                                        Stroke="#E5E7EB"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 5"
                                        Padding="8,4"
                                        HorizontalOptions="End">
                                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                        <Image Source="star.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                                        <Label FontSize="12" TextColor="#6B7280" VerticalTextAlignment="Center">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding SecondPalette.MatchPercentage}" FontAttributes="Bold" />
                                                    <Span Text=" % Match" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                            <Border Stroke="#E5E7EB" StrokeShape="RoundRectangle 10">
                                <inputs:SfColorPicker x:Name="SecondColorPicker"
                                                      ColorMode="Palette"
                                                      IsInline="True"
                                                      IsOpen="True"
                                                      PaletteColumnCount="5"
                                                      PaletteRowCount="1"
                                                      PaletteCellSize="80"
                                                      HeightRequest="100"
                                                      ShowRecentColors="False"
                                                      IsActionButtonsVisible="False"
                                                      IsColorModeSwitcherVisible="False"
                                                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                            </Border>
                            <Button Text="Select"
                                    HeightRequest="50"
                                    CornerRadius="10"
                                    BorderColor="#D1D5DB"
                                    BorderWidth="1"
                                    BackgroundColor="White"
                                    TextColor="#374151"
                                    IsEnabled="False" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="20"
                            BackgroundColor="White"
                            Stroke="#E5E7EB"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="20">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding ThirdPalette.ThemeName}"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="#1F2937" />
                                <Border Grid.Column="1"
                                        BackgroundColor="#F3F4F6"
                                        Stroke="#E5E7EB"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 5"
                                        Padding="8,4"
                                        HorizontalOptions="End">
                                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                        <Image Source="star.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                                        <Label FontSize="12" TextColor="#6B7280" VerticalTextAlignment="Center">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding ThirdPalette.MatchPercentage}" FontAttributes="Bold" />
                                                    <Span Text=" % Match" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                            <Border Stroke="#E5E7EB" StrokeShape="RoundRectangle 10">
                                <inputs:SfColorPicker x:Name="ThirdColorPicker"
                                                      ColorMode="Palette"
                                                      IsInline="True"
                                                      IsOpen="True"
                                                      PaletteColumnCount="5"
                                                      PaletteRowCount="1"
                                                      PaletteCellSize="80"
                                                      HeightRequest="100"
                                                      ShowRecentColors="False"
                                                      IsActionButtonsVisible="False"
                                                      IsColorModeSwitcherVisible="False"
                                                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                            </Border>
                            <Button Text="Select"
                                    HeightRequest="50"
                                    CornerRadius="10"
                                    BorderColor="#D1D5DB"
                                    BorderWidth="1"
                                    BackgroundColor="White"
                                    TextColor="#374151"
                                    IsEnabled="False" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <Grid BackgroundColor="#80000000"
              IsVisible="{Binding IsBusy}"
              InputTransparent="False">
            <ActivityIndicator IsRunning="True"
                               IsVisible="True"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Color="White" />
        </Grid>
    </Grid>
</ContentPage>
