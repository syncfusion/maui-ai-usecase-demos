# Example environment file for the flight-booking agent.
#
# Copy this file to `.env` next to `flight_booking_agent.py` and fill in your
# own values. The agent loads it automatically at startup; it does NOT read
# any other `.env` from the ADK or repository root.
#
#     cp .env.example .env
#
# Only `OPENROUTER_API_KEY` and `MODEL_NAME` are strictly required.
# Everything below them is optional.

# ---- Azure OpenAI (optional; preferred if you have an Azure resource) -------
# If these are set, the agent uses Azure OpenAI instead of OpenRouter.
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-11-20

# ---- OpenRouter (fallback) ---------------------------------------------------
# Get a key at https://openrouter.ai/keys (free tier available).
# 100+ models from OpenAI, Anthropic, Google, Meta, etc. via one endpoint.
OPENROUTER_API_KEY=your-openrouter-api-key
# `provider/model` format, see https://openrouter.io/docs/models
MODEL_NAME=google/gemini-3.1-flash-lite

# ---- Custom agent skills (optional) -----------------------------------------
# Path to a directory of SKILL.md files for the local skill router.
# Leave empty to disable skill routing.
SKILLS_PATH=

# ---- Syncfusion Platform MCP (optional, currently disabled) ----------------
# Account-level API key from https://www.syncfusion.com/account/api-key
# Only required if SYNCFUSION_REACT_MCP_AVAILABLE=1.
# Variable name matches the ADK: it reads `Syncfusion_API_Key` from the
# MCP server config; keep this exact spelling here.
Syncfusion_API_Key=your-syncfusion-api-key
SYNCFUSION_REACT_MCP_AVAILABLE=0

# ---- CORS (optional) --------------------------------------------------------
# Comma-separated list of allowed origins, or `*` for local development.
# Use a specific origin (e.g. https://app.example.com) in production.
SYNCFUSION_A2A_CORS_ORIGINS=*
