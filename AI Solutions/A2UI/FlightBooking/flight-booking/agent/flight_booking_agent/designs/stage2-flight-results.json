[
  {
    "version": "v0.9",
    "createSurface": {
      "surfaceId": "workspace",
      "catalogId": "syncfusion-a2ui-catalog"
    }
  },
  {
    "version": "v0.9",
    "updateComponents": {
      "surfaceId": "workspace",
      "components": [
        {
          "id": "root",
          "component": "Column",
          "padding": "24px",
          "gap": "20px",
          "maxWidth": "1100px",
          "margin": "0 auto",
          "children": [
            "appbar",
            "summaryCard",
            "resultsCard"
          ]
        },
        {
          "id": "appbar",
          "component": "SyncfusionAppBar",
          "title": "Flight Results",
          "colorMode": "Primary",
          "mode": "Regular"
        },
        {
          "id": "summaryCard",
          "component": "SyncfusionCard",
          "title": "Trip Summary",
          "subtitle": "Stage 1 details",
          "style": {
            "padding": "20px",
            "borderRadius": "12px",
            "boxShadow": "0 2px 8px rgba(0,0,0,0.08)",
            "width": "100%",
            "maxWidth": "1080px",
            "margin": "0 auto"
          },
          "children": [
            "summaryText"
          ]
        },
        {
          "id": "summaryText",
          "component": "Text",
          "text": {
            "path": "/summaryText"
          },
          "style": {
            "fontSize": "14px",
            "lineHeight": "1.7",
            "color": "#334155"
          }
        },
        {
          "id": "resultsCard",
          "component": "SyncfusionCard",
          "title": "Available Flights",
          "subtitle": "Choose a flight to continue to Booking",
          "style": {
            "padding": "20px",
            "borderRadius": "12px",
            "boxShadow": "0 2px 8px rgba(0,0,0,0.08)",
            "width": "100%",
            "maxWidth": "1080px",
            "margin": "0 auto"
          },
          "children": [
            "flightsGrid"
          ]
        },
        {
          "id": "flightsGrid",
          "component": "SyncfusionDataGrid",
          "width": "100%",
          "height": "auto",
          "cssClass": "a2ui-grid a2ui-grid--clean",
          "enableScroll": false,
          "dataSource": {
            "path": "/filteredFlights"
          },
          "allowPaging": true,
          "allowSorting": true,
          "allowFiltering": false,
          "pageSettings": {
            "pageSize": 6
          },
          "columns": [
            {
              "field": "airline",
              "headerText": "Airline",
              "width": "140"
            },
            {
              "field": "flight",
              "headerText": "Flight",
              "width": "110"
            },
            {
              "field": "departure",
              "headerText": "Departure",
              "width": "150"
            },
            {
              "field": "arrival",
              "headerText": "Arrival",
              "width": "150"
            },
            {
              "field": "duration",
              "headerText": "Duration",
              "width": "110"
            },
            {
              "field": "stops",
              "headerText": "Stops",
              "width": "100"
            },
            {
              "field": "baggage",
              "headerText": "Baggage",
              "width": "120"
            },
            {
              "field": "rating",
              "headerText": "Rating",
              "width": "90",
              "textAlign": "Right"
            },
            {
              "field": "price",
              "headerText": "Price",
              "width": "110",
              "textAlign": "Right",
              "format": "C0"
            },
            {
              "field": "action",
              "headerText": "Book now",
              "width": "130",
              "commands": [
                {
                  "id": "selectFlight",
                  "content": "Book now",
                  "cssClass": "e-primary"
                }
              ]
            }
          ],
          "onCommandClick": {
            "event": {
              "name": "selectFlightAndProceed",
              "context": {
                "selectedRow": {
                  "path": "/selectedFlight"
                },
                "stage1": {
                  "path": "/stage1"
                },
                "passengers": {
                  "path": "/stage1/passengers"
                },
                "results": {
                  "path": "/filteredFlights"
                },
                "activeStep": 1,
                "nextStep": 2
              }
            }
          }
        }
      ]
    }
  },
