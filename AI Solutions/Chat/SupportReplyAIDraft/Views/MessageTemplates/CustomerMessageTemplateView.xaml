<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SupportReplyAIDraft.Models"
             xmlns:viewModels="clr-namespace:SupportReplyAIDraft.ViewModels"
             xmlns:views="clr-namespace:SupportReplyAIDraft.Views"
             x:Class="SupportReplyAIDraft.Views.MessageTemplates.CustomerMessageTemplateView"
             x:DataType="models:SupportConversationMessage">
    <Grid Padding="0,2" HorizontalOptions="Start">
        <Border StrokeShape="RoundRectangle 18"
                BackgroundColor="{StaticResource ConversationBubbleBackground}"
                Stroke="{StaticResource BubbleBorderColor}"
                StrokeThickness="1"
                Padding="12"
                MaximumWidthRequest="560">
            <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Stroke" Value="{StaticResource AccentColor}" />
                    <Setter Property="StrokeThickness" Value="2" />
                    <Setter Property="BackgroundColor" Value="{StaticResource SelectedBubbleBackground}" />
                </DataTrigger>
            </Border.Triggers>
            <VerticalStackLayout Spacing="6">
                <HorizontalStackLayout Spacing="8">
                    <Border Style="{StaticResource AvatarStyle}">
                        <Label Text="{Binding Initials}" Style="{StaticResource AvatarTextStyle}" />
                    </Border>
                    <VerticalStackLayout Spacing="0">
                        <Label Text="{Binding AuthorName}" Style="{StaticResource MessageAuthorStyle}" />
                        <Label Text="{Binding Timestamp}" Style="{StaticResource MessageTimeStyle}" />
                    </VerticalStackLayout>
                    <HorizontalStackLayout HorizontalOptions="EndAndExpand" Spacing="4" IsVisible="{Binding IsSelected}">
                        <Label Text="✓" Style="{StaticResource BadgeIconStyle}" />
                        <Label Text="Selected for reply" Style="{StaticResource SelectedTextStyle}" />
                    </HorizontalStackLayout>
                </HorizontalStackLayout>
                <Label Text="{Binding Text}" Style="{StaticResource MessageBodyStyle}" />
            </VerticalStackLayout>
            <Border.GestureRecognizers>
                <TapGestureRecognizer x:DataType="views:SupportChatPage"
                                      Command="{Binding Source={x:Reference RootPage}, Path=SelectMessageCommand}"
                                      CommandParameter="{Binding .}" />
            </Border.GestureRecognizers>
        </Border>
    </Grid>
</ContentView>
