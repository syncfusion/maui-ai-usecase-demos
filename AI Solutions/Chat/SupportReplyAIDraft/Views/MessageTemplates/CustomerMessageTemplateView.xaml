<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:chat="clr-namespace:Syncfusion.Maui.Chat;assembly=Syncfusion.Maui.Chat"
    xmlns:views="clr-namespace:SupportReplyAIDraft.Views"
    x:Class="SupportReplyAIDraft.Views.MessageTemplates.CustomerMessageTemplateView"
    x:DataType="chat:TextMessage">

    <Grid
        Padding="0"
        Margin="0,0,0,8"
        HorizontalOptions="Start"
        VerticalOptions="Start">

        <Grid
            ColumnDefinitions="32,*"
            ColumnSpacing="12"
            HorizontalOptions="Start"
            VerticalOptions="Start">

            <!-- Circular customer avatar -->
            <Border
                Grid.Column="0"
                WidthRequest="32"
                HeightRequest="32"
                Padding="0"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                BackgroundColor="#E7ECF3"
                Stroke="#CFD7E4"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16">

                <Label
                    Text="AM"
                    FontSize="11"
                    FontAttributes="Bold"
                    TextColor="#1E2A44"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center" />

            </Border>

            <!-- Customer message content -->
            <VerticalStackLayout
                Grid.Column="1"
                Spacing="4"
                HorizontalOptions="Start"
                VerticalOptions="Start">

                <!-- Customer name and timestamp -->
                <HorizontalStackLayout
                    Spacing="8"
                    HorizontalOptions="Start"
                    VerticalOptions="Center">

                    <Label
                        Text="{Binding Author.Name}"
                        Style="{StaticResource MessageAuthorStyle}"
                        LineBreakMode="NoWrap"
                        VerticalTextAlignment="Center"
                        VerticalOptions="Center" />

                    <Label
                        Text="{Binding DateTime, StringFormat='{0:h:mm tt}'}"
                        Style="{StaticResource MessageTimeStyle}"
                        LineBreakMode="NoWrap"
                        VerticalTextAlignment="Center"
                        VerticalOptions="Center" />

                </HorizontalStackLayout>

                <!--
                    Entire selectable customer message.

                    Selected for reply, message text, Draft Reply,
                    drafting state, review hint, and error state remain
                    inside this border so the bubble expands on selection.
                -->
                <Border
                    Padding="12"
                    MaximumWidthRequest="{OnIdiom Phone=320, Tablet=500, Desktop=680, Default=680}"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    BackgroundColor="#F1F5FA"
                    Stroke="{StaticResource BubbleBorderColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={RelativeSource AncestorType={x:Type views:SupportChatPage}}, Path=BindingContext.SelectMessageCommand}"
                            CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>

                    <Border.Triggers>
                        <DataTrigger
                            TargetType="Border"
                            Value="True">

                            <DataTrigger.Binding>
                                <MultiBinding Converter="{StaticResource SelectedMessageMatchConverter}">
                                    <Binding Path="." />
                                    <Binding
                                        Path="BindingContext.SelectedMessage"
                                        Source="{RelativeSource AncestorType={x:Type views:SupportChatPage}}" />
                                </MultiBinding>
                            </DataTrigger.Binding>

                            <Setter
                                Property="Stroke"
                                Value="{StaticResource AccentColor}" />

                            <Setter
                                Property="StrokeThickness"
                                Value="2" />

                            <Setter
                                Property="BackgroundColor"
                                Value="{StaticResource SurfaceColor}" />

                        </DataTrigger>
                    </Border.Triggers>

                    <VerticalStackLayout
                        Spacing="10"
                        HorizontalOptions="Fill"
                        VerticalOptions="Start">

                        <!-- Selected-for-reply header -->
                        <VerticalStackLayout
                            Spacing="8"
                            IsVisible="False"
                            HorizontalOptions="Fill"
                            VerticalOptions="Start">

                            <VerticalStackLayout.Triggers>
                                <DataTrigger
                                    TargetType="VerticalStackLayout"
                                    Value="True">

                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource SelectedMessageMatchConverter}">
                                            <Binding Path="." />
                                            <Binding
                                                Path="BindingContext.SelectedMessage"
                                                Source="{RelativeSource AncestorType={x:Type views:SupportChatPage}}" />
                                        </MultiBinding>
                                    </DataTrigger.Binding>

                                    <Setter
                                        Property="IsVisible"
                                        Value="True" />

                                </DataTrigger>
                            </VerticalStackLayout.Triggers>

                            <HorizontalStackLayout
                                Spacing="8"
                                HorizontalOptions="Start"
                                VerticalOptions="Center">

                                <Border
                                    WidthRequest="16"
                                    HeightRequest="16"
                                    Padding="0"
                                    BackgroundColor="{StaticResource AccentColor}"
                                    Stroke="{StaticResource AccentColor}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="✓"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        TextColor="White"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center" />

                                </Border>

                                <Label
                                    Text="Selected for reply"
                                    Style="{StaticResource SelectedTextStyle}"
                                    TextColor="{StaticResource AccentColor}"
                                    FontAttributes="Bold"
                                    VerticalTextAlignment="Center"
                                    VerticalOptions="Center" />

                            </HorizontalStackLayout>

                            <BoxView
                                HeightRequest="1"
                                HorizontalOptions="Fill"
                                Color="{StaticResource BubbleBorderColor}" />

                        </VerticalStackLayout>

                        <!-- Customer message text -->
                        <Label
                            Text="{Binding Text}"
                            Style="{StaticResource MessageBodyStyle}"
                            HorizontalTextAlignment="Start"
                            VerticalTextAlignment="Start" />

                        <!-- Draft Reply action -->
                        <Button
                            Text="{Binding Source={RelativeSource AncestorType={x:Type views:SupportChatPage}}, Path=BindingContext.DraftReplyButtonText}"
                            IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type views:SupportChatPage}}, Path=BindingContext.CanDraftReply}"
                            IsVisible="False"
                            Padding="0"
                            Margin="0"
                            CornerRadius="0"
                            BorderWidth="0"
                            BackgroundColor="Transparent"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            TextColor="{StaticResource AccentColor}"
                            FontSize="14"
                            FontAttributes="Bold"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type views:SupportChatPage}}, Path=BindingContext.DraftReplyCommand}"
                            CommandParameter="{Binding .}"
                            SemanticProperties.Description="Draft reply for selected customer message">

                            <Button.Triggers>
                                <DataTrigger
                                    TargetType="Button"
                                    Value="True">

                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource SelectedMessageMatchConverter}">
                                            <Binding Path="." />
                                            <Binding
                                                Path="BindingContext.SelectedMessage"
                                                Source="{RelativeSource AncestorType={x:Type views:SupportChatPage}}" />
                                        </MultiBinding>
                                    </DataTrigger.Binding>

                                    <Setter
                                        Property="IsVisible"
                                        Value="True" />

                                </DataTrigger>

                                <DataTrigger
                                    TargetType="Button"
                                    Binding="{Binding Source={RelativeSource AncestorType={x:Type views:SupportChatPage}}, Path=BindingContext.IsDraftReplyVisible}"
                                    Value="False">

                                    <Setter
                                        Property="IsVisible"
                                        Value="False" />

                                </DataTrigger>
                            </Button.Triggers>

                        </Button>

                        <!-- Drafting state -->
                        <HorizontalStackLayout
                            Spacing="8"
                            IsVisible="False"
                            HorizontalOptions="Start"
                            VerticalOptions="Center">

                            <HorizontalStackLayout.Triggers>
                                <DataTrigger
                                    TargetType="HorizontalStackLayout"
                                    Value="True">

                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource SelectedMessageMatchConverter}">
                                            <Binding Path="." />
                                            <Binding
                                                Path="BindingContext.SelectedMessage"
                                                Source="{RelativeSource AncestorType={x:Type views:SupportChatPage}}" />
                                        </MultiBinding>
                                    </DataTrigger.Binding>

                                    <Setter
                                        Property="IsVisible"
                                        Value="True" />

                                </DataTrigger>

                                <DataTrigger
                                    TargetType="HorizontalStackLayout"
                                    Binding="{Binding Source={RelativeSource AncestorType={x:Type views:SupportChatPage}}, Path=BindingContext.IsDrafting}"
                                    Value="False">

                                    <Setter
                                        Property="IsVisible"
                                        Value="False" />

                                </DataTrigger>
                            </HorizontalStackLayout.Triggers>

                            <ActivityIndicator
                                IsRunning="True"
                                WidthRequest="16"
                                HeightRequest="16"
                                Color="{StaticResource AccentColor}" />

                            <Label
                                Text="{Binding Source={RelativeSource AncestorType={x:Type views:SupportChatPage}}, Path=BindingContext.ProgressMessage}"
                                Style="{StaticResource MessageTimeStyle}"
                                TextColor="{StaticResource AccentColor}"
                                VerticalTextAlignment="Center"
                                VerticalOptions="Center" />

                        </HorizontalStackLayout>

                        <!-- Review hint -->
                        <Label
                            Text="{Binding Source={RelativeSource AncestorType={x:Type views:SupportChatPage}}, Path=BindingContext.InlineMessage}"
                            IsVisible="False"
                            Style="{StaticResource MessageTimeStyle}">

                            <Label.Triggers>
                                <DataTrigger
                                    TargetType="Label"
                                    Value="True">

                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource SelectedMessageMatchConverter}">
                                            <Binding Path="." />
                                            <Binding
                                                Path="BindingContext.SelectedMessage"
                                                Source="{RelativeSource AncestorType={x:Type views:SupportChatPage}}" />
                                        </MultiBinding>
                                    </DataTrigger.Binding>

                                    <Setter
                                        Property="IsVisible"
                                        Value="True" />

                                </DataTrigger>

                                <DataTrigger
                                    TargetType="Label"
                                    Binding="{Binding Source={RelativeSource AncestorType={x:Type views:SupportChatPage}}, Path=BindingContext.ShowReviewHint}"
                                    Value="False">

                                    <Setter
                                        Property="IsVisible"
                                        Value="False" />

                                </DataTrigger>
                            </Label.Triggers>

                        </Label>

                        <!-- Error message -->
                        <Label
                            Text="{Binding Source={RelativeSource AncestorType={x:Type views:SupportChatPage}}, Path=BindingContext.InlineMessage}"
                            IsVisible="False"
                            Style="{StaticResource MessageTimeStyle}"
                            TextColor="{StaticResource DangerColor}">

                            <Label.Triggers>
                                <DataTrigger
                                    TargetType="Label"
                                    Value="True">

                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource SelectedMessageMatchConverter}">
                                            <Binding Path="." />
                                            <Binding
                                                Path="BindingContext.SelectedMessage"
                                                Source="{RelativeSource AncestorType={x:Type views:SupportChatPage}}" />
                                        </MultiBinding>
                                    </DataTrigger.Binding>

                                    <Setter
                                        Property="IsVisible"
                                        Value="True" />

                                </DataTrigger>

                                <DataTrigger
                                    TargetType="Label"
                                    Binding="{Binding Source={RelativeSource AncestorType={x:Type views:SupportChatPage}}, Path=BindingContext.ShowErrorMessage}"
                                    Value="False">

                                    <Setter
                                        Property="IsVisible"
                                        Value="False" />

                                </DataTrigger>
                            </Label.Triggers>

                        </Label>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </Grid>

    </Grid>

</ContentView>