<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:chat="clr-namespace:Syncfusion.Maui.Chat;assembly=Syncfusion.Maui.Chat"
             xmlns:viewModels="clr-namespace:SupportReplyAIDraft.ViewModels"
             xmlns:views="clr-namespace:SupportReplyAIDraft.Views"
             x:Class="SupportReplyAIDraft.Views.MessageTemplates.CustomerMessageTemplateView"
             x:DataType="chat:TextMessage">
    <Grid Padding="0,2"
          HorizontalOptions="Start">
        <Grid ColumnDefinitions="34,*"
              ColumnSpacing="8"
              HorizontalOptions="Start">
            <Border WidthRequest="34"
                    HeightRequest="34"
                    HorizontalOptions="Center"
                    VerticalOptions="Start"
                    StrokeShape="RoundRectangle 17"
                    Stroke="#CFD7E4"
                    StrokeThickness="1"
                    BackgroundColor="#E7ECF3"
                    Padding="0">
                <Label Text="A"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#1E2A44" />
            </Border>

            <Border Grid.Column="1"
                    StrokeShape="RoundRectangle 14"
                    Stroke="{StaticResource BubbleBorderColor}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource SurfaceColor}"
                    Padding="14"
                    MaximumWidthRequest="730">
                <Border.Triggers>
                    <DataTrigger TargetType="Border"
                                 Value="True">
                        <DataTrigger.Binding>
                            <MultiBinding Converter="{StaticResource SelectedMessageMatchConverter}">
                                <Binding Path="." />
                                <Binding Path="BindingContext.SelectedMessage"
                                         Source="{RelativeSource AncestorType={x:Type views:SupportChatPage}}" />
                            </MultiBinding>
                        </DataTrigger.Binding>
                        <Setter Property="Stroke" Value="{StaticResource AccentColor}" />
                        <Setter Property="StrokeThickness" Value="2" />
                    </DataTrigger>
                </Border.Triggers>

                <VerticalStackLayout Spacing="8">
                    <VerticalStackLayout Spacing="8">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type views:SupportChatPage}}, Path=BindingContext.SelectMessageCommand}"
                                                  CommandParameter="{Binding .}" />
                        </VerticalStackLayout.GestureRecognizers>

                        <HorizontalStackLayout Spacing="8"
                                               VerticalOptions="Center">
                            <Label Text="{Binding Author.Name}"
                                   Style="{StaticResource MessageAuthorStyle}" />
                            <Label Text="{Binding DateTime, StringFormat='{0:h:mm tt}'}"
                                   Style="{StaticResource MessageTimeStyle}" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="6"
                                               IsVisible="False"
                                               VerticalOptions="Center">
                            <HorizontalStackLayout.IsVisible>
                                <MultiBinding Converter="{StaticResource SelectedMessageMatchConverter}">
                                    <Binding Path="." />
                                    <Binding Path="BindingContext.SelectedMessage"
                                             Source="{RelativeSource AncestorType={x:Type views:SupportChatPage}}" />
                                </MultiBinding>
                            </HorizontalStackLayout.IsVisible>
                            <Label Text="✓"
                                   FontSize="12"
                                   TextColor="{StaticResource AccentColor}" />
                            <Label Text="Selected for reply"
                                   Style="{StaticResource SelectedTextStyle}" />
                        </HorizontalStackLayout>

                        <Label Text="{Binding Text}"
                               Style="{StaticResource MessageBodyStyle}" />
                    </VerticalStackLayout>

                    <Button Text="{Binding Source={RelativeSource AncestorType={x:Type views:SupportChatPage}}, Path=BindingContext.DraftReplyButtonText}"
                            IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type views:SupportChatPage}}, Path=BindingContext.CanDraftReply}"
                            IsVisible="False"
                            Padding="0"
                            CornerRadius="0"
                            BorderWidth="0"
                            BackgroundColor="Transparent"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            TextColor="{StaticResource AccentColor}"
                            FontSize="14"
                            FontAttributes="Bold"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type views:SupportChatPage}}, Path=BindingContext.DraftReplyCommand}"
                            CommandParameter="{Binding .}"
                            SemanticProperties.Description="Draft reply for selected customer message">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                         Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource SelectedMessageMatchConverter}">
                                        <Binding Path="." />
                                        <Binding Path="BindingContext.SelectedMessage"
                                                 Source="{RelativeSource AncestorType={x:Type views:SupportChatPage}}" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding Source={RelativeSource AncestorType={x:Type views:SupportChatPage}}, Path=BindingContext.IsDraftReplyVisible}"
                                         Value="False">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <HorizontalStackLayout Spacing="8"
                                           IsVisible="False"
                                           VerticalOptions="Center">
                        <HorizontalStackLayout.Triggers>
                            <DataTrigger TargetType="HorizontalStackLayout"
                                         Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource SelectedMessageMatchConverter}">
                                        <Binding Path="." />
                                        <Binding Path="BindingContext.SelectedMessage"
                                                 Source="{RelativeSource AncestorType={x:Type views:SupportChatPage}}" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                            <DataTrigger TargetType="HorizontalStackLayout"
                                         Binding="{Binding Source={RelativeSource AncestorType={x:Type views:SupportChatPage}}, Path=BindingContext.IsDrafting}"
                                         Value="False">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </HorizontalStackLayout.Triggers>
                        <ActivityIndicator IsRunning="True"
                                           Color="{StaticResource AccentColor}"
                                           WidthRequest="16"
                                           HeightRequest="16" />
                        <Label Text="Drafting reply..."
                               Style="{StaticResource MessageTimeStyle}"
                               TextColor="{StaticResource AccentColor}" />
                    </HorizontalStackLayout>

                    <Label Text="{Binding Source={RelativeSource AncestorType={x:Type views:SupportChatPage}}, Path=BindingContext.InlineMessage}"
                           IsVisible="False"
                           Style="{StaticResource MessageTimeStyle}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource SelectedMessageMatchConverter}">
                                        <Binding Path="." />
                                        <Binding Path="BindingContext.SelectedMessage"
                                                 Source="{RelativeSource AncestorType={x:Type views:SupportChatPage}}" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding Source={RelativeSource AncestorType={x:Type views:SupportChatPage}}, Path=BindingContext.ShowReviewHint}"
                                         Value="False">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <Label Text="{Binding Source={RelativeSource AncestorType={x:Type views:SupportChatPage}}, Path=BindingContext.InlineMessage}"
                           IsVisible="False"
                           Style="{StaticResource MessageTimeStyle}"
                           TextColor="{StaticResource DangerColor}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource SelectedMessageMatchConverter}">
                                        <Binding Path="." />
                                        <Binding Path="BindingContext.SelectedMessage"
                                                 Source="{RelativeSource AncestorType={x:Type views:SupportChatPage}}" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding Source={RelativeSource AncestorType={x:Type views:SupportChatPage}}, Path=BindingContext.ShowErrorMessage}"
                                         Value="False">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentView>
