<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:chat="clr-namespace:Syncfusion.Maui.Chat;assembly=Syncfusion.Maui.Chat"
             x:Class="SupportReplyAIDraft.Views.MessageTemplates.AgentMessageTemplateView"
             x:DataType="chat:TextMessage">
    <Grid Padding="0,2"
          HorizontalOptions="End">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="8"
              HorizontalOptions="End">
            <Border Grid.Column="0"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="{StaticResource AgentBubbleBackground}"
                    Stroke="{StaticResource AgentBorderColor}"
                    StrokeThickness="1"
                    Padding="14"
                    MaximumWidthRequest="730"
                    HorizontalOptions="End">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="8"
                                           VerticalOptions="Center"
                                           HorizontalOptions="End">
                        <Label Text="{Binding DateTime, StringFormat='{0:h:mm tt}'}"
                               Style="{StaticResource MessageTimeStyle}" />
                        <Label Text="{Binding Author.Name}"
                               Style="{StaticResource MessageAuthorStyle}" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding Text}"
                           Style="{StaticResource MessageBodyStyle}"
                           HorizontalTextAlignment="Start" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource AgentAvatarStyle}">
                <Label Text="J"
                       Style="{StaticResource AgentAvatarTextStyle}" />
            </Border>
        </Grid>
    </Grid>
</ContentView>
