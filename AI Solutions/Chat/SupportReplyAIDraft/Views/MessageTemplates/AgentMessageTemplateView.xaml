<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:chat="clr-namespace:Syncfusion.Maui.Chat;assembly=Syncfusion.Maui.Chat"
             x:Class="SupportReplyAIDraft.Views.MessageTemplates.AgentMessageTemplateView"
             x:DataType="chat:TextMessage">
    <Grid Padding="0,2"
          HorizontalOptions="End">
        <Grid ColumnDefinitions="*,34"
              ColumnSpacing="8"
              HorizontalOptions="End"
              VerticalOptions="Center">
            <Border Grid.Column="0"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="{StaticResource AgentBubbleBackground}"
                    Stroke="{StaticResource AgentBorderColor}"
                    StrokeThickness="1"
                    Padding="12"
                    MaximumWidthRequest="720"
                    HorizontalOptions="End"
                    VerticalOptions="Center">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="8"
                                           VerticalOptions="Center"
                                           HorizontalOptions="End">
                        <Label Text="{Binding DateTime, StringFormat='{0:h:mm tt}'}"
                               Style="{StaticResource MessageTimeStyle}" />
                        <Label Text="{Binding Author.Name}"
                               Style="{StaticResource MessageAuthorStyle}" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding Text}"
                           Style="{StaticResource MessageBodyStyle}"
                           HorizontalTextAlignment="Start" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="1"
                    WidthRequest="34"
                    HeightRequest="34"
                    HorizontalOptions="Center"
                    VerticalOptions="Start"
                    StrokeShape="RoundRectangle 17"
                    Stroke="#1D4ED8"
                    StrokeThickness="1"
                    BackgroundColor="#2557FF"
                    Padding="0">
                <Label Text="J"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="White" />
            </Border>
        </Grid>
    </Grid>
</ContentView>
