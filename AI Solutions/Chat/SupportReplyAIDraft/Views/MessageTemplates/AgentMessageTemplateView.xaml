<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SupportReplyAIDraft.Models"
             x:Class="SupportReplyAIDraft.Views.MessageTemplates.AgentMessageTemplateView"
             x:DataType="models:SupportConversationMessage">
    <Grid Padding="0,2"
          HorizontalOptions="End">
        <Border StrokeShape="RoundRectangle 14"
                BackgroundColor="{StaticResource AgentBubbleBackground}"
                Stroke="{StaticResource AgentBorderColor}"
                StrokeThickness="1"
                Padding="14"
                MaximumWidthRequest="730">
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <HorizontalStackLayout Grid.Column="0"
                                           Spacing="8"
                                           VerticalOptions="Center"
                                           HorizontalOptions="End">
                        <Label Text="{Binding Timestamp}"
                               Style="{StaticResource MessageTimeStyle}" />
                        <Label Text="{Binding AuthorName}"
                               Style="{StaticResource MessageAuthorStyle}" />
                    </HorizontalStackLayout>
                    <Border Grid.Column="1"
                            Style="{StaticResource AgentAvatarStyle}">
                        <Label Text="{Binding Initials}"
                               Style="{StaticResource AgentAvatarTextStyle}" />
                    </Border>
                </Grid>
                <Label Text="{Binding Text}"
                       Style="{StaticResource MessageBodyStyle}"
                       HorizontalTextAlignment="Start" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>