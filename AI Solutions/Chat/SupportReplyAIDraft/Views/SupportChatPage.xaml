<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:chat="clr-namespace:Syncfusion.Maui.Chat;assembly=Syncfusion.Maui.Chat"
             xmlns:viewModels="clr-namespace:SupportReplyAIDraft.ViewModels"
             x:Class="SupportReplyAIDraft.Views.SupportChatPage"
             x:Name="RootPage"
             x:DataType="viewModels:SupportChatViewModel"
             Title="Support Reply AI Draft"
             BackgroundColor="{StaticResource AppBackground}">
    <Grid>
        <Grid.Padding>
            <OnIdiom x:TypeArguments="Thickness">
                <OnIdiom.Phone>0</OnIdiom.Phone>
                <OnIdiom.Tablet>16</OnIdiom.Tablet>
                <OnIdiom.Desktop>24</OnIdiom.Desktop>
                <OnIdiom.Default>16</OnIdiom.Default>
            </OnIdiom>
        </Grid.Padding>

        <Border Stroke="{StaticResource BubbleBorderColor}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 4"
                BackgroundColor="{StaticResource SurfaceColor}"
                HorizontalOptions="FillAndExpand"
                VerticalOptions="FillAndExpand">
            <Border.Shadow>
                <Shadow Brush="#24000000"
                        Offset="0,8"
                        Radius="18"
                        Opacity="0.12" />
            </Border.Shadow>

            <Grid RowDefinitions="Auto,1,Auto,1,Auto,1,*"
                  BackgroundColor="{StaticResource SurfaceColor}">
                <Grid Grid.Row="0"
                      Padding="16,10"
                      ColumnDefinitions="Auto,Auto,*"
                      ColumnSpacing="14">
                    <HorizontalStackLayout Spacing="6"
                                           VerticalOptions="Center">
                        <Border HeightRequest="10"
                                WidthRequest="10"
                                BackgroundColor="#CBD5E1"
                                StrokeShape="RoundRectangle 999" />
                        <Border HeightRequest="10"
                                WidthRequest="10"
                                BackgroundColor="#CBD5E1"
                                StrokeShape="RoundRectangle 999" />
                        <Border HeightRequest="10"
                                WidthRequest="10"
                                BackgroundColor="#CBD5E1"
                                StrokeShape="RoundRectangle 999" />
                    </HorizontalStackLayout>

                    <BoxView Grid.Column="1"
                             WidthRequest="1"
                             HeightRequest="24"
                             Color="{StaticResource BubbleBorderColor}"
                             VerticalOptions="Center" />

                    <VerticalStackLayout Grid.Column="2"
                                         Spacing="0"
                                         VerticalOptions="Center">
                        <Label Text="Support Reply AI Draft"
                               Style="{StaticResource PageTitleStyle}" />
                        <Label Text="Customer support workspace"
                               Style="{StaticResource PageSubtitleStyle}" />
                    </VerticalStackLayout>
                </Grid>

                <BoxView Grid.Row="1"
                         HeightRequest="1"
                         Color="{StaticResource BubbleBorderColor}" />

                <Grid Grid.Row="2"
                      Padding="16,12"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="16">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="SUBJECT"
                               TextColor="#8A97B2"
                               FontSize="11"
                               CharacterSpacing="1.2" />
                        <Label Text="License still shows as expired after renewal"
                               TextColor="{StaticResource TextPrimaryColor}"
                               FontSize="15"
                               FontAttributes="Bold"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>

                    <HorizontalStackLayout Grid.Column="1"
                                           Spacing="12"
                                           VerticalOptions="Center"
                                           HorizontalOptions="End">
                        <HorizontalStackLayout Spacing="6"
                                               VerticalOptions="Center">
                            <Label Text="Case ID:"
                                   Style="{StaticResource MessageTimeStyle}" />
                            <Border BackgroundColor="#EDF3FF"
                                    Stroke="#D4E2FF"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 2"
                                    Padding="8,3">
                                <Label Text="CS-28417"
                                       TextColor="{StaticResource AccentColor}"
                                       FontSize="12"
                                       FontAttributes="Bold" />
                            </Border>
                        </HorizontalStackLayout>

                        <BoxView WidthRequest="1"
                                 HeightRequest="16"
                                 Color="{StaticResource BubbleBorderColor}"
                                 VerticalOptions="Center" />

                        <HorizontalStackLayout Spacing="6"
                                               VerticalOptions="Center">
                            <Label Text="Customer:"
                                   Style="{StaticResource MessageTimeStyle}" />
                            <Label Text="Alex Morgan"
                                   Style="{StaticResource MessageAuthorStyle}" />
                        </HorizontalStackLayout>

                        <BoxView WidthRequest="1"
                                 HeightRequest="16"
                                 Color="{StaticResource BubbleBorderColor}"
                                 VerticalOptions="Center" />

                        <HorizontalStackLayout Spacing="6"
                                               VerticalOptions="Center">
                            <Label Text="Status:"
                                   Style="{StaticResource MessageTimeStyle}" />
                            <Border BackgroundColor="#F3F5F9"
                                    Stroke="#D5DBE8"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 2"
                                    Padding="8,3">
                                <Label Text="Open"
                                       TextColor="{StaticResource TextPrimaryColor}"
                                       FontSize="12"
                                       FontAttributes="Bold" />
                            </Border>
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
                </Grid>

                <BoxView Grid.Row="3"
                         HeightRequest="1"
                         Color="{StaticResource BubbleBorderColor}" />

                <Grid Grid.Row="4"
                      Padding="16,12,16,10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Conversation"
                               Style="{StaticResource SectionTitleStyle}" />
                        <Label Text="Select a customer message to draft a grounded reply."
                               Style="{StaticResource SectionSubtitleStyle}" />
                    </VerticalStackLayout>
                </Grid>

                <BoxView Grid.Row="5"
                         HeightRequest="1"
                         Color="{StaticResource BubbleBorderColor}" />

                <Grid Grid.Row="6"
                      Padding="16,10,16,12"
                      BackgroundColor="#F7F9FC">
                    <chat:SfChat x:Name="ConversationChat"
                                 Messages="{Binding Messages}"
                                 CurrentUser="{Binding CurrentUser}"
                                 TypingIndicator="{Binding TypingIndicator}"
                                 ShowTypingIndicator="{Binding ShowTypingIndicator}"
                                 Suggestions="{Binding ChatSuggestions}"
                                 SuggestionItemSelectedCommand="{Binding SuggestionItemSelectedCommand}"
                                 ShowMessageInputView="True"
                                 AllowMultilineInput="True"
                                 SendMessageCommand="{Binding NativeSendCommand}"
                                 VerticalOptions="FillAndExpand"
                                 HorizontalOptions="FillAndExpand"
                                 BackgroundColor="Transparent"
                                 Margin="0" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
