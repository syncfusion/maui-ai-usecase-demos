<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:chat="clr-namespace:Syncfusion.Maui.Chat;assembly=Syncfusion.Maui.Chat"
             xmlns:viewModels="clr-namespace:SupportReplyAIDraft.ViewModels"
             x:Class="SupportReplyAIDraft.Views.SupportChatPage"
             x:DataType="viewModels:SupportChatViewModel"
             Title="Support Reply AI Draft">
    <Grid RowDefinitions="Auto,*,Auto"
          BackgroundColor="{StaticResource AppBackground}"
          Padding="20,20,20,32">
        <VerticalStackLayout Spacing="4" Grid.Row="0">
            <Label Text="AI-Powered Support Reply Drafting"
                   Style="{StaticResource PageTitleStyle}" />
            <Label Text="Select a customer message, draft a reply, review the generated text, and send only when ready."
                   Style="{StaticResource PageSubtitleStyle}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Style="{StaticResource SurfaceCardStyle}"
                Margin="0,16,0,12">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto" Padding="16,16,16,0">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Conversation" Style="{StaticResource SectionTitleStyle}" />
                        <Label Text="Select a customer message to begin." Style="{StaticResource SectionSubtitleStyle}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1"
                            VerticalOptions="Center"
                            IsVisible="{Binding SelectedMessage, Converter={StaticResource NullToBoolConverter}}"
                            Style="{StaticResource SelectedBadgeStyle}">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="✓" Style="{StaticResource BadgeIconStyle}" />
                            <Label Text="Selected for reply" Style="{StaticResource BadgeTextStyle}" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <chat:SfChat x:Name="ConversationChat"
                            Grid.Row="1"
                            Messages="{Binding Messages}"
                            CurrentUser="{Binding CurrentUser}"
                            Margin="0,0,0,4"
                            VerticalOptions="Fill"
                            BackgroundColor="Transparent" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource SurfaceCardStyle}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" Padding="16">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Reply composer" Style="{StaticResource SectionTitleStyle}" />
                        <Label Text="{Binding ComposerHint}" Style="{StaticResource SectionSubtitleStyle}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="4">
                        <Label Text="AI draft"
                               IsVisible="{Binding HasValidatedDraft}"
                               HorizontalOptions="End"
                               Style="{StaticResource BadgeTextStyle}" />
                        <Label Text="Review before sending"
                               IsVisible="{Binding HasValidatedDraft}"
                               HorizontalOptions="End"
                               Style="{StaticResource SectionSubtitleStyle}" />
                    </VerticalStackLayout>
                </Grid>

                <Border Grid.Row="1"
                        IsVisible="{Binding ShowStatus}"
                        Style="{StaticResource ErrorBannerStyle}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Text="!" Style="{StaticResource ErrorIconStyle}" />
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding StatusTitle}" Style="{StaticResource ErrorTitleStyle}" />
                            <Label Text="{Binding StatusMessage}" Style="{StaticResource ErrorMessageStyle}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <VerticalStackLayout Grid.Row="2" Spacing="8"
                                     IsVisible="{Binding ShowRequestedInformation}">
                    <Label Text="Requested information" Style="{StaticResource SectionSubtitleStyle}" />
                    <FlexLayout BindableLayout.ItemsSource="{Binding RequestedInformation}"
                                Wrap="Wrap"
                                Direction="Row"
                                Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PillStyle}">
                                    <Label Text="{Binding .}" Style="{StaticResource PillTextStyle}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="3" Spacing="8"
                                     IsVisible="{Binding HasWarnings}">
                    <Label Text="Warnings" Style="{StaticResource SectionSubtitleStyle}" />
                    <FlexLayout BindableLayout.ItemsSource="{Binding Warnings}"
                                Wrap="Wrap"
                                Direction="Row"
                                Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PillStyle}">
                                    <Label Text="{Binding .}" Style="{StaticResource PillTextStyle}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>

                <Editor Grid.Row="4"
                        Text="{Binding ReplyText, Mode=TwoWay}"
                        Placeholder="Generate a draft to edit it here."
                        AutoSize="TextChanges"
                        IsEnabled="{Binding IsComposerEnabled}"
                        MinimumHeightRequest="120"
                        Style="{StaticResource ReplyEditorStyle}" />

                <Grid Grid.Row="5" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="10">
                    <Button Text="Draft Reply"
                            Command="{Binding DraftReplyCommand}"
                            IsVisible="{Binding CanDraftReply}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Text="Discard"
                            Command="{Binding DiscardCommand}"
                            IsEnabled="{Binding CanDiscard}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Text="Regenerate"
                            Command="{Binding RegenerateCommand}"
                            IsVisible="{Binding CanRegenerate}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <ActivityIndicator Grid.Column="3"
                                       IsRunning="{Binding IsDrafting}"
                                       IsVisible="{Binding IsDrafting}"
                                       HorizontalOptions="End"
                                       Color="{StaticResource AccentColor}" />
                    <Button Grid.Column="4"
                            Text="Send"
                            Command="{Binding SendCommand}"
                            IsEnabled="{Binding CanSend}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>

                <Button Grid.Row="6"
                        Text="Retry"
                        Command="{Binding RetryCommand}"
                        HorizontalOptions="End"
                        IsVisible="{Binding ShowStatus}"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
