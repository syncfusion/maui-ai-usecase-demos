<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:chat="clr-namespace:Syncfusion.Maui.Chat;assembly=Syncfusion.Maui.Chat"
             xmlns:viewModels="clr-namespace:SupportReplyAIDraft.ViewModels"
             x:Class="SupportReplyAIDraft.Views.SupportChatPage"
             x:Name="RootPage"
             x:DataType="viewModels:SupportChatViewModel"
             Title="Support Reply AI Draft"
             BackgroundColor="{StaticResource AppBackground}">
    <Grid>
        <Border Stroke="{StaticResource BubbleBorderColor}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 4"
                BackgroundColor="{StaticResource SurfaceColor}"
                Margin="0"
                Padding="0"
                HorizontalOptions="FillAndExpand"
                VerticalOptions="FillAndExpand">
            <Border.Shadow>
                <Shadow Brush="#24000000"
                        Offset="0,8"
                        Radius="18"
                        Opacity="0.12" />
            </Border.Shadow>

            <Grid RowDefinitions="Auto,1,Auto,1,Auto,1,*"
                  BackgroundColor="{StaticResource SurfaceColor}">
                <Grid Grid.Row="0"
                      Padding="12,8"
                      ColumnDefinitions="Auto,Auto,*"
                      ColumnSpacing="12">
                    <HorizontalStackLayout Spacing="6"
                                           VerticalOptions="Center">
                        <Border HeightRequest="10"
                                WidthRequest="10"
                                BackgroundColor="#CBD5E1"
                                StrokeShape="RoundRectangle 999" />
                        <Border HeightRequest="10"
                                WidthRequest="10"
                                BackgroundColor="#CBD5E1"
                                StrokeShape="RoundRectangle 999" />
                        <Border HeightRequest="10"
                                WidthRequest="10"
                                BackgroundColor="#CBD5E1"
                                StrokeShape="RoundRectangle 999" />
                    </HorizontalStackLayout>

                    <BoxView Grid.Column="1"
                             WidthRequest="1"
                             HeightRequest="24"
                             Color="{StaticResource BubbleBorderColor}"
                             VerticalOptions="Center" />

                    <VerticalStackLayout Grid.Column="2"
                                         Spacing="0"
                                         VerticalOptions="Center">
                        <Label Text="Support Reply AI Draft"
                               Style="{StaticResource PageTitleStyle}" />
                        <Label Text="Customer support workspace"
                               Style="{StaticResource PageSubtitleStyle}" />
                    </VerticalStackLayout>
                </Grid>

                <BoxView Grid.Row="1"
                         HeightRequest="1"
                         Color="{StaticResource BubbleBorderColor}" />

                <Grid Grid.Row="2"
                      Padding="12,10"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="6">
                    <Grid RowDefinitions="Auto"
                          ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="10"
                          VerticalOptions="Center"
                          x:Name="SubjectRowWide">
                        <Label Text="SUBJECT"
                               TextColor="#8A97B2"
                               FontSize="11"
                               CharacterSpacing="1.2"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="License still shows as expired after renewal"
                               TextColor="{StaticResource TextPrimaryColor}"
                               FontSize="15"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <Grid Grid.Column="2"
                              ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                              ColumnSpacing="10"
                              VerticalOptions="Center"
                              HorizontalOptions="End">
                            <Label Text="Case ID:"
                                   Style="{StaticResource MessageTimeStyle}"
                                   VerticalOptions="Center" />
                            <Border Grid.Column="1"
                                    BackgroundColor="#EDF3FF"
                                    Stroke="#D4E2FF"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 2"
                                    Padding="8,3"
                                    VerticalOptions="Center">
                                <Label Text="CS-28417"
                                       TextColor="{StaticResource AccentColor}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                            </Border>
                            <BoxView Grid.Column="2"
                                     WidthRequest="1"
                                     HeightRequest="16"
                                     Color="{StaticResource BubbleBorderColor}"
                                     VerticalOptions="Center" />
                            <Label Grid.Column="3"
                                   Text="Customer: Alex Morgan"
                                   Style="{StaticResource MessageAuthorStyle}"
                                   VerticalOptions="Center" />
                            <BoxView Grid.Column="4"
                                     WidthRequest="1"
                                     HeightRequest="16"
                                     Color="{StaticResource BubbleBorderColor}"
                                     VerticalOptions="Center" />
                            <Label Grid.Column="5"
                                   Text="Status: Open"
                                   Style="{StaticResource MessageTimeStyle}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Grid>

                    <VerticalStackLayout Grid.Row="1"
                                         x:Name="SubjectRowNarrow"
                                         IsVisible="False"
                                         Spacing="4">
                        <Label Text="SUBJECT"
                               TextColor="#8A97B2"
                               FontSize="11"
                               CharacterSpacing="1.2" />
                        <Label Text="License still shows as expired after renewal"
                               TextColor="{StaticResource TextPrimaryColor}"
                               FontSize="15"
                               FontAttributes="Bold"
                               LineBreakMode="TailTruncation" />
                        <VerticalStackLayout Spacing="4">
                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="Case ID:"
                                       Style="{StaticResource MessageTimeStyle}" />
                                <Border BackgroundColor="#EDF3FF"
                                        Stroke="#D4E2FF"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 2"
                                        Padding="8,3"
                                        VerticalOptions="Center">
                                    <Label Text="CS-28417"
                                           TextColor="{StaticResource AccentColor}"
                                           FontSize="12"
                                           FontAttributes="Bold" />
                                </Border>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="Customer:"
                                       Style="{StaticResource MessageTimeStyle}" />
                                <Label Text="Alex Morgan"
                                       Style="{StaticResource MessageAuthorStyle}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="Status:"
                                       Style="{StaticResource MessageTimeStyle}" />
                                <Border BackgroundColor="#F3F5F9"
                                        Stroke="#D5DBE8"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 2"
                                        Padding="8,3"
                                        VerticalOptions="Center">
                                    <Label Text="Open"
                                           TextColor="{StaticResource TextPrimaryColor}"
                                           FontSize="12"
                                           FontAttributes="Bold" />
                                </Border>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroupList>
                            <VisualStateGroup x:Name="ResponsiveSubjectRowStates">
                                <VisualState x:Name="Wide">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="900" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter TargetName="SubjectRowWide" Property="IsVisible" Value="True" />
                                        <Setter TargetName="SubjectRowNarrow" Property="IsVisible" Value="False" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Narrow">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="0" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter TargetName="SubjectRowWide" Property="IsVisible" Value="False" />
                                        <Setter TargetName="SubjectRowNarrow" Property="IsVisible" Value="True" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateGroupList>
                    </VisualStateManager.VisualStateGroups>
                </Grid>

                <BoxView Grid.Row="3"
                         HeightRequest="1"
                         Color="{StaticResource BubbleBorderColor}" />

                <Grid Grid.Row="4"
                      Padding="12,10,12,8">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Conversation"
                               Style="{StaticResource SectionTitleStyle}" />
                        <Label Text="Select a customer message to draft a grounded reply."
                               Style="{StaticResource SectionSubtitleStyle}" />
                    </VerticalStackLayout>
                </Grid>

                <BoxView Grid.Row="5"
                         HeightRequest="1"
                         Color="{StaticResource BubbleBorderColor}" />

                <Grid Grid.Row="6"
                      Padding="8,8,8,8"
                      BackgroundColor="#F7F9FC">
                    <chat:SfChat x:Name="ConversationChat"
                                 Messages="{Binding Messages}"
                                 CurrentUser="{Binding CurrentUser}"
                                 TypingIndicator="{Binding TypingIndicator}"
                                 ShowTypingIndicator="{Binding ShowTypingIndicator}"
                                 Suggestions="{Binding ChatSuggestions}"
                                 SuggestionItemSelected="OnSuggestionItemSelected"
                                 ShowMessageInputView="True"
                                 AllowMultilineInput="True"
                                 SendMessageCommand="{Binding NativeSendCommand}"
                                 VerticalOptions="FillAndExpand"
                                 HorizontalOptions="FillAndExpand"
                                 BackgroundColor="Transparent"
                                 Margin="0" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
