<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sf="clr-namespace:Syncfusion.Maui.ImageEditor;assembly=Syncfusion.Maui.ImageEditor"
             xmlns:inputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             xmlns:helpers="clr-namespace:SmartCropping.Helpers"
             xmlns:viewModel="clr-namespace:SmartCropping.ViewModel"
             x:Class="SmartCropping.SmartCroppingMobileView"
             x:DataType="viewModel:SmartCroppingViewModel"
             Title="Smart Cropping"
             BackgroundColor="#FFFFFF">

    <!--
        Mobile-specific layout. Mirrors the desktop colours and component
        styles, but uses a vertical action stack and a 2-column grid so it
        fits Android/iOS screens. All command bindings, visibility rules,
        AI service, overlay and apply-crop logic are shared with the
        desktop view through the same SmartCroppingViewModel.
    -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="ActionButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#FFFFFF" />
                <Setter Property="TextColor" Value="#1E293B" />
                <Setter Property="BorderColor" Value="#E2E8F0" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="MinimumWidthRequest" Value="0" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.45" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                <Setter Property="BackgroundColor" Value="#0066F5" />
                <Setter Property="TextColor" Value="#FFFFFF" />
                <Setter Property="BorderColor" Value="#0066F5" />
            </Style>

            <Style x:Key="RetryButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="#0066F5" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HeightRequest" Value="28" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ====== ROW 0: HEADER + ACTIONS ====== -->
        <ScrollView Grid.Row="0" Orientation="Vertical">
            <VerticalStackLayout Spacing="12">

                <VerticalStackLayout Spacing="2">
                    <Label Text="Smart Cropping"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />
                    <Label Text="Let AI suggest a crop around the important content in an image."
                           FontSize="13"
                           TextColor="#64748B" />
                </VerticalStackLayout>

                <!-- Row 1: Open Image -->
                <Button Text="Open Image"
                        Style="{StaticResource ActionButtonStyle}"
                        HeightRequest="44"
                        HorizontalOptions="Fill"
                        Command="{Binding OpenImageCommand}" />

                <!-- Row 2: Intent Selector -->
                <VerticalStackLayout IsVisible="{Binding IsImageLoaded}" Spacing="4">
                    <Label Text="Crop Intent"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#64748B" />
                    <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#FFFFFF"
                            HeightRequest="44"
                            StrokeShape="RoundRectangle 4">
                        <inputs:SfComboBox ItemsSource="{Binding CropIntents}"
                                           SelectedItem="{Binding SelectedIntent, Mode=TwoWay}"
                                           Placeholder="Select an intent..."
                                           ShowBorder="False"
                                           IsClearButtonVisible="False"
                                           VerticalOptions="Fill"
                                           VerticalTextAlignment="Center" />
                    </Border>
                </VerticalStackLayout>

                <!-- Row 3: Smart Crop | Apply Crop -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8"
                      IsVisible="{Binding IsImageLoaded}">
                    <Button Grid.Column="0" Text="Smart Crop"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            HeightRequest="44"
                            IsVisible="{Binding CanGenerateCrop}"
                            Command="{Binding SmartCropCommand}" />
                    <Button Grid.Column="1" Text="Apply Crop"
                            Style="{StaticResource ActionButtonStyle}"
                            HeightRequest="44"
                            IsVisible="{Binding CanApplyCrop}"
                            Command="{Binding ApplyCropCommand}" />
                </Grid>

                <!-- Row 4: Save | Reset -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8"
                      IsVisible="{Binding IsImageLoaded}">
                    <Button Grid.Column="0" Text="Reset"
                            Style="{StaticResource ActionButtonStyle}"
                            HeightRequest="44"
                            IsVisible="{Binding CanReset}"
                            Command="{Binding ResetCommand}" />
                    <Button Grid.Column="1" Text="Save"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            HeightRequest="44"
                            IsVisible="{Binding CanSave}"
                            Command="{Binding SaveCommand}" />
                </Grid>

                <!-- Status / error banners (same progressive states as desktop) -->
                <Border IsVisible="{Binding IsBusy}"
                        BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1"
                        StrokeShape="RoundRectangle 4" Padding="10,8">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           Color="#0066F5"
                                           WidthRequest="16" HeightRequest="16"
                                           VerticalOptions="Center" />
                        <Label Text="{Binding StatusMessage}"
                               TextColor="#1E293B" FontSize="14" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <Border IsVisible="{Binding HasStatusMessage}"
                        BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1"
                        StrokeShape="RoundRectangle 4" Padding="10,8">
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="&#8505;"
                                   TextColor="#0066F5" FontSize="14" VerticalOptions="Center" />
                            <Label Text="{Binding StatusMessage}"
                                   TextColor="#1E293B" FontSize="14" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding SuggestionReason}"
                               IsVisible="{Binding HasSuggestionReason}"
                               TextColor="#475569" FontSize="12" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding IsError}"
                        BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1"
                        StrokeShape="RoundRectangle 4" Padding="10,8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                            <Label Text="&#9888;" TextColor="#E11D48" FontSize="14" VerticalOptions="Center" />
                            <Label Text="{Binding StatusMessage}"
                                   TextColor="#1E293B" FontSize="14" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Button Grid.Column="1" Text="Retry"
                                Style="{StaticResource RetryButtonStyle}"
                                Command="{Binding RetryCommand}"
                                VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ====== ROW 1: EDITOR + OVERLAY ====== -->
        <Grid Grid.Row="1" BackgroundColor="#F8FAFC">
            <sf:SfImageEditor x:Name="imageEditor"
                              BackgroundColor="#F8FAFC" />
            <helpers:CropOverlayView IsVisible="{Binding IsOverlayVisible}"
                                     OverlayX="{Binding OverlayX, Mode=OneWay}"
                                     OverlayY="{Binding OverlayY, Mode=OneWay}"
                                     OverlayWidth="{Binding OverlayWidth, Mode=OneWay}"
                                     OverlayHeight="{Binding OverlayHeight, Mode=OneWay}" />
        </Grid>
    </Grid>
</ContentPage>