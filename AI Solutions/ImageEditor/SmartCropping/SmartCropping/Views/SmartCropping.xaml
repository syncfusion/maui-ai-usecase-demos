<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sf="clr-namespace:Syncfusion.Maui.ImageEditor;assembly=Syncfusion.Maui.ImageEditor"
             xmlns:inputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             xmlns:helpers="clr-namespace:SmartCropping.Helpers"
             xmlns:viewModel="clr-namespace:SmartCropping.ViewModel"
             x:Class="SmartCropping.SmartCropping"
             x:DataType="viewModel:SmartCroppingViewModel"
             BackgroundColor="#FFFFFF">

    <!--
        Styling mirrors the Stitch reference design:
        - Syncfusion blue #0066f5 for primary actions and the crop border
        - Border #e2e8f0, surface #f8fafc, editor canvas #f8fafc
        - Body text #1e293b, muted text #64748b
        - Buttons are 40px tall, 4px corner radius, 16px horizontal padding,
          min-width 104px, 14px semibold text
        - Disabled buttons keep their normal colors at 45% opacity rather than
          switching to a separate grey palette, so "disabled" reads as a
          dimmed version of the real control instead of a different button.
    -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="ActionButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#FFFFFF" />
                <Setter Property="TextColor" Value="#1E293B" />
                <Setter Property="BorderColor" Value="#E2E8F0" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="MinimumWidthRequest" Value="104" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#F1F5F9" />
                                    <Setter Property="BorderColor" Value="#CBD5E1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.45" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                <Setter Property="BackgroundColor" Value="#0066F5" />
                <Setter Property="TextColor" Value="#FFFFFF" />
                <Setter Property="BorderColor" Value="#0066F5" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#0052CC" />
                                    <Setter Property="BorderColor" Value="#0052CC" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.45" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- Retry is a text-weight link in the reference, not a boxed button. -->
            <Style x:Key="RetryButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="#0066F5" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HeightRequest" Value="28" />
                <Setter Property="MinimumWidthRequest" Value="44" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ====== ROW 0: HEADER ====== -->
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="Smart Cropping"
                  
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#0F172A" />
            <Label Text="Choose how you will use the image and let AI suggest the right crop."
                  
                   FontSize="14"
                   TextColor="#64748B" />
        </VerticalStackLayout>

        <!-- ====== ROW 1: ACTIONS (progressive visibility) ====== -->
        <VerticalStackLayout Grid.Row="1" Spacing="12">
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8" VerticalOptions="End">
                    <Button Text="Open Image"
                            Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding OpenImageCommand}" />

                    <VerticalStackLayout IsVisible="{Binding IsImageLoaded}" Spacing="4">
                        <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#FFFFFF"
                                HeightRequest="45" WidthRequest="220"
                                StrokeShape="RoundRectangle 4"
                                VerticalOptions="End">
                            <inputs:SfComboBox ItemsSource="{Binding CropIntents}"
                                               SelectedItem="{Binding SelectedIntent, Mode=TwoWay}"
                                               Placeholder="Select an intent..."
                                               ShowBorder="False"
                                               IsClearButtonVisible="False"
                                               VerticalOptions="Fill"
                                               VerticalTextAlignment="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <Button Text="Smart Crop"
                            VerticalOptions="End"
                            IsVisible="{Binding CanGenerateCrop}"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Command="{Binding SmartCropCommand}" />
                    <Button Text="Apply Crop"
                            VerticalOptions="End"
                            IsVisible="{Binding CanApplyCrop}"
                            Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding ApplyCropCommand}" />
                    <Button Text="Reset"
                            VerticalOptions="End"
                            IsVisible="{Binding CanReset}"
                            Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding ResetCommand}" />
                    <Button Text="Save"
                            VerticalOptions="End"
                            IsVisible="{Binding CanSave}"
                            Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding SaveCommand}" />
                </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>

        <!-- ====== ROW 2: STATE MESSAGE ====== -->
        <Grid Grid.Row="2">
            <Border IsVisible="{Binding IsBusy}"
                    BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1"
                    StrokeShape="RoundRectangle 4" Padding="10,8">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="#0066F5"
                                       WidthRequest="16" HeightRequest="16"
                                       VerticalOptions="Center" />
                    <Label Text="{Binding StatusMessage}"
                           TextColor="#1E293B" FontSize="14" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Border IsVisible="{Binding HasStatusMessage}"
                    BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1"
                    StrokeShape="RoundRectangle 4" Padding="10,8">
                <VerticalStackLayout Spacing="6">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="&#8505;"
                               TextColor="#0066F5" FontSize="14" VerticalOptions="Center" />
                        <Label Text="{Binding StatusMessage}"
                               TextColor="#1E293B" FontSize="14" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding SuggestionReason}"
                           IsVisible="{Binding HasSuggestionReason}"
                           TextColor="#475569" FontSize="12" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding IsError}"
                    BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1"
                    StrokeShape="RoundRectangle 4" Padding="10,8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                        <Label Text="&#9888;" TextColor="#E11D48" FontSize="14" VerticalOptions="Center" />
                        <Label Text="{Binding StatusMessage}"
                               TextColor="#1E293B" FontSize="14" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Button Grid.Column="1" Text="Retry"
                            Style="{StaticResource RetryButtonStyle}"
                            Command="{Binding RetryCommand}"
                            VerticalOptions="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- ====== ROW 3: SfImageEditor + CROP OVERLAY ====== -->
        <Border Grid.Row="3"
                BackgroundColor="#F8FAFC"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 4"
                Padding="16">
            <Grid>
                <sf:SfImageEditor x:Name="ImageEditor"
                                  BackgroundColor="#F8FAFC"
                                  ShowToolbar="False"
                                  AutoGenerateToolbarItems="False" />

                <helpers:CropOverlayView x:Name="CropOverlay"
                                         IsOverlayVisible="{Binding IsOverlayVisible}"
                                         OverlayX="{Binding OverlayX, Mode=OneWay}"
                                         OverlayY="{Binding OverlayY, Mode=OneWay}"
                                         OverlayWidth="{Binding OverlayWidth, Mode=OneWay}"
                                         OverlayHeight="{Binding OverlayHeight, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>