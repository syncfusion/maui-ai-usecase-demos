<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusionDiagram="clr-namespace:Syncfusion.Maui.Diagram;assembly=Syncfusion.Maui.Diagram"
             x:Class="AIProcessDiagramDrafting.ProcessDiagramPage">
    <Grid x:Name="RootGrid"
          Padding="24"
          RowSpacing="16"
          ColumnSpacing="24">
        <VerticalStackLayout x:Name="HeaderSection" Spacing="6">
            <Label Text="AI-Powered Process Diagram Drafting"
                   FontSize="28"
                   FontAttributes="Bold" />
            <Label Text="Enter a short process description and generate an editable flowchart draft."
                   FontSize="14" />
        </VerticalStackLayout>

        <VerticalStackLayout x:Name="DetailsSection" Spacing="16">
            <Border x:Name="InputSection"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="16"
                    StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Process description"
                           FontAttributes="Bold"
                           FontSize="16" />

                    <Editor x:Name="ProcessDescriptionEditor"
                            Text="{Binding ProcessDescription, Mode=TwoWay}"
                            HeightRequest="220"
                            Placeholder="Describe the workflow in a few sentences..."
                            SemanticProperties.Hint="Type the process you want turned into a draft diagram."
                            SemanticProperties.Description="Process description editor" />

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">
                        <Button Grid.Column="0"
                                Text="Generate Draft"
                                Command="{Binding GenerateDraftCommand}"
                                SemanticProperties.Hint="Generate and accept a new process diagram draft." />
                        <Button Grid.Column="1"
                                Text="Discard"
                                Command="{Binding DiscardDraftCommand}"
                                SemanticProperties.Hint="Discard the current draft and clear the diagram." />
                    </Grid>

                    <Border IsVisible="{Binding HasStatusMessage}"
                            Stroke="#E5E7EB"
                            StrokeThickness="1"
                            BackgroundColor="#F9FAFB"
                            Padding="12"
                            StrokeShape="RoundRectangle 12">
                        <Label Text="{Binding StatusMessage}"
                               TextColor="{Binding StatusMessageColor}"
                               LineBreakMode="WordWrap" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding HasDraftSummary}"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="16"
                    StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Draft summary"
                           FontAttributes="Bold"
                           FontSize="16" />

                    <VerticalStackLayout Spacing="4"
                                         IsVisible="{Binding HasDraftTitle}">
                        <Label Text="Title"
                               FontSize="12"
                               TextColor="#6B7280" />
                        <Label Text="{Binding DraftTitle}"
                               FontSize="18"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8"
                                         IsVisible="{Binding HasWarnings}">
                        <Label Text="Warnings"
                               FontSize="12"
                               TextColor="#6B7280" />
                        <VerticalStackLayout Spacing="8"
                                             BindableLayout.ItemsSource="{Binding Warnings}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*"
                                          ColumnSpacing="8">
                                        <BoxView WidthRequest="8"
                                                 HeightRequest="8"
                                                 Color="#F59E0B"
                                                 VerticalOptions="Center" />
                                        <Label Grid.Column="1"
                                               Text="{Binding Message}"
                                               LineBreakMode="WordWrap" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <Border x:Name="DiagramSection"
                Stroke="#E5E7EB"
                StrokeThickness="1"
                BackgroundColor="White"
                Padding="12"
                StrokeShape="RoundRectangle 16">
            <Grid x:Name="DiagramHost" />
        </Border>
    </Grid>
</ContentPage>