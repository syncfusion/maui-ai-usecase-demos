<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusionDiagram="clr-namespace:Syncfusion.Maui.Diagram;assembly=Syncfusion.Maui.Diagram"
             x:Class="AIProcessDiagramDrafting.ProcessDiagramPage">
    <Grid x:Name="RootGrid"
          Padding="24"
          RowSpacing="16"
          ColumnSpacing="24">
        <VerticalStackLayout x:Name="HeaderSection" Spacing="6">
            <Label Text="AI-Powered Process Diagram Drafting"
                   FontSize="28"
                   FontAttributes="Bold" />
            <Label Text="Enter a short process description and generate an editable flowchart draft."
                   FontSize="14" />
        </VerticalStackLayout>

        <VerticalStackLayout x:Name="DetailsSection" Spacing="16">
			<Border x:Name="InputSection"
					Stroke="#E5E7EB"
					StrokeThickness="1"
					BackgroundColor="White"
					Padding="16"
					StrokeShape="RoundRectangle 16">
				<VerticalStackLayout Spacing="12">
					<Label Text="Process description"
						   FontAttributes="Bold"
						   FontSize="16" />

					<Editor x:Name="ProcessDescriptionEditor"
							Text="{Binding ProcessDescription, Mode=TwoWay}"
							HeightRequest="220"
							TextChanged="OnProcessDescriptionTextChanged"
							Placeholder="Describe the workflow in a few sentences..." />

					<Button Text="Generate Draft"
							BackgroundColor="#4F46E5"
							TextColor="White"
							Clicked="OnGenerateDraftClicked" />

					<Label Text="{Binding StatusMessage}"
						   IsVisible="{Binding HasStatusMessage}"
						   TextColor="#B91C1C" />
				</VerticalStackLayout>
			</Border>
		</VerticalStackLayout>

        <Border x:Name="DiagramSection"
                Stroke="#E5E7EB"
                StrokeThickness="1"
                BackgroundColor="White"
                Padding="12"
                StrokeShape="RoundRectangle 16">
            <Grid x:Name="DiagramHost" />
        </Border>
    </Grid>
</ContentPage>
