<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusionDiagram="clr-namespace:Syncfusion.Maui.Diagram;assembly=Syncfusion.Maui.Diagram"
             x:Class="AIProcessDiagramDrafting.ProcessDiagramPage"
             Title="AI-Powered Process Diagram Drafting">
    <Grid x:Name="RootGrid"
          Padding="24"
          RowSpacing="16"
          RowDefinitions="Auto,Auto,*,Auto">
        <VerticalStackLayout x:Name="HeaderSection" Spacing="6">
            <Label Text="AI-Powered Process Diagram Drafting"
                   FontSize="28"
                   FontAttributes="Bold" />
            <Label Text="Edit the workflow description and generate an updated diagram with AI."
                   FontSize="14" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                x:Name="InputSection"
                Stroke="#E5E7EB"
                StrokeThickness="1"
                BackgroundColor="White"
                Padding="16"
                StrokeShape="RoundRectangle 16">
            <VerticalStackLayout Spacing="12">
                <Label Text="Process description"
                       FontAttributes="Bold"
                       FontSize="16" />

                <Editor x:Name="ProcessDescriptionEditor"
                        Text="{Binding ProcessDescription, Mode=TwoWay}"
                        HeightRequest="180"
                        Placeholder="Describe the workflow in a few sentences..." />

                <Button Text="Generate Draft"
                        Clicked="OnGenerateDraftClicked" />

                <Label Text="{Binding StatusMessage}"
                       IsVisible="{Binding HasStatusMessage}"
                       TextColor="#B91C1C" />
            </VerticalStackLayout>
        </Border>

        <Border Grid.Row="2"
                x:Name="DiagramSection"
                Stroke="#E5E7EB"
                StrokeThickness="1"
                BackgroundColor="White"
                Padding="12"
                StrokeShape="RoundRectangle 16">
            <syncfusionDiagram:SfDiagram x:Name="DiagramSurface" />
        </Border>

        <Border Grid.Row="3"
                x:Name="ReviewSection"
                Stroke="#E5E7EB"
                StrokeThickness="1"
                Padding="16"
                StrokeShape="RoundRectangle 16">
            <VerticalStackLayout Spacing="12">
                <Label Text="Review actions"
                       FontAttributes="Bold"
                       FontSize="16" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text="Accept Draft"
                            Clicked="OnAcceptDraftClicked" />
                    <Button Grid.Column="1"
                            Text="Regenerate"
                            Clicked="OnRegenerateClicked" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
