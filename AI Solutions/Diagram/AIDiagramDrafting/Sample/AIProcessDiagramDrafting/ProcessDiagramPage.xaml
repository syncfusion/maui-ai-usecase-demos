<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusionDiagram="clr-namespace:Syncfusion.Maui.Diagram;assembly=Syncfusion.Maui.Diagram"
             x:Class="AIDiagramDrafting.ProcessDiagramPage"
             Title="AI-Powered Process Diagram Drafting">
    <Grid Padding="24" RowDefinitions="Auto,Auto,*" ColumnDefinitions="2*,3*" RowSpacing="16" ColumnSpacing="24">
        <VerticalStackLayout Grid.Row="0" Grid.ColumnSpan="2" Spacing="8">
            <Label Text="AI-Powered Process Diagram Drafting" FontSize="28" FontAttributes="Bold" />
            <Label Text="Enter a short process description and generate an editable flowchart draft." FontSize="14" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="12">
            <Label Text="Process description" FontAttributes="Bold" />
            <Editor Text="{Binding ProcessDescription}" AutoSize="TextChanges" HeightRequest="180" />
            <HorizontalStackLayout Spacing="12">
                <Button Text="Generate Draft" Command="{Binding GenerateDraftCommand}" />
                <Button Text="Accept Draft" Command="{Binding AcceptDraftCommand}" />
                <Button Text="Regenerate" Command="{Binding RegenerateCommand}" />
                <Button Text="Discard" Command="{Binding DiscardCommand}" />
            </HorizontalStackLayout>
            <Label Text="{Binding StatusMessage}" TextColor="DarkRed" />
        </VerticalStackLayout>

        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" StrokeThickness="1" Stroke="LightGray" Padding="12">
            <syncfusionDiagram:SfDiagram x:Name="DiagramSurface" />
        </Border>
    </Grid>
</ContentPage>
