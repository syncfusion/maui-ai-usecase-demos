<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:models="clr-namespace:NutriLens.Models"
    x:Class="NutriLens.Views.HistoryPage"
    BackgroundColor="#F3F5FA"
    NavigationPage.HasNavigationBar="False">

    <Grid
        RowDefinitions="Auto,*,64"
        BackgroundColor="#F3F5FA">

        <!-- Header -->
        <Grid
            Grid.Row="0"
            Margin="20,18,20,0"
            HeightRequest="36"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="8">

            <HorizontalStackLayout
                Spacing="8"
                VerticalOptions="Center">

                <Label
                    Text="{Binding BiotechIcon}"
                    Style="{StaticResource HistoryIconStyle}"
                    FontSize="24"
                    TextColor="#0B7A5A"
                    WidthRequest="24"
                    HeightRequest="24" />

                <Label
                    Text="NutriLens AI"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#14324A"
                    VerticalTextAlignment="Center" />
            </HorizontalStackLayout>

            <buttons:SfButton
                Grid.Column="1"
                WidthRequest="36"
                HeightRequest="36"
                Text="{Binding PersonIcon}"
                FontFamily="MaterialIconsRegular"
                FontSize="20"
                TextColor="White"
                Background="#047857"
                Stroke="Transparent"
                CornerRadius="18"
                Padding="0" />
        </Grid>

        <!-- Page content -->
        <ScrollView
            Grid.Row="1"
            VerticalScrollBarVisibility="Never">

            <VerticalStackLayout
                Padding="20,18,20,28"
                Spacing="14">
 
                <!-- Search -->
                <Grid>
                    <core:SfTextInputLayout
          ContainerType="Outlined" HeightRequest="68"
        Hint="Search here..." 
        HorizontalOptions="Fill"
        VerticalOptions="Center">
                        <core:SfTextInputLayout.LeadingView>
                            <Label

                        Margin="-1,5,0,0"
                        Text="{Binding SearchIcon}"
                        Style="{StaticResource HistoryIconStyle}"
                        FontSize="20"
                        TextColor="#6B7280"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                        </core:SfTextInputLayout.LeadingView>
                        <Entry
    Text="{Binding SearchText, Mode=TwoWay}"
    HeightRequest="48"
    Margin="0" 
    FontSize="13"
    TextColor="#0F172A"
    Placeholder="Search here..."
    PlaceholderColor="#6B7280"
    VerticalTextAlignment="Center"
    HorizontalTextAlignment="Start"
    ClearButtonVisibility="WhileEditing"
    BackgroundColor="Transparent" />
                    </core:SfTextInputLayout>
                </Grid>

                <!-- Filter chips -->
                <ScrollView
                    HeightRequest="36"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never">

                    <HorizontalStackLayout
                        Spacing="10">

                        <!-- SfChipGroup is used for the unselected filter options -->
                        <!--<core:SfChipGroup
                            ItemsSource="{Binding UnselectedFilters}"
                            DisplayMemberPath="."
                            ChipPadding="14,8,14,8"
                            ChipBackground="#EDF2F7"
                            ChipTextColor="#6B7280"
                            HorizontalOptions="Start"
                            VerticalOptions="Center" />-->

                        <!-- Selected chip is kept separate so its color is exact -->
                        <Border
                            Style="{StaticResource HistoryFilterChipStyle}"
                            BackgroundColor="#047857"
                            VerticalOptions="Center">

                            <Label
                                Text="All Scans"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="White"
                                VerticalTextAlignment="Center" />
                        </Border>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Summary -->
                <Grid
                    Margin="0,8,0,0"
                    ColumnDefinitions="*,Auto">

                    <Label Text="{Binding SummaryText}"
                            FontSize="16"
                            TextColor="#374151"
                            VerticalTextAlignment="Center" />

                    <Border
                        Grid.Column="1"
                        Padding="10,6"
                        BackgroundColor="#DFF5EE"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 10">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="OnSelectClicked" />
                        </Border.GestureRecognizers>

                        <HorizontalStackLayout Spacing="5">
                            <Label
                                Text="{Binding DoneAllIcon}"
                                Style="{StaticResource HistoryIconStyle}"
                                FontSize="16"
                                TextColor="#047857" />

                            <Label
                                Text="Select"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#047857" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- History list -->
                <listView:SfListView
                    ItemsSource="{Binding HistoryItems}"
                    ItemSize="100" 
                    SelectionMode="None">

                    <listView:SfListView.ItemTemplate>
                        <DataTemplate x:DataType="models:HistoryItem">

                            <Border
                                Style="{StaticResource HistoryCardStyle}">
                                <Border.Shadow>
                                    <Shadow
                                        Brush="#26000000"
                                        Offset="0,2"
                                        Radius="8"
                                        Opacity="0.35" />
                                </Border.Shadow>

                                <Grid
                                    ColumnDefinitions="52,*,Auto"
                                    ColumnSpacing="12">

                                    <!-- Thumbnail -->
                                    <Border
                                        WidthRequest="52"
                                        HeightRequest="52"
                                        BackgroundColor="#EEF2F1"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 8"
                                        VerticalOptions="Center">

                                        <Image
                                            Source="{Binding Image}"
                                            Aspect="AspectFill" />
                                    </Border>

                                    <!-- Details -->
                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="5"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="{Binding ProductName}"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            TextColor="#0F172A"
                                            LineBreakMode="TailTruncation" />

                                        <HorizontalStackLayout
                                            Spacing="8">

                                            <Label
                                                Text="{Binding Score}"
                                                FontSize="15"
                                                FontAttributes="Bold"
                                                TextColor="{Binding ScoreColor}"
                                                VerticalTextAlignment="Center" />

                                            <Label
                                                Text="{Binding ScanDate}"
                                                FontSize="13"
                                                TextColor="#6B7280"
                                                VerticalTextAlignment="Center" />

                                            <Label
                                                Text="{Binding StatusIcon}"
                                                Style="{StaticResource HistoryIconStyle}"
                                                FontSize="16"
                                                TextColor="{Binding ScoreColor}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <!-- Trailing arrow -->
                                    <Label
                                        Grid.Column="2"
                                        Text="&#xE5CC;"
                                        Style="{StaticResource HistoryIconStyle}"
                                        FontSize="22"
                                        TextColor="#94A3B8"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </listView:SfListView.ItemTemplate>
                </listView:SfListView>
                
            </VerticalStackLayout>
        </ScrollView>

        <!-- Fixed footer -->
        <Grid
            Grid.Row="2"
            ZIndex="10"
            ColumnDefinitions="*,*,*,*,*"
            BackgroundColor="White">

            <Grid.Shadow>
                <Shadow
                    Brush="#40000000"
                    Offset="0,-4"
                    Radius="10"
                    Opacity="0.35" />
            </Grid.Shadow>

            <!-- Home -->
            <VerticalStackLayout
                Grid.Column="0"
                Spacing="2"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <buttons:SfButton
                    Text="{Binding HomeIcon}"
                    Style="{StaticResource HistoryNavButtonStyle}"
                    TextColor="#6B7280"
                    Clicked="OnHomeClicked" />

                <Label
                    Text="Home"
                    FontSize="10"
                    TextColor="#6B7280"
                    HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- History -->
            <VerticalStackLayout
                Grid.Column="1"
                Spacing="2"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <buttons:SfButton
                    Text="{Binding HistoryIcon}"
                    Style="{StaticResource HistoryNavButtonStyle}"
                    TextColor="#047857" />

                <Label
                    Text="History"
                    FontSize="10"
                    FontAttributes="Bold"
                    TextColor="#047857"
                    HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Empty center slot -->
            <BoxView
                Grid.Column="2"
                Color="White" />

            <!-- Trends -->
            <VerticalStackLayout
                Grid.Column="3"
                Spacing="2"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <buttons:SfButton
                    Text="{Binding TrendsIcon}"
                    Style="{StaticResource HistoryNavButtonStyle}"
                    TextColor="#6B7280"
                    Clicked="OnTrendsClicked" />

                <Label
                    Text="Trends"
                    FontSize="10"
                    TextColor="#6B7280"
                    HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Profile -->
            <VerticalStackLayout
                Grid.Column="4"
                Spacing="2"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <buttons:SfButton
                    Text="{Binding ProfileIcon}"
                    Style="{StaticResource HistoryNavButtonStyle}"
                    TextColor="#6B7280"
                    Clicked="OnProfileClicked" />

                <Label
                    Text="Profile"
                    FontSize="10"
                    TextColor="#6B7280"
                    HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Floating Scan button -->
            <Border
                Grid.Column="2"
                WidthRequest="72"
                HeightRequest="72"
                Margin="0,-36,0,0"
                BackgroundColor="#047857"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 36"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                ZIndex="20">

                <Border.Shadow>
                    <Shadow
                        Brush="#66000000"
                        Offset="0,6"
                        Radius="12"
                        Opacity="0.7" />
                </Border.Shadow>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="OnScanClicked" />
                </Border.GestureRecognizers>

                <Grid
                    RowDefinitions="*,Auto"
                    Padding="0,9,0,8">

                    <Label
                        Text="{Binding ScannerIcon}"
                        Style="{StaticResource HistoryIconStyle}"
                        FontSize="28"
                        TextColor="White"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Row="1"
                        Text="SCAN"
                        FontSize="10"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>