<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:models="clr-namespace:NutriLens.Models"
    xmlns:helpers="clr-namespace:NutriLens.Helpers"
    x:Class="NutriLens.Views.HistoryPage"
    BackgroundColor="#F3F5FA"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="HistoryIconStyle" TargetType="Label">
                <Setter Property="FontFamily" Value="MaterialIconsRegular" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>

            <Style x:Key="HistoryNavButtonStyle" TargetType="buttons:SfButton">
                <Setter Property="FontFamily" Value="MaterialIconsRegular" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Stroke" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="WidthRequest" Value="42" />
                <Setter Property="HeightRequest" Value="34" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,80" BackgroundColor="#F3F5FA">

        <!-- Top header -->
        <Grid
            Grid.Row="0"
            Padding="20,18,20,8"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="8">

            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Label
                    Text="{Binding BiotechIcon}"
                    Style="{StaticResource HistoryIconStyle}"
                    FontSize="24"
                    TextColor="#0B7A5A"
                    WidthRequest="24"
                    HeightRequest="24" />

                <Label
                    Text="NutriLens AI"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#14324A"
                    VerticalTextAlignment="Center" />
            </HorizontalStackLayout>

            <buttons:SfButton
                Grid.Column="1"
                WidthRequest="36"
                HeightRequest="36"
                Text="{Binding PersonIcon}"
                FontFamily="MaterialIconsRegular"
                FontSize="20"
                TextColor="White"
                Background="#047857"
                Stroke="Transparent"
                CornerRadius="18"
                Padding="0"
                Command="{Binding OpenProfileCommand}" />
        </Grid>

        <!-- Main content -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,8,20,24" Spacing="16">

                <!-- Title -->
                <VerticalStackLayout Spacing="4">
                    <Label
                        Text="Scan History"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="#0F172A" />

                    <Label
                        Text="Review your past nutritional analyses."
                        FontSize="14"
                        TextColor="#64748B" />
                </VerticalStackLayout>

                <!-- Search -->
                <Border Stroke="Transparent" StrokeShape="RoundRectangle 16">
                    <core:SfTextInputLayout
                        ContainerType="Outlined" x:Name="SearchInputLayout"
                        HeightRequest="64"
                        Hint="Search by product name..."
                        Stroke="White"
                        HorizontalOptions="Fill"
                        Background="White"
                        VerticalOptions="Center">

                        <core:SfTextInputLayout.LeadingView>
                            <Label
                                Text="{Binding SearchIcon}"
                                Style="{StaticResource HistoryIconStyle}"
                                FontSize="20"
                                TextColor="#6B7280"
                                Margin="0,4,0,0" />
                        </core:SfTextInputLayout.LeadingView>

                        <Entry
                            Text="{Binding SearchText, Mode=TwoWay}"
                            HeightRequest="46"
                            FontSize="14" x:Name="SearchEntry"
                            TextColor="#0F172A"
                            Placeholder="Search by product name..."
                            PlaceholderColor="#6B7280"
                            ClearButtonVisibility="WhileEditing"
                            BackgroundColor="Transparent"
                            Focused="OnSearchFocused"
                            Unfocused="OnSearchUnfocused" />
                    </core:SfTextInputLayout>
                </Border>

                <!-- Filter chips -->
                <ScrollView
                    HeightRequest="48"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    VerticalScrollBarVisibility="Never">

                    <core:SfChipGroup
                        ItemsSource="{Binding UnselectedFilters}"
                        ChipType="Choice"
                        ChoiceMode="Single"
                        SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                        ItemHeight="36"
                        ChipPadding="14,0"
                        ChipCornerRadius="18"
                        ChipBackground="#EAF0FF"
                        SelectedChipBackground="#047857"
                        SelectedChipTextColor="White"
                        ChipTextSize="13"
                        ChipFontAttributes="None"
                        ChipStroke="Transparent"
                        ChipStrokeThickness="0"
                        HorizontalOptions="Start"
                        VerticalOptions="Center" />
                </ScrollView>

                <!-- Summary -->
                <Label
                    Text="{Binding SummaryText}"
                    FontSize="16"
                    TextColor="#374151"
                    VerticalTextAlignment="Center" />

                <!-- History list -->
                <listView:SfListView
                    ItemsSource="{Binding HistoryItems}"
                    ItemSize="100"
                    SelectionMode="None"
                    ItemSpacing="0,10,0,0"
                    ItemTapped="OnHistoryItemTapped">

                    <listView:SfListView.ItemTemplate>
                        <DataTemplate x:DataType="models:HistoryItem">
                            <Border
                                Padding="14"
                                Background="White"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 16">

                                <Border.Shadow>
                                    <Shadow
                                        Brush="#26000000"
                                        Offset="0,2"
                                        Radius="8"
                                        Opacity="0.35" />
                                </Border.Shadow>

                                <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="12">

                                    <!-- Thumbnail -->
                                    <Border
                                        WidthRequest="56"
                                        HeightRequest="56"
                                        BackgroundColor="#EEF2F1"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 10"
                                        VerticalOptions="Center">

                                        <Image
                                            Source="{Binding Image}"
                                            Aspect="AspectFill" />
                                    </Border>

                                    <!-- Details -->
                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="4"
                                                         VerticalOptions="Center">

                                        <Label
                                            Text="{Binding ProductName}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="#0F172A"
                                            LineBreakMode="TailTruncation" />

                                        <Label
                                            Text="{Binding ScanDate}"
                                            FontSize="12"
                                            TextColor="#6B7280" />
                                    </VerticalStackLayout>

                                    <!-- Score badge + arrow -->
                                    <HorizontalStackLayout
                                        Grid.Column="2"
                                        Spacing="10"
                                        VerticalOptions="Center">

                                        <Border
                                            WidthRequest="42"
                                            HeightRequest="42"
                                            BackgroundColor="{Binding ScoreColor}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 21">

                                            <Label
                                                Text="{Binding Score}"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="White"
                                                HorizontalTextAlignment="Center"
                                                VerticalTextAlignment="Center" />
                                        </Border>

                                        <Label
                                            Text="&#xE5CC;"
                                            Style="{StaticResource HistoryIconStyle}"
                                            FontSize="22"
                                            TextColor="#94A3B8"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </listView:SfListView.ItemTemplate>
                </listView:SfListView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom navigation -->
        <Grid Grid.Row="2"
              ZIndex="10"
              ColumnDefinitions="*,*,*,*,*"
              BackgroundColor="White">

            <Grid.Shadow>
                <Shadow
                    Brush="#40000000"
                    Offset="0,-4"
                    Radius="10"
                    Opacity="0.35" />
            </Grid.Shadow>

            <!-- Home -->
            <VerticalStackLayout Grid.Column="0"
                                 Spacing="2"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <buttons:SfButton
                    Text="{Binding HomeIcon}"
                    Style="{StaticResource HistoryNavButtonStyle}"
                    TextColor="#6B7280"
                    Clicked="OnHomeClicked" />
                <Label Text="Home"
                       FontSize="10"
                       TextColor="#6B7280"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- History -->
            <VerticalStackLayout Grid.Column="1"
                                 Spacing="2"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <buttons:SfButton
                    Text="{Binding HistoryIcon}"
                    Style="{StaticResource HistoryNavButtonStyle}"
                    TextColor="#047857" />
                <Label Text="History"
                       FontSize="10"
                       FontAttributes="Bold"
                       TextColor="#047857"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Scan FAB -->
            <Grid Grid.Column="2"
                  HorizontalOptions="Center"
                  VerticalOptions="Start"
                  TranslationY="-36"
                  ZIndex="20">

                <Border
                    WidthRequest="72"
                    HeightRequest="72"
                    Background="#047857"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 36">

                    <Border.Shadow>
                        <Shadow
                            Brush="#55000000"
                            Offset="0,6"
                            Radius="12"
                            Opacity="0.75" />
                    </Border.Shadow>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnScanClicked" />
                    </Border.GestureRecognizers>

                    <Grid RowDefinitions="*,Auto"
                          Padding="0,9,0,8">

                        <Label
                            Text="{Binding ScannerIcon}"
                            Style="{StaticResource HistoryIconStyle}"
                            FontSize="28"
                            TextColor="White"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Row="1"
                            Text="SCAN"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalTextAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Trends -->
            <VerticalStackLayout Grid.Column="3"
                                 Spacing="2"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <buttons:SfButton
                    Text="{Binding TrendsIcon}"
                    Style="{StaticResource HistoryNavButtonStyle}"
                    TextColor="#6B7280"
                    Clicked="OnTrendsClicked" />
                <Label Text="Trends"
                       FontSize="10"
                       TextColor="#6B7280"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Profile -->
            <VerticalStackLayout Grid.Column="4"
                                 Spacing="2"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <buttons:SfButton
                    Text="{Binding ProfileIcon}"
                    Style="{StaticResource HistoryNavButtonStyle}"
                    TextColor="#6B7280"
                    Clicked="OnProfileClicked" />
                <Label Text="Profile"
                       FontSize="10"
                       TextColor="#6B7280"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>