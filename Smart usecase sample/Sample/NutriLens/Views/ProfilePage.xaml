<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:models="clr-namespace:NutriLens.Models"
    xmlns:vm="clr-namespace:NutriLens.ViewModels"
    x:Class="NutriLens.Views.ProfilePage"
    x:DataType="vm:ProfileViewModel"
    BackgroundColor="#F4F6FA"
    xmlns:desktop="clr-namespace:NutriLens.Views"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="{OnIdiom Phone='Auto,*,80',Default='Auto,*'}" BackgroundColor="#F4F6FA">

        <!-- Header -->
        <Grid
            Grid.Row="0"
            Margin="20,20,20,0" 
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="8">

            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Label
                    Text="{Binding BiotechIcon}"
                    FontFamily="MaterialIconsRegular"
                    FontSize="24"
                    TextColor="#047857"
                    WidthRequest="24" />
                <Label
                    Text="NutriLens AI"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#1F2937"
                    VerticalTextAlignment="Center" />
            </HorizontalStackLayout>
            <!-- Desktop navigation -->
            <desktop:DesktopHeaderNavigation Grid.Column="1"  HorizontalOptions="End" 
                                VerticalOptions="Center"
                                CurrentPage="Profile" />
            <buttons:SfButton
                Grid.Column="2"
                WidthRequest="36"
                HeightRequest="36"
                Text="{Binding PersonIcon}"
                FontFamily="MaterialIconsRegular"
                FontSize="20"
                TextColor="White"
                Background="#047857"
                Stroke="Transparent"
                CornerRadius="18"
                Padding="0" />
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,24,20,110" Spacing="20">

                <!-- Avatar -->
                <Grid
                    HeightRequest="128"
                    HorizontalOptions="Center">

                    <Border
                        WidthRequest="100"
                        HeightRequest="100"
                        Background="#047857"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 50"
                        HorizontalOptions="Center"
                        VerticalOptions="Start">
                        <Border.Shadow>
                            <Shadow
                                Brush="#35000000"
                                Offset="0,3"
                                Radius="8"
                                Opacity="0.4" />
                        </Border.Shadow>

                        <Grid>
                            <core:SfAvatarView
                                WidthRequest="100"
                                HeightRequest="100"
                                FontSize="26"
                                CornerRadius="50"
                                AvatarName="Alex"
                                ContentType="Initials"
                                Background="#047857"
                                HorizontalOptions="Center"
                                VerticalOptions="Start"
                                IsVisible="{Binding HasAvatar, Converter={StaticResource InverseBoolConverter}}"/>

                            <Image
                                Source="{Binding AvatarSource}"
                                Aspect="AspectFill"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill"
                                IsVisible="{Binding HasAvatar}" />
                        </Grid>
                    </Border>

                    <buttons:SfButton
                        WidthRequest="28"
                        HeightRequest="28"
                        Text="{Binding EditIcon}"
                        FontFamily="MaterialIconsRegular"
                        FontSize="15"
                        TextColor="#047857"
                        Background="#DCEAFF"
                        Stroke="White"
                        StrokeThickness="2"
                        CornerRadius="14"
                        Padding="0"
                        HorizontalOptions="End"
                        VerticalOptions="End"
                        Margin="0,0,4,8"
                        Command="{Binding EditProfileCommand}" />
                </Grid>

                <!--
                    Desktop-only two-column row:
                      Phone  -> single column, stacked: Dietary Goals, Allergies, Health Considerations, Settings
                      Desktop-> left column: Dietary Goals + Health Considerations,
                               right column: Allergies & Preferences + Settings (account)
                -->
                <Grid
                    ColumnDefinitions="{OnIdiom Phone='*', Default='*,*'}"
                    RowDefinitions="{OnIdiom Phone='Auto,Auto,Auto,Auto', Default='Auto,Auto'}"
                    ColumnSpacing="{OnIdiom Phone=0, Default=20}"
                    RowSpacing="{OnIdiom Phone=20, Default=20}">

                    <!-- Dietary Goals (left top on desktop) -->
                    <Border
                        Grid.Row="{OnIdiom Phone=0, Default=0}"
                        Grid.Column="0"
                        Padding="16" BackgroundColor="White" Stroke="Transparent" StrokeShape="RoundRectangle 12">
                        <Border.Shadow>
                            <Shadow Brush="#26000000" Offset="0,2" Radius="8" Opacity="0.35" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="12">
                            <HorizontalStackLayout Spacing="8">
                                <Label
                                    Text="{Binding FlagIcon}"
                                    FontFamily="MaterialIconsRegular"
                                    FontSize="22"
                                    TextColor="#047857" />
                                <Label
                                    Text="Dietary Goals"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="#1F2937"
                                    VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>

                            <Label
                                Text="Select your primary nutritional focus."
                                FontSize="13"
                                TextColor="#6B7280" />
                            <ScrollView
                                Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never"
                                VerticalScrollBarVisibility="Never">
                                <core:SfChipGroup
                                    ItemsSource="{Binding DietaryGoals}" 
                                    ChipType="Filter"
                                    ItemHeight="40" 
                                    ChipCornerRadius="20" DisplayMemberPath="Title"
                                    SelectedChipBackground="#047857" 
                                    ChipBackground="#E9EFFA" 
                                    ChipStroke="White"
                                    ChipStrokeThickness="2"
                                    ChipTextSize="13"
                                    ChipFontAttributes="None"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center" />
                            </ScrollView>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Allergies & Preferences (right top on desktop) -->
                    <Border
                        Grid.Row="{OnIdiom Phone=1, Default=0}"
                        Grid.Column="{OnIdiom Phone=0, Default=1}"
                        Padding="16" BackgroundColor="White" Stroke="Transparent" StrokeShape="RoundRectangle 12">
                        <Border.Shadow>
                            <Shadow Brush="#26000000" Offset="0,2" Radius="8" Opacity="0.35" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="12">
                            <HorizontalStackLayout Spacing="8">
                                <Label
                                    Text="{Binding RestaurantMenuIcon}"
                                    FontFamily="MaterialIconsRegular"
                                    FontSize="22"
                                    TextColor="#C98A00" />
                                <Label
                                    Text="Allergies &amp; Preferences"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="#1F2937"
                                    VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>

                            <Label
                                Text="Avoid risky ingredients in your scans."
                                FontSize="13"
                                TextColor="#6B7280" />
                            <ScrollView
                                Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never"
                                VerticalScrollBarVisibility="Never">
                                <core:SfChipGroup
                                    ItemsSource="{Binding Preferences}" 
                                    ChipType="Filter"
                                    ItemHeight="40" DisplayMemberPath="Title" 
                                    ChipCornerRadius="20"
                                    SelectedChipBackground="#EA8C00" 
                                    ChipBackground="#E9EFFA" 
                                    ChipStroke="White"
                                    ChipStrokeThickness="2"
                                    ChipTextSize="13"
                                    ChipFontAttributes="None"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center" />
                            </ScrollView>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Health Considerations (left bottom on desktop) -->
                    <Border
                        Grid.Row="{OnIdiom Phone=2, Default=1}"
                        Grid.Column="0"
                        Padding="16" BackgroundColor="White" Stroke="Transparent" StrokeShape="RoundRectangle 12">
                        <Border.Shadow>
                            <Shadow Brush="#26000000" Offset="0,2" Radius="8" Opacity="0.35" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="12">
                            <HorizontalStackLayout Spacing="8">
                                <Label
                                    Text="{Binding HealthIcon}"
                                    FontFamily="MaterialIconsRegular"
                                    FontSize="22"
                                    TextColor="#EF4444" />
                                <Label
                                    Text="Health Considerations"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="#1F2937"
                                    VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>

                            <Label
                                Text="Tailor insights for specific health profiles."
                                FontSize="13"
                                TextColor="#6B7280" />

                            <Border
                                HeightRequest="60"
                                Padding="14,0"
                                BackgroundColor="#DCEAFF"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 12">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Label
                                        Text="{Binding MedicalServicesIcon}"
                                        FontFamily="MaterialIconsRegular"
                                        FontSize="22"
                                        TextColor="#E11D48"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        Text="Diabetes considerations"
                                        Margin="12,0,8,0"
                                        FontSize="14"
                                        TextColor="#0F172A"
                                        VerticalTextAlignment="Center" />
                                    <buttons:SfSwitch
                                        Grid.Column="2"
                                        IsOn="{Binding DiabetesEnabled}"
                                        VerticalOptions="Center" >
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="On">
                                                    <VisualState.Setters>
                                                        <Setter Property="SwitchSettings">
                                                            <Setter.Value>
                                                                <buttons:SwitchSettings
                                                                    ThumbBackground="White"
                                                                    ThumbStroke="#047857"
                                                                    TrackBackground="#047857"
                                                                    TrackStroke="Transparent" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Off">
                                                    <VisualState.Setters>
                                                        <Setter Property="SwitchSettings">
                                                            <Setter.Value>
                                                                <buttons:SwitchSettings
                                                                    ThumbBackground="Gray"
                                                                    ThumbStroke="Gray"
                                                                    TrackBackground="#e6e0e9"
                                                                    TrackStroke="Gray" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </buttons:SfSwitch>
                                </Grid>
                            </Border>

                            <Border
                                HeightRequest="60"
                                Padding="14,0"
                                BackgroundColor="#DCEAFF"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 12">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Label
                                        Text="{Binding HealthIcon}"
                                        FontFamily="MaterialIconsRegular"
                                        FontSize="22"
                                        TextColor="#E11D48"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        Text="Hypertension considerations"
                                        Margin="12,0,8,0"
                                        FontSize="14"
                                        TextColor="#0F172A"
                                        VerticalTextAlignment="Center" />
                                    <buttons:SfSwitch
                                        Grid.Column="2"
                                        IsOn="{Binding HypertensionEnabled}"
                                        VerticalOptions="Center">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="On">
                                                    <VisualState.Setters>
                                                        <Setter Property="SwitchSettings">
                                                            <Setter.Value>
                                                                <buttons:SwitchSettings
                                                                    ThumbBackground="White"
                                                                    ThumbStroke="#047857"
                                                                    TrackBackground="#047857"
                                                                    TrackStroke="Transparent" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Off">
                                                    <VisualState.Setters>
                                                        <Setter Property="SwitchSettings">
                                                            <Setter.Value>
                                                                <buttons:SwitchSettings
                                                                    ThumbBackground="Gray"
                                                                    ThumbStroke="Gray"
                                                                    TrackBackground="#e6e0e9"
                                                                    TrackStroke="Gray" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </buttons:SfSwitch>
                                </Grid>
                            </Border>

                            <Border
                                Padding="14"
                                BackgroundColor="#DCEAFF"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 12">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label
                                        Text="{Binding LockIcon}"
                                        FontFamily="MaterialIconsRegular"
                                        FontSize="20"
                                        TextColor="#0F766E"
                                        VerticalOptions="Start" />
                                    <Label
                                        Grid.Column="1"
                                        Text="Health details are private, editable, and used only to personalize your analysis locally on your device."
                                        Margin="12,0,0,0"
                                        FontSize="13"
                                        TextColor="#0F766E"
                                        LineBreakMode="WordWrap" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Settings Menu / account settings (right bottom on desktop) -->
                    <Border
                        Grid.Row="{OnIdiom Phone=3, Default=1}"
                        Grid.Column="{OnIdiom Phone=0, Default=1}"
                        Margin="0,4,0,0"
                        Style="{StaticResource ProfileCardStyle}"
                        Padding="0"
                        VerticalOptions="Start">

                        <VerticalStackLayout
                            BindableLayout.ItemsSource="{Binding Settings}"
                            Spacing="0">

                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ProfileSetting">
                                    <Grid
                                        HeightRequest="58"
                                        Padding="20,0"
                                        ColumnDefinitions="Auto,*,Auto">

                                        <Label
                                            Text="{Binding Icon}"
                                            Style="{StaticResource ProfileIconStyle}"
                                            FontSize="21"
                                            TextColor="#475569" />

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Title}"
                                            Margin="14,0,8,0"
                                            FontSize="14"
                                            TextColor="#0F172A"
                                            VerticalTextAlignment="Center" />

                                        <Label
                                            Grid.Column="2"
                                            Text="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ChevronIcon}"
                                            Style="{StaticResource ProfileIconStyle}"
                                            FontSize="20"
                                            TextColor="#94A3B8" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <buttons:SfButton
                    Text="SIGN OUT"
                    Background="Transparent"
                    Stroke="Transparent"
                    FontSize="14" WidthRequest="120"
                    FontAttributes="Bold"
                    TextColor="#EF4444"
                    Command="{Binding SignOutCommand}" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom navigation -->
        <Grid Grid.Row="2" IsVisible="{OnIdiom Phone=true, Default=false}" HeightRequest="84" ZIndex="20" ColumnDefinitions="*,*,*,*,*" BackgroundColor="White">
            <Grid.Shadow>
                <Shadow Brush="#40000000" Offset="0,-4" Radius="10" Opacity="0.35" />
            </Grid.Shadow>

            <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                <buttons:SfButton Text="{Binding HomeIcon}" FontFamily="MaterialIconsRegular" FontSize="24" TextColor="#6B7280" Background="Transparent" Stroke="Transparent" Padding="0" Command="{Binding OpenHomeCommand}" />
                <Label Text="Home" FontSize="10" TextColor="#6B7280" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                <buttons:SfButton Text="{Binding HistoryIcon}" FontFamily="MaterialIconsRegular" FontSize="24" TextColor="#6B7280" Background="Transparent" Stroke="Transparent" Padding="0" Command="{Binding OpenHistoryCommand}" />
                <Label Text="History" FontSize="10" TextColor="#6B7280" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <BoxView Grid.Column="2" Color="White" />

            <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                <buttons:SfButton Text="{Binding TrendsIcon}" FontFamily="MaterialIconsRegular" FontSize="24" TextColor="#6B7280" Background="Transparent" Stroke="Transparent" Padding="0" Command="{Binding OpenTrendsCommand}" />
                <Label Text="Trends" FontSize="10" TextColor="#6B7280" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="4" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                <buttons:SfButton Text="{Binding PersonIcon}" FontFamily="MaterialIconsRegular" FontSize="24" TextColor="#047857" Background="Transparent" Stroke="Transparent" Padding="0" />
                <Label Text="Profile" FontSize="10" FontAttributes="Bold" TextColor="#047857" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Grid
                Grid.Row="0"
                Grid.Column="2"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                TranslationY="-36"
                ZIndex="20">

                <Border
                    WidthRequest="72"
                    HeightRequest="72"
                    Background="#047857"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 36">

                    <Border.Shadow>
                        <Shadow
                            Brush="#55000000"
                            Offset="0,6"
                            Radius="12"
                            Opacity="0.75" />
                    </Border.Shadow>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ScanCommand}" />
                    </Border.GestureRecognizers>

                    <Grid
                        RowDefinitions="*,Auto"
                        Padding="0,9,0,8">

                        <Label
                            Text="{Binding ScannerIcon}"
                            FontFamily="MaterialIconsRegular"
                            FontSize="28"
                            TextColor="White"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />

                        <Label
                            Grid.Row="1"
                            Text="SCAN"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalTextAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>