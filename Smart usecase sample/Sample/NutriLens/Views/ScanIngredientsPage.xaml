<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:vm="clr-namespace:NutriLens.ViewModels"
    x:Class="NutriLens.Views.ScanIngredientsPage"
    x:DataType="vm:ScanIngredientsViewModel"
    BackgroundColor="#FFFFFF"
    NavigationPage.HasNavigationBar="False">

    <Grid
        RowDefinitions="56,*,Auto,96"
        BackgroundColor="#FFFFFF">

        <!-- Header -->
        <Grid
            Grid.Row="0"
            Padding="12,0"
            ColumnDefinitions="56,*,56"
            BackgroundColor="White">

            <buttons:SfButton
                Grid.Column="0"
                WidthRequest="40"
                HeightRequest="40"
                Text="{Binding BackIcon}"
                FontFamily="MaterialIconsRegular"
                FontSize="24"
                TextColor="#374151"
                Background="Transparent"
                Stroke="Transparent"
                Padding="0"
                Command="{Binding BackCommand}"
                SemanticProperties.Description="Go back" />

            <Label
                Grid.Column="1"
                Text="Scan"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="#1F2937"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center" />

            <buttons:SfButton
                Grid.Column="2"
                WidthRequest="36"
                HeightRequest="36"
                Text="{Binding PersonIcon}"
                FontFamily="MaterialIconsRegular"
                FontSize="20"
                TextColor="White"
                Background="#047857"
                Stroke="Transparent"
                CornerRadius="18"
                Padding="0"
                SemanticProperties.Description="Open profile" />
        </Grid>

        <!-- Camera preview and scanner overlay -->
        <Grid
            x:Name="CameraPreviewArea"
            Grid.Row="1"
            BackgroundColor="#202525"
            RowDefinitions="*,130,*"
            ColumnDefinitions="*,270,*">

            <!-- Captured image -->
            <Image
                Grid.RowSpan="3"
                Grid.ColumnSpan="3"
                Source="{Binding CapturedImage}"
                Aspect="AspectFill"
                Opacity="0.92"
                IsVisible="{Binding HasCapturedImage}" />

            <!-- Empty camera placeholder -->
            <Grid
                Grid.RowSpan="3"
                Grid.ColumnSpan="3"
                BackgroundColor="#202525"
                IsVisible="{Binding HasCapturedImage, Converter={StaticResource InverseBoolConverter}}">

                <VerticalStackLayout
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="8">

                    <Label
                        Text="Camera preview"
                        FontSize="16"
                        TextColor="#CBD5E1"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Point the camera at an ingredient label"
                        FontSize="12"
                        TextColor="#94A3B8"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>

            <!-- Dark overlay: top -->
            <BoxView
                Grid.Row="0"
                Grid.ColumnSpan="3"
                BackgroundColor="#66000000" />

            <!-- Dark overlay: left -->
            <BoxView
                Grid.Row="1"
                Grid.Column="0"
                BackgroundColor="#66000000" />

            <!-- Dark overlay: right -->
            <BoxView
                Grid.Row="1"
                Grid.Column="2"
                BackgroundColor="#66000000" />

            <!-- Dark overlay: bottom -->
            <BoxView
                Grid.Row="2"
                Grid.ColumnSpan="3"
                BackgroundColor="#66000000" />

            <!-- Analysis status pill -->
            <Border
                Grid.Row="0"
                Grid.ColumnSpan="3"
                Margin="0,12,0,0"
                Padding="12,0"
                HeightRequest="40"
                BackgroundColor="White"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 20"
                HorizontalOptions="Center"
                VerticalOptions="Start">

                <Border.Shadow>
                    <Shadow
                        Brush="#55000000"
                        Offset="0,2"
                        Radius="8"
                        Opacity="0.35" />
                </Border.Shadow>

                <Grid
                    ColumnDefinitions="30,Auto"
                    ColumnSpacing="6"
                    VerticalOptions="Center">

                    <!-- Visible only while extraction is running -->
                    <core:SfBusyIndicator
                        Grid.Column="0"
                        HeightRequest="28"
                        WidthRequest="28"
                        SizeFactor="0.3"
                        IndicatorColor="#047857"
                        AnimationType="CircularMaterial"
                        IsRunning="{Binding IsExtracting}"
                        IsVisible="{Binding IsExtracting}" />

                    <!-- Visible only when extraction is not running -->
                    <Label
                        Grid.Column="0"
                        Text="{Binding AnalysisIcon}"
                        FontFamily="MaterialIconsRegular"
                        FontSize="18"
                        TextColor="#047857"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"
                        IsVisible="{Binding IsExtracting, Converter={StaticResource InverseBoolConverter}}" />

                    <!-- Dynamic status text -->
                    <Label
                        Grid.Column="1"
                        Text="Analyzing Ingredients"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="#374151"
                        VerticalTextAlignment="Center"
                        LineBreakMode="TailTruncation"
                        MaxLines="1" />
                </Grid>
            </Border>
        </Grid>

        <!-- Instructions -->
        <Border
            Grid.Row="2"
            Padding="20,18"
            BackgroundColor="#F3F4F6"
            Stroke="Transparent"
            StrokeShape="RoundRectangle 24,24,0,0">

            <Label
                Text="{Binding ScannerMessage}"
                FontSize="14"
                TextColor="#6B7280"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center"
                LineBreakMode="WordWrap" />
        </Border>

        <!-- Bottom controls -->
        <Grid
            Grid.Row="3"
            Padding="20,8,20,18"
            BackgroundColor="#F3F4F6"
            ColumnDefinitions="*,*,*">

            <!-- Gallery -->
            <buttons:SfButton
                Grid.Column="0"
                WidthRequest="48"
                HeightRequest="48"
                Text="{Binding GalleryIcon}"
                FontFamily="MaterialIconsRegular"
                FontSize="25"
                TextColor="#4B5563"
                Background="#E5E7EB"
                Stroke="Transparent"
                CornerRadius="24"
                Padding="0"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Command="{Binding PickImageCommand}"
                SemanticProperties.Description="Choose image from gallery" />

            <!-- Scan -->
            <Grid
                Grid.Column="1"
                WidthRequest="75"
                HeightRequest="75"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <Border
                    WidthRequest="75"
                    HeightRequest="75"
                    BackgroundColor="White"
                    Stroke="#047857"
                    StrokeThickness="3"
                    StrokeShape="RoundRectangle 38">

                    <Border.Shadow>
                        <Shadow
                            Brush="#66000000"
                            Offset="0,5"
                            Radius="12"
                            Opacity="0.65" />
                    </Border.Shadow>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding ScanCommand}" />
                    </Border.GestureRecognizers>

                    <Border
                        Margin="5"
                        BackgroundColor="#047857"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 32">

                        <Grid
                            RowDefinitions="*,Auto"
                            Padding="0,7,0,6">

                            <Label
                                Text="{Binding ScanIcon}"
                                FontFamily="MaterialIconsRegular"
                                FontSize="28"
                                TextColor="White"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />

                            <Label
                                Grid.Row="1"
                                Text="SCAN"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="White"
                                HorizontalTextAlignment="Center" />
                        </Grid>
                    </Border>
                </Border>
            </Grid>

            <!-- Flash -->
            <buttons:SfButton
                Grid.Column="2"
                WidthRequest="48"
                HeightRequest="48"
                Text="{Binding FlashIcon}"
                FontFamily="MaterialIconsRegular"
                FontSize="25"
                TextColor="#4B5563"
                Background="#E5E7EB"
                Stroke="Transparent"
                CornerRadius="24"
                Padding="0"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Command="{Binding ToggleFlashCommand}"
                SemanticProperties.Description="Toggle flash" />
        </Grid>
    </Grid>
</ContentPage>