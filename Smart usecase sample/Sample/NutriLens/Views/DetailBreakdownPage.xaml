<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:expander="clr-namespace:Syncfusion.Maui.Expander;assembly=Syncfusion.Maui.Expander"
    x:Class="NutriLens.Views.DetailBreakdownPage"
    BackgroundColor="{StaticResource BreakdownBackground}"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="56,*,Auto">

        <!-- Header -->
        <Grid
            Grid.Row="0"
            Style="{StaticResource BreakdownHeaderStyle}">

            <buttons:SfButton
                Grid.Column="0"
                Style="{StaticResource BreakdownBackButtonStyle}"
                Text="&#xE5E0;"
                Clicked="SfButton_Clicked" />

            <Label
                Grid.Column="1"
                Text="Scan Result"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="{StaticResource BreakdownHeaderText}"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center" />

            <buttons:SfButton
                Grid.Column="2"
                Style="{StaticResource BreakdownBackButtonStyle}"
                Background="#0B8E69"
                TextColor="White"
                Text="&#xE7FD;"
                CornerRadius="16" />
        </Grid>

        <!-- Main content -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="16,16,16,24"
                Spacing="16">

                <!-- Product summary (AI: ProductName, Score, Category) -->
                <Grid ColumnDefinitions="*,Auto">

                    <VerticalStackLayout Spacing="4">

                        <Label
                            Text="Detailed Breakdown"
                            FontSize="30"
                            FontAttributes="Bold"
                            TextColor="#0F172A" />

                        <Label
                            Text="{Binding ProductName}"
                            FontSize="14"
                            TextColor="#64748B" />
                    </VerticalStackLayout>

                    <!-- Overall score badge (AI: Score) -->
                    <Border
                        Grid.Column="1"
                        WidthRequest="50"
                        HeightRequest="50"
                        BackgroundColor="#E8FFF2"
                        Stroke="#10B981"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 25"
                        VerticalOptions="Center">

                        <Label
                            Text="{Binding Score}"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="#047857"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Status chips (AI: ConfidenceDisplay) -->
                <HorizontalStackLayout
                    Spacing="8">

                    <Border
                        Padding="10,7"
                        BackgroundColor="#E0F2FE"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 14">

                        <HorizontalStackLayout Spacing="5">
                            <Label
                                Text="&#xE935;"
                                Style="{StaticResource MaterialIconStyle}"
                                FontSize="14"
                                TextColor="#0369A1" />

                            <Label
                                Text="Scanned Today"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#0369A1" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border
                        Padding="10,7"
                        BackgroundColor="#E8FFF2"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 14">

                        <HorizontalStackLayout Spacing="5">
                            <Label
                                Text="&#xE8E8;"
                                Style="{StaticResource MaterialIconStyle}"
                                FontSize="14"
                                TextColor="#15803D" />

                            <Label
                                Text="{Binding ConfidenceDisplay}"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#15803D" />
                        </HorizontalStackLayout>
                    </Border>
                </HorizontalStackLayout>

                <!-- Nutrition facts (AI: Nutrition.*) -->
                <Border
                    Style="{StaticResource BreakdownCardStyle}">

                    <VerticalStackLayout Spacing="14">

                        <HorizontalStackLayout Spacing="8">
                            <Label
                                Text="&#xE56C;"
                                Style="{StaticResource MaterialIconStyle}"
                                FontSize="22" />

                            <Label
                                Text="Nutrition Facts"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="#0F172A" />
                        </HorizontalStackLayout>

                        <Grid
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto"
                            RowSpacing="6">

                            <Label
                                Text="Serving Size"
                                FontSize="13"
                                TextColor="#64748B" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding Nutrition.ServingSize}"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#0F172A" />

                            <Label
                                Grid.Row="1"
                                Text="Servings Per Container"
                                FontSize="13"
                                TextColor="#64748B" />

                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding Nutrition.ServingsPerContainer}"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#0F172A" />
                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            Color="#E5E7EB" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Text="Calories"
                                FontSize="14"
                                TextColor="#64748B"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding Nutrition.CaloriesDisplay}"
                                FontSize="40"
                                FontAttributes="Bold"
                                TextColor="#111827" />
                        </Grid>

                        <!-- Total fat (AI) -->
                        <Grid RowDefinitions="Auto,5" RowSpacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    Text="{Binding Nutrition.TotalFatLabel}"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="#0F172A" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Nutrition.TotalFatDv}"
                                    FontSize="12"
                                    TextColor="#64748B" />
                            </Grid>

                            <ProgressBar
                                Grid.Row="1"
                                Progress="{Binding Nutrition.TotalFatProgress}"
                                ProgressColor="#F59E0B"
                                BackgroundColor="#FEF3C7" />
                        </Grid>

                        <!-- Saturated fat (AI) -->
                        <Grid RowDefinitions="Auto,5" RowSpacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    Text="{Binding Nutrition.SaturatedFatLabel}"
                                    FontSize="13"
                                    TextColor="#475569" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Nutrition.SaturatedFatDv}"
                                    FontSize="12"
                                    TextColor="#64748B" />
                            </Grid>

                            <ProgressBar
                                Grid.Row="1"
                                Progress="{Binding Nutrition.SaturatedFatProgress}"
                                ProgressColor="#FDBA74"
                                BackgroundColor="#FFEDD5" />
                        </Grid>

                        <!-- Sodium (AI) -->
                        <Grid RowDefinitions="Auto,5" RowSpacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    Text="{Binding Nutrition.SodiumLabel}"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="#DC2626" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Nutrition.SodiumDv}"
                                    FontSize="12"
                                    TextColor="#64748B" />
                            </Grid>

                            <ProgressBar
                                Grid.Row="1"
                                Progress="{Binding Nutrition.SodiumProgress}"
                                ProgressColor="#EF4444"
                                BackgroundColor="#FEE2E2" />
                        </Grid>

                        <!-- Carbohydrates (AI) -->
                        <Grid RowDefinitions="Auto,5" RowSpacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    Text="{Binding Nutrition.CarbohydratesLabel}"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="#0F172A" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Nutrition.CarbohydratesDv}"
                                    FontSize="12"
                                    TextColor="#64748B" />
                            </Grid>

                            <ProgressBar
                                Grid.Row="1"
                                Progress="{Binding Nutrition.CarbohydratesProgress}"
                                ProgressColor="#10B981"
                                BackgroundColor="#D1FAE5" />
                        </Grid>

                        <!-- Sugars (AI) -->
                        <Grid RowDefinitions="Auto,Auto,5" RowSpacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    Text="{Binding Nutrition.SugarsLabel}"
                                    FontSize="13"
                                    TextColor="#475569" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Nutrition.SugarsDv}"
                                    FontSize="12"
                                    TextColor="#64748B" />
                            </Grid>

                            <Label
                                Grid.Row="1"
                                Text="{Binding Nutrition.AddedSugarsNote}"
                                FontSize="12"
                                TextColor="#64748B" />

                            <ProgressBar
                                Grid.Row="2"
                                Progress="{Binding Nutrition.SugarsProgress}"
                                ProgressColor="#FBBF24"
                                BackgroundColor="#FEF3C7" />
                        </Grid>

                        <!-- Protein (AI) -->
                        <Grid RowDefinitions="Auto,5" RowSpacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    Text="{Binding Nutrition.ProteinLabel}"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="#0F172A" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Nutrition.ProteinDv}"
                                    FontSize="12"
                                    TextColor="#64748B" />
                            </Grid>

                            <ProgressBar
                                Grid.Row="1"
                                Progress="{Binding Nutrition.ProteinProgress}"
                                ProgressColor="#3B82F6"
                                BackgroundColor="#DBEAFE" />
                        </Grid>

                        <Label
                            Text="* The % Daily Value (DV) tells you how much of a nutrient in a serving of food contributes to a daily diet."
                            FontSize="10"
                            TextColor="#6B7280"
                            LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- Score factors heading -->
                <HorizontalStackLayout
                    Spacing="8"
                    Margin="0,4,0,0">

                    <Label
                        Text="&#xE8E5;"
                        Style="{StaticResource MaterialIconStyle}"
                        FontSize="24" />

                    <Label
                        Text="Score Factors"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="#0F172A" />
                </HorizontalStackLayout>

                <!-- Positive factor (AI: PositiveAttributes) -->
                <Border
                    BackgroundColor="#DDF5EE"
                    Style="{StaticResource FactorCardStyle}">

                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="10">

                        <Label
                            Text="&#xE147;"
                            Style="{StaticResource MaterialIconStyle}"
                            FontSize="24"
                            TextColor="#0E7C57" />

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="5">

                            <Label
                                Text="{Binding BenefitTitle}"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="#0E7C57" />

                            <Label
                                Text="{Binding BenefitDescription}"
                                Style="{StaticResource BodyTextStyle}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Warning factor (AI: NegativeAttributes + Allergens) -->
                <Border
                    BackgroundColor="#FFE4E4"
                    Style="{StaticResource FactorCardStyle}">

                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="10">

                        <Label
                            Text="&#xE15D;"
                            Style="{StaticResource MaterialIconStyle}"
                            FontSize="24"
                            TextColor="#DC2626" />

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="5">

                            <Label
                                Text="{Binding ConcernTitle}"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="#DC2626" />

                            <Label
                                Text="{Binding ConcernDescription}"
                                Style="{StaticResource BodyTextStyle}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Information factor (AI: ScoreExplanation — why the score is what it is) -->
                <Border
                    BackgroundColor="#EAF1FF"
                    Style="{StaticResource FactorCardStyle}">

                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="10">

                        <Label
                            Text="&#xE88E;"
                            Style="{StaticResource MaterialIconStyle}"
                            FontSize="24"
                            TextColor="#2563EB" />

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="5">

                            <Label
                                Text="{Binding InfoTitle}"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="#2563EB" />

                            <Label
                                Text="{Binding InfoDescription}"
                                Style="{StaticResource BodyTextStyle}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Full ingredients heading -->
                <HorizontalStackLayout
                    Spacing="8"
                    Margin="0,8,0,0">

                    <Label
                        Text="&#xE873;"
                        Style="{StaticResource MaterialIconStyle}"
                        FontSize="24" />

                    <Label
                        Text="Full Ingredients"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="#0F172A" />
                </HorizontalStackLayout>

                <!-- Full ingredients (AI: FullIngredients / ExtractedText) -->
                <Border
                    Padding="16"
                    BackgroundColor="White"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 12">

                    <Label
                        Text="{Binding FullIngredientsDisplay}"
                        FontFamily="Courier New"
                        FontSize="13"
                        TextColor="#374151" />
                </Border>

                <!-- Additive breakdown heading -->
                <Label
                    Text="Additive Breakdown"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#0F172A"
                    Margin="0,8,0,0" />

                <!-- Additive breakdown (AI: Additives + Preservatives expanders) -->
                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding BreakdownAdditives}"
                    Spacing="0">

                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border
                                BackgroundColor="White"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 12"
                                Padding="0"
                                Margin="0,0,0,10">

                                <expander:SfExpander
                                    BackgroundColor="White"
                                    HeaderIconColor="#047857"
                                    IsExpanded="False"
                                    AnimationDuration="200">

                                    <expander:SfExpander.Header>
                                        <Grid
                                            HeightRequest="52"
                                            Padding="14,0"
                                            ColumnDefinitions="Auto,*,Auto"
                                            BackgroundColor="White">

                                            <Label
                                                Text="&#xEA4B;"
                                                FontFamily="MaterialIconsRegular"
                                                FontSize="20"
                                                TextColor="#047857"
                                                HorizontalTextAlignment="Center"
                                                VerticalTextAlignment="Center" />

                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding Name}"
                                                Margin="10,0,0,0"
                                                FontSize="15"
                                                FontAttributes="Bold"
                                                TextColor="#0F172A"
                                                VerticalTextAlignment="Center" />
                                        </Grid>
                                    </expander:SfExpander.Header>

                                    <expander:SfExpander.Content>
                                        <Grid
                                            Padding="16"
                                            BackgroundColor="White">

                                            <VerticalStackLayout Spacing="8">

                                                <Label
                                                    Text="{Binding PurposeDisplay}"
                                                    Style="{StaticResource BodyTextStyle}"
                                                    BackgroundColor="White" />

                                                <Label
                                                    Text="{Binding SafetyDisplay}"
                                                    Style="{StaticResource BodyTextStyle}"
                                                    BackgroundColor="White" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </expander:SfExpander.Content>
                                </expander:SfExpander>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Reference -->
                <Border
                    Padding="14"
                    BackgroundColor="#EEF4FF"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 12">

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">

                        <Label
                            Text="&#xE02F;"
                            Style="{StaticResource MaterialIconStyle}"
                            FontSize="22"
                            TextColor="#2563EB" />

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="2">

                            <Label
                                Text="Reference:"
                                FontSize="12"
                                TextColor="#64748B" />

                            <Label
                                Text="WHO Food Additive Database"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#1E3A8A" />
                        </VerticalStackLayout>

                        <Label
                            Grid.Column="2"
                            Text="&#xE89E;"
                            Style="{StaticResource MaterialIconStyle}"
                            FontSize="20"
                            TextColor="#2563EB"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Bottom Save Result button -->
                <Border
                    Margin="16,8,16,16"
                    HeightRequest="56"
                    BackgroundColor="#047857"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 28"
                    HorizontalOptions="Fill">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="OnSaveResultTapped" />
                    </Border.GestureRecognizers>

                    <Grid
                        ColumnDefinitions="Auto,Auto"
                        ColumnSpacing="8"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Label
                            Text="&#xE866;"
                            FontFamily="MaterialIconsRegular"
                            FontSize="21"
                            TextColor="White"
                            VerticalTextAlignment="Center" />

                        <Label
                            Grid.Column="1"
                            Text="Save Result"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="White"
                            VerticalTextAlignment="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>