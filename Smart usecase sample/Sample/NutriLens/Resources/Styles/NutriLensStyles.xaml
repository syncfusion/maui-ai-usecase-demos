<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons">

    <!-- ===== Brand palette ===== -->
    <Color x:Key="BrandPrimary">#0E7C57</Color>
    <Color x:Key="BrandPrimaryHover">#0A6444</Color>
    <Color x:Key="Surface">#F5F7F6</Color>
    <Color x:Key="Card">#FFFFFF</Color>
    <Color x:Key="InsightBg">#EAF3EE</Color>
    <Color x:Key="Amber">#E0A33B</Color>
    <Color x:Key="AmberHover">#C9912F</Color>
    <Color x:Key="Danger">#E04B4B</Color>
    <Color x:Key="DangerSoft">#FCE6E6</Color>
    <Color x:Key="AmberSoft">#FFF1D9</Color>
    <Color x:Key="TextPrimary">#1A1A1A</Color>
    <Color x:Key="TextSecondary">#6B7280</Color>
    <Color x:Key="TextMuted">#9CA3AF</Color>

    <!-- ===== CornerRadius tokens ===== -->
    <CornerRadius x:Key="RadiusMd">14</CornerRadius>
    <CornerRadius x:Key="RadiusLg">16</CornerRadius>
    <CornerRadius x:Key="RadiusPill">28</CornerRadius>

    <!-- Primary SfButton (filled) — hover via VSM PointerOver state -->
    <Style x:Key="PrimaryButton" TargetType="buttons:SfButton">
        <Setter Property="BackgroundColor" Value="{StaticResource Card}"/>
        <Setter Property="Background" Value="{StaticResource BrandPrimary}"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
        <Setter Property="Stroke" Value="Transparent"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="EnableRippleEffect" Value="True"/>
        <Setter Property="HeightRequest" Value="48"/>
        <Setter Property="FontFamily" Value="OpenSansSemibold"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup Name="CommonStates">
                    <VisualState Name="Normal"/>
                    <VisualState Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="{StaticResource BrandPrimaryHover}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="{StaticResource BrandPrimaryHover}"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Outline SfButton (secondary) — hover swaps border + fill -->
    <Style x:Key="OutlineButton" TargetType="buttons:SfButton">
        <Setter Property="Background" Value="{StaticResource Card}"/>
        <Setter Property="TextColor" Value="{StaticResource BrandPrimary}"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
        <Setter Property="Stroke" Value="{StaticResource BrandPrimary}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="EnableRippleEffect" Value="True"/>
        <Setter Property="HeightRequest" Value="48"/>
        <Setter Property="FontFamily" Value="OpenSansSemibold"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup Name="CommonStates">
                    <VisualState Name="Normal"/>
                    <VisualState Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="{StaticResource InsightBg}"/>
                            <Setter Property="Stroke" Value="{StaticResource BrandPrimaryHover}"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Circular FAB SfButton — hover darkens background -->
    <Style x:Key="FabPrimary" TargetType="buttons:SfButton">
        <Setter Property="Background" Value="{StaticResource BrandPrimary}"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
        <Setter Property="Stroke" Value="White"/>
        <Setter Property="StrokeThickness" Value="4"/>
        <Setter Property="EnableRippleEffect" Value="True"/>
        <Setter Property="HeightRequest" Value="60"/>
        <Setter Property="WidthRequest" Value="60"/>
        <Setter Property="FontFamily" Value="OpenSansSemibold"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup Name="CommonStates">
                    <VisualState Name="Normal"/>
                    <VisualState Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="{StaticResource BrandPrimaryHover}"/>
                            <Setter Property="Stroke" Value="#D8ECE3"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Amber filled (for "MODERATE" CTAs) -->
    <Style x:Key="AmberButton" TargetType="buttons:SfButton">
        <Setter Property="Background" Value="{StaticResource Amber}"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
        <Setter Property="Stroke" Value="Transparent"/>
        <Setter Property="EnableRippleEffect" Value="True"/>
        <Setter Property="HeightRequest" Value="48"/>
        <Setter Property="FontFamily" Value="OpenSansSemibold"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup Name="CommonStates">
                    <VisualState Name="Normal"/>
                    <VisualState Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="{StaticResource AmberHover}"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

</ResourceDictionary>