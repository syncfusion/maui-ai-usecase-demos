<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:picker="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    xmlns:viewmodels="clr-namespace:SmartAIDatePicker.ViewModels"
    x:DataType="viewmodels:DatePickerViewModel"
    x:Class="SmartAIDatePicker.MainPage">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Margin="0,40,0,0"
            VerticalOptions="Start"
            Spacing="24">

            <Label
                Text="AI-Powered Smart Date Selection"
                FontSize="18"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="{StaticResource Black}" />

            <!-- Input -->

                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="8"
                    HeightRequest="56">

                <Editor
                        x:Name="DateRequestEditor"
                        Placeholder="{Binding Placeholder}"
                        Text="{Binding DateRequest, Mode=TwoWay}"
                        IsEnabled="{Binding IsEditorEnabled}"
                        AutoSize="Disabled"
                        HeightRequest="54"
                        VerticalOptions="Center"
                        VerticalTextAlignment="Center"
                        BackgroundColor="Transparent"
                        PlaceholderColor="Gray"
                        TextColor="{StaticResource PrimaryDarkText}"
                        FontSize="14" >
                </Editor>

                <Border
                        Grid.Column="1"
                        x:Name="SearchButtonBorder"
                        BackgroundColor="{Binding SearchButtonBackgroundColor}"
                        Opacity="{Binding SearchButtonOpacity}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SearchCommand}" />
                        </Border.GestureRecognizers>

                        <Grid WidthRequest="56"
                              HeightRequest="56">

                            <Label
                                x:Name="SearchButton"
                                Text="&#xE65F;"
                                IsVisible="{Binding IsSearchIconVisible}"
                                FontFamily="MaterialIcons"
                                FontSize="22"
                                TextColor="White"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />

                            <ActivityIndicator
                                x:Name="LoadingIndicator"
                                IsVisible="{Binding IsLoadingVisible}"
                                IsRunning="{Binding IsLoadingVisible}"
                                Color="White"
                                VerticalOptions="Center"
                                HorizontalOptions="Center" />
                        </Grid>

                    </Border>

                </Grid>

            <Grid
                WidthRequest="320"
                HeightRequest="290"
                HorizontalOptions="Fill">

                <picker:SfDatePicker
                    x:Name="DatePicker"
                    IsEnabled="{Binding IsPickerEnabled}"
                    SelectedDate="{Binding PickerDate, Mode=TwoWay}"
                    MinimumDate="{Binding MinimumDate}"
                    MaximumDate="{Binding MaximumDate}"
                    BlackoutDates="{Binding BlackoutDates}"
                    DayInterval="{Binding DayInterval}"
                    MonthInterval="{Binding MonthInterval}"
                    YearInterval="{Binding YearInterval}"
                    EnableLooping="{Binding EnableLooping}"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    Format="{Binding DateFormat}">

                    <picker:SfDatePicker.HeaderView>
                        <picker:PickerHeaderView
                            Text="Select Date"
                            Height="44" />
                    </picker:SfDatePicker.HeaderView>

                </picker:SfDatePicker>

                <Border
                    IsVisible="{Binding IsBusy}"
                    BackgroundColor="#BFFFFFFF"
                    StrokeThickness="0"
                    InputTransparent="False"
                    ZIndex="1">

                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="8">

                        <ActivityIndicator
                            IsRunning="True"
                            Color="{StaticResource SearchButtonPurple}"
                            WidthRequest="32"
                            HeightRequest="32" />

                        <Label
                            Text="Updating date picker..."
                            TextColor="{StaticResource PrimaryDarkText}"
                            FontSize="13"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </Border>

            </Grid>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>