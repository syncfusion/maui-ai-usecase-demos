<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Todo.Features.Notes.ViewModels"
             xmlns:views="clr-namespace:Todo.Features.Notes.Views"
             xmlns:commonviews="clr-namespace:Todo.Features.Common.Views"
             x:Class="Todo.Features.Notes.Views.MainLayoutView"
             x:DataType="vm:NotesListViewModel">

    <!--
        Module-08 task 8-1 (responsive layout pass):
        - The grid has TWO columns: the sidebar on the left and the
          main content on the right. The sidebar column collapses to
          0 on Phone (matches collapsed.png) and stays at 220 on
          Tablet/Desktop (matches the expanded sidebar in
          mynotes.png). The hamburger button in the header can still
          toggle the column manually on any device.
    -->
    <Grid x:Name="RootGrid"
          Margin="0,10,0,0"
          RowDefinitions="48,*"
          ColumnDefinitions="{OnIdiom Phone='0,*', Default='220,*'}"
          BackgroundColor="{StaticResource BackgroundColor}">

        <!-- Shared application header (spans both columns) -->
        <views:HeaderView x:Name="Header"
                          Grid.Row="0"
                          Grid.ColumnSpan="2" />

        <!-- Sidebar (hides on Phone per collapsed.png) -->
        <views:SidebarView x:Name="Sidebar"
                           Grid.Row="1"
                           Grid.Column="0" />

        <!-- Main content area (consumes the freed space when sidebar collapses) -->
        <ContentView x:Name="MainContent"
                     Grid.Row="1"
                     Grid.Column="1" />

        <!-- Profile menu overlay: positioned at the top-right and
             toggled on demand. The grid sits above the content so the
             dim background catches taps to dismiss the menu. -->
        <Grid x:Name="ProfileOverlay"
              Grid.RowSpan="2"
              Grid.ColumnSpan="2"
              IsVisible="False"
              BackgroundColor="Transparent">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnProfileOverlayTapped" />
            </Grid.GestureRecognizers>
            <ContentView x:Name="ProfileMenuHost"
                         HorizontalOptions="End"
                         VerticalOptions="Start"
                         Margin="0,52,16,0" />
        </Grid>

        <!-- Snackbar-style toast at the bottom of the screen. -->
        <commonviews:ToastView x:Name="Toast"
                               Grid.RowSpan="2"
                               Grid.ColumnSpan="2"
                               HorizontalOptions="Center"
                               VerticalOptions="End" />
    </Grid>

</ContentView>
