<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Todo.Features.Notes.ViewModels"
             xmlns:custmodels="clr-namespace:Todo.Features.CustomLists.Models"
             xmlns:common="clr-namespace:Todo.Common"
             xmlns:conv="clr-namespace:Todo.Converters"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             x:Class="Todo.Features.Notes.Views.SidebarView"
             x:Name="SidebarRoot"
             x:DataType="vm:NotesListViewModel"
             BackgroundColor="{StaticResource SidebarBackgroundColor}">

    <Grid RowDefinitions="*,Auto"
          Padding="0,12,0,16">

        <!-- Scrollable sidebar contents: built-in categories + custom lists -->
        <ScrollView Grid.Row="0"
                    VerticalOptions="Fill"
                    VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="4">

                <!-- Built-in entries (My Notes, Important, Reminder, Bin) -->
                <CollectionView ItemsSource="{Binding AvailableCategories}"
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedCategory, Mode=TwoWay, Converter={StaticResource ObjectToCategoryConverter}}"
                                BackgroundColor="Transparent"
                                SelectionChanged="OnSidebarSelectionChanged">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="common:NotesListCategory">
                            <Border Margin="10,2"
                                    Padding="14,0"
                                    BackgroundColor="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    HeightRequest="44">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <!-- Module-07 task 7-2: the sidebar entry
                                     can receive a drop from the note list
                                     to move the note into this category. -->
                                <Border.GestureRecognizers>
                                    <DropGestureRecognizer
                                        AllowDrop="True"
                                        DragOver="OnSidebarDragOver"
                                        DragLeave="OnSidebarDragLeave"
                                        Drop="OnSidebarDrop" />
                                </Border.GestureRecognizers>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{StaticResource InputPillBackgroundColor}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{StaticResource SidebarSelectionColor}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="14"
                                      VerticalOptions="Center">
                                    <syncfusion:SfButton Grid.Column="0"
                                                         Style="{StaticResource IconSfButtonStyle}"
                                                         FontSize="20"
                                                         VerticalOptions="Center"
                                                         WidthRequest="32"
                                                         HeightRequest="32"
                                                         Padding="0"
                                                         IsEnabled="False"
                                                         TextColor="{Binding ., Converter={StaticResource CategoryToColorConverter}}">
                                        <syncfusion:SfButton.Triggers>
                                            <DataTrigger TargetType="syncfusion:SfButton" Binding="{Binding .}" Value="{x:Static common:NotesListCategory.MyNotes}">
                                                <Setter Property="ImageSource" Value="profileicon.png" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="syncfusion:SfButton" Binding="{Binding .}" Value="{x:Static common:NotesListCategory.Important}">
                                                <Setter Property="ImageSource" Value="importanticon.png" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="syncfusion:SfButton" Binding="{Binding .}" Value="{x:Static common:NotesListCategory.Reminder}">
                                                <Setter Property="ImageSource" Value="belliconsidebar.png" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="syncfusion:SfButton" Binding="{Binding .}" Value="{x:Static common:NotesListCategory.Bin}">
                                                <Setter Property="ImageSource" Value="binicon.png" />
                                            </DataTrigger>
                                        </syncfusion:SfButton.Triggers>
                                    </syncfusion:SfButton>

                                    <Label Grid.Column="1"
                                           Text="{Binding ., Converter={StaticResource EnumDisplayNameConverter}, FallbackValue=''}"
                                           Style="{StaticResource SidebarItemLabelStyle}"
                                           IsVisible="{Binding Source={x:Reference SidebarRoot}, Path=BindingContext.IsSidebarCollapsed, Converter={StaticResource InvertedBoolConverter}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- "Lists" section header (only shown when there are
                     custom lists AND the sidebar is expanded). -->
                <Label Text="Lists"
                       Style="{StaticResource SidebarSectionHeaderStyle}"
                       IsVisible="{Binding Source={x:Reference SidebarRoot}, Path=BindingContext.HasCustomLists}" />

                <!-- "No lists found" empty state shown when the custom
                     lists region has zero entries. -->
                <Label Text="No lists found"
                       FontSize="12"
                       FontAttributes="Italic"
                       TextColor="{StaticResource TextSecondaryColor}"
                       HorizontalOptions="Center"
                       Margin="0,8"
                       IsVisible="{Binding Source={x:Reference SidebarRoot}, Path=BindingContext.HasCustomLists, Converter={StaticResource InvertedBoolConverter}}" />

                <!-- Custom (user-defined) lists -->
                <CollectionView x:Name="CustomListsView"
                                ItemsSource="{Binding CustomLists}"
                                SelectionMode="Single"
                                BackgroundColor="Transparent"
                                SelectionChanged="OnCustomListSelectionChanged">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="custmodels:NoteList">
                            <Border Margin="10,2"
                                    Padding="14,0"
                                    BackgroundColor="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    HeightRequest="44">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <!-- Module-07 task 7-2: drop from note list
                                     moves the note into THIS list. -->
                                <Border.GestureRecognizers>
                                    <DropGestureRecognizer
                                        AllowDrop="True"
                                        DragOver="OnCustomListDragOver"
                                        DragLeave="OnCustomListDragLeave"
                                        Drop="OnCustomListDrop" />
                                </Border.GestureRecognizers>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{StaticResource InputPillBackgroundColor}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{StaticResource SidebarSelectionColor}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="8"
                                      VerticalOptions="Center">
                                    <!-- List icon (notesicon.png) -->
                                    <syncfusion:SfButton Grid.Column="0"
                                                         ImageSource="notesicon.png"
                                                         Style="{StaticResource IconSfButtonStyle}"
                                                         FontSize="16"
                                                         Background="Transparent"
                                                         WidthRequest="32"
                                                         HeightRequest="32"
                                                         Padding="0"
                                                         StrokeThickness="0"
                                                         IsEnabled="False" />

                                    <!-- List name. A long-press starts a
                                         drag so the user can reorder
                                         the sidebar lists. Right-click
                                         shows the context menu. -->
                                    <Label Grid.Column="1"
                                           Text="{Binding Name}"
                                           Style="{StaticResource SidebarItemLabelStyle}"
                                           LineBreakMode="TailTruncation"
                                           IsVisible="{Binding Source={x:Reference SidebarRoot}, Path=BindingContext.IsSidebarCollapsed, Converter={StaticResource InvertedBoolConverter}}">
                                        <Label.GestureRecognizers>
                                            <DragGestureRecognizer
                                                CanDrag="True"
                                                DragStarting="OnCustomListDragStarting"
                                                DropCompleted="OnCustomListDropCompleted" />
                                            <!-- Right-click on Windows /
                                                 desktop shows the list
                                                 context menu. PointerEventArgs
                                                 is the standard MAUI
                                                 argument for this event. -->
                                            <PointerGestureRecognizer
                                                ButtonPressed="OnCustomListRightTapped" />
                                        </Label.GestureRecognizers>
                                    </Label>

                                    <!-- Per-list "more" menu (rename / delete) -->
                                    <syncfusion:SfButton Grid.Column="2"
                                                         Text="&#8943;"
                                                         Style="{StaticResource IconSfButtonStyle}"
                                                         FontSize="18"
                                                         Rotation="90"
                                                         WidthRequest="32"
                                                         HeightRequest="32"
                                                         Padding="0"
                                                         StrokeThickness="0"
                                                         Background="Transparent"
                                                         TextColor="{StaticResource TextSecondaryColor}"
                                                         Command="{Binding Source={x:Reference SidebarRoot}, Path=BindingContext.ShowListMenuCommand}"
                                                         CommandParameter="{Binding .}"
                                                         SemanticProperties.Description="More list options" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- "+" button to create a new list (Module-05 task 5-2) -->
        <syncfusion:SfButton Grid.Row="1"
                             Text="&#65291;"
                             Style="{StaticResource FabSfButtonStyle}"
                             FontSize="26"
                             WidthRequest="52"
                             HeightRequest="52"
                             StrokeThickness="0"
                             Padding="0"
                             Margin="16,12,0,0"
                             HorizontalOptions="End"
                             BackgroundColor="{StaticResource PrimaryColor}"
                             TextColor="{StaticResource OnPrimaryColor}"
                             Command="{Binding OpenCreateListDialogCommand}"
                             SemanticProperties.Description="Create a to-do list" />
    </Grid>

</ContentView>
