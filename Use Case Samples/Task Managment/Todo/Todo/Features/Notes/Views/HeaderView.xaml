<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Todo.Features.Notes.ViewModels"
             x:Class="Todo.Features.Notes.Views.HeaderView"
             x:DataType="vm:NotesListViewModel">

    <Grid HeightRequest="{StaticResource HeaderHeight}"
          Padding="8,0,16,0"
          ColumnDefinitions="Auto,*,Auto"
          BackgroundColor="{StaticResource SurfaceColor}">
        <Grid.Shadow>
            <Shadow Brush="#10000000" Radius="4" Offset="0,1" Opacity="0.10" />
        </Grid.Shadow>

        <HorizontalStackLayout Grid.Column="0"
                               Spacing="4"
                               VerticalOptions="Center">
            <!-- Hamburger menu: collapses / expands the sidebar.
                 Module-08 task 8-2: 48x48 touch target per the spec. -->
            <Button ImageSource="humburger.png"
                    FontSize="20"
                    WidthRequest="48"
                    HeightRequest="48"
                    Padding="0"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource TextSecondaryColor}"
                    Command="{Binding ToggleSidebarCommand}"
                    SemanticProperties.Description="Toggle navigation menu" />
            <Label Text="To Do List"
                   FontSize="17"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimaryColor}"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>

        <!-- Search pill -->
        <Border Grid.Column="1"
                WidthRequest="{OnIdiom Phone=180, Default=360}"
                HeightRequest="36"
                Padding="12,0"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="{StaticResource InputPillBackgroundColor}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 18">
            <Grid ColumnDefinitions="*,Auto">
                <!--
                    The entry is read-only because the actual search UI
                    lives in SearchResultsPage. We still want a tap anywhere
                    on the pill to open that page, so the parent Grid
                    carries a TapGestureRecognizer. The trailing search
                    icon button is kept as a redundant affordance for
                    screen readers and pointer users.
                -->
                <Entry Placeholder="Search"
                       FontSize="14"
                       TextColor="{StaticResource TextPrimaryColor}"
                       PlaceholderColor="{StaticResource TextSecondaryColor}"
                       IsReadOnly="True"
                       Focused="OnSearchEntryFocused"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        ImageSource="search.png"
                        FontSize="15" Background="Transparent"
                        TextColor="{StaticResource TextSecondaryColor}"
                        Command="{Binding OpenSearchCommand}"
                        SemanticProperties.Description="Search notes"
                        VerticalOptions="Center" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenSearchCommand}" />
                </Grid.GestureRecognizers>
            </Grid>
        </Border>

        <!--
            Static avatar shown in the header per the design (mynotes.png).
            Not interactive — profile pages are explicitly out of scope, so
            the avatar is decorative. We mark it as ignored by accessibility
            so a screen reader doesn't announce a non-actionable "Profile"
            control.
        -->
        <Border Grid.Column="2"
                WidthRequest="34"
                HeightRequest="34"
                Padding="0"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 17"
                VerticalOptions="Center">
            <Image Source="profile.png"
                   Aspect="AspectFill"
                   SemanticProperties.Description="User avatar" />
        </Border>
    </Grid>

</ContentView>
