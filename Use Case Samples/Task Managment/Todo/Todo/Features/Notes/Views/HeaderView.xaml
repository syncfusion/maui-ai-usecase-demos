<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Todo.Features.Notes.ViewModels"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:syncfusionCore="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             x:Class="Todo.Features.Notes.Views.HeaderView"
             x:DataType="vm:NotesListViewModel">

    <Grid HeightRequest="{StaticResource HeaderHeight}"
          Padding="8,0,16,0"
          ColumnDefinitions="Auto,*,Auto"
          BackgroundColor="{StaticResource SurfaceColor}">
        <Grid.Shadow>
            <Shadow Brush="#10000000" Radius="4" Offset="0,1" Opacity="0.10" />
        </Grid.Shadow>

        <HorizontalStackLayout Grid.Column="0"
                               Spacing="4"
                               VerticalOptions="Center">
            <!-- Hamburger menu: collapses / expands the sidebar.
                 Syncfusion SfButton with a transparent icon style for hover. -->
            <syncfusion:SfButton ImageSource="humburger.png"
                                 Style="{StaticResource IconSfButtonStyle}"
                                 WidthRequest="44"
                                 HeightRequest="44"
                                 FontSize="20"
                                 StrokeThickness="0"
                                 Command="{Binding ToggleSidebarCommand}"
                                 SemanticProperties.Description="Toggle navigation menu" />
            <Label Text="To Do List"
                   FontSize="17"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimaryColor}"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>

        <!-- Search pill - styled to match the mynotes.png header reference. -->
        <syncfusionCore:SfTextInputLayout Grid.Column="1"
                                         ContainerType="None"
                                         Hint="Search"
                                         ShowHint="False"
                                         ReserveSpaceForAssistiveLabels="False"
                                         InputViewPadding="0"
                                         BackgroundColor="{StaticResource InputPillBackgroundColor}"
                                         OutlineCornerRadius="18"
                                         WidthRequest="{OnIdiom Phone=180, Default=360}"
                                         HeightRequest="36"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
            <Grid ColumnDefinitions="*,Auto">
                <Entry Placeholder="Search"
                       FontSize="14"
                       TextColor="{StaticResource TextPrimaryColor}"
                       PlaceholderColor="{StaticResource TextSecondaryColor}"
                       IsReadOnly="True"
                       Focused="OnSearchEntryFocused"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center" />
                <syncfusion:SfButton Grid.Column="1"
                                     ImageSource="search.png"
                                     Style="{StaticResource IconSfButtonStyle}"
                                     FontSize="15"
                                     StrokeThickness="0"
                                     Background="Transparent"
                                     TextColor="{StaticResource TextSecondaryColor}"
                                     Command="{Binding OpenSearchCommand}"
                                     SemanticProperties.Description="Search notes"
                                     VerticalOptions="Center" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenSearchCommand}" />
                </Grid.GestureRecognizers>
            </Grid>
        </syncfusionCore:SfTextInputLayout>

        <!--
            Profile avatar - shows a dropdown profile menu (Hi John, account
            options) when tapped. The border is wrapped in a tap recognizer
            so the entire pill behaves like a button.
        -->
        <Grid Grid.Column="2" VerticalOptions="Center">
            <Border WidthRequest="36"
                    HeightRequest="36"
                    Padding="0"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18"
                    BackgroundColor="{StaticResource InputPillBackgroundColor}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <Image Source="profile.png"
                       Aspect="AspectFill"
                       SemanticProperties.Description="User avatar" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProfileTapped" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>
    </Grid>

</ContentView>
