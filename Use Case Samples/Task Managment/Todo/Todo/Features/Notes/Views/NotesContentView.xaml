<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Todo.Features.Notes.ViewModels"
             xmlns:models="clr-namespace:Todo.Features.Notes.Models"
             xmlns:common="clr-namespace:Todo.Common"
             xmlns:conv="clr-namespace:Todo.Converters"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:syncfusionCore="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:syncfusionButtons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:syncfusionExpander="clr-namespace:Syncfusion.Maui.Expander;assembly=Syncfusion.Maui.Expander"
             x:Class="Todo.Features.Notes.Views.NotesContentView"
             x:Name="NotesContentRoot"
             x:DataType="vm:NotesListViewModel"
             Padding="16">

    <ContentView.Resources>
        <ResourceDictionary>
            <conv:MultiplyByConverter x:Key="MultiplyByConverter" />
            <conv:DragStateColorConverter x:Key="DragStateColorConverter" />
            <conv:RepeatTypeToGlyphConverter x:Key="RepeatTypeToGlyphConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <Border BackgroundColor="{StaticResource BackgroundColor}"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 14">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Background image for the active category -->
            <Image Grid.RowSpan="3"
                   Aspect="AspectFill"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill">
                <Image.Triggers>
                    <DataTrigger TargetType="Image" Binding="{Binding SelectedCategory}" Value="{x:Static common:NotesListCategory.MyNotes}">
                        <Setter Property="Source" Value="mynotes_bg.png" />
                    </DataTrigger>
                    <DataTrigger TargetType="Image" Binding="{Binding SelectedCategory}" Value="{x:Static common:NotesListCategory.Important}">
                        <Setter Property="Source" Value="important_bg.png" />
                    </DataTrigger>
                    <DataTrigger TargetType="Image" Binding="{Binding SelectedCategory}" Value="{x:Static common:NotesListCategory.Reminder}">
                        <Setter Property="Source" Value="remainder_bg.png" />
                    </DataTrigger>
                    <DataTrigger TargetType="Image" Binding="{Binding SelectedCategory}" Value="{x:Static common:NotesListCategory.Bin}">
                        <Setter Property="Source" Value="bin_bg.png" />
                    </DataTrigger>
                </Image.Triggers>
            </Image>
            <BoxView Grid.RowSpan="3" Color="#66000000" />

            <!-- Page title bar inside the content area. The title
                 itself is a clickable label that triggers Rename
                 (matching the click-on-title behavior of Microsoft
                 To Do) and shows a hover state. -->
            <Grid Grid.Row="0"
                  Padding="20,14"
                  ColumnDefinitions="Auto,*,Auto">
                <HorizontalStackLayout Grid.Column="0"
                                       Spacing="10"
                                       VerticalOptions="Center">
                    <syncfusionButtons:SfButton Style="{StaticResource IconSfButtonStyle}"
                                                FontSize="20"
                                                VerticalOptions="Center"
                                                Background="Transparent"
                                                WidthRequest="32"
                                                HeightRequest="32"
                                                Padding="0"
                                                StrokeThickness="0"
                                                IsEnabled="False">
                        <syncfusionButtons:SfButton.Triggers>
                            <DataTrigger TargetType="syncfusionButtons:SfButton" Binding="{Binding SelectedCategory}" Value="{x:Static common:NotesListCategory.MyNotes}">
                                <Setter Property="ImageSource" Value="profileiconmain.png" />
                            </DataTrigger>
                            <DataTrigger TargetType="syncfusionButtons:SfButton" Binding="{Binding SelectedCategory}" Value="{x:Static common:NotesListCategory.Important}">
                                <Setter Property="ImageSource" Value="importanticon.png" />
                            </DataTrigger>
                            <DataTrigger TargetType="syncfusionButtons:SfButton" Binding="{Binding SelectedCategory}" Value="{x:Static common:NotesListCategory.Reminder}">
                                <Setter Property="ImageSource" Value="belliconsidebar.png" />
                            </DataTrigger>
                            <DataTrigger TargetType="syncfusionButtons:SfButton" Binding="{Binding SelectedCategory}" Value="{x:Static common:NotesListCategory.Bin}">
                                <Setter Property="ImageSource" Value="binicon.png" />
                            </DataTrigger>
                        </syncfusionButtons:SfButton.Triggers>
                    </syncfusionButtons:SfButton>
                    <Label Text="{Binding HeaderTitle}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{StaticResource OnPrimaryColor}"
                           VerticalOptions="Center"
                           TextDecorations="None">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTitleTapped" />
                        </Label.GestureRecognizers>
                        <Label.Triggers>
                            <Trigger TargetType="Label" Property="IsFocused" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource PrimaryLightColor}" />
                            </Trigger>
                        </Label.Triggers>
                    </Label>
                </HorizontalStackLayout>
                <syncfusionButtons:SfButton Grid.Column="2"
                                            Text="&#8943;"
                                            Style="{StaticResource IconSfButtonStyle}"
                                            FontSize="22"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            Padding="0"
                                            StrokeThickness="0"
                                            Rotation="90"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource OnPrimaryColor}"
                                            Command="{Binding ShowListMenuFromTitleCommand}"
                                            SemanticProperties.Description="List options" />
            </Grid>

            <!-- Notes list / empty state -->
            <Grid Grid.Row="1">

                <!-- Empty state -->
                <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="12">
                    <Label Text="&#128203;"
                           FontSize="56"
                           TextColor="{StaticResource OnPrimaryColor}"
                           HorizontalOptions="Center" />
                    <Label Text="{Binding EmptyStateTitle}"
                           Style="{StaticResource EmptyStateMessageStyle}"
                           TextColor="{StaticResource OnPrimaryColor}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding EmptyStateMessage}"
                           Style="{StaticResource EmptyStateMessageStyle}"
                           TextColor="{StaticResource OnPrimaryColor}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Module-07 task 7-1: gap-highlight bar that appears
                     at the in-list drop position while the user is
                     dragging. -->
                <BoxView IsVisible="{Binding IsDragging}"
                         HeightRequest="3"
                         Margin="16,0"
                         Color="{StaticResource PrimaryColor}"
                         VerticalOptions="Start"
                         HorizontalOptions="Fill"
                         TranslationY="{Binding DropGapIndex, Converter={StaticResource MultiplyByConverter}, ConverterParameter=70}">
                    <BoxView.Triggers>
                        <DataTrigger TargetType="BoxView"
                                     Binding="{Binding DropGapIndex}"
                                     Value="-1">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </BoxView.Triggers>
                </BoxView>

                <!-- Module-07 task 7-2: drag-mode hint banner. -->
                <Border IsVisible="{Binding IsDragging}"
                        Margin="16,8"
                        Padding="10,6"
                        BackgroundColor="{StaticResource PrimaryColor}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8"
                        HorizontalOptions="Fill"
                        VerticalOptions="Start">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label Text="&#9776;"
                               FontSize="14"
                               TextColor="{StaticResource OnPrimaryColor}"
                               VerticalOptions="Center" />
                        <Label Text="Dragging — drop on a list to move, or release here to reorder"
                               FontSize="12"
                               TextColor="{StaticResource OnPrimaryColor}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Active notes list (bound to the ActiveNotes
                     collection populated by the ViewModel). -->
                <syncfusion:SfListView ItemsSource="{Binding ActiveNotes}"
                                       IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}"
                                       ItemSpacing="0" ItemSize="70"
                                       BackgroundColor="Transparent"
                                       SelectionMode="SingleDeselect"
                                       ItemDragging="OnItemDragging">
                    <syncfusion:SfListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Note">
                            <Border Margin="16,6"
                                    Padding="14,12"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Border.BackgroundColor>
                                    <MultiBinding Converter="{StaticResource DragStateColorConverter}"
                                                  ConverterParameter="#FFFFFF|#EEEAFB">
                                        <Binding Path="Id" />
                                        <Binding Source="{x:Reference NotesContentRoot}"
                                                 Path="BindingContext.DraggingNoteId" />
                                    </MultiBinding>
                                </Border.BackgroundColor>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference NotesContentRoot}, Path=BindingContext.EditNoteCommand}"
                                        CommandParameter="{Binding .}" />
                                    <DragGestureRecognizer
                                        CanDrag="True"
                                        DragStarting="OnNoteDragStarting"
                                        DropCompleted="OnNoteDropCompleted" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                      ColumnSpacing="10"
                                      VerticalOptions="Center">
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                              CheckedChanged="OnCheckChanged"
                                              Color="{StaticResource PrimaryColor}"
                                              VerticalOptions="Center" />

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="2"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding Title}"
                                               Style="{StaticResource NoteTitleStyle}"
                                               TextDecorations="{Binding IsCompleted, Converter={StaticResource BoolToTextDecorationConverter}}" />
                                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                            <Label Text="&#128197;"
                                                   FontSize="12"
                                                   TextColor="{StaticResource TextSecondaryColor}"
                                                   IsVisible="{Binding DueDate, Converter={StaticResource NotNullToBoolConverter}}" />
                                            <Label Text="{Binding DueDate, Converter={StaticResource DateTimeFormatConverter}}"
                                                   Style="{StaticResource NoteMetaStyle}"
                                                   IsVisible="{Binding DueDate, Converter={StaticResource NotNullToBoolConverter}}" />
                                            <Label Text="&#128276;"
                                                   FontSize="12"
                                                   TextColor="{StaticResource TextSecondaryColor}"
                                                   IsVisible="{Binding ReminderDate, Converter={StaticResource NotNullToBoolConverter}}" />
                                            <Label Text="{Binding ReminderDate, Converter={StaticResource DateTimeFormatConverter}}"
                                                   Style="{StaticResource NoteMetaStyle}"
                                                   IsVisible="{Binding ReminderDate, Converter={StaticResource NotNullToBoolConverter}}" />
                                            <Label Text="&#128260;"
                                                   FontSize="12"
                                                   TextColor="{StaticResource TextSecondaryColor}"
                                                   IsVisible="{Binding RepeatType, Converter={StaticResource RepeatTypeToGlyphConverter}, ConverterParameter=visibility}" />
                                            <Label Text="{Binding RepeatType, Converter={StaticResource RepeatTypeToGlyphConverter}}"
                                                   Style="{StaticResource NoteMetaStyle}"
                                                   IsVisible="{Binding RepeatType, Converter={StaticResource RepeatTypeToGlyphConverter}, ConverterParameter=visibility}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <syncfusionButtons:SfButton Grid.Column="2"
                                                               Text="{Binding IsImportant, Converter={StaticResource BoolToStarGlyphConverter}}"
                                                               TextColor="{Binding IsImportant, Converter={StaticResource BoolToStarColorConverter}}"
                                                               Style="{StaticResource IconSfButtonStyle}"
                                                               FontSize="20"
                                                               Background="Transparent"
                                                               WidthRequest="40"
                                                               HeightRequest="40"
                                                               Padding="0"
                                                               StrokeThickness="0"
                                                               Command="{Binding Source={x:Reference NotesContentRoot}, Path=BindingContext.ToggleImportantCommand}"
                                                               CommandParameter="{Binding .}"
                                                               SemanticProperties.Description="Toggle important" />

                                    <syncfusionButtons:SfButton Grid.Column="3"
                                                               Text="&#8943;"
                                                               Style="{StaticResource IconSfButtonStyle}"
                                                               FontSize="22"
                                                               Rotation="90"
                                                               Background="Transparent"
                                                               TextColor="{StaticResource TextSecondaryColor}"
                                                               WidthRequest="40"
                                                               HeightRequest="40"
                                                               Padding="0"
                                                               StrokeThickness="0"
                                                               Command="{Binding Source={x:Reference NotesContentRoot}, Path=BindingContext.ShowNoteMenuCommand}"
                                                               CommandParameter="{Binding .}"
                                                               SemanticProperties.Description="More note options" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </syncfusion:SfListView.ItemTemplate>
                </syncfusion:SfListView>
            </Grid>

            <!-- ============== Completed section (Expander) ============== -->
            <Border Grid.Row="1"
                    Margin="16,0,16,80"
                    Padding="0"
                    StrokeThickness="0"
                    BackgroundColor="Transparent"
                    IsVisible="{Binding IsCompletedEmpty, Converter={StaticResource InvertedBoolConverter}}"
                    VerticalOptions="End">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <syncfusionExpander:SfExpander IsExpanded="{Binding IsCompletedExpanded, Mode=TwoWay}">
                    <syncfusionExpander:SfExpander.Header>
                        <Grid Padding="14,10" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Label Grid.Column="0"
                                   Text="{Binding CompletedCount, StringFormat='Completed ({0})'}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource OnPrimaryColor}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="&#9662;"
                                   FontSize="14"
                                   TextColor="{StaticResource OnPrimaryColor}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </syncfusionExpander:SfExpander.Header>
                    <syncfusion:SfListView ItemsSource="{Binding CompletedNotes}"
                                           ItemSpacing="0" ItemSize="60"
                                           BackgroundColor="Transparent"
                                           SelectionMode="None">
                        <syncfusion:SfListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Note">
                                <Border Margin="0,3"
                                        Padding="14,8"
                                        BackgroundColor="#22FFFFFF"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="10"
                                          VerticalOptions="Center">
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                                  CheckedChanged="OnCheckChanged"
                                                  Color="{StaticResource PrimaryColor}"
                                                  VerticalOptions="Center" />
                                        <Label Grid.Column="1"
                                               Text="{Binding Title}"
                                               FontSize="14"
                                               TextDecorations="Strikethrough"
                                               TextColor="{StaticResource TextOnDarkColor}"
                                               Opacity="0.7"
                                               VerticalOptions="Center" />
                                        <syncfusionButtons:SfButton Grid.Column="2"
                                                                   Text="&#8943;"
                                                                   Style="{StaticResource IconSfButtonStyle}"
                                                                   FontSize="18"
                                                                   Rotation="90"
                                                                   Background="Transparent"
                                                                   TextColor="{StaticResource OnPrimaryColor}"
                                                                   WidthRequest="32"
                                                                   HeightRequest="32"
                                                                   StrokeThickness="0"
                                                                   Padding="0"
                                                                   Command="{Binding Source={x:Reference NotesContentRoot}, Path=BindingContext.ShowNoteMenuCommand}"
                                                                   CommandParameter="{Binding .}"
                                                                   SemanticProperties.Description="More note options" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </syncfusion:SfListView.ItemTemplate>
                    </syncfusion:SfListView>
                </syncfusionExpander:SfExpander>
            </Border>

            <!-- Bottom input bar -->
            <Border Grid.Row="2"
                    Margin="16,12,16,16"
                    Padding="10,4"
                    BackgroundColor="{StaticResource SurfaceColor}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="2"
                      VerticalOptions="Center">
                    <syncfusionCore:SfTextInputLayout Grid.Column="0"
                                                     Hint="Add a note"
                                                     ContainerType="None"
                                                     ShowHint="True"
                                                     ReserveSpaceForAssistiveLabels="False"
                                                     InputViewPadding="0"
                                                     VerticalOptions="Center">
                        <Entry Text="{Binding NewNoteTitle, Mode=TwoWay}"
                               Style="{StaticResource InputPillEntryStyle}"
                               ReturnCommand="{Binding AddNoteCommand}" />
                    </syncfusionCore:SfTextInputLayout>
                    <syncfusionButtons:SfButton Grid.Column="1"
                                                ImageSource="calendaricon.png"
                                                Style="{StaticResource IconSfButtonStyle}"
                                                FontSize="16"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                Padding="0"
                                                StrokeThickness="0"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource TextSecondaryColor}"
                                                SemanticProperties.Description="Add due date" />
                    <syncfusionButtons:SfButton Grid.Column="2"
                                                ImageSource="dateicon.png"
                                                Style="{StaticResource IconSfButtonStyle}"
                                                FontSize="16"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                Padding="0"
                                                StrokeThickness="0"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource TextSecondaryColor}"
                                                SemanticProperties.Description="Add reminder" />
                    <syncfusionButtons:SfButton Grid.Column="3"
                                                ImageSource="bellicon.png"
                                                Style="{StaticResource IconSfButtonStyle}"
                                                FontSize="16"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                Padding="0"
                                                StrokeThickness="0"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource TextSecondaryColor}"
                                                SemanticProperties.Description="Set notification" />
                    <syncfusionButtons:SfButton Grid.Column="4"
                                                Text="|"
                                                Style="{StaticResource IconSfButtonStyle}"
                                                FontSize="18"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                Padding="0"
                                                StrokeThickness="0"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource TextSecondaryColor}"
                                                SemanticProperties.Description="More note options" />
                    <syncfusionButtons:SfButton Grid.Column="5"
                                                ImageSource="tickicon.png"
                                                Style="{StaticResource FabSfButtonStyle}"
                                                FontSize="18"
                                                FontAttributes="Bold"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                CornerRadius="20"
                                                Padding="0"
                                                StrokeThickness="0"
                                                BackgroundColor="{StaticResource PrimaryColor}"
                                                TextColor="{StaticResource OnPrimaryColor}"
                                                Command="{Binding AddNoteCommand}"
                                                SemanticProperties.Description="Save note" />
                </Grid>
            </Border>
        </Grid>
    </Border>

</ContentView>
