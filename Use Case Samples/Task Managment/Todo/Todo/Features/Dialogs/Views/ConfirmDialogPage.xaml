<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Todo.Features.Dialogs.ViewModels"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             x:Class="Todo.Features.Dialogs.Views.ConfirmDialogPage"
             x:DataType="vm:ConfirmDialogViewModel"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="ModalNotAnimated"
             BackgroundColor="#80000000">

    <Grid Padding="32"
          VerticalOptions="Center"
          HorizontalOptions="Center">

        <Border MaximumWidthRequest="440"
                WidthRequest="{OnIdiom Phone=300, Default=400}"
                BackgroundColor="{StaticResource SurfaceColor}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                Padding="24">
            <Border.Shadow>
                <Shadow Brush="#33000000"
                        Radius="8"
                        Offset="0,4"
                        Opacity="0.20" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="16">

                <Label Text="{Binding Title}"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimaryColor}" />

                <Label Text="{Binding Message}"
                       FontSize="14"
                       TextColor="{StaticResource TextSecondaryColor}" />

                <Grid ColumnDefinitions="*,Auto,Auto"
                      ColumnSpacing="12"
                      HorizontalOptions="End"
                      Margin="0,8,0,0">
                    <syncfusion:SfButton Grid.Column="1"
                                         Text="{Binding CancelText}"
                                         Style="{StaticResource OutlinedSfButtonStyle}"
                                         Command="{Binding CancelCommand}"
                                         MinimumWidthRequest="96" />
                    <syncfusion:SfButton Grid.Column="2"
                                         x:Name="ConfirmButton"
                                         Text="{Binding ConfirmText}"
                                         BackgroundColor="{StaticResource PrimaryColor}"
                                         TextColor="{StaticResource OnPrimaryColor}"
                                         FontFamily="{StaticResource FontFamilySemibold}"
                                         FontSize="14"
                                         CornerRadius="8"
                                         StrokeThickness="0"
                                         Padding="14,10"
                                         MinimumHeightRequest="44"
                                         Command="{Binding ConfirmCommand}"
                                         MinimumWidthRequest="96">
                        <syncfusion:SfButton.Triggers>
                            <DataTrigger TargetType="syncfusion:SfButton"
                                         Binding="{Binding IsDestructive}"
                                         Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource ErrorColor}" />
                            </DataTrigger>
                            <DataTrigger TargetType="syncfusion:SfButton"
                                         Binding="{Binding IsDestructive}"
                                         Value="False">
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
                            </DataTrigger>
                        </syncfusion:SfButton.Triggers>
                    </syncfusion:SfButton>
                </Grid>

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
