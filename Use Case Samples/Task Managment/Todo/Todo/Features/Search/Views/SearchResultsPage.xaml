<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Todo.Features.Search.ViewModels"
             xmlns:models="clr-namespace:Todo.Features.Notes.Models"
             xmlns:conv="clr-namespace:Todo.Converters"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:syncfusionCore="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:syncfusionButtons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             x:Class="Todo.Features.Search.Views.SearchResultsPage"
             x:Name="SearchRoot"
             x:DataType="vm:SearchResultsViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="Search">

    <Grid Padding="0,10,0,0"
          RowDefinitions="48,*"
          BackgroundColor="{StaticResource BackgroundColor}">

        <Grid Grid.Row="0"
              HeightRequest="{StaticResource HeaderHeight}"
              Padding="8,0,16,0"
              ColumnDefinitions="Auto,*,Auto"
              BackgroundColor="{StaticResource SurfaceColor}">
            <Grid.Shadow>
                <Shadow Brush="#10000000" Radius="4" Offset="0,1" Opacity="0.10" />
            </Grid.Shadow>

            <syncfusionButtons:SfButton Grid.Column="0"
                                         Text="&#8592;"
                                         Style="{StaticResource IconSfButtonStyle}"
                                         FontSize="22"
                                         WidthRequest="40"
                                         HeightRequest="40"
                                         Padding="0"
                                         StrokeThickness="0"
                                         Background="Transparent"
                                         TextColor="{StaticResource TextSecondaryColor}"
                                         Clicked="OnBackClicked"
                                         SemanticProperties.Description="Go back" />

            <syncfusionCore:SfTextInputLayout Grid.Column="1"
                                             ContainerType="Outlined"
                                             OutlineCornerRadius="18"
                                             HeightRequest="36"
                                             HorizontalOptions="Fill"
                                             VerticalOptions="Center"
                                             BackgroundColor="{StaticResource InputPillBackgroundColor}">
                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="8"
                      VerticalOptions="Center">
                    <Image Grid.Column="0"
                           Source="search.png"
                           WidthRequest="16"
                           HeightRequest="16"
                           Aspect="AspectFit"
                           VerticalOptions="Center" />
                    <Entry Grid.Column="1"
                           Text="{Binding Query, Mode=TwoWay}"
                           Placeholder="Search"
                           FontSize="14"
                           TextColor="{StaticResource TextPrimaryColor}"
                           PlaceholderColor="{StaticResource TextSecondaryColor}"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center" />
                    <syncfusionButtons:SfButton Grid.Column="2"
                                                 Text="&#10005;"
                                                 Style="{StaticResource IconSfButtonStyle}"
                                                 FontSize="14"
                                                 WidthRequest="28"
                                                 HeightRequest="28"
                                                 Padding="0"
                                                 StrokeThickness="0"
                                                 Background="Transparent"
                                                 TextColor="{StaticResource TextSecondaryColor}"
                                                 Command="{Binding ClearQueryCommand}"
                                                 IsVisible="{Binding Query, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                                                 SemanticProperties.Description="Clear search" />
                </Grid>
            </syncfusionCore:SfTextInputLayout>

            <BoxView Grid.Column="2"
                     WidthRequest="40"
                     HeightRequest="40"
                     Color="Transparent" />
        </Grid>

        <Grid Grid.Row="1"
              Padding="16">

            <Border BackgroundColor="{StaticResource BackgroundColor}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto,*,Auto">

                    <Image Grid.RowSpan="3"
                           Source="mynotes_bg.png"
                           Aspect="AspectFill"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill" />
                    <BoxView Grid.RowSpan="3" Color="#66000000" />

                    <Grid Grid.Row="0"
                          Padding="20,14"
                          ColumnDefinitions="Auto,*,Auto">
                        <HorizontalStackLayout Grid.Column="0"
                                               Spacing="10"
                                               VerticalOptions="Center">
                            <syncfusionButtons:SfButton ImageSource="search.png"
                                                        Style="{StaticResource IconSfButtonStyle}"
                                                        FontSize="20"
                                                        Background="Transparent"
                                                        WidthRequest="32"
                                                        HeightRequest="32"
                                                        Padding="0"
                                                        StrokeThickness="0"
                                                        IsEnabled="False" />
                            <Label Text="Search notes"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource OnPrimaryColor}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Grid>

                    <Grid Grid.Row="1">

                        <VerticalStackLayout IsVisible="{Binding IsQueryEmpty}"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             Spacing="12">
                            <Label Text="&#128203;"
                                   FontSize="56"
                                   TextColor="{StaticResource OnPrimaryColor}"
                                   HorizontalOptions="Center" />
                            <Label Text="You can search the created notes here"
                                   FontSize="16"
                                   TextColor="{StaticResource OnPrimaryColor}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout IsVisible="{Binding HasNoResults}"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             Spacing="8">
                            <Label Text="&#128683;"
                                   FontSize="48"
                                   TextColor="{StaticResource OnPrimaryColor}"
                                   HorizontalOptions="Center" />
                            <Label Text="No notes match your search"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource OnPrimaryColor}"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Try a different keyword."
                                   FontSize="14"
                                   TextColor="{StaticResource OnPrimaryColor}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <syncfusion:SfListView ItemsSource="{Binding Results}"
                                               IsVisible="{Binding HasNoResults, Converter={StaticResource InvertedBoolConverter}}"
                                               ItemSpacing="0"
                                               ItemSize="70"
                                               BackgroundColor="Transparent"
                                               SelectionMode="None">
                            <syncfusion:SfListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Note">
                                    <Border Margin="16,6"
                                            Padding="14,12"
                                            BackgroundColor="{StaticResource SurfaceColor}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference SearchRoot}, Path=BindingContext.OpenNoteCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>

                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                              ColumnSpacing="10"
                                              VerticalOptions="Center">

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                                      CheckedChanged="OnCheckChanged"
                                                      Color="{StaticResource PrimaryColor}"
                                                      VerticalOptions="Center" />

                                            <VerticalStackLayout Grid.Column="1"
                                                                 Spacing="2"
                                                                 VerticalOptions="Center">
                                                <Label Text="{Binding Title}"
                                                       Style="{StaticResource NoteTitleStyle}"
                                                       TextDecorations="{Binding IsCompleted, Converter={StaticResource BoolToTextDecorationConverter}}" />
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="&#128197;"
                                                           FontSize="12"
                                                           TextColor="{StaticResource TextSecondaryColor}"
                                                           IsVisible="{Binding DueDate, Converter={StaticResource NotNullToBoolConverter}}" />
                                                    <Label Text="{Binding DueDate, Converter={StaticResource DateTimeFormatConverter}}"
                                                           Style="{StaticResource NoteMetaStyle}"
                                                           IsVisible="{Binding DueDate, Converter={StaticResource NotNullToBoolConverter}}" />
                                                    <Label Text="&#128276;"
                                                           FontSize="12"
                                                           TextColor="{StaticResource TextSecondaryColor}"
                                                           IsVisible="{Binding ReminderDate, Converter={StaticResource NotNullToBoolConverter}}" />
                                                    <Label Text="{Binding ReminderDate, Converter={StaticResource DateTimeFormatConverter}}"
                                                           Style="{StaticResource NoteMetaStyle}"
                                                           IsVisible="{Binding ReminderDate, Converter={StaticResource NotNullToBoolConverter}}" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                            <syncfusionButtons:SfButton Grid.Column="2"
                                                                       Text="{Binding IsImportant, Converter={StaticResource BoolToStarGlyphConverter}}"
                                                                       TextColor="{Binding IsImportant, Converter={StaticResource BoolToStarColorConverter}}"
                                                                       Style="{StaticResource IconSfButtonStyle}"
                                                                       FontSize="20"
                                                                       Background="Transparent"
                                                                       WidthRequest="40"
                                                                       HeightRequest="40"
                                                                       Padding="0"
                                                                       StrokeThickness="0"
                                                                       Command="{Binding Source={x:Reference SearchRoot}, Path=BindingContext.ToggleImportantCommand}"
                                                                       CommandParameter="{Binding .}"
                                                                       SemanticProperties.Description="Toggle important" />

                                            <syncfusionButtons:SfButton Grid.Column="3"
                                                                       Text="&#8943;"
                                                                       Style="{StaticResource IconSfButtonStyle}"
                                                                       FontSize="22"
                                                                       Rotation="90"
                                                                       Background="Transparent"
                                                                       TextColor="{StaticResource TextSecondaryColor}"
                                                                       WidthRequest="40"
                                                                       HeightRequest="40"
                                                                       Padding="0"
                                                                       StrokeThickness="0"
                                                                       IsEnabled="False"
                                                                       SemanticProperties.Description="More note options" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </syncfusion:SfListView.ItemTemplate>
                        </syncfusion:SfListView>
                    </Grid>

                    <BoxView Grid.Row="2"
                             HeightRequest="16"
                             Color="Transparent" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
