<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Todo.Features.Dialogs.ViewModels"
             x:Class="Todo.Features.Bin.Views.PermanentDeleteDialog"
             x:DataType="vm:ConfirmDialogViewModel"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="ModalNotAnimated"
             BackgroundColor="#80000000">

    <Grid Padding="32"
          VerticalOptions="Center"
          HorizontalOptions="Center">

        <Border MaximumWidthRequest="420"
                WidthRequest="{OnIdiom Phone=300, Default=400}"
                BackgroundColor="{StaticResource SurfaceColor}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                Padding="24">
            <Border.Shadow>
                <Shadow Brush="#33000000"
                        Radius="8"
                        Offset="0,4"
                        Opacity="0.20" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="16">

                <!-- Dialog title (matches deletepermently.png) -->
                <Label Text="{Binding Title}"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimaryColor}" />

                <!-- Dialog message -->
                <Label Text="{Binding Message}"
                       FontSize="14"
                       TextColor="{StaticResource TextSecondaryColor}" />

                <!-- Action buttons: Cancel + Delete (destructive) -->
                <Grid ColumnDefinitions="*,Auto,Auto"
                      ColumnSpacing="12"
                      HorizontalOptions="End"
                      Margin="0,8,0,0">
                    <Button Grid.Column="1"
                            Text="{Binding CancelText}"
                            Style="{StaticResource TextButtonStyle}"
                            Command="{Binding CancelCommand}"
                            MinimumWidthRequest="96" />
                    <Button Grid.Column="2"
                            Text="{Binding ConfirmText}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ConfirmCommand}"
                            MinimumWidthRequest="96" />
                </Grid>

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
