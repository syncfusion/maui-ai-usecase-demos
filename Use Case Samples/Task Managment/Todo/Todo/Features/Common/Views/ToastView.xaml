<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Todo.Features.Common.Views.ToastView">

    <!--
        Snackbar-style toast shown at the bottom of the screen for
        short confirmations (e.g. "List deleted successfully").
        The host code-behind sets the text and triggers a fade in/out
        animation.
    -->
    <Border x:Name="Root"
            BackgroundColor="#CC323232"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 20"
            Padding="16,10"
            HorizontalOptions="Center"
            VerticalOptions="End"
            Margin="0,0,0,20"
            Opacity="0">
        <Border.Shadow>
            <Shadow Brush="#33000000" Radius="8" Offset="0,4" Opacity="0.30" />
        </Border.Shadow>
        <Label x:Name="MessageLabel"
               Text=""
               FontSize="14"
               FontAttributes="Bold"
               TextColor="{StaticResource OnPrimaryColor}" />
    </Border>
</ContentView>
