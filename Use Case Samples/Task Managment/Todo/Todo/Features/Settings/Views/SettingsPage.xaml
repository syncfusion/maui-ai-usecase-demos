<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:syncfusionInputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             xmlns:syncfusionCore="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:vm="clr-namespace:Todo.Features.Settings.ViewModels"
             x:Class="Todo.Features.Settings.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundColor}">

    <Grid RowDefinitions="48,*">
        <!-- Custom header: back arrow + title -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              Padding="8,0,16,0"
              BackgroundColor="{StaticResource SurfaceColor}">
            <Grid.Shadow>
                <Shadow Brush="#10000000" Radius="4" Offset="0,1" Opacity="0.10" />
            </Grid.Shadow>
            <syncfusion:SfButton Grid.Column="0"
                                 Text="&#8592;"
                                 Style="{StaticResource IconSfButtonStyle}"
                                 FontSize="22"
                                 WidthRequest="40"
                                 HeightRequest="40"
                                 StrokeThickness="0"
                                 Background="Transparent"
                                 TextColor="{StaticResource TextSecondaryColor}"
                                 Clicked="OnBackClicked"
                                 SemanticProperties.Description="Go back" />
            <Label Grid.Column="1"
                   Text="Settings"
                   FontSize="17"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimaryColor}"
                   VerticalOptions="Center"
                   HorizontalOptions="Start"
                   Margin="8,0,0,0" />
        </Grid>

        <!-- Body -->
        <ScrollView Grid.Row="1" Padding="20,16">
            <VerticalStackLayout Spacing="20">

                <!-- Notifications section -->
                <Label Text="NOTIFICATIONS"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextSecondaryColor}"
                       Margin="4,0,0,0" />

                <Border BackgroundColor="{StaticResource SurfaceColor}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="16,12">
                    <Border.Shadow>
                        <Shadow Brush="#10000000" Radius="4" Offset="0,1" Opacity="0.08" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="*,Auto"
                          VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Enable notifications"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimaryColor}" />
                            <Label Text="Show reminders for due tasks and reminders."
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondaryColor}" />
                        </VerticalStackLayout>
                        <syncfusion:SfSwitch Grid.Column="1"
                                             IsOn="{Binding NotificationsEnabled, Mode=TwoWay}"
                                             VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Theme section -->
                <Label Text="APPEARANCE"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextSecondaryColor}"
                       Margin="4,0,0,0" />

                <Border BackgroundColor="{StaticResource SurfaceColor}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="16,12">
                    <Border.Shadow>
                        <Shadow Brush="#10000000" Radius="4" Offset="0,1" Opacity="0.08" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Theme"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimaryColor}" />
                        <Label Text="Choose how To Do List looks on this device."
                               FontSize="12"
                               TextColor="{StaticResource TextSecondaryColor}" />
                        <syncfusionInputs:SfSegmentedControl x:Name="ThemeSegment"
                                                             SelectionChanged="OnThemeChanged">
                            <syncfusionInputs:SfSegmentedControl.Items>
                                <syncfusionInputs:SfSegmentItem Text="Light" />
                                <syncfusionInputs:SfSegmentItem Text="Dark" />
                                <syncfusionInputs:SfSegmentItem Text="System" />
                            </syncfusionInputs:SfSegmentedControl.Items>
                        </syncfusionInputs:SfSegmentedControl>
                    </VerticalStackLayout>
                </Border>

                <!-- About section -->
                <Label Text="ABOUT"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextSecondaryColor}"
                       Margin="4,0,0,0" />

                <Border BackgroundColor="{StaticResource SurfaceColor}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="16,12">
                    <Border.Shadow>
                        <Shadow Brush="#10000000" Radius="4" Offset="0,1" Opacity="0.08" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="To Do List"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimaryColor}" />
                        <Label Text="Version 1.0.0"
                               FontSize="12"
                               TextColor="{StaticResource TextSecondaryColor}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
