    <!--
        Shared SfListView item templates. The mobile and desktop layouts used to inline
        six near-identical DataTemplates; these three keyed resources are referenced by
        both layouts so a task row is defined once per category.
        Only the icon badge tint differs between categories.
    -->
    <DataTemplate x:Key="DoTodayTaskItemTemplate">
        <Grid ColumnDefinitions="48, *"
              ColumnSpacing="8">
            <Border BackgroundColor="#DDEAF2"
                    WidthRequest="40"
                    HeightRequest="40"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Label Style="{StaticResource TaskTypeIconLabel}" />
            </Border>
            <StackLayout Grid.Column="1"
                         VerticalOptions="Center"
                         Spacing="2">
                <Label Text="{Binding Topic}"
                       FontAttributes="Bold"
                       FontSize="16" />
                <Label Text="{Binding Description}"
                       FontSize="13"
                       TextColor="#6B6B6B" />
            </StackLayout>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="PostponeTaskItemTemplate">
        <Grid ColumnDefinitions="48, *"
              ColumnSpacing="8">
            <Border BackgroundColor="#FFFFFF"
                    WidthRequest="40"
                    HeightRequest="40"
