    <Style TargetType="Label" x:Key="TaskTypeIconLabel">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="SemanticProperties.Description" Value="Task type icon" />
        <Setter Property="Text" Value="🗂️" />
        <Style.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding ProjectType}" Value="Report">
                <Setter Property="Text" Value="📄" />
                <Setter Property="SemanticProperties.Description" Value="Report task" />
            </DataTrigger>
            <DataTrigger TargetType="Label" Binding="{Binding ProjectType}" Value="Meeting">
                <Setter Property="Text" Value="👥" />
                <Setter Property="SemanticProperties.Description" Value="Meeting task" />
            </DataTrigger>
            <DataTrigger TargetType="Label" Binding="{Binding ProjectType}" Value="Email">
                <Setter Property="Text" Value="✉️" />
                <Setter Property="SemanticProperties.Description" Value="Email task" />
            </DataTrigger>
            <DataTrigger TargetType="Label" Binding="{Binding ProjectType}" Value="Design">
                <Setter Property="Text" Value="🎨" />
                <Setter Property="SemanticProperties.Description" Value="Design task" />
            </DataTrigger>
            <DataTrigger TargetType="Label" Binding="{Binding ProjectType}" Value="Cleanup">
                <Setter Property="Text" Value="🧹" />
                <Setter Property="SemanticProperties.Description" Value="Cleanup task" />
            </DataTrigger>
            <DataTrigger TargetType="Label" Binding="{Binding ProjectType}" Value="Feedback">
                <Setter Property="Text" Value="💬" />
                <Setter Property="SemanticProperties.Description" Value="Feedback task" />
            </DataTrigger>
            <DataTrigger TargetType="Label" Binding="{Binding ProjectType}" Value="Docs">
                <Setter Property="Text" Value="📚" />
                <Setter Property="SemanticProperties.Description" Value="Documentation task" />
            </DataTrigger>
            <DataTrigger TargetType="Label" Binding="{Binding ProjectType}" Value="Review">
                <Setter Property="Text" Value="🔍" />
                <Setter Property="SemanticProperties.Description" Value="Review task" />
            </DataTrigger>
            <DataTrigger TargetType="Label" Binding="{Binding ProjectType}" Value="Contract">
                <Setter Property="Text" Value="📜" />
                <Setter Property="SemanticProperties.Description" Value="Contract task" />
            </DataTrigger>
            <DataTrigger TargetType="Label" Binding="{Binding ProjectType}" Value="Audit">
                <Setter Property="Text" Value="📝" />
                <Setter Property="SemanticProperties.Description" Value="Audit task" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

