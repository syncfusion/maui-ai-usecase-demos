<?xml version="1.0" encoding="utf-8" ?>
<!--
    Desktop split-view pane: Dashboard in column 1, Smart Shopping
    in column 2. This page is now a child of
    DesktopSplitHostPage — it no longer hosts its own side rail,
    profile popup, or Shell routing. The host owns the chrome; this
    page is purely a two-column content container.

    Reparenting: DashboardPage and ShoppingPage are resolved from
    DI and their root visual trees are stolen into the column
    ContentView hosts by DashboardShoppingSplitPage.OnAppearing
    (see code-behind). Each child keeps its existing ViewModel +
    DI scope + bindings + OnAppearing refresh logic untouched.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WardrobeAI.Views.DashboardShoppingSplitPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}"
             Title="Dashboard and Shopping"
             Shell.NavBarIsVisible="False">

    <Grid ColumnDefinitions="2*,1.25*"
          ColumnSpacing="0"
          RowSpacing="0">

        <!-- Column 1 — Dashboard content -->
        <ScrollView Grid.Column="0"
                    Padding="20,8,12,32"
                    VerticalScrollBarVisibility="Never"
                    x:Name="DashboardScroll">
            <ContentView x:Name="DashboardHost" />
        </ScrollView>

        <!-- Vertical divider between the two columns. Anchored to the
             end of column 0 so it perfectly bisects the content area
             regardless of side-rail width. -->
        <BoxView Grid.Column="0"
                 WidthRequest="10"
                 Color="Transparent"
                 HorizontalOptions="End" VerticalOptions="Fill"/>

        <!-- Column 2 — Shopping content -->
        <ScrollView Grid.Column="1"
                    Padding="12,8,20,32"
                    VerticalScrollBarVisibility="Never"
                    x:Name="ShoppingScroll">
            <Border StrokeShape="RoundRectangle 16" StrokeThickness="0">
                <ContentView x:Name="ShoppingHost" />
            </Border>
        </ScrollView>
    </Grid>
</ContentPage>
