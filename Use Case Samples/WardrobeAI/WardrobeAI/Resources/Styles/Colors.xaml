<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- M3 warm-navy scheme — light tokens (wardrobe.prompt §3.1) -->
    <Color x:Key="Background">#FCF9F4</Color>
    <Color x:Key="Surface">#FCF9F4</Color>
    <Color x:Key="SurfaceBright">#FCF9F4</Color>
    <Color x:Key="SurfaceContainerLow">#F6F3EE</Color>
    <Color x:Key="SurfaceContainer">#F0EDE9</Color>
    <Color x:Key="SurfaceContainerHigh">#EBE8E3</Color>
    <Color x:Key="SurfaceContainerHighest">#E5E2DD</Color>
    <Color x:Key="SurfaceDim">#DCDAD5</Color>
    <Color x:Key="OnSurface">#1C1C19</Color>
    <Color x:Key="OnBackground">#1C1C19</Color>

    <Color x:Key="Primary">#091523</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="PrimaryContainer">#1E2A38</Color>
    <Color x:Key="OnPrimaryContainer">#8591A2</Color>
    <Color x:Key="PrimaryFixed">#D7E3F6</Color>
    <Color x:Key="PrimaryFixedDim">#BBC7DA</Color>

    <Color x:Key="Secondary">#505F76</Color>
    <Color x:Key="SecondaryContainer">#D0E1FB</Color>
    <Color x:Key="OnSecondaryContainer">#54647A</Color>

    <Color x:Key="Tertiary">#001335</Color>
    <Color x:Key="TertiaryContainer">#00275C</Color>
    <Color x:Key="OnTertiaryContainer">#091523</Color>

    <Color x:Key="Outline">#75777C</Color>
    <Color x:Key="OutlineVariant">#C4C6CC</Color>

    <Color x:Key="Error">#BA1A1A</Color>
    <Color x:Key="ErrorContainer">#FFDAD6</Color>
    <Color x:Key="OnErrorContainer">#93000A</Color>

    <Color x:Key="BeigeCard">#F8F5F0</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- Dark inverses -->
    <Color x:Key="BackgroundDark">#131311</Color>
    <Color x:Key="SurfaceDark">#131311</Color>
    <Color x:Key="OnSurfaceDark">#F4F1EB</Color>
    <Color x:Key="PrimaryDark">#A5C7F5</Color>
    <Color x:Key="OnPrimaryDark">#091523</Color>
    <Color x:Key="SecondaryDark">#B6CCF0</Color>
    <Color x:Key="TertiaryDark">#4C8DFF</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>