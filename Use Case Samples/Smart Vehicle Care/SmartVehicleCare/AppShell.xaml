<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SmartVehicleCare.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SmartVehicleCare"
    xmlns:views="clr-namespace:SmartVehicleCare.Views"
    Title="SmartVehicleCare"
    FlyoutBehavior="Disabled">

    <!-- Splash / Landing Page — always shown first -->
    <ShellContent x:Name="SplashShellContent"
        Title="Splash"
        ContentTemplate="{DataTemplate views:SplashPage}"
        Route="splash"
        Shell.NavBarIsVisible="False"
        Shell.TabBarIsVisible="False" />

    <!-- Welcome Page — onboarding form -->
    <ShellContent x:Name="WelcomeShellContent"
        Title="Welcome"
        ContentTemplate="{DataTemplate views:WelcomePage}"
        Route="welcome"
        Shell.NavBarIsVisible="False"
        Shell.TabBarIsVisible="False" />

    <!-- Main App (dashboard + navigation) -->
    <ShellContent x:Name="MainShellContent"
        Title="Main"
        ContentTemplate="{DataTemplate views:MainPage}"
        Route="main"
        Shell.NavBarIsVisible="False"
        Shell.TabBarIsVisible="False" />

</Shell>
