<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ESimDataManager.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Navy">#102A43</Color>
            <Color x:Key="Blue">#0756C9</Color>
            <Color x:Key="Mint">#00A985</Color>
            <Color x:Key="PageBackground">#F4F7FC</Color>
            <Color x:Key="Muted">#687B91</Color>
            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{StaticResource PageBackground}" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Navy}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
