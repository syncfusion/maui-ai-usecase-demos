<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:ESimDataManager.Views"
       x:Class="ESimDataManager.AppShell"
       FlyoutBehavior="Disabled"
       Title="eSIM Data Manager">
    <TabBar Route="main">
        <ShellContent Title="Home" Route="home" ContentTemplate="{DataTemplate views:MainPage}" />
        <ShellContent Title="My eSIMs" Route="esims" ContentTemplate="{DataTemplate views:MainPage}" />
        <ShellContent Title="Explore" Route="explore" ContentTemplate="{DataTemplate views:MainPage}" />
    </TabBar>
</Shell>
