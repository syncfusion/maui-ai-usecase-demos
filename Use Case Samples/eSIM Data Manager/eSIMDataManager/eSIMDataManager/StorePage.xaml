<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:list="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView" xmlns:sfButton="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons" xmlns:sfInput="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core" xmlns:models="clr-namespace:eSIMDataManager.Models" xmlns:vm="clr-namespace:eSIMDataManager.ViewModels" x:Class="eSIMDataManager.StorePage" x:DataType="vm:MainViewModel" BackgroundColor="#F7F9FF">
    <ContentPage.Resources>
        <Style x:Key="StoreFilterButton" TargetType="sfButton:SfButton" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinimumHeightRequest" Value="34" />
            <Setter Property="MinimumWidthRequest" Value="0" />
        </Style>
    </ContentPage.Resources>
    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Padding="{OnIdiom Phone=16, Tablet=24, Desktop=26}" Spacing="18">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18" VerticalOptions="Center" MinimumHeightRequest="56">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center"><Border WidthRequest="34" HeightRequest="34" BackgroundColor="#1E5BFF" StrokeThickness="0" StrokeShape="RoundRectangle 11"><Label Text="e" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border><Label Text="eSIM Data Manager" FontSize="18" FontAttributes="Bold" TextColor="#101D35" VerticalOptions="Center" /></HorizontalStackLayout>
                    <Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                        <Border BackgroundColor="#EEF3FF" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="5" VerticalOptions="Center"><HorizontalStackLayout Spacing="2"><sfButton:SfButton Text="Dashboard" Clicked="DashboardClicked" Style="{StaticResource NavigationInactiveButton}"/><sfButton:SfButton Text="My eSIMs" Clicked="ProfilesClicked" Style="{StaticResource NavigationInactiveButton}"/><sfButton:SfButton Text="Store" Style="{StaticResource NavigationActiveButton}"/></HorizontalStackLayout></Border>
                        <Border Grid.Column="1" BackgroundColor="#F0F4FF" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="42" VerticalOptions="Center"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="12,0"><Label Text="&#xE715;" FontFamily="MaterialAssets" FontSize="20" TextColor="#26334B" VerticalOptions="Center"/><Entry Grid.Column="1" Placeholder="Search countries, ICCID, orders..." FontSize="13" TextColor="#101D35" PlaceholderColor="#6C7890" ClearButtonVisibility="WhileEditing" BackgroundColor="Transparent" VerticalOptions="Center"/></Grid></Border>
                        <sfButton:SfButton Grid.Column="2" Text="&#xE700;" FontFamily="UiKitIcons" FontSize="20" Background="Transparent" TextColor="#18243B" VerticalOptions="Center"/>
                    </Grid>
                    <HorizontalStackLayout Grid.Column="2" Spacing="9" VerticalOptions="Center" IsVisible="{OnIdiom Phone=False, Default=True}"><BoxView WidthRequest="1" HeightRequest="30" Color="#E4EAF5" VerticalOptions="Center"/><Border WidthRequest="36" HeightRequest="36" BackgroundColor="#E9F1FF" StrokeThickness="0" StrokeShape="RoundRectangle 18"><Label Text="&#xE71B;" FontFamily="MaterialAssets" FontSize="20" TextColor="#1E5BFF" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border><VerticalStackLayout Spacing="0" VerticalOptions="Center"><Label Text="Global Traveler" FontSize="12" FontAttributes="Bold" TextColor="#101D35"/><HorizontalStackLayout Spacing="6"><Ellipse WidthRequest="8" HeightRequest="8" Fill="#007A56" VerticalOptions="Center"/><Label Text="Roaming Online" FontSize="11" TextColor="#007A56"/></HorizontalStackLayout></VerticalStackLayout></HorizontalStackLayout>
                </Grid>
                <Border BackgroundColor="#EEF3FF" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="{OnIdiom Phone=20, Default=32}">
                    <VerticalStackLayout Spacing="12">
                        <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,5" HorizontalOptions="Start"><Label Text="●  190+ Global Destinations Live" FontSize="11" TextColor="#007A50" /></Border>
                        <Label Text="Explore Travel eSIM Plans" FontSize="{OnIdiom Phone=27, Default=30}" FontAttributes="Bold" TextColor="#07152B" />
                        <Label Text="Instant connectivity in 190+ countries with zero physical SIM swaps and zero roaming fees." FontSize="14" TextColor="#59677D" />
                        <Border BackgroundColor="White" Stroke="#E6EBF5" StrokeShape="RoundRectangle 12" Padding="8,0" MaximumWidthRequest="620" HorizontalOptions="Start">
                            <Grid ColumnDefinitions="Auto,*,Auto"><Label Text="⌕" FontSize="23" TextColor="#102B52" VerticalOptions="Center" Margin="4,0"/><Entry Grid.Column="1" Text="{Binding Search}" Placeholder="Search country, region, or carrier (e.g. Japan, SoftBank, Europe)..." FontSize="13"/><sfButton:SfButton Grid.Column="2" Text="×" Command="{Binding ClearFiltersCommand}" Style="{StaticResource LinkButton}" /></Grid>
                        </Border>
                        <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Center">
                            <Label Text="Trending:" FontSize="11" TextColor="#24334A" Margin="0,0,8,5" />
                            <sfButton:SfButton Text="🇯🇵 Japan" Clicked="DestinationClicked" Style="{StaticResource StoreFilterButton}" HorizontalOptions="Start" Margin="0,0,5,5" />
                            <sfButton:SfButton Text="🇺🇸 USA" Clicked="DestinationClicked" Style="{StaticResource StoreFilterButton}" HorizontalOptions="Start" Margin="0,0,5,5" />
                            <sfButton:SfButton Text="🇫🇷 France" Clicked="DestinationClicked" Style="{StaticResource StoreFilterButton}" HorizontalOptions="Start" Margin="0,0,5,5" />
                            <sfButton:SfButton Text="🇰🇷 Korea" Clicked="DestinationClicked" Style="{StaticResource StoreFilterButton}" HorizontalOptions="Start" Margin="0,0,5,5" />
                            <sfButton:SfButton Text="🇸🇬 Singapore" Clicked="DestinationClicked" Style="{StaticResource StoreFilterButton}" HorizontalOptions="Start" Margin="0,0,5,5" />
                            <sfButton:SfButton Text="🇹🇭 Thailand" Clicked="DestinationClicked" Style="{StaticResource StoreFilterButton}" HorizontalOptions="Start" Margin="0,0,5,5" />
                        </FlexLayout>
                        <FlexLayout Wrap="Wrap" Direction="Row"><sfButton:SfButton Text="🇪🇺 Europe (33)" Clicked="DestinationClicked" Style="{StaticResource StoreFilterButton}" HorizontalOptions="Start" Margin="0,0,6,0"/><sfButton:SfButton Text="🌐 Asia-Pacific" Clicked="DestinationClicked" Style="{StaticResource StoreFilterButton}" HorizontalOptions="Start" /></FlexLayout>
                    </VerticalStackLayout>
                </Border>
                <Border BackgroundColor="White" Stroke="#E8EDF5" StrokeShape="RoundRectangle 12" Padding="8">
                    <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Center">
                        <sfButton:SfButton Text="All" Clicked="FilterClicked" Style="{StaticResource StoreFilterButton}" HorizontalOptions="Start"/><sfButton:SfButton Text="Local" Clicked="FilterClicked" Style="{StaticResource StoreFilterButton}" HorizontalOptions="Start"/><sfButton:SfButton Text="Regional" Clicked="FilterClicked" Style="{StaticResource StoreFilterButton}" HorizontalOptions="Start"/><sfButton:SfButton Text="Global" Clicked="FilterClicked" Style="{StaticResource StoreFilterButton}" HorizontalOptions="Start"/>
                        <sfButton:SfButton Text="All Networks⌄" Style="{StaticResource StoreFilterButton}" HorizontalOptions="Start"/><sfButton:SfButton Text="All Quotas⌄" Style="{StaticResource StoreFilterButton}" HorizontalOptions="Start"/><sfButton:SfButton Text="Any Duration⌄" Style="{StaticResource StoreFilterButton}" HorizontalOptions="Start"/><Label Text="Sort by:" FontSize="10" VerticalOptions="Center"/><sfButton:SfButton Text="Recommended⌄" Style="{StaticResource StoreFilterButton}" HorizontalOptions="Start"/>
                    </FlexLayout>
                </Border>
                <Grid ColumnDefinitions="{OnIdiom Phone='*', Default='2*,*'}" ColumnSpacing="18" RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto"><Label Text="Available eSIM Plans  ·  6 Plans" FontSize="16" FontAttributes="Bold" TextColor="#101C2D"/><Label Grid.Column="1" Text="● Real-time Network Inventory" FontSize="10" TextColor="#00845A" VerticalOptions="Center"/></Grid>
                        <FlexLayout BindableLayout.ItemsSource="{Binding FilteredPlans}" Wrap="Wrap" Direction="Row" AlignItems="Stretch" AlignContent="Start" HorizontalOptions="Fill"><BindableLayout.ItemTemplate><DataTemplate x:DataType="models:Plan">
                            <Border BackgroundColor="White" Stroke="#E9EDF5" StrokeThickness="1" StrokeShape="RoundRectangle 15" Padding="15" Margin="0,0,10,10" FlexLayout.Basis="{OnIdiom Phone='100%', Default='49%'}">
                                <VerticalStackLayout Spacing="9">
                                    <Grid ColumnDefinitions="Auto,*,Auto"><Label Text="🌐" FontSize="22" VerticalOptions="Center"/><VerticalStackLayout Grid.Column="1" Margin="8,0"><Label Text="{Binding Country}" FontSize="15" FontAttributes="Bold" TextColor="#101C2D"/><Label Text="{Binding Region}" FontSize="10" TextColor="#667085"/></VerticalStackLayout><Border Grid.Column="2" BackgroundColor="#D8F7FF" StrokeThickness="0" StrokeShape="RoundRectangle 5" Padding="7,4"><Label Text="{Binding Network, StringFormat='5G {0}'}" FontSize="9" TextColor="#005E78"/></Border></Grid>
                                    <Border BackgroundColor="#F0F5FF" StrokeThickness="0" StrokeShape="RoundRectangle 7" Padding="8,3" HorizontalOptions="Start"><Label Text="{Binding Provider, StringFormat='● Carrier: {0}'}" FontSize="10" TextColor="#20324C"/></Border>
                                    <Grid ColumnDefinitions="*,*" BackgroundColor="#EFF4FF" Padding="9" ColumnSpacing="10"><VerticalStackLayout><Label Text="ALLOCATION" FontSize="9"/><Label Text="{Binding DataLabel}" FontSize="21" FontAttributes="Bold" TextColor="#0752DB"/><Label Text="High-Speed data" FontSize="9" TextColor="#667085"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="VALIDITY" FontSize="9"/><Label Text="{Binding ValidityDays, StringFormat='{0} Days'}" FontSize="20" FontAttributes="Bold" TextColor="#101C2D"/><Label Text="From activation" FontSize="9" TextColor="#667085"/></VerticalStackLayout></Grid>
                                    <Label Text="✓  Instant QR Code delivery via email &amp; app&#10;◉  Personal Hotspot &amp; Tethering allowed&#10;▤  Local high-speed routing" FontSize="10" TextColor="#344054" LineHeight="1.3"/>
                                    <BoxView HeightRequest="1" Color="#E7EEFA"/>
                                    <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="0"><Label Text="Total Price" FontSize="9"/><Label Text="{Binding Price, StringFormat='${0:0.00} USD'}" FontSize="22" FontAttributes="Bold" TextColor="#101C2D"/></VerticalStackLayout><sfButton:SfButton Grid.Column="1" Text="Buy Plan  →" Clicked="BuyPlanClicked" Style="{StaticResource PrimaryButton}" VerticalOptions="Center"/></Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate></BindableLayout.ItemTemplate></FlexLayout>
                        <Border BackgroundColor="White" Stroke="#E9EDF5" StrokeShape="RoundRectangle 14" Padding="18"><VerticalStackLayout HorizontalOptions="Center"><Label Text="Showing 6 of 148 verified eSIM packages for the selected filters" FontSize="10" TextColor="#667085"/><sfButton:SfButton Text="Load More Destinations" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0"/></VerticalStackLayout></Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="{OnIdiom Phone=0, Default=1}" Grid.Row="{OnIdiom Phone=1, Default=0}" Spacing="12">
                        <Border BackgroundColor="White" Stroke="#E9EDF5" StrokeShape="RoundRectangle 15" Padding="15"><VerticalStackLayout Spacing="10"><Label Text="✧  Trending Destinations" FontSize="16" FontAttributes="Bold" TextColor="#101C2D"/><Label Text="🇯🇵  Japan          ★ 4.9 · 12 Carriers        From $4.50  ›" FontSize="11"/><Label Text="🇰🇷  South Korea   ★ 4.9 · 6 Carriers         From $5.00  ›" FontSize="11"/><Label Text="🇸🇬  Singapore     ★ 4.8 · 4 Carriers         From $6.00  ›" FontSize="11"/><Label Text="🇫🇷  France          ★ 4.9 · 8 Carriers         From $7.50  ›" FontSize="11"/><Label Text="🇺🇸  United States ★ 4.8 · 10 Carriers       From $8.00  ›" FontSize="11"/></VerticalStackLayout></Border>
                        <Border BackgroundColor="#EEF3FF" StrokeThickness="0" StrokeShape="RoundRectangle 15" Padding="15"><VerticalStackLayout Spacing="9"><Label Text="◇  Why eSIM Data Manager?" FontSize="16" FontAttributes="Bold" TextColor="#101C2D"/><Label Text="▧  100% Digital Delivery&#10;       Install in seconds. No postage, no plastic, no kiosk queue." FontSize="11"/><Label Text="▤  Keep WhatsApp &amp; SIM&#10;       Receive home 2FA bank texts while roaming." FontSize="11"/><Label Text="＄  Zero Bill Shock&#10;       Prepaid transparency. Never return home to an accidental bill." FontSize="11"/><Label Text="◉  24/7 Global SLA Support&#10;       Real telecom network engineers ready to help wherever you land." FontSize="11"/></VerticalStackLayout></Border>
                        <Border BackgroundColor="#084BE8" StrokeThickness="0" StrokeShape="RoundRectangle 15" Padding="16"><VerticalStackLayout Spacing="9"><Label Text="● FLIGHT CONCIERGE ACTIVE" FontSize="10" TextColor="#D9E7FF"/><Label Text="Need help choosing a plan?" FontSize="16" FontAttributes="Bold" TextColor="White"/><Label Text="Tell us your trip schedule and handset model. We will pick the highest signal carrier for you." FontSize="11" TextColor="White"/><sfButton:SfButton Text="□  Chat with Roaming Advisor" Style="{StaticResource SecondaryButton}" Background="#FFFFFF" TextColor="#0645D8"/></VerticalStackLayout></Border>
                    </VerticalStackLayout>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Padding="0,8"><Label Text="●  Core Signal: 5G Ultra-Low Latency Mesh" FontSize="10" TextColor="#344054"/><Label Grid.Column="1" Text="© 2024 eSIM Data Manager. Precision Connectivity Platform." FontSize="10" TextColor="#667085"/></Grid>
                <Label Text="DEMO ONLY · All plans, costs, activation codes, QR details and usage figures are fictional. No payment, carrier connection, provisioning, or persistent storage is used." FontSize="10" TextColor="#667085" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>
