                                <BoxView HeightRequest="1" Color="#E4EAF5" Margin="0,0,0,8"/>
                                <Grid ColumnDefinitions="48,*,Auto,Auto" ColumnSpacing="10" Padding="10,15">
                                    <Label Text="JP" FontSize="20" TextColor="#101C2D" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center"><Label Text="Japan" FontSize="16" FontAttributes="Bold" TextColor="#101C2D"/><HorizontalStackLayout Spacing="7"><Label Text="★ 4.9" FontSize="13" FontAttributes="Bold" TextColor="#F39200"/><Label Text="·" FontSize="13" TextColor="#344054"/><Label Text="12 Carriers" FontFamily="monospace" FontSize="13" TextColor="#344054"/></HorizontalStackLayout></VerticalStackLayout>
                                    <Label Grid.Column="2" Text="From $4.50" FontSize="16" FontAttributes="Bold" TextColor="#101C2D" VerticalOptions="Center"/>
                                    <Label Grid.Column="3" Text="›" FontSize="26" TextColor="#344054" VerticalOptions="Center"/>
                                </Grid>
                                <Border Stroke="#EEF2F8" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="0"><Grid ColumnDefinitions="48,*,Auto,Auto" ColumnSpacing="10" Padding="10,15"><Label Text="KR" FontSize="20" TextColor="#101C2D" VerticalOptions="Center" HorizontalTextAlignment="Center"/><VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center"><Label Text="South Korea" FontSize="16" FontAttributes="Bold" TextColor="#101C2D"/><HorizontalStackLayout Spacing="7"><Label Text="★ 4.9" FontSize="13" FontAttributes="Bold" TextColor="#F39200"/><Label Text="·" FontSize="13" TextColor="#344054"/><Label Text="6 Carriers" FontFamily="monospace" FontSize="13" TextColor="#344054"/></HorizontalStackLayout></VerticalStackLayout><Label Grid.Column="2" Text="From $5.00" FontSize="16" FontAttributes="Bold" TextColor="#101C2D" VerticalOptions="Center"/><Label Grid.Column="3" Text="›" FontSize="26" TextColor="#344054" VerticalOptions="Center"/></Grid></Border>
                                <Border Stroke="#EEF2F8" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="0"><Grid ColumnDefinitions="48,*,Auto,Auto" ColumnSpacing="10" Padding="10,15"><Label Text="SG" FontSize="20" TextColor="#101C2D" VerticalOptions="Center" HorizontalTextAlignment="Center"/><VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center"><Label Text="Singapore" FontSize="16" FontAttributes="Bold" TextColor="#101C2D"/><HorizontalStackLayout Spacing="7"><Label Text="★ 4.8" FontSize="13" FontAttributes="Bold" TextColor="#F39200"/><Label Text="·" FontSize="13" TextColor="#344054"/><Label Text="4 Carriers" FontFamily="monospace" FontSize="13" TextColor="#344054"/></HorizontalStackLayout></VerticalStackLayout><Label Grid.Column="2" Text="From $6.00" FontSize="16" FontAttributes="Bold" TextColor="#101C2D" VerticalOptions="Center"/><Label Grid.Column="3" Text="›" FontSize="26" TextColor="#344054" VerticalOptions="Center"/></Grid></Border>
                                <Border Stroke="#EEF2F8" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="0"><Grid ColumnDefinitions="48,*,Auto,Auto" ColumnSpacing="10" Padding="10,15"><Label Text="FR" FontSize="20" TextColor="#101C2D" VerticalOptions="Center" HorizontalTextAlignment="Center"/><VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center"><Label Text="France" FontSize="16" FontAttributes="Bold" TextColor="#101C2D"/><HorizontalStackLayout Spacing="7"><Label Text="★ 4.9" FontSize="13" FontAttributes="Bold" TextColor="#F39200"/><Label Text="·" FontSize="13" TextColor="#344054"/><Label Text="8 Carriers" FontFamily="monospace" FontSize="13" TextColor="#344054"/></HorizontalStackLayout></VerticalStackLayout><Label Grid.Column="2" Text="From $7.50" FontSize="16" FontAttributes="Bold" TextColor="#101C2D" VerticalOptions="Center"/><Label Grid.Column="3" Text="›" FontSize="26" TextColor="#344054" VerticalOptions="Center"/></Grid></Border>
                                <Border Stroke="#EEF2F8" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="0"><Grid ColumnDefinitions="48,*,Auto,Auto" ColumnSpacing="10" Padding="10,15"><Label Text="US" FontSize="20" TextColor="#101C2D" VerticalOptions="Center" HorizontalTextAlignment="Center"/><VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center"><Label Text="United States" FontSize="16" FontAttributes="Bold" TextColor="#101C2D"/><HorizontalStackLayout Spacing="7"><Label Text="★ 4.8" FontSize="13" FontAttributes="Bold" TextColor="#F39200"/><Label Text="·" FontSize="13" TextColor="#344054"/><Label Text="10 Carriers" FontFamily="monospace" FontSize="13" TextColor="#344054"/></HorizontalStackLayout></VerticalStackLayout><Label Grid.Column="2" Text="From $8.00" FontSize="16" FontAttributes="Bold" TextColor="#101C2D" VerticalOptions="Center"/><Label Grid.Column="3" Text="›" FontSize="26" TextColor="#344054" VerticalOptions="Center"/></Grid></Border>
                            </VerticalStackLayout>
                        </Border>
                        <Border BackgroundColor="#EEF3FF" StrokeThickness="0" StrokeShape="RoundRectangle 22" Padding="26,24">
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="4,0,0,20">
                                    <Label Text="&#xE734;" FontFamily="MaterialAssets" FontSize="25" TextColor="#008B63" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="Why eSIM Data Manager?" FontSize="23" FontAttributes="Bold" TextColor="#101C2D" VerticalOptions="Center"/>
                                </Grid>
                                <Grid ColumnDefinitions="54,*" ColumnSpacing="12" Margin="0,0,0,19">
                                    <Border WidthRequest="50" HeightRequest="58" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18"><Label Text="&#xE753;" FontFamily="MaterialAssets" FontSize="24" TextColor="#0752DB" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center"><Label Text="100% Digital Delivery" FontSize="17" FontAttributes="Bold" TextColor="#101C2D"/><Label Text="Install in seconds. No postage, no plastic, no kiosk queue." FontSize="16" TextColor="#344054" LineBreakMode="WordWrap"/></VerticalStackLayout>
                                </Grid>
                                <Grid ColumnDefinitions="54,*" ColumnSpacing="12" Margin="0,0,0,19">
                                    <Border WidthRequest="50" HeightRequest="58" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18"><Label Text="&#xE8BD;" FontFamily="MaterialAssets" FontSize="24" TextColor="#0752DB" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center"><Label Text="Keep WhatsApp &amp; SIM" FontSize="17" FontAttributes="Bold" TextColor="#101C2D"/><Label Text="Receive home 2FA bank texts while roaming on local high-speed data." FontSize="16" TextColor="#344054" LineBreakMode="WordWrap"/></VerticalStackLayout>
                                </Grid>
                                <Grid ColumnDefinitions="54,*" ColumnSpacing="12" Margin="0,0,0,19">
                                    <Border WidthRequest="50" HeightRequest="58" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18"><Label Text="&#xE8C7;" FontFamily="MaterialAssets" FontSize="24" TextColor="#0752DB" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center"><Label Text="Zero Bill Shock" FontSize="17" FontAttributes="Bold" TextColor="#101C2D"/><Label Text="Prepaid transparency. Never return home to an accidental $500 bill." FontSize="16" TextColor="#344054" LineBreakMode="WordWrap"/></VerticalStackLayout>
                                </Grid>
                                <Grid ColumnDefinitions="54,*" ColumnSpacing="12">
                                    <Border WidthRequest="50" HeightRequest="58" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18"><Label Text="&#xE720;" FontFamily="MaterialAssets" FontSize="24" TextColor="#0752DB" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center"><Label Text="24/7 Global SLA Support" FontSize="17" FontAttributes="Bold" TextColor="#101C2D"/><Label Text="Real telecom network engineers ready to help whenever you land." FontSize="16" TextColor="#344054" LineBreakMode="WordWrap"/></VerticalStackLayout>
