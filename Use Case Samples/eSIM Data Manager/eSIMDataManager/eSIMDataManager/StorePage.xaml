                            <sfChip:SfChip Text="US  USA" Clicked="DestinationClicked" Background="White" TextColor="#07152B" FontSize="14" Padding="12,8" WidthRequest="104" HeightRequest="48" HorizontalOptions="Start" VerticalOptions="Center" CornerRadius="24" ChipStroke="#E4EAF5" ChipStrokeThickness="1" />
                            <sfChip:SfChip Text="FR  France" Clicked="DestinationClicked" Background="White" TextColor="#101C2D" FontSize="14" Padding="12,8" WidthRequest="120" HeightRequest="48" HorizontalOptions="Start" VerticalOptions="Center" CornerRadius="24" ChipStroke="#E4EAF5" ChipStrokeThickness="1" />
                            <sfChip:SfChip Text="KR  Korea" Clicked="DestinationClicked" Background="White" TextColor="#101C2D" FontSize="14" Padding="12,8" WidthRequest="118" HeightRequest="48" HorizontalOptions="Start" VerticalOptions="Center" CornerRadius="24" ChipStroke="#E4EAF5" ChipStrokeThickness="1" />
                            <sfChip:SfChip Text="SG  Singapore" Clicked="DestinationClicked" Background="White" TextColor="#101C2D" FontSize="14" Padding="12,8" WidthRequest="154" HeightRequest="48" HorizontalOptions="Start" VerticalOptions="Center" CornerRadius="24" ChipStroke="#E4EAF5" ChipStrokeThickness="1" />
