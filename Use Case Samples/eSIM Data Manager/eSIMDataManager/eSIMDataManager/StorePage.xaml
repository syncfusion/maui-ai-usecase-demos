                        <Border BackgroundColor="#0D50EA" StrokeThickness="0" StrokeShape="RoundRectangle 22" Padding="28,26">
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,0,0,20">
