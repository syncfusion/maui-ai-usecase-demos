                                    <VerticalStackLayout Grid.Row="4" Spacing="5" Margin="3,0,0,14"><Label Text="{Binding FeatureList}" FontSize="12" TextColor="#102B52" LineHeight="1.25" LineBreakMode="WordWrap"/></VerticalStackLayout>
