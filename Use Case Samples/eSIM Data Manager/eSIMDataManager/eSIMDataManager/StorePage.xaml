                </Grid>
                <Border BackgroundColor="#EDF3FF" Stroke="#E8EFFB" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="{OnIdiom Phone=24, Default=60}" MinimumHeightRequest="278">
