<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:sfButton="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons" x:Class="eSIMDataManager.MainPage" Title="eSIM Data Manager">
    <Grid Padding="32" RowDefinitions="Auto,*" RowSpacing="22" BackgroundColor="#F5F7FC">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
            <Label Text="eSIM Data Manager" FontSize="19" FontAttributes="Bold" TextColor="#102B52" VerticalOptions="Center"/>
            <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                <sfButton:SfButton Grid.Column="1" Text="My eSIMs" Clicked="ProfilesClicked" Style="{StaticResource NavigationInactiveButton}"/>
                <sfButton:SfButton Grid.Column="2" Text="Store" Clicked="StoreClicked" Style="{StaticResource NavigationInactiveButton}"/>
            </HorizontalStackLayout>
            <Label Grid.Column="2" Text="Global Traveler · Roaming Online" TextColor="#006B4F" FontSize="12" VerticalOptions="Center"/>
        </Grid>
    </Grid>
</ContentPage>