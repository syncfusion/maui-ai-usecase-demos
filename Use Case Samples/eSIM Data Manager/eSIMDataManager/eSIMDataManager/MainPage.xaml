<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:sfButton="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons" x:Class="eSIMDataManager.MainPage" Title="eSIM Data Manager">
    <Grid Padding="32" RowDefinitions="Auto,*" RowSpacing="22" BackgroundColor="#F5F7FC">
        <VerticalStackLayout><Label Text="eSIM Data Manager" FontSize="28" FontAttributes="Bold" TextColor="#102B52"/><Label Text="Traveler connectivity · simulated data" TextColor="#63748B"/></VerticalStackLayout>
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="18">
            <sfButton:SfButton Text="Dashboard" Clicked="DashboardClicked"/>
            <sfButton:SfButton Grid.Column="1" Text="My eSIMs" Clicked="ProfilesClicked"/>
            <sfButton:SfButton Grid.Column="2" Text="Explore plans" Clicked="StoreClicked"/>
        </Grid>
    </Grid>
</ContentPage>