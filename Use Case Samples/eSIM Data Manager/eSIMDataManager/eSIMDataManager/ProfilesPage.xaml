<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:list="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView" xmlns:tabs="clr-namespace:Syncfusion.Maui.TabView;assembly=Syncfusion.Maui.TabView" xmlns:models="clr-namespace:eSIMDataManager.Models" xmlns:vm="clr-namespace:eSIMDataManager.ViewModels" xmlns:sfButton="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons" x:Class="eSIMDataManager.ProfilesPage" x:DataType="vm:MainViewModel" BackgroundColor="#F8F9FF">
 <ContentPage.Content>
  <Grid RowDefinitions="*,Auto">
   <ScrollView Grid.Row="0"><VerticalStackLayout Padding="24" Spacing="18">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18"><Label Text="eSIM Data Manager" FontSize="19" FontAttributes="Bold" TextColor="#0B1C30" VerticalOptions="Center"/><HorizontalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center"><sfButton:SfButton Text="Dashboard" Clicked="DashboardClicked" Style="{StaticResource NavigationInactiveButton}"/><sfButton:SfButton Text="My eSIMs" Style="{StaticResource NavigationActiveButton}"/><sfButton:SfButton Text="Store" Clicked="StoreClicked" Style="{StaticResource NavigationInactiveButton}"/></HorizontalStackLayout><Label Grid.Column="2" Text="Global Traveler
Roaming Online" FontSize="12" TextColor="#006141" VerticalOptions="Center"/></Grid>
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18"><VerticalStackLayout Spacing="2"><Label Text="My eSIMs" FontSize="32" FontAttributes="Bold" TextColor="#0B1C30"/><Label Text="Manage your active data profiles, pending installations, and travel history" TextColor="#434656"/></VerticalStackLayout><HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center"><SearchBar Placeholder="Search profile or country..." WidthRequest="260" HeightRequest="44"/><sfButton:SfButton Text="☷ Filter" Style="{StaticResource SecondaryButton}"/><sfButton:SfButton Text="＋ Add New eSIM" Clicked="StoreClicked" Style="{StaticResource PrimaryButton}"/></HorizontalStackLayout></Grid>
    <Grid x:Name="Workspace" ColumnDefinitions="0.85*,1.7*" ColumnSpacing="22" SizeChanged="WorkspaceSizeChanged">
     <VerticalStackLayout Grid.Column="0" Spacing="12"><Border BackgroundColor="White" Stroke="#E8ECF5" StrokeShape="RoundRectangle 20" Padding="10"><tabs:SfTabView x:Name="ProfileTabs" HeightRequest="370"><tabs:SfTabView.Items>
      <tabs:SfTabItem Header="Active  1"><tabs:SfTabItem.Content><list:SfListView ItemsSource="{Binding ActiveProfiles}" AutoFitMode="DynamicHeight" SelectionMode="None" BackgroundColor="Transparent"><list:SfListView.ItemTemplate><DataTemplate x:DataType="models:EsimProfile"><Border Style="{StaticResource ProfileCard}" Stroke="#0046CC" StrokeThickness="2"><VerticalStackLayout Spacing="8"><Grid ColumnDefinitions="Auto,*,Auto"><Label Text="🇯🇵" FontSize="24" BackgroundColor="#EFF4FF" Padding="8"/><VerticalStackLayout Grid.Column="1" Margin="8,0"><Label Text="{Binding ProfileName}" FontSize="18" FontAttributes="Bold"/><Label Text="{Binding Carrier}" FontSize="12" TextColor="#434656"/></VerticalStackLayout><Label Grid.Column="2" Text="● Connected" TextColor="#006141" FontSize="12"/></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="{Binding RemainingGb, StringFormat='{0:0.#} GB Remaining'}" TextColor="#0046CC"/><Label Grid.Column="1" Text="6 Days Left"/></Grid><ProgressBar Progress="0.64" ProgressColor="#0D5CFF"/><Grid ColumnDefinitions="*,Auto"><Label Text="3.2 GB used of 5.0 GB" FontSize="11"/><Label Grid.Column="1" Text="64% Consumed" FontSize="11"/></Grid><HorizontalStackLayout><sfButton:SfButton Text="Top Up" Clicked="TopUpItemClicked" Style="{StaticResource SecondaryButton}"/><sfButton:SfButton Text="QR" Clicked="QrItemClicked" Style="{StaticResource SecondaryButton}"/></HorizontalStackLayout></VerticalStackLayout></Border></DataTemplate></list:SfListView.ItemTemplate></list:SfListView></tabs:SfTabItem.Content></tabs:SfTabItem>
      <tabs:SfTabItem Header="Ready  1"><tabs:SfTabItem.Content><list:SfListView ItemsSource="{Binding ReadyProfiles}" AutoFitMode="DynamicHeight" SelectionMode="None" BackgroundColor="Transparent"><list:SfListView.ItemTemplate><DataTemplate x:DataType="models:EsimProfile"><Border Style="{StaticResource ProfileCard}"><VerticalStackLayout><Label Text="{Binding ProfileName}" FontSize="17" FontAttributes="Bold"/><Label Text="{Binding Country}"/><sfButton:SfButton Text="Show QR / Activate demo" Clicked="ActivateItemClicked" Style="{StaticResource PrimaryButton}"/></VerticalStackLayout></Border></DataTemplate></list:SfListView.ItemTemplate></list:SfListView></tabs:SfTabItem.Content></tabs:SfTabItem>
      <tabs:SfTabItem Header="Expired  3"><tabs:SfTabItem.Content><list:SfListView ItemsSource="{Binding ExpiredProfiles}" AutoFitMode="DynamicHeight" SelectionMode="None" BackgroundColor="Transparent"><list:SfListView.ItemTemplate><DataTemplate x:DataType="models:EsimProfile"><Border Style="{StaticResource ProfileCard}"><VerticalStackLayout><Label Text="{Binding ProfileName}" FontSize="17" FontAttributes="Bold"/><Label Text="Expired · sample history"/></VerticalStackLayout></Border></DataTemplate></list:SfListView.ItemTemplate></list:SfListView></tabs:SfTabItem.Content></tabs:SfTabItem>
     </tabs:SfTabView.Items></tabs:SfTabView></Border><Border BackgroundColor="#EFF4FF" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="14"><Label Text="Buying another profile? Access regional store packages with 1-click activation." TextColor="#17345C"/></Border></VerticalStackLayout>
     <VerticalStackLayout Grid.Column="1" Spacing="14">
      <Border Style="{StaticResource PanelCard}"><VerticalStackLayout Spacing="14"><Grid ColumnDefinitions="Auto,*,Auto"><Label Text="🇯🇵" FontSize="30" BackgroundColor="#EFF4FF" Padding="12"/><VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center"><Label Text="Japan 5G Explorer    ● Active" FontSize="23" FontAttributes="Bold" TextColor="#0B1C30"/><Label Text="Carrier: SoftBank Corp.  •  Plan: 14 Days High-Speed" TextColor="#434656"/></VerticalStackLayout><HorizontalStackLayout Grid.Column="2"><sfButton:SfButton Text="⊕ Top Up Data" Clicked="TopUpSelectedClicked" Style="{StaticResource PrimaryButton}"/><sfButton:SfButton Text="Renew Plan" Clicked="RenewSelectedClicked" Style="{StaticResource SecondaryButton}"/></HorizontalStackLayout></Grid>
       <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8"><Border BackgroundColor="#F3F6FF" StrokeThickness="0" Padding="12"><VerticalStackLayout><Label Text="DESTINATION" FontSize="11"/><Label Text="Japan (Nationwide)" FontAttributes="Bold"/></VerticalStackLayout></Border><Border Grid.Column="1" BackgroundColor="#F3F6FF" StrokeThickness="0" Padding="12"><VerticalStackLayout><Label Text="CELLULAR SPEED" FontSize="11"/><Label Text="▮ 5G mmWave / LTE" FontAttributes="Bold"/></VerticalStackLayout></Border><Border Grid.Column="2" BackgroundColor="#F3F6FF" StrokeThickness="0" Padding="12"><VerticalStackLayout><Label Text="DATA ROAMING" FontSize="11"/><Label Text="✓ Enabled" TextColor="#006141" FontAttributes="Bold"/></VerticalStackLayout></Border><Border Grid.Column="3" BackgroundColor="#F3F6FF" StrokeThickness="0" Padding="12"><VerticalStackLayout><Label Text="APN SETUP" FontSize="11"/><Label Text="Automatic (v4/v6)" FontAttributes="Bold"/></VerticalStackLayout></Border></Grid>
       <Border BackgroundColor="#EFF4FF" StrokeThickness="0" Padding="12"><Grid ColumnDefinitions="*,Auto"><Label Text="ICCID:  8981 0200 4819 5012 34 F" FontFamily="monospace" VerticalOptions="Center"/><sfButton:SfButton Grid.Column="1" Text="▢ Copy ICCID" Clicked="CopyIccidClicked" Style="{StaticResource SecondaryButton}"/></Grid></Border></VerticalStackLayout></Border>
      <Border Style="{StaticResource PanelCard}"><VerticalStackLayout Spacing="12"><Grid ColumnDefinitions="*,Auto"><Label Text="◉ Data Usage &amp; Allowance" FontSize="20" FontAttributes="Bold"/><Label Grid.Column="1" Text="Live Synchronized" BackgroundColor="#EFF4FF" Padding="8,3"/></Grid><Grid ColumnDefinitions="*,Auto"><HorizontalStackLayout><Label Text="1.8 GB" FontSize="30" FontAttributes="Bold"/><Label Text=" Remaining of 5.0 GB Total" VerticalOptions="Center"/></HorizontalStackLayout><Label Grid.Column="1" Text="3.2 GB Consumed (64%)" TextColor="#00687A" VerticalOptions="Center"/></Grid><ProgressBar Progress="0.64" ProgressColor="#0046CC"/><Grid ColumnDefinitions="*,Auto"><Label Text="0 GB"/><Label Grid.Column="1" Text="5.0 GB High-Speed Cap"/></Grid><Grid ColumnDefinitions="*,*,*" ColumnSpacing="8"><Border BackgroundColor="#EFF4FF" StrokeThickness="0" Padding="12"><VerticalStackLayout><Label Text="Daily Average Burn"/><Label Text="530 MB /day" FontSize="18" FontAttributes="Bold"/><Label Text="Optimal pacing" TextColor="#006141"/></VerticalStackLayout></Border><Border Grid.Column="1" BackgroundColor="#EFF4FF" StrokeThickness="0" Padding="12"><VerticalStackLayout><Label Text="Connected Network Peak"/><Label Text="5G NR High Band" FontSize="17" FontAttributes="Bold"/><Label Text="Ultra-low latency mesh"/></VerticalStackLayout></Border><Border Grid.Column="2" BackgroundColor="#EFF4FF" StrokeThickness="0" Padding="12"><VerticalStackLayout><Label Text="Safety Speed Cap"/><Label Text="128 kbps" FontSize="18" FontAttributes="Bold"/><Label Text="Backup unlimited safe mode"/></VerticalStackLayout></Border></Grid></VerticalStackLayout></Border>
      <Border Style="{StaticResource PanelCard}"><VerticalStackLayout Spacing="12"><Grid ColumnDefinitions="*,Auto"><Label Text="▣ Plan Validity &amp; Expiry" FontSize="20" FontAttributes="Bold"/><Label Grid.Column="1" Text="Auto-Renew Protected" BackgroundColor="#DDF8FF" Padding="10,5"/></Grid><HorizontalStackLayout><Label Text="6 Days" FontSize="29" FontAttributes="Bold"/><Label Text="Remaining before expiration" VerticalOptions="Center"/></HorizontalStackLayout><ProgressBar Progress="0.57" ProgressColor="#00687A"/><Grid ColumnDefinitions="*,Auto,*"><VerticalStackLayout><Label Text="Nov 14, 2025" FontAttributes="Bold"/><Label Text="08:31 JST (Activated)" FontSize="11"/></VerticalStackLayout><Label Grid.Column="1" Text="8 of 14 Days Elapsed" BackgroundColor="#DCE9FF" Padding="8,3" VerticalOptions="Center"/><VerticalStackLayout Grid.Column="2" HorizontalOptions="End"><Label Text="Nov 28, 2025" FontAttributes="Bold"/><Label Text="23:59 JST (Expires)" FontSize="11"/></VerticalStackLayout></Grid></VerticalStackLayout></Border>
      <Border Style="{StaticResource PanelCard}"><VerticalStackLayout Spacing="12"><Grid ColumnDefinitions="*,Auto"><Label Text="▦ eSIM Activation &amp; QR Code" FontSize="20" FontAttributes="Bold"/><Label Grid.Column="1" Text="♧ Profile Validated" TextColor="#006141"/></Grid><Grid ColumnDefinitions="Auto,*" ColumnSpacing="18"><VerticalStackLayout BackgroundColor="#EFF4FF" Padding="18" HorizontalOptions="Center"><Border BackgroundColor="White" Stroke="#E5EAF5" StrokeShape="RoundRectangle 16" Padding="24"><VerticalStackLayout Spacing="4" HorizontalOptions="Center"><Label Text="▣ ▪ ▫ ▣" FontSize="24"/><Label Text="▪ ▪ ✓ ▪ ▪" FontSize="24" TextColor="#0046CC"/><Label Text="▣ ▪ ▫ ▣" FontSize="24"/></VerticalStackLayout></Border><Label Text="Scan via Camera or in
Settings &gt; Cellular" HorizontalTextAlignment="Center" FontSize="12"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="9"><Border BackgroundColor="#DDFBF0" StrokeThickness="0" Padding="10"><Label Text="▯  Installed on iPhone 16 Pro Max (Device eSIM 1)" TextColor="#006141"/></Border><Label Text="SM-DP+ Address" FontSize="12"/><Border BackgroundColor="#EFF4FF" StrokeThickness="0" Padding="10"><Grid ColumnDefinitions="*,Auto"><Label Text="rsp.global-esim.net" FontFamily="monospace" VerticalOptions="Center"/><sfButton:SfButton Grid.Column="1" Text="▢" Clicked="CopySmDpClicked" Style="{StaticResource LinkButton}"/></Grid></Border><Label Text="Activation Code (Manual Entry)" FontSize="12"/><Border BackgroundColor="#EFF4FF" StrokeThickness="0" Padding="10"><Grid ColumnDefinitions="*,Auto"><Label Text="LPA:1$rsp.global-esim.net$JAP-89182390" FontFamily="monospace" LineBreakMode="TailTruncation" VerticalOptions="Center"/><sfButton:SfButton Grid.Column="1" Text="▢" Clicked="CopyCodeClicked" Style="{StaticResource LinkButton}"/></Grid></Border><Border BackgroundColor="#EFF4FF" StrokeThickness="0" Padding="12"><VerticalStackLayout><Label Text="Quick Traveler Instructions:" FontAttributes="Bold"/><Grid ColumnDefinitions="*,*,*" ColumnSpacing="8"><Border BackgroundColor="White" Padding="8"><Label Text="①
Scan QR Code" HorizontalTextAlignment="Center"/></Border><Border Grid.Column="1" BackgroundColor="White" Padding="8"><Label Text="②
Turn Roaming ON" HorizontalTextAlignment="Center"/></Border><Border Grid.Column="2" BackgroundColor="White" Padding="8"><Label Text="③
Ready to Browse" HorizontalTextAlignment="Center" TextColor="#006141"/></Border></Grid></VerticalStackLayout></Border></VerticalStackLayout></Grid></VerticalStackLayout></Border>
     </VerticalStackLayout>
    </Grid>
    <Label Text="DEMO ONLY · All plans, costs, activation codes, QR details and usage figures are fictional." FontSize="11" TextColor="#63748B" HorizontalTextAlignment="Center"/>
   </VerticalStackLayout></ScrollView>
   <Grid Grid.Row="1" BackgroundColor="White" Padding="28,12" ColumnDefinitions="*,Auto"><Label Text="●  Core Signal: 5G Ultra-Low Latency Mesh" FontFamily="monospace" FontSize="12" TextColor="#006141"/><Label Grid.Column="1" Text="© 2024 eSIM Data Manager. Precision Connectivity Platform." FontSize="12"/></Grid>
  </Grid>
 </ContentPage.Content>
</ContentPage>
