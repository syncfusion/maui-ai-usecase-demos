<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:progressBar="clr-namespace:Syncfusion.Maui.ProgressBar;assembly=Syncfusion.Maui.ProgressBar"
    xmlns:models="clr-namespace:NutriLens.Models"
    xmlns:helpers="clr-namespace:NutriLens.Helpers"
    xmlns:vm="clr-namespace:NutriLens.ViewModels"
    x:Class="NutriLens.Views.HistoryPage"
    xmlns:desktop="clr-namespace:NutriLens.Views"
    x:DataType="vm:HistoryViewModel"
    BackgroundColor="#F4F7FB"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>

            <!-- Converts values such as 92/100 to 92 -->
            <helpers:HistoryScoreConverter
                x:Key="HistoryScoreConverter" />

            <!-- Material icon style -->
            <Style
                x:Key="HistoryIconStyle"
                TargetType="Label">

                <Setter Property="FontFamily" Value="MaterialIconsRegular" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
            </Style>

            <!-- Bottom navigation button style -->
            <Style
                x:Key="HistoryNavButtonStyle"
                TargetType="buttons:SfButton">

                <Setter Property="WidthRequest" Value="44" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="FontFamily" Value="MaterialIconsRegular" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Stroke" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
            </Style>

            <!-- History card style -->
            <Style
                x:Key="HistoryCardStyle"
                TargetType="Border">

                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="Transparent" />
                <Setter Property="Padding" Value="14" />

                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="18" />
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid
        RowDefinitions="{OnIdiom Phone='Auto,*,80',Default='Auto,*'}"
        BackgroundColor="#F4F7FB">

        <!-- Header -->
        <Grid
            Grid.Row="0"
            Padding="20,18,20,10"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="12">

            <HorizontalStackLayout
                Spacing="9"
                VerticalOptions="Center">

                <Border
                    WidthRequest="34"
                    HeightRequest="34"
                    BackgroundColor="#DDF5EA"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 17">

                    <Label
                        Text="{Binding BiotechIcon}"
                        Style="{StaticResource HistoryIconStyle}"
                        FontSize="21"
                        TextColor="#047857" />
                </Border>

                <Label
                    Text="NutriLens AI"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#102A43"
                    VerticalTextAlignment="Center" />
            </HorizontalStackLayout>

            <!-- Desktop navigation -->
            <desktop:DesktopHeaderNavigation Grid.Column="1"  HorizontalOptions="End" 
                                VerticalOptions="Center"
                                CurrentPage="History" />
            
            <buttons:SfButton
                Grid.Column="2"
                WidthRequest="42"
                HeightRequest="42"
                Text="{Binding PersonIcon}"
                FontFamily="MaterialIconsRegular"
                FontSize="21"
                TextColor="White"
                Background="#047857"
                Stroke="Transparent"
                CornerRadius="21"
                Padding="0"
                Clicked="OnProfileClicked"
                SemanticProperties.Description="Open profile" />
        </Grid>
        
        <!-- Page content --> 

        <VerticalStackLayout Grid.Row="1"
                Padding="20,12,20,110"
                Spacing="18">

                <!-- Page title -->
                <VerticalStackLayout Spacing="5">

                    <Label
                        Text="Scan History"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="#0F172A" />

                    <Label
                        Text="Review your past nutritional analyses."
                        FontSize="14"
                        TextColor="#64748B" />
                </VerticalStackLayout>

                <!-- Search -->
                <Border
                    Padding="0"
                    BackgroundColor="White"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 16">

                    <core:SfTextInputLayout
                        x:Name="SearchInputLayout"
                        HeightRequest="60"
                        Hint="Search by product name..."
                        ContainerType="Outlined"
                        Stroke="Transparent"
                        Background="White" ReserveSpaceForAssistiveLabels="False"
                        HorizontalOptions="Fill">

                        <core:SfTextInputLayout.LeadingView>
                            <Label
                                Text="{Binding SearchIcon}"
                                Style="{StaticResource HistoryIconStyle}"
                                FontSize="21"
                                TextColor="#64748B"
                                Margin="0,3,0,0" />
                        </core:SfTextInputLayout.LeadingView> 

                        <Entry
                            x:Name="SearchEntry"
                            Text="{Binding SearchText, Mode=TwoWay}"
                            HeightRequest="46"
                            FontSize="14"
                            TextColor="#0F172A"
                            Placeholder="Search by product name..."
                            PlaceholderColor="#94A3B8"
                            ClearButtonVisibility="WhileEditing"
                            BackgroundColor="Transparent"
                            Focused="OnSearchFocused"
                            Unfocused="OnSearchUnfocused" />
                    </core:SfTextInputLayout>
                </Border>

                <!-- Time filters -->
                <ScrollView
                    HeightRequest="44"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    VerticalScrollBarVisibility="Never">

                    <core:SfChipGroup
                        ItemsSource="{Binding UnselectedFilters}"
                        ChipType="Choice"
                        ChoiceMode="Single"
                        SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                        ItemHeight="38"
                        ChipPadding="16,0"
                        ChipCornerRadius="19"
                        ChipBackground="#E6EEF8"
                        SelectedChipBackground="#047857"
                        SelectedChipTextColor="White"
                        ChipTextColor="#334155"
                        ChipTextSize="13"
                        ChipFontAttributes="None"
                        ChipStroke="Transparent"
                        ChipStrokeThickness="0"
                        HorizontalOptions="Start"
                        VerticalOptions="Center" />
                </ScrollView>

                <!-- Result summary -->
                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="8">

                    <Label
                        Text="Recent scans"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#0F172A" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding SummaryText}"
                        FontSize="13"
                        TextColor="#64748B"
                        VerticalTextAlignment="Center" />
                </Grid>

                <!-- History list -->
                <listView:SfListView
                    ItemsSource="{Binding HistoryItems}"
                    ItemSize="100"   HeightRequest="400"
                    SelectionMode="None"
                    ItemSpacing="0,12,0,0"
                    Background="Transparent"
                    ItemTapped="OnHistoryItemTapped">

                    <listView:SfListView.ItemTemplate>
                        <DataTemplate x:DataType="models:HistoryItem">

                            <Border
                                Style="{StaticResource HistoryCardStyle}">

                                <Border.Shadow>
                                    <Shadow
                                        Brush="#24000000"
                                        Offset="0,3"
                                        Radius="10"
                                        Opacity="0.35" />
                                </Border.Shadow>

                                <Grid
                                    ColumnDefinitions="64,*,116"
                                    ColumnSpacing="13" >

                                    <!-- Product thumbnail -->
                                    <Border
                                        WidthRequest="64"
                                        HeightRequest="64"
                                        BackgroundColor="#EFF4F2"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 14"
                                        VerticalOptions="Center">

                                        <Image
                                            Source="{Binding Image}"
                                            Aspect="AspectFill"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill" />
                                    </Border>

                                    <!-- Product information -->
                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="6"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="{Binding ProductName}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="#0F172A"
                                            MaxLines="1"
                                            LineBreakMode="TailTruncation" />

                                        <HorizontalStackLayout
                                            Spacing="5">

                                            <Label
                                                Text="{Binding ScanDate}"
                                                FontSize="12"
                                                TextColor="#64748B"
                                                VerticalTextAlignment="Center"
                                                LineBreakMode="TailTruncation" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <!-- Score and chevron -->
                                    <Grid
    Grid.Column="2"
    ColumnDefinitions="68,Auto"
    ColumnSpacing="8"
    VerticalOptions="Center">

                                        <Grid
        Grid.Column="0"
        WidthRequest="68"
        HeightRequest="68">

                                            <progressBar:SfCircularProgressBar
            WidthRequest="68"
            HeightRequest="68"
            Progress="{Binding Score, Converter={StaticResource HistoryScoreConverterCircular}}"
            Maximum="100"
            ProgressFill="{Binding ScoreColor, Converter={StaticResource HistoryScoreBrushConverter}}"
            TrackFill="#E5EAF0" 
            HorizontalOptions="Center"
            VerticalOptions="Center" />

                                            <Label
            Text="{Binding Score}"
            FontSize="13"
            FontAttributes="Bold"
            TextColor="#0F172A"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            HorizontalTextAlignment="Center"
            VerticalTextAlignment="Center" />
                                        </Grid>

                                        <Label
        Grid.Column="1"
        Text="&#xE5CC;"
        Style="{StaticResource HistoryIconStyle}"
        FontSize="22"
        TextColor="#94A3B8"
        VerticalOptions="Center"
        SemanticProperties.Description="Open scan analysis" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </listView:SfListView.ItemTemplate>
                </listView:SfListView>
            </VerticalStackLayout> 

        <!-- Bottom navigation -->
        <Grid
            Grid.Row="2"
            HeightRequest="84"
            ZIndex="10" IsVisible="{OnIdiom Phone=true, Default=false}"
            ColumnDefinitions="*,*,*,*,*"
            BackgroundColor="White">

            <Grid.Shadow>
                <Shadow
                    Brush="#40000000"
                    Offset="0,-4"
                    Radius="12"
                    Opacity="0.35" />
            </Grid.Shadow>

            <!-- Home -->
            <VerticalStackLayout
                Grid.Column="0"
                Spacing="1"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <buttons:SfButton
                    Text="{Binding HomeIcon}"
                    Style="{StaticResource HistoryNavButtonStyle}"
                    TextColor="#6B7280"
                    Clicked="OnHomeClicked"
                    SemanticProperties.Description="Open home" />

                <Label
                    Text="Home"
                    FontSize="10"
                    TextColor="#6B7280"
                    HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- History -->
            <VerticalStackLayout
                Grid.Column="1"
                Spacing="1"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <buttons:SfButton
                    Text="{Binding HistoryIcon}"
                    Style="{StaticResource HistoryNavButtonStyle}"
                    TextColor="#047857"
                    SemanticProperties.Description="Current page: history" />

                <Label
                    Text="History"
                    FontSize="10"
                    FontAttributes="Bold"
                    TextColor="#047857"
                    HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Floating scan button -->
            <Grid
                Grid.Column="2"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                TranslationY="-34"
                ZIndex="20">

                <Border
                    WidthRequest="72"
                    HeightRequest="72"
                    BackgroundColor="#047857"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 36">

                    <Border.Shadow>
                        <Shadow
                            Brush="#55000000"
                            Offset="0,6"
                            Radius="12"
                            Opacity="0.75" />
                    </Border.Shadow>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="OnScanClicked" />
                    </Border.GestureRecognizers>

                    <Grid
                        RowDefinitions="*,Auto"
                        Padding="0,9,0,8">

                        <Label
                            Text="{Binding ScannerIcon}"
                            Style="{StaticResource HistoryIconStyle}"
                            FontSize="28"
                            TextColor="White"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Row="1"
                            Text="SCAN"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalTextAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Trends -->
            <VerticalStackLayout
                Grid.Column="3"
                Spacing="1"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <buttons:SfButton
                    Text="{Binding TrendsIcon}"
                    Style="{StaticResource HistoryNavButtonStyle}"
                    TextColor="#6B7280"
                    Clicked="OnTrendsClicked"
                    SemanticProperties.Description="Open trends" />

                <Label
                    Text="Trends"
                    FontSize="10"
                    TextColor="#6B7280"
                    HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Profile -->
            <VerticalStackLayout
                Grid.Column="4"
                Spacing="1"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <buttons:SfButton
                    Text="{Binding ProfileIcon}"
                    Style="{StaticResource HistoryNavButtonStyle}"
                    TextColor="#6B7280"
                    Clicked="OnProfileClicked"
                    SemanticProperties.Description="Open profile" />

                <Label
                    Text="Profile"
                    FontSize="10"
                    TextColor="#6B7280"
                    HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>