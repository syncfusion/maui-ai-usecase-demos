<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HomeInventoryManager.Views.ScanPage"
             x:Name="scanPage"
             Shell.NavBarIsVisible="False"
			 xmlns:behaviors="clr-namespace:HomeInventoryManager.Behaviors"
			 xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
			 xmlns:editors="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
			 xmlns:picker="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
			 xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
			 BackgroundColor="White"			 
			 xmlns:controls="clr-namespace:HomeInventoryManager.Views"
			 xmlns:sys="clr-namespace:System;assembly=netstandard">

	<Grid RowDefinitions="{OnIdiom Default='*', Phone='*,72'}"
		  ColumnDefinitions="{OnIdiom Default='200,*', Phone='*'}">
		<!-- Shared sidebar with active-tab-aware nav rows. -->
		<controls:AppSideBar Grid.Row="{OnIdiom Default=0, Phone=1}"
							 Grid.Column="{OnIdiom Default='0', Phone='0'}"
							 ActiveTab="Scan" />

		<ScrollView Grid.Row="{OnIdiom Default=0, Phone=0}"
					Grid.Column="{OnIdiom Default='1', Phone='0'}">
			<VerticalStackLayout MaximumWidthRequest="1200"
								 Padding="{OnIdiom Default='24,20', Phone='16,12', Tablet='20,16', Desktop='24,20'}">

				<Label Grid.ColumnSpan="{OnIdiom Default='2', Phone='1'}"
					   Text="Add New Item"
					   Padding="{OnIdiom Default='0,2,0,4', Phone='0,4,0,0', Tablet='0,2,0,4', Desktop='0,2,0,4'}"
					   FontSize="{OnIdiom Default=22, Phone=18, Tablet=20, Desktop=22}"
					   FontAttributes="Bold"
					   TextColor="#1E3A8A"
					   VerticalOptions="Start"
					   HorizontalOptions="Start" />

				<!--<Grid ColumnDefinitions="*"
                  Padding="{OnIdiom Default='0,2,0,4', Phone='0,4,0,0', Tablet='0,2,0,4', Desktop='0,2,0,4'}">


                <Label Text="Add New Item"
                       FontSize="{OnIdiom Default=22, Phone=18, Tablet=20, Desktop=22}"
                       FontAttributes="Bold"
                       TextColor="#1E3A8A"
                       VerticalOptions="Center"
                       HorizontalOptions="Start" />
			</Grid>-->

				<!--  TOP HALF — vibrant capture hero (Choose stage)              -->				<Grid IsVisible="{Binding IsInChooseStage}"
					  Margin="0,8,0,0"
					  ColumnDefinitions="{OnIdiom Default='600', Phone='*'}"					  HorizontalOptions="Start">
					<!--<Border HeightRequest="{OnIdiom Default='350', Phone='350'}"
							IsVisible="{OnIdiom Default='True', Phone='False'}"
							StrokeShape="RoundRectangle 8">						<Border.Background>
							<LinearGradientBrush StartPoint="0,0"
												 EndPoint="1,0">

								<GradientStop Color="#630ED4"
											  Offset="0.0" />

								<GradientStop Color="#7C3AED"
											  Offset="0.5" />

								<GradientStop Color="#732EE4"
											  Offset="1.0" />

							</LinearGradientBrush>
						</Border.Background>						<VerticalStackLayout VerticalOptions="Center"
											 Spacing="0">
							--><!--  Display the svg illustration image  --><!--							<Image Source="nophotos.png"
								   Margin="0,20,0,0"
								   VerticalOptions="Center"
								   WidthRequest="{x:OnIdiom Phone=200,Desktop=300,Tablet=300}" />
							--><!--  Label to display header  --><!--							<Label Margin="0,32,0,8"
								   FontSize="22"
								   Text="No photos"
								   TextColor="White"
								   VerticalTextAlignment="Center"
								   HorizontalTextAlignment="Center" />
							--><!--  Label to display content  --><!--							<Label Margin="8,0,8,0"
								   FontSize="16"
								   LineHeight="{OnPlatform Android=1.25, Default=-1}"
								   TextColor="White"
								   Text="You haven't selected any photos yet"
								   VerticalTextAlignment="Center"
								   HorizontalTextAlignment="Center" />						</VerticalStackLayout>
					</Border>-->


					<Border Stroke="{StaticResource CardBorder}"
							StrokeThickness="0.6"
							Margin="{OnIdiom Default='8', Phone='0'}"
							StrokeShape="RoundRectangle 8"
							Padding="0">

						<!--HeightRequest="{OnIdiom Default='350', Phone='350'}"-->

						<Grid RowDefinitions="*,Auto" ColumnDefinitions="*">

							<!-- Vibrant copy + corner accents -->
							<Grid Grid.Row="0"
								  RowDefinitions="Auto,*,Auto"
								  ColumnDefinitions="Auto,*,Auto"
								  Padding="20">

								<BoxView Grid.Row="0"
										 Grid.Column="0"
										 WidthRequest="36"
										 HeightRequest="4"
										 Color="#5F5E60"
										 Opacity="0.85"
										 HorizontalOptions="Start"
										 VerticalOptions="Start" />
								<BoxView Grid.Row="2"
										 Grid.Column="0"
										 WidthRequest="4"
										 HeightRequest="36"
										 Color="#5F5E60"
										 Opacity="0.85"
										 HorizontalOptions="Start"
										 VerticalOptions="Start" />
								<BoxView Grid.Row="2"
										 Grid.Column="2"
										 WidthRequest="4"
										 HeightRequest="36"
										 Color="#5F5E60"
										 Opacity="0.85"
										 HorizontalOptions="End"
										 VerticalOptions="Start" />
								<BoxView Grid.Row="0"
										 Grid.Column="0"
										 WidthRequest="4"
										 HeightRequest="36"
										 Color="#5F5E60"
										 Opacity="0.85"
										 HorizontalOptions="Start"
										 VerticalOptions="Start" />

								<BoxView Grid.Row="0"
										 Grid.Column="2"
										 WidthRequest="4"
										 HeightRequest="36"
										 Color="#5F5E60"
										 Opacity="0.85"
										 HorizontalOptions="End"
										 VerticalOptions="Start" />
								<BoxView Grid.Row="0"
										 Grid.Column="2"
										 WidthRequest="36"
										 HeightRequest="4"
										 Color="#5F5E60"
										 Opacity="0.85"
										 HorizontalOptions="End"
										 VerticalOptions="Start" />

								<BoxView Grid.Row="2"
										 Grid.Column="0"
										 WidthRequest="36"
										 HeightRequest="4"
										 Color="#5F5E60"
										 Opacity="0.85"
										 HorizontalOptions="Start"
										 VerticalOptions="End" />
								<BoxView Grid.Row="2"
										 Grid.Column="2"
										 WidthRequest="36"
										 HeightRequest="4"
										 Color="#5F5E60"
										 Opacity="0.85"
										 HorizontalOptions="End"
										 VerticalOptions="End" />

								<VerticalStackLayout Grid.Row="{OnIdiom Default='1', Phone='1'}"
													 Grid.ColumnSpan="3"
													 HorizontalOptions="Center"
													 VerticalOptions="Center"
													 Spacing="6">
									<Label Text="📷"
										   FontSize="{OnIdiom Default='56', Phone='32'}"
										   TextColor="White"
										   HorizontalOptions="Center" />
									<Label Text="Add a product photo"
										   FontSize="{OnIdiom Default='20', Phone='18'}"
										   FontAttributes="Bold"
										   TextColor="#5F5E60"
										   HorizontalOptions="Center" />
									<Label Text="Use your camera or pick an existing photo. We'll handle the rest."
										   FontSize="13"
										   TextColor="#5F5E60"
										   Opacity="0.85"
										   HorizontalTextAlignment="Center"
										   HorizontalOptions="Center" />
								</VerticalStackLayout>
							</Grid>

							<!-- Two big CTAs -->
							<HorizontalStackLayout Grid.Row="1"
												   Spacing="12"
												   Padding="{OnIdiom Default='16,0,16,16', Phone='2,0,2,16'}"
												   HorizontalOptions="Center">

								<buttons:SfButton Text="Take Photo"
											      WidthRequest="{OnIdiom Default='-1', Phone='168'}"
												  Style="{StaticResource FormsButtonStyle}"
												  Clicked="TakePhoto_Clicked" />

								<buttons:SfButton Text="Upload Photo"
												  WidthRequest="{OnIdiom Default='-1', Phone='168'}"
												  Style="{StaticResource FormsButtonStyle}"
												  Clicked="UploadPhoto_Clicked" />
							</HorizontalStackLayout>
						</Grid>
					</Border>

				</Grid>

				<!--  TOP HALF — captured photo preview (Confirm stage)           -->

				<Grid IsVisible="{Binding IsInConfirmStage}"
					  ColumnDefinitions="{OnIdiom Default='600', Phone='*'}"
					  HorizontalOptions="Start">

					<Border BackgroundColor="#FFFFFF"
							Stroke="{StaticResource CardBorder}"
							StrokeThickness="0.6"
							Margin="0,8,0,0"
							StrokeShape="RoundRectangle 8"
							Padding="16">
							
							<!--HeightRequest="{OnIdiom Default='400', Phone='400'}"-->

						<VerticalStackLayout Spacing="14">

							<Grid ColumnDefinitions="40,*"
								  ColumnSpacing="12"
								  VerticalOptions="Center">
								<Border WidthRequest="40"
										HeightRequest="40"
										BackgroundColor="{StaticResource Surface}"
										StrokeShape="RoundRectangle 8">
									<Label Text="🖼"
										   FontSize="18"
										   HorizontalOptions="Center"
										   VerticalOptions="Center" />
								</Border>
								<VerticalStackLayout Grid.Column="1"
													 Spacing="2"
													 VerticalOptions="Center">
									<Label Text="Photo attached"
										   FontFamily="OpenSansSemibold"
										   FontAttributes="Bold"
										   FontSize="15"
										   TextColor="{StaticResource TextPrimary}" />
								</VerticalStackLayout>
							</Grid>

							<Border BackgroundColor="{StaticResource Surface}"
									Stroke="{StaticResource CardBorder}"
									StrokeThickness="0.6"
									StrokeShape="RoundRectangle 8"
									Padding="8">
								<Image Source="{Binding CurrentItem.ImagePreview}"
									   Aspect="AspectFit" />
							</Border>

							<HorizontalStackLayout HorizontalOptions="End"
												   Spacing="8"
												   Margin="0,0,8,0">
								<buttons:SfButton Text="Cancel"
												  Style="{StaticResource FormsButtonStyle}"
												  Clicked="CancelCapture_Clicked" />
								<buttons:SfButton Text="Continue"
												  Style="{StaticResource FormsButtonStyle}"
												  Clicked="Continue_Clicked" />
							</HorizontalStackLayout>
						</VerticalStackLayout>
					</Border>

				</Grid>

				<Border IsVisible="{Binding IsInReviewStage}"
						BackgroundColor="White"
						Stroke="{StaticResource CardBorder}"
						StrokeShape="RoundRectangle 12"
						Margin="0,8,0,0"
						Padding="{OnIdiom Default='18', Phone='8'}">

					<Grid ColumnDefinitions="{OnIdiom Default='520,*', Phone='*'}"
						  RowDefinitions="{OnIdiom Default='*', Phone='Auto,*'}"
						  ColumnSpacing="{OnIdiom Default='24', Phone='8'}"
						  RowSpacing="{OnIdiom Default='16', Phone='8'}">


						<Border HeightRequest="{OnIdiom Default='440', Phone='300'}"
								Stroke="{StaticResource CardBorder}"
								BackgroundColor="{StaticResource Surface}"
								StrokeShape="RoundRectangle 8"
								Padding="{OnIdiom Default='12', Phone='8'}">

							<Image Source="{Binding CurrentItem.ImagePreview}"
								   Aspect="AspectFit" />
						</Border>

						<!-- RIGHT SIDE -->

						<Grid Grid.Column="{OnIdiom Default='1', Phone='0'}"
						      Grid.Row="{OnIdiom Default='0', Phone='1'}"
							  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
							  ColumnDefinitions="*"
							  ColumnSpacing="16"
							  RowSpacing="{OnIdiom Default='14', Phone='4'}">

							<!-- Product -->

							<inputLayout:SfTextInputLayout Grid.Row="0"
														   Grid.Column="0"
														   Hint="Product"
														   ContainerType="Outlined">

								<Entry Text="{Binding CurrentItem.ProductName}" />
							</inputLayout:SfTextInputLayout>

							<!-- Brand -->

							<inputLayout:SfTextInputLayout Grid.Row="1"
														   Grid.Column="0"
														   Hint="Brand"
														   ContainerType="Outlined">

								<Entry Text="{Binding CurrentItem.Brand}" />
							</inputLayout:SfTextInputLayout>

							<!-- Category -->

							<inputLayout:SfTextInputLayout Grid.Row="2"
														   Grid.Column="0"
														   Hint="Category"
														   ContainerType="Outlined">

								<Entry Text="{Binding CurrentItem.Category}"/>
							</inputLayout:SfTextInputLayout>

							<!-- Price -->

							<inputLayout:SfTextInputLayout Grid.Row="3"
														   Grid.Column="0"
														   Hint="Purchase Price"
														   ContainerType="Outlined">

								<editors:SfNumericEntry Value="{Binding CurrentItem.Amount}" />
							</inputLayout:SfTextInputLayout>

							<!-- Purchase Date -->

							<inputLayout:SfTextInputLayout Grid.Row="4"
														   Grid.Column="0"
														   Hint="Purchase Date"
														   ContainerType="Outlined">

								<editors:SfMaskedEntry Mask="00/00/0000"
													   MaskType="Simple"
													   Value="{Binding PurchaseDateString}" />
							</inputLayout:SfTextInputLayout>

							<!-- Warranty -->

							<inputLayout:SfTextInputLayout Grid.Row="5"
														   Grid.Column="0"
														   Hint="Warranty EndDate"
														   ContainerType="Outlined">

								<editors:SfMaskedEntry Mask="00/00/0000"
													   MaskType="Simple"
													   Value="{Binding WarrantyEndDateString}" />
							</inputLayout:SfTextInputLayout>

							<HorizontalStackLayout HorizontalOptions="End"
												   Grid.Row="6"
												   Grid.Column="0"
												   Margin="4">
								<buttons:SfButton Text="Cancel"
												  Style="{StaticResource FormsButtonStyle}"
												  Clicked="CancelReview_Clicked" />
								<buttons:SfButton Margin="4"
												  Text="Save to Inventory"
												  Style="{StaticResource FormsButtonStyle}"
												  Clicked="Save_Clicked" />
							</HorizontalStackLayout>

						</Grid>

					</Grid>

				</Border>

			</VerticalStackLayout>

		</ScrollView>

	</Grid>

</ContentPage>
