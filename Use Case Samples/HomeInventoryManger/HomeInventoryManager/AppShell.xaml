<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="HomeInventoryManager.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:HomeInventoryManager.Views"
       Shell.NavBarIsVisible="True">
    <ShellContent Route="Dashboard"
                  Title="Dashboard"
                  ContentTemplate="{DataTemplate views:DashboardPage}" />
    <ShellContent Route="Inventory"
                  Title="Inventory"
                  ContentTemplate="{DataTemplate views:InventoryPage}" />
    <ShellContent Route="Scan"
                  Title="Scan"
                  ContentTemplate="{DataTemplate views:ScanPage}" />
    <ShellContent Route="Warranty"
                  Title="Warranty"
                  ContentTemplate="{DataTemplate views:WarrantyPage}" />
</Shell>
