<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tree="clr-namespace:Syncfusion.Maui.TreeView;assembly=Syncfusion.Maui.TreeView"
             xmlns:controls="clr-namespace:MauiNotes.Controls"
             xmlns:popups="clr-namespace:MauiNotes.Controls.Popups"
             xmlns:vm="clr-namespace:MauiNotes.ViewModels"
             xmlns:models="clr-namespace:MauiNotes.Models"
             x:Class="MauiNotes.Views.Notes.NotesPageMobileUI"
             x:DataType="vm:NotesViewModel"
             Title="Notes"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F5F5F7">
    <Grid RowDefinitions="58,44,Auto,*" Padding="16,8">
        <Grid ColumnDefinitions="*,44" ColumnSpacing="8">
            <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                <Label Text="Notes"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#222329"
                       LineBreakMode="TailTruncation" />
                <Label Text="{Binding SelectedCountText}"
                       FontSize="12"
                       TextColor="#7C7D84"
                       LineBreakMode="TailTruncation" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="&#xE712;"
                    FontFamily="MauiMaterialAssets"
                    FontSize="18"
                    TextColor="#52545B"
                    BackgroundColor="Transparent"
                    Command="{Binding CreateRootFolderCommand}"
                    WidthRequest="44"
                    HeightRequest="44"
                    MinimumWidthRequest="44"
                    MinimumHeightRequest="44"
                    Padding="0"
                    SemanticProperties.Description="Create folder" />
        </Grid>

        <Border Grid.Row="1"
                HeightRequest="36"
                MinimumHeightRequest="36"
                MaximumHeightRequest="36"
                Padding="8,0"
                Background="White"
                Stroke="#ECECEF"
                StrokeThickness="0.5"
                StrokeShape="RoundRectangle 18"
                VerticalOptions="Center">
            <Grid ColumnDefinitions="24,*"
                  ColumnSpacing="8"
                  RowDefinitions="36">
                <Label Grid.Column="0"
                       Text="&#xE8B6;"
                       FontFamily="MaterialIconRegular"
                       FontSize="16"
                       TextColor="#6E6E73"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       SemanticProperties.Description="Search" />
                <controls:BorderlessEntry Grid.Column="1"
                                          Text="{Binding SearchText, Mode=TwoWay}"
                                          Placeholder="Search"
                                          PlaceholderColor="#85868E"
                                          TextColor="#29292D"
                                          FontSize="14"
                                          HeightRequest="36"
                                          MinimumHeightRequest="0"
                                          Margin="0"
                                          Background="Transparent"
                                          HorizontalOptions="Fill"
                                          VerticalOptions="Fill"
                                          HorizontalTextAlignment="Start"
                                          VerticalTextAlignment="Center"
                                          ReturnType="Search"
                                          ClearButtonVisibility="WhileEditing" />
            </Grid>
        </Border>

        <Label Grid.Row="2"
               Text="{Binding PersistenceStatus}"
               IsVisible="{Binding HasPersistenceStatus}"
               FontSize="10"
               TextColor="#74757D"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               Margin="0,0,0,4">
            <Label.Triggers>
                <DataTrigger TargetType="Label"
                             Binding="{Binding IsPersistenceStatusError}"
                             Value="True">
                    <Setter Property="TextColor" Value="#B3261E" />
                </DataTrigger>
            </Label.Triggers>
        </Label>

        <tree:SfTreeView x:Name="NotesTreeView"
                         Grid.Row="3"
                         ItemsSource="{Binding TreeNodes}"
                         ChildPropertyName="Children"
                         SelectionMode="Single"
                         SelectedItem="{Binding SelectedTreeNode, Mode=TwoWay}"
                         AutoExpandMode="None"
                         IsAnimationEnabled="False"
                         FilterMode="Contains"
                         FilterPath="Title"
                         FilterText="{Binding SearchText}"
                         AutoExpandOnFilter="True"
                         Indentation="18"
                         ExpanderWidth="24"
                         ItemHeight="56"
                         BackgroundColor="Transparent"
                         SelectionBackground="Transparent">
            <tree:SfTreeView.ExpanderTemplate>
                <DataTemplate>
                    <Grid WidthRequest="24"
                  HeightRequest="56"
                  HorizontalOptions="Center"
                  VerticalOptions="Fill">

                        <Label Text="&#xE5CC;"
                       FontFamily="MaterialIconRegular"
                       FontSize="18"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                     Binding="{Binding IsExpanded}"
                                     Value="True">
                                    <Setter Property="Text"
                                    Value="&#xE5CF;" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>

                    </Grid>
                </DataTemplate>
            </tree:SfTreeView.ExpanderTemplate>
            <tree:SfTreeView.ItemTemplate>
                <DataTemplate x:DataType="models:NoteTreeNode">
                    <Grid>
                        <Border IsVisible="{Binding IsFolder}"
                                Margin="0,2"
                                Padding="10,6"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 6"
                                BackgroundColor="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="#EDEDEF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>
                            <Grid ColumnDefinitions="Auto,*,Auto,32" ColumnSpacing="8">
                                <Label Text="&#xE712;" FontFamily="MauiMaterialAssets" FontSize="14"
                                       TextColor="#1F1F24" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="#4C4D53" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Grid.Column="1" Text="{Binding Title}" FontSize="14" TextColor="#29292D"
                                       VerticalOptions="Center" LineBreakMode="TailTruncation">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="#4C4D53" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Grid.Column="2" Text="{Binding NoteCount}" FontSize="12" TextColor="#A0A0A7"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="3"
                                        Text="&#xE759;"
                                        FontFamily="MauiMaterialAssets"
                                        FontSize="16"
                                        TextColor="#6C6C73"
                                        BackgroundColor="Transparent"
                                        Padding="0"
                                        WidthRequest="32"
                                        HeightRequest="32"
                                        MinimumWidthRequest="32"
                                        MinimumHeightRequest="32"
                                        VerticalOptions="Center"
                                        Clicked="OnNodeMenuClicked"
                                        SemanticProperties.Description="Folder actions" />
                            </Grid>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#EDEDEF" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFolderRowTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border IsVisible="{Binding IsNote}"
                                Margin="0,2"
                                Padding="10,6"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 6"
                                BackgroundColor="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="#EDEDEF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>
                            <Grid ColumnDefinitions="*,32" ColumnSpacing="4">
                                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                    <Label Text="{Binding Title}" FontSize="14" TextColor="#29292D"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding PreviewLine}" FontSize="12" TextColor="#8D8D95"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1"
                                        Text="&#xE759;"
                                        FontFamily="MauiMaterialAssets"
                                        FontSize="16"
                                        TextColor="#6C6C73"
                                        BackgroundColor="Transparent"
                                        Padding="0"
                                        WidthRequest="32"
                                        HeightRequest="32"
                                        MinimumWidthRequest="32"
                                        MinimumHeightRequest="32"
                                        VerticalOptions="Center"
                                        Clicked="OnNodeMenuClicked"
                                        SemanticProperties.Description="Note actions" />
                            </Grid>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#EDEDEF" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotesViewModel}}, Path=OpenNoteCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>
                </DataTemplate>
            </tree:SfTreeView.ItemTemplate>
        </tree:SfTreeView>
        <popups:NodeActionPopups x:Name="NodeActionPopups" Grid.RowSpan="4" />
    </Grid>
</ContentPage>