<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartVehicleCare.ViewModels"
             xmlns:assistView="clr-namespace:Syncfusion.Maui.AIAssistView;assembly=Syncfusion.Maui.AIAssistView"
             xmlns:syncTheme="clr-namespace:Syncfusion.Maui.Themes;assembly=Syncfusion.Maui.Core"
             x:Class="SmartVehicleCare.Views.AIAssistPage"
             BackgroundColor="{AppThemeBinding Light=#FAF9F5, Dark=#111009}">

    <ContentView.Resources>
        <syncTheme:SyncfusionThemeDictionary>
            <syncTheme:SyncfusionThemeDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <x:String x:Key="SfAIAssistViewTheme">CustomTheme</x:String>
                    <!-- Light-theme defaults; code-behind updates these per theme change -->
                    <Color x:Key="SfAIAssistViewInputViewBackground">#FCFCFC</Color>
                    <Color x:Key="SfAIAssistViewEditorBackground">#FCFCFC</Color>
                    <Color x:Key="SfAIAssistViewEditorTextColor">#1E293B</Color>
                    <Color x:Key="SfAIAssistViewEditorPlaceholderTextColor">#94A3B8</Color>
                    <Color x:Key="SfAIAssistViewEditorStroke">#E2E8F0</Color>
                </ResourceDictionary>
            </syncTheme:SyncfusionThemeDictionary.MergedDictionaries>
        </syncTheme:SyncfusionThemeDictionary>
    </ContentView.Resources>

    <!--
        BindingContext on inner Grid so IsVisible on this element in MainPage.xaml
        still resolves against the inherited MainViewModel.
    -->
    <Grid x:Name="RootGrid" x:DataType="vm:AIAssistViewModel">
        <!-- ── Main: chat + right panel ── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{Binding Source={x:Reference RootGrid}, Path=Width, Converter={StaticResource WidthToGridLengthConverter}, ConverterParameter=1}"/>
                <ColumnDefinition Width="{Binding Source={x:Reference RootGrid}, Path=Width, Converter={StaticResource WidthToGridLengthConverter}, ConverterParameter=380}"/>
            </Grid.ColumnDefinitions>

            <!-- Chat column -->
            <Grid RowDefinitions="*,Auto" Margin="0,20,0,0"
                  BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark={StaticResource AppBackgroundDark}}">

                <assistView:SfAIAssistView Grid.Row="0"
                    x:Name="AssistView"
                    AssistItems="{Binding AssistItems}"
                    ConversationItemsSource="{Binding ConversationItems}"
                    RequestCommand="{Binding RequestCommand}"
                    Suggestions="{Binding Suggestions}"
                    ShowHeader="True"
                    ShowToolbar="False"
                                           
                                           EnableVoiceInput="False"
                                          
                    ShowActionButtons="False"
                    Background="{AppThemeBinding Light={StaticResource AppBackground}, Dark={StaticResource AppBackgroundDark}}"
                    EnableConversationHistory="False">

                    <assistView:SfAIAssistView.HeaderTemplate>
                        <DataTemplate>
                            <StackLayout Spacing="6"
                                         Padding="0,32,0,16"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                                <Border BackgroundColor="{AppThemeBinding Light=#E2F3FF, Dark=#122C45}"
                                        StrokeThickness="0"
                                        WidthRequest="72" HeightRequest="72"
                                        HorizontalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18"/>
                                    </Border.StrokeShape>
                                    <Label Text="&#xE65F;" FontFamily="MaterialIcons" FontSize="36"
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           TextColor="#0EA5E9"/>
                                </Border>
                                <Label Text="Vehicle Care AI"
                                       Style="{StaticResource PageTitleMobileStyle}"
                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#EDF6FF}"
                                       HorizontalTextAlignment="Center"
                                       Margin="0,8,0,0"/>
                                <Label Text="Your intelligent vehicle companion"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#9DB7D2}"
                                       HorizontalTextAlignment="Center"/>
                            </StackLayout>
                        </DataTemplate>
                    </assistView:SfAIAssistView.HeaderTemplate>

                    <assistView:SfAIAssistView.SuggestionTemplate>
                        <DataTemplate x:DataType="assistView:ISuggestion">
                            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0D1F35}"
                                    Stroke="{AppThemeBinding Light={StaticResource BrandBlue}, Dark={StaticResource BrandBlueBright}}"
                                    StrokeThickness="1"
                                    Padding="14,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="{Binding Text}"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light=#1A2332, Dark=#EDF6FF}"
                                           VerticalTextAlignment="Center"
                                           LineBreakMode="WordWrap"/>
                                    <Label Grid.Column="1"
                                           Text="→"
                                           FontSize="16"
                                           TextColor="{AppThemeBinding Light={StaticResource BrandBlue}, Dark={StaticResource BrandBlueBright}}"
                                           VerticalTextAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </assistView:SfAIAssistView.SuggestionTemplate>

                    <!-- Response bubble: theme-aware bg + text color + inner padding -->
                    <assistView:SfAIAssistView.ResponseItemTemplate>
                        <DataTemplate x:DataType="{x:Null}">
                            <!-- 7*,3* grid caps bubble at 70% width; HorizontalOptions=Start shrinks to content -->
                            <Grid ColumnDefinitions="7*,3*">
                                <Border Grid.Column="0"
                                        BackgroundColor="{AppThemeBinding Light=#E0F2FE, Dark=#0D2135}"
                                        StrokeThickness="0"
                                        Padding="14,10"
                                        Margin="12,8"
                                        HorizontalOptions="Start"
                                        StrokeShape="RoundRectangle 14">
                                    <Label Text="{Binding Text}"
                                           TextColor="{AppThemeBinding Light=#0C4A6E, Dark=#BAE6FD}"
                                           LineBreakMode="WordWrap"
                                           FontSize="13"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </assistView:SfAIAssistView.ResponseItemTemplate>

                    <!-- Request bubble: theme-aware bg + text color + inner padding -->
                    <assistView:SfAIAssistView.RequestItemTemplate>
                        <DataTemplate x:DataType="{x:Null}">
                            <!-- 3*,7* grid caps bubble at 70% width; HorizontalOptions=End shrinks to content -->
                            <Grid ColumnDefinitions="3*,7*">
                                <Border Grid.Column="1"
                                        BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#2D2117}"
                                        StrokeThickness="0"
                                        Padding="14,10"
                                        Margin="12,4"
                                        HorizontalOptions="End"
                                        StrokeShape="RoundRectangle 14">
                                    <Label Text="{Binding Text}"
                                           TextColor="{AppThemeBinding Light=#92400E, Dark=#FDE68A}"
                                           LineBreakMode="WordWrap"
                                           FontSize="13"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </assistView:SfAIAssistView.RequestItemTemplate>

                </assistView:SfAIAssistView>

                <Label Grid.Row="1"
                       Text="AI can make mistakes. Verify critical technical parameters."
                      FontSize="{OnPlatform Default=12, WinUI=11, MacCatalyst=11}"
                      HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#94A3B8, Dark=#4A6482}"
                       Padding="16,5,16,8"/>
            </Grid>

            <!-- Right info panel (desktop only) -->
            <BoxView Grid.Column="1"
                     IsVisible="{Binding Source={x:Reference RootGrid}, Path=Width, Converter={StaticResource WidthToBooleanConverter}, ConverterParameter=desktop}"
                     BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1A2F45}"
                     WidthRequest="2" HorizontalOptions="Fill"/>

            <Grid Grid.Column="2"
                  IsVisible="{Binding Source={x:Reference RootGrid}, Path=Width, Converter={StaticResource WidthToBooleanConverter}, ConverterParameter=desktop}"
                  BackgroundColor="{AppThemeBinding Light={StaticResource BrandSurfaceLight}, Dark={StaticResource BrandDarkCard}}">

                <ScrollView Padding="16,16,16,24">
                    <StackLayout Spacing="26">

                        <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark={StaticResource AppBackgroundDark}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                Padding="14,12"
                                Margin="0,4,0,0">
                            <Border.Shadow>
                                <Shadow Brush="{AppThemeBinding Light=#20000000, Dark=#40000000}"
                                        Offset="0,4"
                                        Radius="12"
                                        Opacity="0.18"/>
                            </Border.Shadow>
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                <Label Text="{Binding VehicleDisplayName}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#EDF6FF}"/>

                                <Border Grid.Column="1" Grid.RowSpan="2"
                                        BackgroundColor="{AppThemeBinding Light=#E2F3FF, Dark=#122C45}"
                                        StrokeThickness="0"
                                        WidthRequest="36" HeightRequest="36"
                                        VerticalOptions="Start">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8"/>
                                    </Border.StrokeShape>
                                    <Label Text="{Binding VehicleIconGlyph}" FontFamily="MaterialIcons" FontSize="17" TextColor="{AppThemeBinding Light={StaticResource BrandCyan}, Dark={StaticResource BrandCyanBright}}"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>

                                <Grid Grid.Row="2" Grid.ColumnSpan="2"
                                      ColumnDefinitions="*,Auto"
                                      Margin="0,12,0,0">
                                    <StackLayout Spacing="2">
                                        <Label Text="Odometer" FontSize="11"
                                               TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                                               CharacterSpacing="1"/>
                                        <Label Text="{Binding VehicleOdometer}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#EDF6FF}"/>
                                    </StackLayout>

                                    <StackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                                        <Label Text="Health" FontSize="11"
                                               TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                                               CharacterSpacing="1"/>
                                        <Border BackgroundColor="{Binding VehicleHealthBadgeColor}"
                                                StrokeThickness="0"
                                                Padding="8,4"
                                                HorizontalOptions="End">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding VehicleHealthLabel}"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="White"/>
                                        </Border>
                                    </StackLayout>
                                </Grid>
                            </Grid>
                        </Border>

                        <StackLayout Spacing="10">
                            <Label Text="What I can help with"
                                   Style="{StaticResource CardTitleStyle}"
                                   TextColor="{AppThemeBinding Light=#1A2332, Dark=#EDF6FF}"/>

                            <StackLayout Spacing="10">
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="&#xE8D0;" FontFamily="MaterialIcons" FontSize="14" Margin="0,2,0,0" TextColor="{AppThemeBinding Light={StaticResource BrandCyan}, Dark={StaticResource BrandCyanBright}}" VerticalOptions="Center"/>
                                    <Label Text="Service &amp; maintenance history" FontSize="13"
                                           TextColor="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="&#xE9E4;" FontFamily="MaterialIcons" FontSize="14" Margin="0,2,0,0" TextColor="{AppThemeBinding Light={StaticResource BrandCyan}, Dark={StaticResource BrandCyanBright}}" VerticalOptions="Center"/>
                                    <Label Text="Fuel efficiency &amp; cost analysis" FontSize="13"
                                           TextColor="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="&#xE8A1;" FontFamily="MaterialIcons" FontSize="14" Margin="0,2,0,0" TextColor="{AppThemeBinding Light={StaticResource BrandCyan}, Dark={StaticResource BrandCyanBright}}" VerticalOptions="Center"/>
                                    <Label Text="Expense insights &amp; trends" FontSize="13"
                                           TextColor="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="&#xE87D;" FontFamily="MaterialIcons" FontSize="14" Margin="0,2,0,0" TextColor="#EF4444" VerticalOptions="Center"/>
                                    <Label Text="Vehicle health breakdown" FontSize="13"
                                           TextColor="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </StackLayout>
                        </StackLayout>

                        <StackLayout Spacing="10">
                            <Label Text="Recent insights"
                                   Style="{StaticResource CardTitleStyle}"
                                   TextColor="{AppThemeBinding Light=#1A2332, Dark=#EDF6FF}"/>

                            <!-- Empty state when no insights data exists -->
                        <StackLayout IsVisible="{Binding HasRecentInsights, Converter={StaticResource InvertedBoolConverter}}"
                                     Spacing="8" Padding="0,4,0,0">
                            <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0B1929}"
                                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E3A5F}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="16,20">
                                <StackLayout Spacing="8" HorizontalOptions="Center">
                                    <Label Text="&#xEA87;" FontFamily="MaterialIcons" FontSize="32"
                                           TextColor="{AppThemeBinding Light=#CBD5E1, Dark=#2A4A6A}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="No insights available"
                                           FontSize="13" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#94A3B8, Dark=#4A6482}"
                                           HorizontalTextAlignment="Center"/>
                                    <Label Text="Add service records or fuel logs to see AI-generated insights here."
                                           FontSize="11"
                                           TextColor="{AppThemeBinding Light=#B0BEC5, Dark=#3A5570}"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="WordWrap"/>
                                </StackLayout>
                            </Border>
                        </StackLayout>

                        <StackLayout BindableLayout.ItemsSource="{Binding RecentInsights}"
                                         IsVisible="{Binding HasRecentInsights}"
                                         Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AIRecentInsight">
                                        <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark={StaticResource AppBackgroundDark}}"
                                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E3A5F}"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 10"
                                                Padding="10,8">
                                            <Border.Shadow>
                                                <Shadow Brush="{AppThemeBinding Light=#10000000, Dark=#25000000}"
                                                        Offset="0,2"
                                                        Radius="6"
                                                        Opacity="0.10"/>
                                            </Border.Shadow>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                    <Label Text="&#xE65F;" FontFamily="MaterialIcons" Margin="0,3,0,0" FontSize="12"
                                                           TextColor="{AppThemeBinding Light=#0EA5E9, Dark=#5EE7FF}"
                                                           VerticalOptions="Center"/>
                                                    <Label Text="{Binding Text}"
                                                           FontSize="12"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="2"
                                                           TextColor="{AppThemeBinding Light=#1A2332, Dark=#EDF6FF}"
                                                           VerticalOptions="Center"/>
                                                </HorizontalStackLayout>

                                                <Border Grid.Column="1"
                                                        BackgroundColor="{Binding BadgeBgColor}"
                                                        StrokeThickness="0"
                                                        Padding="8,4"
                                                        VerticalOptions="Center"
                                                        HorizontalOptions="End">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="6"/>
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding Badge}"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           TextColor="{Binding BadgeColor}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </StackLayout>
                        </StackLayout>
                    </StackLayout>
                </ScrollView>
            </Grid>

        </Grid>
    </Grid>
</ContentView>