<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:progressBar="clr-namespace:Syncfusion.Maui.ProgressBar;assembly=Syncfusion.Maui.ProgressBar"
             x:Class="SmartVehicleCare.Views.SplashPage"
             Title="Splash"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource OnboardingBgLight}, Dark={StaticResource OnboardingBgDark}}">

    <Grid>

        <!-- LAYER 1 — Decorative constellation -->
        <GraphicsView x:Name="ConstellationView"
                      InputTransparent="True"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill"/>

        <!-- LAYER 2 — Main centered content -->
        <VerticalStackLayout VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="0"
                             MaximumWidthRequest="380"
                             Padding="40,0">

            <!-- Circular car icon badge with light-theme outer ring -->
            <Border WidthRequest="110" HeightRequest="110"
                    BackgroundColor="{AppThemeBinding Light={StaticResource OnboardingRingLight}, Dark={StaticResource OnboardingRingDark}}"
                    StrokeThickness="0"
                    HorizontalOptions="Center"
                    Margin="0,0,0,28">
                <Border.StrokeShape>
                    <Ellipse/>
                </Border.StrokeShape>
                <Border WidthRequest="88" HeightRequest="88"
                        StrokeThickness="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <Ellipse/>
                    </Border.StrokeShape>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0EA5E9" Offset="0.0"/>
                            <GradientStop Color="#B45309" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Label Text="&#xE531;" FontFamily="MaterialIcons" FontSize="44"
                           TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
            </Border>

            <!-- App title -->
            <Label Text="Vehicle Care AI"
                   Style="{StaticResource DisplayStyle}"
                   TextColor="{AppThemeBinding Light={StaticResource BrandTextDark}, Dark=White}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,12"/>

            <!-- Subtitle -->
            <Label Text="Know everything about your vehicle, before it fails you."
                   Style="{StaticResource BodySmallStyle}"
                   FontSize="14"
                   MaxLines="2"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap"
                   Margin="0,0,0,36"/>

            <!-- Progress bar container card (light: white card, dark: transparent) -->

            <VerticalStackLayout Spacing="10" Padding="20,0">
                <progressBar:SfLinearProgressBar x:Name="InitProgress"
                                                      Progress="0"
                                                      Minimum="0" Maximum="100"
                                                      AnimationDuration="600"
                                                      ProgressFill="{AppThemeBinding Light=#B45309, Dark=#B45309}"
                                                      TrackFill="{AppThemeBinding Light={StaticResource OnboardingProgressTrackLight}, Dark={StaticResource OnboardingProgressTrackDark}}"
                                                      TrackCornerRadius="6"
                                                      ProgressCornerRadius="6"
                                                      TrackHeight="8"
                                                      ProgressHeight="8"
                                                      HorizontalOptions="Fill"/>

            </VerticalStackLayout>

        </VerticalStackLayout>


    </Grid>
</ContentPage>
