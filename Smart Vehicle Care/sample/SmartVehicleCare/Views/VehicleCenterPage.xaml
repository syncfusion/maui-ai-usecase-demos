                                                    <DataTemplate x:DataType="models:ScheduleAlert">
                                                        <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#2D2117}"
                                                                StrokeThickness="0"
                                                                StrokeShape="RoundRectangle 10"
                                                                Padding="0">
                                                            <Grid ColumnDefinitions="4,*">
                                                                <BoxView BackgroundColor="{Binding LeftAccentColor}"
                                                                         HorizontalOptions="Fill" VerticalOptions="Fill"/>
                                                                <StackLayout Grid.Column="1" Spacing="5" Padding="12,10">
                                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                                        <Border BackgroundColor="{Binding BadgeBgColor}"
                                                                                Padding="6,2" StrokeThickness="0">
                                                                            <Border.StrokeShape>
                                                                                <RoundRectangle CornerRadius="4"/>
                                                                            </Border.StrokeShape>
                                                                            <Label Text="{Binding Badge}"
                                                                                   TextColor="{Binding BadgeColor}"
                                                                                   FontSize="9" FontAttributes="Bold"/>
                                                                        </Border>
                                                                        <Label Grid.Column="2" Text="{Binding Date}"
                                                                               FontSize="11"
                                                                               TextColor="{AppThemeBinding Light=#94A3B8, Dark=#7A94AA}"
                                                                               VerticalOptions="Center"/>
                                                                    </Grid>
                                                                    <Label Text="{Binding Title}" FontSize="13"
                                                                           FontAttributes="Bold"
                                                                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"/>
                                                                    <Label Text="{Binding Description}" FontSize="12"
                                                                           TextColor="{AppThemeBinding Light=#64748B, Dark=#9DB7D2}"
                                                                           LineBreakMode="WordWrap"/>
                                                                    <Grid ColumnDefinitions="*,Auto">
                                                                        <Label Grid.Column="1" Text="Remove" FontSize="11" FontAttributes="Bold"
                                                                               TextColor="#DC2626" VerticalOptions="Center">
                                                                            <Label.GestureRecognizers>
                                                                                <TapGestureRecognizer Command="{Binding Source={x:Reference RootGrid}, Path=BindingContext.DeleteScheduleCommand}"
                                                                                                      CommandParameter="{Binding .}"/>
                                                                            </Label.GestureRecognizers>
                                                                        </Label>
                                                                    </Grid>
                                                                </StackLayout>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </StackLayout>
                                        </StackLayout>
                                    </Border>

                                    <!-- Predictive Service card (desktop) -->
                                        <Border IsVisible="{Binding ShowForecast}"
                                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                            StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"
                                            StrokeShape="RoundRectangle 16"
                                            Padding="16">
                                        
                                        <StackLayout Spacing="12">
                                            <StackLayout Orientation="Horizontal" Spacing="10">
                                                <Border BackgroundColor="#0D9488"
                                                        WidthRequest="36" HeightRequest="36"
                                                        StrokeThickness="0">
                                                    <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                                    <Label Text="+" FontSize="20" TextColor="White"
                                                           FontAttributes="Bold"
                                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                                </Border>
                                                      <Label Text="Next service forecast" Style="{StaticResource CardTitleStyle}" FontSize="15"
                                                       TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"
                                                       VerticalOptions="Center"/>
                                            </StackLayout>
                                            <Label Text="{Binding PredictiveServiceDate}" FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#B45309, Dark=#F59E0B}"/>
                                            <Label Text="{Binding PredictiveServiceDescription}" FontSize="12"
                                                   TextColor="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"
                                                   LineBreakMode="WordWrap"/>
                                            <buttons:SfButton Text="Add forecast to schedule"
                                                              Command="{Binding AddForecastReminderCommand}"
                                                              HeightRequest="36" Padding="12,0" CornerRadius="8"
                                                              Background="{AppThemeBinding Light=#B45309, Dark=#D97706}"
                                                              TextColor="White" FontFamily="OpenSansSemibold" FontSize="12"
                                                              HorizontalOptions="Start">
                                                <buttons:SfButton.Triggers>
                                                    <DataTrigger TargetType="buttons:SfButton" Binding="{Binding IsForecastAlreadyScheduled}" Value="True">
                                                        <Setter Property="Text" Value="Already on schedule"/>
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="Background" Value="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"/>
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#64748B, Dark=#9DB7D2}"/>
                                                    </DataTrigger>
                                                </buttons:SfButton.Triggers>
                                            </buttons:SfButton>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Text="Next service mileage" FontSize="12"
                                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#9DB7D2}"
                                                       VerticalOptions="Center"/>
                                                <Label Grid.Column="1" Text="{Binding PredictiveServiceMileage}"
                                                       FontSize="14" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"
                                                       VerticalOptions="Center"/>
                                            </Grid>
                                        </StackLayout>
                                    </Border>

                                </StackLayout>
                            </ScrollView>
                        </Grid>
                    </Grid>
                </tabView:SfTabItem.Content>
            </tabView:SfTabItem>

        </tabView:SfTabView>

