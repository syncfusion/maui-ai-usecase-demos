<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tabView="clr-namespace:Syncfusion.Maui.TabView;assembly=Syncfusion.Maui.TabView"
             xmlns:treeView="clr-namespace:Syncfusion.Maui.TreeView;assembly=Syncfusion.Maui.TreeView"
             xmlns:calendar="clr-namespace:Syncfusion.Maui.Calendar;assembly=Syncfusion.Maui.Calendar"
             xmlns:charts="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
             xmlns:progressBar="clr-namespace:Syncfusion.Maui.ProgressBar;assembly=Syncfusion.Maui.ProgressBar"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:combo="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             xmlns:dataGrid="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
             xmlns:popup="clr-namespace:Syncfusion.Maui.Popup;assembly=Syncfusion.Maui.Popup"
             xmlns:scheduler="clr-namespace:Syncfusion.Maui.Scheduler;assembly=Syncfusion.Maui.Scheduler"
             xmlns:maps="clr-namespace:Syncfusion.Maui.Maps;assembly=Syncfusion.Maui.Maps"
             xmlns:vm="clr-namespace:SmartVehicleCare.ViewModels"
             xmlns:models="clr-namespace:SmartVehicleCare.Models"
             xmlns:views="clr-namespace:SmartVehicleCare.Views"
             xmlns:til="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:picker="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
             x:Class="SmartVehicleCare.Views.VehicleCenterPage"
             BackgroundColor="{AppThemeBinding Light=#FAF9F5, Dark=#111009}">

    <!-- BindingContext set here so the IsVisible on this element in MainPage.xaml
         still resolves against the inherited MainViewModel. -->
    <Grid RowDefinitions="*"
          x:Name="RootGrid">
        <Grid.Resources>
            <!-- Map pin marker shown on the tile layer for each nearby place -->
            <DataTemplate x:Key="NearbyMarkerTemplate">
                <Grid WidthRequest="52" HeightRequest="52"
                      IsClippedToBounds="False"
                      HorizontalOptions="Start" VerticalOptions="Start">
                    <Label Text="📍"
                           FontSize="{Binding MarkerSize}"
                           WidthRequest="52" HeightRequest="52"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="End"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Grid>
            </DataTemplate>

            <!-- Tooltip shown when a marker is tapped -->
            <DataTemplate x:Key="NearbyTooltipTemplate">
                <Border BackgroundColor="#1E293B" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,8" WidthRequest="200">
                    <StackLayout Spacing="3">
                        <Label Text="{Binding DataItem.Name}"    FontSize="12" FontAttributes="Bold" TextColor="White"   LineBreakMode="WordWrap"/>
                        <Label Text="{Binding DataItem.Details}" FontSize="{OnPlatform Default=11, WinUI=10, MacCatalyst=10}" TextColor="#94A3B8"   LineBreakMode="WordWrap"/>
                        <Label Text="{Binding DataItem.Address}" FontSize="{OnPlatform Default=11, WinUI=10, MacCatalyst=10}" TextColor="#64748B"   LineBreakMode="WordWrap"/>
                    </StackLayout>
                </Border>
            </DataTemplate>
        </Grid.Resources>

        <!-- Custom expense range pickers stay behind the page until opened. -->
        <picker:SfDatePicker x:Name="ExpenseStartDatePicker" Mode="Dialog"
                             IsOpen="False"
                             ColumnDividerColor="{AppThemeBinding Light=#E5E0D8, Dark=#3D2E24}"
                             SelectedDate="{Binding CustomExpenseStartDate}"
                             OkButtonClicked="OnExpenseStartDateOkClicked">
            <picker:SfDatePicker.SelectionView>
                <picker:PickerSelectionView CornerRadius="20"
                                             Background="{AppThemeBinding Light=#B45309, Dark=#D97706}"/>
            </picker:SfDatePicker.SelectionView>
            <picker:SfDatePicker.SelectedTextStyle>
                <picker:PickerTextStyle TextColor="White" FontAttributes="Bold"/>
            </picker:SfDatePicker.SelectedTextStyle>
            <picker:SfDatePicker.ColumnHeaderView>
                <picker:DatePickerColumnHeaderView Height="50"
                                                   Background="{AppThemeBinding Light=#FAF9F5, Dark=#2D2117}"
                                                   DividerColor="{AppThemeBinding Light=#E5E0D8, Dark=#3D2E24}">
                    <picker:DatePickerColumnHeaderView.TextStyle>
                        <picker:PickerTextStyle TextColor="{AppThemeBinding Light=#6B5E55, Dark=#B0A39A}" FontAttributes="Bold"/>
                    </picker:DatePickerColumnHeaderView.TextStyle>
                </picker:DatePickerColumnHeaderView>
            </picker:SfDatePicker.ColumnHeaderView>
            <picker:SfDatePicker.HeaderView>
                <picker:PickerHeaderView Text="Select start date" Height="40"
                                         Background="{AppThemeBinding Light=White, Dark={StaticResource BrandNavyLight}}"
                                         DividerColor="{AppThemeBinding Light=#E5E0D8, Dark=#3D2E24}">
                    <picker:PickerHeaderView.TextStyle>
                        <picker:PickerTextStyle TextColor="{AppThemeBinding Light={StaticResource BrandTextDark}, Dark={StaticResource BrandTextOnDark}}" FontAttributes="Bold"/>
                    </picker:PickerHeaderView.TextStyle>
                </picker:PickerHeaderView>
            </picker:SfDatePicker.HeaderView>
            <picker:SfDatePicker.FooterView>
                <picker:PickerFooterView ShowOkButton="True" CancelButtonText="Cancel" Height="40"
                                         Background="{AppThemeBinding Light=White, Dark={StaticResource BrandNavyLight}}"
                                         DividerColor="{AppThemeBinding Light=#E5E0D8, Dark=#3D2E24}">
                    <picker:PickerFooterView.TextStyle>
                        <picker:PickerTextStyle TextColor="{AppThemeBinding Light={StaticResource BrandBlue}, Dark={StaticResource BrandBlueBright}}" FontAttributes="Bold"/>
                    </picker:PickerFooterView.TextStyle>
                </picker:PickerFooterView>
            </picker:SfDatePicker.FooterView>
        </picker:SfDatePicker>
        <picker:SfDatePicker x:Name="ExpenseEndDatePicker" Mode="Dialog"
                             IsOpen="False"
                             ColumnDividerColor="{AppThemeBinding Light=#E5E0D8, Dark=#3D2E24}"
                             SelectedDate="{Binding CustomExpenseEndDate}"
                             OkButtonClicked="OnExpenseEndDateOkClicked">
            <picker:SfDatePicker.SelectionView>
                <picker:PickerSelectionView CornerRadius="20" 
                                             Background="{AppThemeBinding Light=#B45309, Dark=#D97706}"/>
            </picker:SfDatePicker.SelectionView>
            <picker:SfDatePicker.SelectedTextStyle>
                <picker:PickerTextStyle TextColor="White" FontAttributes="Bold"/>
            </picker:SfDatePicker.SelectedTextStyle>
            <picker:SfDatePicker.ColumnHeaderView>
                <picker:DatePickerColumnHeaderView Height="50"
                                                   Background="{AppThemeBinding Light=#FAF9F5, Dark=#2D2117}"
                                                   DividerColor="{AppThemeBinding Light=#E5E0D8, Dark=#3D2E24}">
                    <picker:DatePickerColumnHeaderView.TextStyle>
                        <picker:PickerTextStyle TextColor="{AppThemeBinding Light=#6B5E55, Dark=#B0A39A}" FontAttributes="Bold"/>
                    </picker:DatePickerColumnHeaderView.TextStyle>
                </picker:DatePickerColumnHeaderView>
            </picker:SfDatePicker.ColumnHeaderView>
            <picker:SfDatePicker.HeaderView>
                <picker:PickerHeaderView Text="Select end date" Height="40"
                                         Background="{AppThemeBinding Light=White, Dark={StaticResource BrandNavyLight}}"
                                         DividerColor="{AppThemeBinding Light=#E5E0D8, Dark=#3D2E24}">
                    <picker:PickerHeaderView.TextStyle>
                        <picker:PickerTextStyle TextColor="{AppThemeBinding Light={StaticResource BrandTextDark}, Dark={StaticResource BrandTextOnDark}}" FontAttributes="Bold"/>
                    </picker:PickerHeaderView.TextStyle>
                </picker:PickerHeaderView>
            </picker:SfDatePicker.HeaderView>
            <picker:SfDatePicker.FooterView>
                <picker:PickerFooterView ShowOkButton="True" CancelButtonText="Cancel" Height="40"
                                         Background="{AppThemeBinding Light=White, Dark={StaticResource BrandNavyLight}}"
                                         DividerColor="{AppThemeBinding Light=#E5E0D8, Dark=#3D2E24}">
                    <picker:PickerFooterView.TextStyle>
                        <picker:PickerTextStyle TextColor="{AppThemeBinding Light={StaticResource BrandBlue}, Dark={StaticResource BrandBlueBright}}" FontAttributes="Bold"/>
                    </picker:PickerFooterView.TextStyle>
                </picker:PickerFooterView>
            </picker:SfDatePicker.FooterView>
        </picker:SfDatePicker>

        
        <tabView:SfTabView x:Name="VehicleTabView"
                           Grid.Row="0"
                           BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                           IndicatorBackground="{AppThemeBinding Light=#B45309, Dark=#F59E0B}"
                           IndicatorStrokeThickness="3"
                           IndicatorPlacement="Bottom"
                           IndicatorWidthMode="Fit"
                           TabBarBackground="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                           TabBarSize="52"
                           TabHeaderPadding="12,0"
                           SelectedIndex="{Binding SelectedTabIndex}"
                           TabWidthMode="SizeToContent">

            <tabView:SfTabItem Header="Maintenance"
                               FontSize="15"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#FAF6F0}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal"/>
                        <VisualState Name="Selected">
                            <VisualState.Setters>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="FontAttributes" Value="Bold"/>
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BrandBlue}, Dark={StaticResource BrandBlueBright}}"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <tabView:SfTabItem.Content>
                    <ScrollView BackgroundColor="{AppThemeBinding Light=#FAF9F5, Dark=#111009}">
                        <StackLayout Padding="{Binding Source={x:Reference RootGrid}, Path=Width, Converter={StaticResource WidthToThicknessConverter}, ConverterParameter='16,18,16,22|8,18,8,22|16,18,16,22'}"
                                     Spacing="18">

                            <!-- KPI Cards: 1x4 on Windows, 2x2 on Mobile -->
                            <Grid ColumnSpacing="6" WidthRequest="{OnPlatform Android=390,iOS=390}" Margin="{OnPlatform Android= '22,0,10,0', iOS='22,0,10,0'}" RowSpacing="8"
                                  RowDefinitions="Auto,Auto">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding Source={x:Reference RootGrid}, Path=Width, Converter={StaticResource WidthToGridLengthConverter}, ConverterParameter=kpi-column-1}"/>
                                    <ColumnDefinition Width="{Binding Source={x:Reference RootGrid}, Path=Width, Converter={StaticResource WidthToGridLengthConverter}, ConverterParameter=kpi-column-2}"/>
                                    <ColumnDefinition Width="{Binding Source={x:Reference RootGrid}, Path=Width, Converter={StaticResource WidthToGridLengthConverter}, ConverterParameter=kpi-column-3}"/>
                                    <ColumnDefinition Width="{Binding Source={x:Reference RootGrid}, Path=Width, Converter={StaticResource WidthToGridLengthConverter}, ConverterParameter=kpi-column-4}"/>
                                </Grid.ColumnDefinitions>

                                <!-- TOTAL SERVICES -->
                                <Border Grid.Column="{OnPlatform WinUI=0, Default=0}" Grid.Row="{OnPlatform WinUI=0, Default=0}"
                                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"
                                        Padding="16,12" StrokeShape="RoundRectangle 16"
                                        MinimumHeightRequest="96">
                                    <Border.Shadow><Shadow Brush="{AppThemeBinding Light=#94A3B8, Dark=#020B14}" Offset="0,8" Radius="14" Opacity="0.18"/></Border.Shadow>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                        <StackLayout Spacing="4" VerticalOptions="Center">
                                            <Label Text="Total services" Style="{StaticResource LabelUpperStyle}" FontSize="14"
                                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#7A94AA}"/>
                                            <Label Text="{Binding TotalServices}" Style="{StaticResource KPIMediumStyle}" FontSize="{OnPlatform Default=18, WinUI=20, MacCatalyst=20}"
                                                   TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"/>
                                        </StackLayout>
                                        <Border Grid.Column="1" WidthRequest="34" HeightRequest="34"
                                                BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#2D2117}"
                                                StrokeThickness="0" VerticalOptions="Center">
                                            <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                            <Label Text="&#xE8D0;" FontFamily="MaterialIcons" FontSize="16"
                                                   TextColor="{AppThemeBinding Light=#B45309, Dark=#F59E0B}"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- LAST SERVICE -->
                                <Border Grid.Column="{OnPlatform WinUI=1, Default=1}" Grid.Row="{OnPlatform WinUI=0, Default=0}"
                                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"
                                        Padding="16,12" StrokeShape="RoundRectangle 16"
                                        MinimumHeightRequest="96">
                                    <Border.Shadow><Shadow Brush="{AppThemeBinding Light=#94A3B8, Dark=#020B14}" Offset="0,8" Radius="14" Opacity="0.18"/></Border.Shadow>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                        <StackLayout Spacing="4" VerticalOptions="Center">
                                            <Label Text="Last service" Style="{StaticResource LabelUpperStyle}" FontSize="14"
                                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#7A94AA}"/>
                                            <Label Text="{Binding LastServiceText}" Style="{StaticResource KPIMediumStyle}" FontSize="{OnPlatform Default=18, WinUI=20, MacCatalyst=20}"
                                                   TextColor="{AppThemeBinding Light=#B45309, Dark=#F7D37B}"/>
                                        </StackLayout>
                                        <Border Grid.Column="1" WidthRequest="34" HeightRequest="34"
                                                BackgroundColor="{AppThemeBinding Light=#FEF9C3, Dark=#2A200A}"
                                                StrokeThickness="0" VerticalOptions="Center">
                                            <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                            <Label Text="&#xE889;" FontFamily="MaterialIcons" FontSize="16"
                                                   TextColor="{AppThemeBinding Light=#B45309, Dark=#F7D37B}"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- TOTAL SPENT -->
                                <Border Grid.Column="2" Grid.Row="0"
                                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"
                                        Padding="16,12" StrokeShape="RoundRectangle 16"
                                        MinimumHeightRequest="96">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border"
                                                     Binding="{Binding Source={x:Reference RootGrid}, Path=Width, Converter={StaticResource WidthToBooleanConverter}, ConverterParameter=compact-desktop}"
                                                     Value="True">
                                            <Setter Property="Grid.Column" Value="0"/>
                                            <Setter Property="Grid.Row" Value="1"/>
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.Shadow><Shadow Brush="{AppThemeBinding Light=#94A3B8, Dark=#020B14}" Offset="0,8" Radius="14" Opacity="0.18"/></Border.Shadow>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                        <StackLayout Spacing="4" VerticalOptions="Center">
                                            <Label Text="Total spent" Style="{StaticResource LabelUpperStyle}" FontSize="14"
                                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#7A94AA}"/>
                                              <Label Text="{Binding LifetimeSpend}" Style="{StaticResource KPIMediumStyle}" FontSize="{OnPlatform Default=18, WinUI=20, MacCatalyst=20}"
                                                   TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"/>
                                        </StackLayout>
                                        <Border Grid.Column="1" WidthRequest="34" HeightRequest="34"
                                                BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#2D2117}"
                                                StrokeThickness="0" VerticalOptions="Center">
                                            <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                            <Label Text="&#xE227;" FontFamily="MaterialIcons" FontSize="16"
                                                   TextColor="{AppThemeBinding Light=#B45309, Dark=#F59E0B}"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- NEXT SERVICE DUE -->
                                <Border Grid.Column="3" Grid.Row="0"
                                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"
                                        Padding="16,12" StrokeShape="RoundRectangle 16"
                                        MinimumHeightRequest="96">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border"
                                                     Binding="{Binding Source={x:Reference RootGrid}, Path=Width, Converter={StaticResource WidthToBooleanConverter}, ConverterParameter=compact-desktop}"
                                                     Value="True">
                                            <Setter Property="Grid.Column" Value="1"/>
                                            <Setter Property="Grid.Row" Value="1"/>
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.Shadow><Shadow Brush="{AppThemeBinding Light=#94A3B8, Dark=#020B14}" Offset="0,8" Radius="14" Opacity="0.18"/></Border.Shadow>
                                     <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                         <StackLayout Spacing="3" VerticalOptions="Center">
                                          <Label Text="Next service due" Style="{StaticResource LabelUpperStyle}" FontSize="14"
                                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#7A94AA}"/>
                                          <Label Text="{Binding NextServiceDays}" Style="{StaticResource KPIMediumStyle}" FontSize="{OnPlatform Default=18, WinUI=20, MacCatalyst=20}"
                                                   TextColor="{AppThemeBinding Light=#059669, Dark=#6EE7B7}"/>
                                        </StackLayout>
                                        <Border Grid.Column="1" WidthRequest="34" HeightRequest="34"
                                                BackgroundColor="{AppThemeBinding Light=#DCFCE7, Dark=#0A2A1E}"
                                                StrokeThickness="0" VerticalOptions="Center">
                                            <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                            <Label Text="&#xE425;" FontFamily="MaterialIcons" FontSize="16"
                                                   TextColor="{AppThemeBinding Light=#059669, Dark=#6EE7B7}"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,520" ColumnSpacing="14" HeightRequest="204"
                                  IsVisible="{Binding Source={x:Reference RootGrid}, Path=Width, Converter={StaticResource WidthToBooleanConverter}, ConverterParameter=desktop}">

                                <!-- Service Log -->
                                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                        StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"
                                        StrokeShape="RoundRectangle 16" Padding="0">
                                    <Border.Shadow><Shadow Brush="{AppThemeBinding Light=#94A3B8, Dark=#020B14}" Offset="0,8" Radius="14" Opacity="0.18"/></Border.Shadow>
                                    <StackLayout Spacing="0">
                                        <Grid ColumnDefinitions="*,Auto,Auto" Padding="18,14,18,10" ColumnSpacing="10">
                                            <Label Text="Service log" FontSize="16" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"/>
                                            <buttons:SfButton Grid.Column="2" WidthRequest="132"
                                                                FontSize="12" FontAttributes="Bold"
                                                                HeightRequest="32" CornerRadius="8"
                                                                Padding="8,0"
                                                                Background="{AppThemeBinding Light=#B45309, Dark=#D97706}"
                                                                TextColor="White" StrokeThickness="0"
                                                                Command="{Binding AddServiceCommand}">
                                                <buttons:SfButton.Content>
                                                    <DataTemplate>
                                                        <HorizontalStackLayout Spacing="5" HorizontalOptions="Center" VerticalOptions="Center">
                                                        <Label Text="+" FontSize="16" Margin="0,2,0,0" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                                                        <Label Text="Add service" FontSize="12" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                                                        </HorizontalStackLayout>
                                                    </DataTemplate>
                                                </buttons:SfButton.Content>
                                            </buttons:SfButton>
                                            <buttons:SfButton Grid.Column="1" Text="View all"
                                                             IsVisible="{Binding HasServiceHistory}"
                                                             FontSize="11" FontAttributes="Bold"
                                                             HeightRequest="30" CornerRadius="8"
                                                             Background="Transparent"
                                                             TextColor="{AppThemeBinding Light={StaticResource BrandBlue}, Dark={StaticResource BrandBlueBright}}"
                                                             StrokeThickness="0"
                                                             Command="{Binding ShowServiceLogDetailsCommand}"/>
                                            
                                        </Grid>
                                        <BoxView BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}" HeightRequest="1"/>
                                        <StackLayout IsVisible="{Binding NoServiceHistory}" Padding="16,32" Spacing="8" HorizontalOptions="Center">
                                            <Label Text="&#xE8D0;" FontFamily="MaterialIcons" FontSize="36" HorizontalOptions="Center"
                                                   TextColor="{AppThemeBinding Light=#CBD5E1, Dark=#2A3D5C}"/>
                                            <Label Text="No service records yet" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center"
                                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#9DB7D2}"/>
                                            <Label Text="Click + Add Service to log your first service" FontSize="12" HorizontalOptions="Center"
                                                   TextColor="{AppThemeBinding Light=#94A3B8, Dark=#4A6580}"/>
                                        </StackLayout>
                                        <dataGrid:SfDataGrid x:Name="ServiceHistoryGrid"
                                                             IsVisible="{Binding HasServiceHistory}"
                                                             ItemsSource="{Binding VisibleServiceHistory}"
                                                             AutoGenerateColumnsMode="None"
                                                             AllowEditing="False"
                                                             SortingMode="Single"
                                                             SelectionMode="None"
                                                             NavigationMode="Row"
                                                             HorizontalOverScrollMode="None"
                                                             VerticalOverScrollMode="None"
                                                             AllowDiagonalScrolling="False"
                                                             HorizontalScrollBarVisibility="Never"
                                                             VerticalScrollBarVisibility="Never"
                                                             GridLinesVisibility="Horizontal"
                                                             HeaderGridLinesVisibility="Horizontal"
                                                             ColumnWidthMode="Fill"
                                                             HeaderRowHeight="{OnPlatform WinUI=32, MacCatalyst=32, Android=42, iOS=42}"
                                                             RowHeight="{OnPlatform WinUI=38, MacCatalyst=38, Android=42,iOS=42}"
                                                             HeightRequest="220">
                                            <dataGrid:SfDataGrid.DefaultStyle>
                                                <dataGrid:DataGridStyle
                                                    HeaderRowBackground="{AppThemeBinding Light=#F8FAFC, Dark=#2D2117}"
                                                    HeaderRowTextColor="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"
                                                    RowBackground="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                                    RowTextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"
                                                    GridLineColor="{AppThemeBinding Light=#E2E8F0, Dark=#193752}"/>
                                            </dataGrid:SfDataGrid.DefaultStyle>
                                            <dataGrid:SfDataGrid.Columns>
                                                <dataGrid:DataGridTextColumn MappingName="Date" HeaderText="Date" Width="165"/>
                                                <dataGrid:DataGridTextColumn MappingName="ServiceType" HeaderText="Type" Width="220" LineBreakMode="WordWrap"/>
                                                <dataGrid:DataGridTextColumn MappingName="Amount" HeaderText="Cost" Width="145"/>
                                                <dataGrid:DataGridTemplateColumn MappingName="Status" HeaderText="Status" Width="145">
                                                    <dataGrid:DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate x:DataType="models:ServiceRecord">
                                                            <ContentView HorizontalOptions="Center" VerticalOptions="Center">
                                                                <Border BackgroundColor="{Binding StatusBgColor}"
                                                                        Padding="8,3" StrokeThickness="0"
                                                                        HorizontalOptions="Center" VerticalOptions="Center">
                                                                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                                                    <Label Text="{Binding Status}" TextColor="{Binding StatusColor}" FontSize="10" FontAttributes="Bold"/>
                                                                </Border>
                                                            </ContentView>
                                                        </DataTemplate>
                                                    </dataGrid:DataGridTemplateColumn.CellTemplate>
                                                </dataGrid:DataGridTemplateColumn>
                                                <dataGrid:DataGridTemplateColumn HeaderText="" Width="72">
                                                    <dataGrid:DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate x:DataType="models:ServiceRecord">
                                                            <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                                                                <Label Text="&#xE3C9;" FontFamily="MaterialIcons" FontSize="18"
                                                                       TextColor="{AppThemeBinding Light=#0369A1, Dark=#38BDF8}" VerticalOptions="Center">
                                                                    <Label.GestureRecognizers>
                                                                        <TapGestureRecognizer
                                                                            Command="{Binding Source={x:Reference RootGrid}, Path=BindingContext.EditServiceCommand}"
                                                                            CommandParameter="{Binding .}"/>
                                                                    </Label.GestureRecognizers>
                                                                </Label>
                                                                <Label Text="&#xE872;" FontFamily="MaterialIcons" FontSize="18"
                                                                       TextColor="{AppThemeBinding Light=#DC2626, Dark=#F87171}" VerticalOptions="Center">
                                                                    <Label.GestureRecognizers>
                                                                        <TapGestureRecognizer
                                                                            Command="{Binding Source={x:Reference RootGrid}, Path=BindingContext.DeleteServiceCommand}"
                                                                            CommandParameter="{Binding .}"/>
                                                                    </Label.GestureRecognizers>
                                                                </Label>
                                                            </HorizontalStackLayout>
                                                        </DataTemplate>
                                                    </dataGrid:DataGridTemplateColumn.CellTemplate>
                                                </dataGrid:DataGridTemplateColumn>
                                            </dataGrid:SfDataGrid.Columns>
                                        </dataGrid:SfDataGrid>
                                    </StackLayout>
                                </Border>

                                <!-- Fuel Spending (desktop right panel) -->
                                <Border Grid.Column="1" 
                                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                        StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"
                                        StrokeShape="RoundRectangle 16" Padding="0">
                                    <Border.Shadow><Shadow Brush="{AppThemeBinding Light=#94A3B8, Dark=#020B14}" Offset="0,8" Radius="14" Opacity="0.18"/></Border.Shadow>
                                    <StackLayout Spacing="0">
                                        <Grid ColumnDefinitions="*,Auto,Auto" Padding="16,12,16,10" ColumnSpacing="10">
                                            <StackLayout Orientation="Horizontal" Spacing="6">
                                                <Label Text="Fuel spending" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"
                                                       TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"/>
