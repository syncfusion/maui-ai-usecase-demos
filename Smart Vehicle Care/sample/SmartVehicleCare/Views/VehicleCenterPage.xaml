                                                            <Setter Property="Background" Value="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"/>
                                                            <Setter Property="TextColor" Value="{AppThemeBinding Light=#64748B, Dark=#9DB7D2}"/>
                                                        </DataTrigger>
                                                    </buttons:SfButton.Triggers>
                                                </buttons:SfButton>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Text="Next service mileage" FontSize="12"
                                                           TextColor="{AppThemeBinding Light=#64748B, Dark=#9DB7D2}"
                                                           VerticalOptions="Center"/>
                                                    <Label Grid.Column="1" Text="{Binding PredictiveServiceMileage}"
                                                           FontSize="13" FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"
