                                          HorizontalOptions="Fill" VerticalOptions="Fill">
                                        <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                                            <ActivityIndicator IsRunning="{Binding IsNearbyLoading}"
                                                               Color="{AppThemeBinding Light={StaticResource BrandBlue}, Dark={StaticResource BrandBlueBright}}"
                                                               HeightRequest="36" WidthRequest="36"
                                                               HorizontalOptions="Center"/>
                                            <Label Text="Loading nearby places…"
                                                   FontSize="11"
                                                   TextColor="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"
                                                   HorizontalOptions="Center"/>
                                        </StackLayout>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border IsVisible="{Binding Source={x:Reference RootGrid}, Path=Width, Converter={StaticResource WidthToBooleanConverter}, ConverterParameter=mobile}"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                    StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"
                                    StrokeShape="RoundRectangle 16" Padding="16,14">
                                <StackLayout Spacing="12">
                                    <StackLayout Spacing="2">
                                        <Label Text="{Binding NearbyMapTitle}" FontSize="14" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"/>
                                        <Label Text="{Binding NearbyMapSummary}" FontSize="11"
                                               TextColor="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"/>
                                    </StackLayout>
                                    <StackLayout IsVisible="{Binding IsNearbyEmpty}"
                                                 Spacing="8" Padding="0,20" HorizontalOptions="Center">
                                        <Label Text="📍" FontSize="28" HorizontalOptions="Center"/>
                                        <Label FontSize="13" FontAttributes="Bold"
                                               HorizontalOptions="Center"
                                               TextColor="{AppThemeBinding Light=#475569, Dark=#9DB7D2}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsApiKeyMissing}" Value="True">
                                                    <Setter Property="Text" Value="API key not configured"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsApiKeyMissing}" Value="False">
                                                    <Setter Property="Text" Value="No places found nearby"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label FontSize="12"
                                               HorizontalOptions="Center"
                                               TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsApiKeyMissing}" Value="True">
                                                    <Setter Property="Text" Value="Add your Azure OpenAI key in Settings to enable nearby search"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsApiKeyMissing}" Value="False">
                                                    <Setter Property="Text" Value="Pull to refresh or check your location"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </StackLayout>
                                    <ScrollView MaximumHeightRequest="280" HorizontalScrollBarVisibility="Never"
                                                IsVisible="{Binding IsNearbyEmpty, Converter={StaticResource InvertedBoolConverter}}">
                                        <StackLayout BindableLayout.ItemsSource="{Binding NearbyNetworkItems}" Spacing="10">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:NearbyNetworkItem">
                                                    <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#2D2117}"
                                                            StrokeThickness="1"
                                                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"
                                                            Padding="12,10" StrokeShape="RoundRectangle 12">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding Source={x:Reference RootGrid}, Path=BindingContext.SelectNearbyNetworkCommand}"
                                                                                      CommandParameter="{Binding .}"/>
                                                            </Border.GestureRecognizers>
                                                        <Grid ColumnDefinitions="38,*" ColumnSpacing="10">
                                                            <Border WidthRequest="38" HeightRequest="38"
                                                                    BackgroundColor="{Binding IconBgColor}" StrokeThickness="0">
                                                                <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                                                <Label Text="{Binding IconText}" FontSize="16"
                                                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                                            </Border>
                                                            <StackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                                                <Label Text="{Binding Name}" FontSize="12" FontAttributes="Bold"
                                                                       TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"/>
                                                                <Label Text="{Binding TypeLabel}" FontSize="10"
                                                                       TextColor="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"/>
                                                                <Label Text="{Binding OpenTime}" FontSize="10"
                                                                       TextColor="{AppThemeBinding Light=#059669, Dark=#34D399}"/>
                                                            </StackLayout>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </StackLayout>
                                    </ScrollView>
                                </StackLayout>
                            </Border>

                        </StackLayout>
                    </ScrollView>
                </tabView:SfTabItem.Content>
            </tabView:SfTabItem>

            <tabView:SfTabItem Header="Schedule"
                               FontSize="15"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#FAF6F0}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal"/>
                        <VisualState Name="Selected">
                            <VisualState.Setters>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="FontAttributes" Value="Bold"/>
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BrandBlue}, Dark={StaticResource BrandBlueBright}}"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <tabView:SfTabItem.Content>
                    <Grid BackgroundColor="{AppThemeBinding Light=#FAF9F5, Dark=#111009}"
                          RowDefinitions="Auto,Auto,*"
                          Padding="12,12,12,16"
                          RowSpacing="8">

                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackLayout Spacing="3">
                                <Label Text="Maintenance planner" Style="{StaticResource PageTitleStyle}" FontSize="20"/>
                            </StackLayout>

                            <buttons:SfButton Grid.Column="1" WidthRequest="140" HorizontalOptions="End" VerticalOptions="Center"
                                              Background="{AppThemeBinding Light=#B45309, Dark=#D97706}"
                                              TextColor="White" FontSize="13" FontAttributes="Bold"
                                              CornerRadius="10" HeightRequest="38" Padding="12,0"
                                              Command="{Binding AddScheduleCommand}">
                                <buttons:SfButton.Content>
                                    <DataTemplate>
                                        <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="+" FontSize="18" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                                        <Label Text="Add schedule" FontSize="13" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </DataTemplate>
                                </buttons:SfButton.Content>
                            </buttons:SfButton>
                        </Grid>

                        <Grid Grid.Row="2"
                            ColumnSpacing="{Binding Source={x:Reference RootGrid}, Path=Width, Converter={StaticResource WidthToDoubleConverter}, ConverterParameter='14,0'}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="{Binding Source={x:Reference RootGrid}, Path=Width, Converter={StaticResource WidthToGridLengthConverter}, ConverterParameter=420}"/>
                            </Grid.ColumnDefinitions>

                            <!-- Calendar panel (left on desktop, full on mobile) -->
                            <ScrollView Grid.Column="0"
                                        IsClippedToBounds="True"
                                        VerticalScrollBarVisibility="Never"
                                        HorizontalScrollBarVisibility="Never"
                                        VerticalOptions="Fill">
                                <StackLayout Spacing="14">

                                    <!-- Calendar card -->
                                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                            StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"
                                            StrokeShape="RoundRectangle 16"
                                            Padding="0">
                                        <StackLayout Spacing="0">
                                            <!-- Legend (left) + view-switch buttons (right) -->
                                            <Grid ColumnDefinitions="*,Auto" Padding="14,8" VerticalOptions="Center">
                                                <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                                                    <HorizontalStackLayout Spacing="5">
                                                        <Ellipse WidthRequest="8" HeightRequest="8"
                                                                 Fill="#B45309" VerticalOptions="Center"/>
                                                        <Label Text="Service" FontSize="11"
                                                               TextColor="{AppThemeBinding Light=#475569, Dark=#9DB7D2}" VerticalOptions="Center"/>
                                                    </HorizontalStackLayout>
                                                    <HorizontalStackLayout Spacing="5">
                                                        <Ellipse WidthRequest="8" HeightRequest="8"
                                                                 Fill="#DC2626" VerticalOptions="Center"/>
                                                        <Label Text="Overdue" FontSize="11"
                                                               TextColor="{AppThemeBinding Light=#475569, Dark=#9DB7D2}" VerticalOptions="Center"/>
                                                    </HorizontalStackLayout>
                                                </HorizontalStackLayout>

                                                <!-- Month / Week / Day toggle (right) -->
                                                <Border Grid.Column="1" Padding="2" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#2D2117}"
                                                    Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#3D2E24}" StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 16" VerticalOptions="Center">
                                                <HorizontalStackLayout Spacing="2" VerticalOptions="Center">
                                                    <!-- Month -->
                                                    <Border WidthRequest="68" HeightRequest="32" Padding="0" StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 16">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding SetMonthViewCommand}"/>
                                                        </Border.GestureRecognizers>
                                                        <Border.Triggers>
                                                            <DataTrigger TargetType="Border" Binding="{Binding IsMonthViewActive}" Value="True">
                                                                <Setter Property="BackgroundColor" Value="#B45309"/>
                                                            </DataTrigger>
                                                                <DataTrigger TargetType="Border" Binding="{Binding IsMonthViewActive}" Value="False">
                                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#2D2117}"/>
                                                                </DataTrigger>
                                                            </Border.Triggers>
                                                        <Label Text="Month" FontFamily="OpenSansSemibold" FontSize="11" FontAttributes="Bold"
                                                            HorizontalOptions="Center" VerticalOptions="Center">
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsMonthViewActive}" Value="True">
                                                                    <Setter Property="TextColor" Value="White"/>
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsMonthViewActive}" Value="False">
                                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"/>
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                    </Border>
                                                    <!-- Week -->
                                                        <Border WidthRequest="68" HeightRequest="32" Padding="0" StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 16">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding SetWeekViewCommand}"/>
                                                        </Border.GestureRecognizers>
                                                        <Border.Triggers>
                                                            <DataTrigger TargetType="Border" Binding="{Binding IsWeekViewActive}" Value="True">
                                                                <Setter Property="BackgroundColor" Value="#B45309"/>
                                                            </DataTrigger>
                                                                <DataTrigger TargetType="Border" Binding="{Binding IsWeekViewActive}" Value="False">
                                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#2D2117}"/>
                                                                </DataTrigger>
                                                            </Border.Triggers>
                                                        <Label Text="Week" FontFamily="OpenSansSemibold" FontSize="11" FontAttributes="Bold"
                                                            HorizontalOptions="Center" VerticalOptions="Center">
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsWeekViewActive}" Value="True">
                                                                    <Setter Property="TextColor" Value="White"/>
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsWeekViewActive}" Value="False">
                                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"/>
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                    </Border>
                                                    <!-- Day -->
                                                        <Border WidthRequest="68" HeightRequest="32" Padding="0" StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 16">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding SetDayViewCommand}"/>
                                                        </Border.GestureRecognizers>
                                                        <Border.Triggers>
                                                            <DataTrigger TargetType="Border" Binding="{Binding IsDayViewActive}" Value="True">
                                                                <Setter Property="BackgroundColor" Value="#B45309"/>
                                                            </DataTrigger>
                                                                <DataTrigger TargetType="Border" Binding="{Binding IsDayViewActive}" Value="False">
                                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#2D2117}"/>
                                                                </DataTrigger>
                                                            </Border.Triggers>
                                                        <Label Text="Day" FontFamily="OpenSansSemibold" FontSize="11" FontAttributes="Bold"
                                                            HorizontalOptions="Center" VerticalOptions="Center">
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsDayViewActive}" Value="True">
                                                                    <Setter Property="TextColor" Value="White"/>
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsDayViewActive}" Value="False">
                                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"/>
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                    </Border>
                                                </HorizontalStackLayout>
                                                </Border>
                                            </Grid>
                                            <BoxView BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"
                                                     HeightRequest="1"/>
                                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="12,10" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F1E2D}">
                                                <Border WidthRequest="32" HeightRequest="32"
                                                        StrokeThickness="0"
                                                        BackgroundColor="Transparent"
                                                        StrokeShape="RoundRectangle 10">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnPreviousSchedulePeriodTapped"/>
                                                    </Border.GestureRecognizers>
                                                    <Label Text="&#xE5CB;" FontFamily="MaterialIcons" FontSize="18"
                                                           TextColor="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"
                                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                                </Border>

                                                      <Label Grid.Column="1"
                                                          Text="{Binding SchedulePeriodTitle}"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"/>

                                                <Border Grid.Column="2" WidthRequest="32" HeightRequest="32"
                                                        StrokeThickness="0"
                                                        BackgroundColor="Transparent"
                                                        StrokeShape="RoundRectangle 10">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnNextSchedulePeriodTapped"/>
                                                    </Border.GestureRecognizers>
                                                    <Label Text="&#xE5CC;" FontFamily="MaterialIcons" FontSize="18"
                                                           TextColor="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"
                                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                                </Border>
                                            </Grid>
                                            <!-- SfScheduler with month view by default -->
                                            <scheduler:SfScheduler x:Name="ScheduleCalendar"
                                                View="{Binding CurrentSchedulerView}"
                                                AppointmentsSource="{Binding ServiceAppointments}"
                                                HeightRequest="{Binding Source={x:Reference RootGrid}, Path=Width, Converter={StaticResource WidthToDoubleConverter}, ConverterParameter='460,320'}"
                                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                                CellBorderBrush="{AppThemeBinding Light=#E5E0D8, Dark=#3D2E24}"
                                                ViewChanged="OnScheduleViewChanged"
                                                ShowTodayButton="False"
                                                ShowNavigationArrows="False">
                                                <scheduler:SfScheduler.Triggers>
                                                    <DataTrigger TargetType="scheduler:SfScheduler"
                                                                 Binding="{Binding CurrentSchedulerView}"
                                                                 Value="Day">
                                                        <Setter Property="CellBorderBrush" Value="{AppThemeBinding Light=#E5E0D8, Dark=#3D2E24}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="scheduler:SfScheduler"
                                                                 Binding="{Binding CurrentSchedulerView}"
                                                                 Value="Week">
                                                        <Setter Property="CellBorderBrush" Value="{AppThemeBinding Light=#E5E0D8, Dark=#3D2E24}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="scheduler:SfScheduler"
                                                                 Binding="{Binding CurrentSchedulerView}"
                                                                 Value="Month">
                                                        <Setter Property="CellBorderBrush" Value="{AppThemeBinding Light=transparent, Dark=#3D2E24}"/>
                                                    </DataTrigger>
                                                </scheduler:SfScheduler.Triggers>
                                                <scheduler:SfScheduler.DaysView>
                                                    <scheduler:SchedulerDaysView StartHour="8" EndHour="18"
                                                                                 TimeIntervalHeight="60">
                                                        <scheduler:SchedulerDaysView.ViewHeaderSettings>
                                                            <scheduler:SchedulerViewHeaderSettings Background="{AppThemeBinding Light=#EAF3FB, Dark=#122C45}">
                                                                <scheduler:SchedulerViewHeaderSettings.DayTextStyle>
                                                                    <scheduler:SchedulerTextStyle TextColor="{AppThemeBinding Light=#475569, Dark=#A9C4DA}"
                                                                                                 FontSize="12"
                                                                                                 FontAttributes="Bold"/>
                                                                </scheduler:SchedulerViewHeaderSettings.DayTextStyle>
                                                                <scheduler:SchedulerViewHeaderSettings.DateTextStyle>
                                                                    <scheduler:SchedulerTextStyle TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"
                                                                                                 FontSize="16"
                                                                                                 FontAttributes="Bold"/>
                                                                </scheduler:SchedulerViewHeaderSettings.DateTextStyle>
                                                            </scheduler:SchedulerViewHeaderSettings>
                                                        </scheduler:SchedulerDaysView.ViewHeaderSettings>
                                                        <scheduler:SchedulerDaysView.TimeRulerTextStyle>
                                                            <scheduler:SchedulerTextStyle TextColor="{AppThemeBinding Light=#64748B, Dark=#9DB7D2}"
                                                                                         FontSize="11"/>
                                                        </scheduler:SchedulerDaysView.TimeRulerTextStyle>
                                                    </scheduler:SchedulerDaysView>
                                                </scheduler:SfScheduler.DaysView>
                                                <scheduler:SfScheduler.MonthView>
                                                    <scheduler:SchedulerMonthView AppointmentDisplayMode="Text">
                                                        <scheduler:SchedulerMonthView.ViewHeaderSettings>
                                                            <scheduler:SchedulerViewHeaderSettings DayFormat="ddd"
                                                                                                  Background="{AppThemeBinding Light=#EAF3FB, Dark=#122C45}">
                                                                <scheduler:SchedulerViewHeaderSettings.DayTextStyle>
                                                                    <scheduler:SchedulerTextStyle TextColor="{AppThemeBinding Light=#475569, Dark=#A9C4DA}"
                                                                                                 FontSize="12"
                                                                                                 FontAttributes="Bold"/>
                                                                </scheduler:SchedulerViewHeaderSettings.DayTextStyle>
                                                            </scheduler:SchedulerViewHeaderSettings>
                                                        </scheduler:SchedulerMonthView.ViewHeaderSettings>
                                                        <scheduler:SchedulerMonthView.CellStyle>
                                                            <scheduler:SchedulerMonthCellStyle Background="{AppThemeBinding Light=#FAF9F5, Dark=#1C1917}"
                                                                                              LeadingMonthBackground="{AppThemeBinding Light=#FAF9F5, Dark=#1C1917}"
                                                                                              TrailingMonthBackground="{AppThemeBinding Light=#FAF9F5, Dark=#1C1917}">
                                                                <scheduler:SchedulerMonthCellStyle.TextStyle>
                                                                    <scheduler:SchedulerTextStyle TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"
                                                                                                 FontSize="12"/>
                                                                </scheduler:SchedulerMonthCellStyle.TextStyle>
                                                            </scheduler:SchedulerMonthCellStyle>
                                                        </scheduler:SchedulerMonthView.CellStyle>
                                                    </scheduler:SchedulerMonthView>
                                                </scheduler:SfScheduler.MonthView>
                                                <scheduler:SfScheduler.HeaderView>
                                                    <scheduler:SchedulerHeaderView Height="0"/>
                                                </scheduler:SfScheduler.HeaderView>
                                            </scheduler:SfScheduler>
                                        </StackLayout>
                                    </Border>

                                    <!-- Mobile-only: Schedule Intelligence below calendar -->
                                    <StackLayout IsVisible="{Binding Source={x:Reference RootGrid}, Path=Width, Converter={StaticResource WidthToBooleanConverter}, ConverterParameter=mobile}"
                                                 Spacing="14">
                                        <!-- Empty state when no schedules added (mobile) -->
                                        <Border IsVisible="{Binding NoScheduleAlerts}"
                                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                                StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"
                                                StrokeShape="RoundRectangle 14"
                                                Padding="14">
                                            <StackLayout Spacing="6" HorizontalOptions="Center" Padding="0,8">
                                            <Label Text="&#xE425;" FontFamily="MaterialIcons" FontSize="36" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#CBD5E1, Dark=#2A3D5C}"/>
                                                <Label Text="No reminders yet" FontSize="13" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"
                                                       HorizontalOptions="Center"/>
                                                <Label Text="Tap &quot;+ Add Schedule&quot; to create your first reminder." FontSize="12"
                                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#9DB7D2}"
                                                       HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                                            </StackLayout>
                                        </Border>

                                        <!-- Upcoming Alerts (mobile) -->
                                        <Border IsVisible="{Binding HasScheduleAlerts}"
                                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                                StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"
                                                StrokeShape="RoundRectangle 14"
                                                Padding="14">
                                            <StackLayout Spacing="10">
                                                <StackLayout Orientation="Horizontal" Spacing="6">
                                                    <Label Text="&#xE002;" FontFamily="MaterialIcons" FontSize="15" TextColor="{AppThemeBinding Light=#F59E0B, Dark=#FCD34D}" VerticalOptions="Center"/>
                                                    <Label Text="Upcoming alerts" FontSize="13" FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"
                                                           VerticalOptions="Center"/>
                                                </StackLayout>
                                                <StackLayout BindableLayout.ItemsSource="{Binding ScheduleAlerts}"
                                                             Spacing="10"
                                                             IsClippedToBounds="True">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate x:DataType="models:ScheduleAlert">
                                                            <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#2D2117}"
                                                                    StrokeThickness="0"
                                                                    StrokeShape="RoundRectangle 10"
                                                                    Padding="0">
                                                                <Grid ColumnDefinitions="4,*">
                                                                    <BoxView BackgroundColor="{Binding LeftAccentColor}"
                                                                             HorizontalOptions="Fill" VerticalOptions="Fill"/>
                                                                    <StackLayout Grid.Column="1" Spacing="3" Padding="10,8">
                                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                                            <Border BackgroundColor="{Binding BadgeBgColor}"
                                                                                    Padding="6,2" StrokeThickness="0">
                                                                                <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                                                                                <Label Text="{Binding Badge}"
                                                                                       TextColor="{Binding BadgeColor}"
                                                                                       FontSize="11" FontAttributes="Bold"/>
                                                                                  </Border>
                                                                                  <Label Grid.Column="2" Text="{Binding Date}"
                                                                                      FontSize="12"
                                                                                   TextColor="{AppThemeBinding Light=#94A3B8, Dark=#7A94AA}"
                                                                                      HorizontalOptions="End"
                                                                                      VerticalOptions="Center"/>
                                                                        </Grid>
                                                                        <Label Text="{Binding Title}" FontSize="12"
                                                                               FontAttributes="Bold"
                                                                               TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"/>
                                                                        <Label Text="{Binding Description}" FontSize="11"
                                                                               TextColor="{AppThemeBinding Light=#64748B, Dark=#9DB7D2}"
                                                                               LineBreakMode="WordWrap"/>
                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                            <Label Grid.Column="1" Text="Remove" FontSize="10" FontAttributes="Bold"
                                                                                   TextColor="#DC2626" VerticalOptions="Center">
                                                                                <Label.GestureRecognizers>
                                                                                    <TapGestureRecognizer Command="{Binding Source={x:Reference RootGrid}, Path=BindingContext.DeleteScheduleCommand}"
                                                                                                          CommandParameter="{Binding .}"/>
                                                                                </Label.GestureRecognizers>
                                                                            </Label>
                                                                        </Grid>
                                                                    </StackLayout>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </StackLayout>
                                            </StackLayout>
                                        </Border>

                                        <!-- Predictive Service (mobile) -->
                                        <Border IsVisible="{Binding ShowForecast}"
                                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                                StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"
                                                StrokeShape="RoundRectangle 14"
                                                Padding="14">
                                            <StackLayout Spacing="10">
                                                <StackLayout Orientation="Horizontal" Spacing="10">
                                                    <Border BackgroundColor="#0D9488"
                                                            WidthRequest="32" HeightRequest="32"
                                                            StrokeThickness="0">
                                                        <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                                        <Label Text="+" FontSize="16" TextColor="White"
                                                               FontAttributes="Bold"
                                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                                    </Border>
                                                       <Label Text="Next service forecast" Style="{StaticResource CardTitleStyle}" FontSize="14"
                                                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"
                                                           VerticalOptions="Center"/>
                                                </StackLayout>
                                                <Label Text="{Binding PredictiveServiceDate}" FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource BrandBlue}, Dark={StaticResource BrandBlueBright}}"/>
                                                <Label Text="{Binding PredictiveServiceDescription}" FontSize="12"
                                                       TextColor="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"
                                                       LineBreakMode="WordWrap"/>
                                                <buttons:SfButton Text="Add forecast to schedule"
                                                                  Command="{Binding AddForecastReminderCommand}"
                                                                  HeightRequest="34" Padding="10,0" CornerRadius="8"
                                                                  Background="{AppThemeBinding Light=#B45309, Dark=#D97706}"
                                                                  TextColor="White" FontFamily="OpenSansSemibold" FontSize="11"
                                                                  HorizontalOptions="Start">
                                                    <buttons:SfButton.Triggers>
                                                        <DataTrigger TargetType="buttons:SfButton" Binding="{Binding IsForecastAlreadyScheduled}" Value="True">
