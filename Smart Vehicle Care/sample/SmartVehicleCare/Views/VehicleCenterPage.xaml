        <Grid IsVisible="{Binding IsEditServiceDrawerVisible}" ZIndex="1100">
            <BoxView BackgroundColor="#B2000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CancelEditServiceCommand}"/>
