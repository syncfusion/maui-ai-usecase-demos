    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BrandSurfaceLight}, Dark={StaticResource AppBackgroundDark}}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource BrandNavy}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource BrandTextDark}, Dark={StaticResource BrandTextOnDark}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource BrandTextDark}, Dark={StaticResource BrandTextOnDark}}" />
        <Setter Property="Shell.DisabledColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray950}}" />
        <Setter Property="Shell.UnselectedColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray200}}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource BrandNavy}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource BrandBlue}, Dark={StaticResource BrandBlueBright}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource BrandBlue}, Dark={StaticResource BrandBlueBright}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource BrandNavy}}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource BrandTextDark}, Dark={StaticResource BrandTextOnDark}}" />
        <Setter Property="IconColor" Value="{AppThemeBinding Light={StaticResource BrandTextDark}, Dark={StaticResource BrandTextOnDark}}" />
    </Style>

    <Style TargetType="TabbedPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource BrandNavy}}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource BrandBlue}, Dark={StaticResource BrandBlueBright}}" />
        <Setter Property="UnselectedTabColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray950}}" />
        <Setter Property="SelectedTabColor" Value="{AppThemeBinding Light={StaticResource BrandBlue}, Dark={StaticResource BrandBlueBright}}" />
    </Style>

    <!-- ================================================================
         COPPER ROAD TYPOGRAPHY SYSTEM
         Compact · Professional · Consistent across desktop and mobile
         ================================================================ -->

    <!-- Page title — used in all screen headings (18sp is deliberately NOT oversized) -->
    <Style x:Key="PageTitleStyle" TargetType="Label">
        <Setter Property="FontSize"       Value="18"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontFamily"     Value="OpenSansSemibold"/>
        <Setter Property="TextColor"      Value="{AppThemeBinding Light={StaticResource BrandTextDark}, Dark={StaticResource BrandTextOnDark}}"/>
    </Style>

    <!-- Section header — card and panel section titles -->
    <Style x:Key="SectionHeaderStyle" TargetType="Label">
        <Setter Property="FontSize"       Value="14"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontFamily"     Value="OpenSansSemibold"/>
        <Setter Property="TextColor"      Value="{AppThemeBinding Light={StaticResource BrandTextDark}, Dark={StaticResource BrandTextOnDark}}"/>
    </Style>

    <!-- Card title — card/panel header text  -->
    <Style x:Key="CardTitleStyle" TargetType="Label">
        <Setter Property="FontSize"       Value="13"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontFamily"     Value="OpenSansSemibold"/>
        <Setter Property="TextColor"      Value="{AppThemeBinding Light={StaticResource BrandTextMid}, Dark={StaticResource BrandTextOnDark}}"/>
    </Style>

    <!-- Body text — descriptive labels, descriptions -->
    <Style x:Key="BodyStyle" TargetType="Label">
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="TextColor"  Value="{AppThemeBinding Light={StaticResource BrandMutedOnLight}, Dark={StaticResource BrandMutedOnDark}}"/>
    </Style>

    <!-- Body small — secondary/supporting text -->
    <Style x:Key="BodySmallStyle" TargetType="Label">
        <Setter Property="FontSize"   Value="11"/>
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="TextColor"  Value="{AppThemeBinding Light={StaticResource BrandMutedOnLight}, Dark={StaticResource BrandMutedOnDark}}"/>
    </Style>

    <!-- Label uppercase — section category labels: "APPEARANCE", "TOTAL SERVICES" -->
    <Style x:Key="LabelUpperStyle" TargetType="Label">
        <Setter Property="FontSize"        Value="10"/>
        <Setter Property="FontAttributes"  Value="Bold"/>
        <Setter Property="CharacterSpacing" Value="1.5"/>
        <Setter Property="FontFamily"      Value="OpenSansSemibold"/>
        <Setter Property="TextColor"       Value="{AppThemeBinding Light={StaticResource BrandDimOnLight}, Dark={StaticResource BrandDimOnDark}}"/>
    </Style>

    <!-- Caption — metadata, timestamps, hints -->
    <Style x:Key="CaptionStyle" TargetType="Label">
        <Setter Property="FontSize"   Value="10"/>
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="TextColor"  Value="{AppThemeBinding Light={StaticResource BrandDimOnLight}, Dark={StaticResource BrandDimOnDark}}"/>
    </Style>

    <!-- KPI Large — primary dashboard stat numbers -->
    <Style x:Key="KPILargeStyle" TargetType="Label">
        <Setter Property="FontSize"       Value="28"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontFamily"     Value="OpenSansSemibold"/>
        <Setter Property="TextColor"      Value="{AppThemeBinding Light={StaticResource BrandTextDark}, Dark={StaticResource BrandTextOnDark}}"/>
    </Style>

    <!-- KPI Medium — secondary stat numbers -->
    <Style x:Key="KPIMediumStyle" TargetType="Label">
        <Setter Property="FontSize"       Value="20"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontFamily"     Value="OpenSansSemibold"/>
        <Setter Property="TextColor"      Value="{AppThemeBinding Light={StaticResource BrandTextDark}, Dark={StaticResource BrandTextOnDark}}"/>
    </Style>

    <!-- ── SfTextInputLayout implicit style — applied to all form fields ── -->
    <Style TargetType="til:SfTextInputLayout">
        <Setter Property="ContainerType"                  Value="Outlined"/>
        <Setter Property="OutlineCornerRadius"             Value="10"/>
        <Setter Property="EnableFloating"                  Value="False"/>
        <Setter Property="HeightRequest"                   Value="52"/>
        <Setter Property="FocusedStrokeThickness"          Value="1.5"/>
        <Setter Property="UnfocusedStrokeThickness"        Value="1"/>
        <Setter Property="InputViewPadding"                Value="14,0"/>
        <Setter Property="ReserveSpaceForAssistiveLabels" Value="False"/>
        <Setter Property="Stroke"                         Value="{AppThemeBinding Light=#CBD5E1, Dark=#3D2E24}"/>
        <Setter Property="ContainerBackground"            Value="{AppThemeBinding Light=White, Dark={StaticResource BrandNavyMid}}"/>
    </Style>

    <!-- ── SfComboBox implicit style — applied to all dropdown fields ── -->
    <Style TargetType="combo:SfComboBox">
        <Setter Property="ShowBorder"             Value="False"/>
        <Setter Property="IsClearButtonVisible"   Value="False"/>
        <Setter Property="BackgroundColor"        Value="Transparent"/>
        <Setter Property="TextColor"              Value="{AppThemeBinding Light={StaticResource BrandTextDark}, Dark={StaticResource BrandTextOnDark}}"/>
        <Setter Property="DropDownBackground"     Value="{AppThemeBinding Light=White, Dark={StaticResource BrandDarkCard}}"/>
        <Setter Property="DropDownItemTextColor" Value="{AppThemeBinding Light=Black, Dark=White}"/>
    </Style>

    <Style TargetType="picker:PickerHeaderView">
        <Setter Property="Background" Value="{AppThemeBinding Light=White, Dark={StaticResource BrandNavyLight}}"/>
        <Setter Property="DividerColor" Value="{AppThemeBinding Light={StaticResource BrandBorderLight}, Dark={StaticResource BrandNavyLight}}"/>
        <Setter Property="TextStyle" Value="{StaticResource PickerHeaderTextStyle}"/>
    </Style>

    <Style TargetType="picker:PickerFooterView">
        <Setter Property="Background" Value="{AppThemeBinding Light=White, Dark={StaticResource BrandNavyLight}}"/>
        <Setter Property="DividerColor" Value="{AppThemeBinding Light={StaticResource BrandBorderLight}, Dark={StaticResource BrandNavyLight}}"/>
        <Setter Property="TextStyle" Value="{StaticResource PickerFooterTextStyle}"/>
    </Style>

</ResourceDictionary>
