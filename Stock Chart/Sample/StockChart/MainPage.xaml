<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:calendar="clr-namespace:Syncfusion.Maui.Calendar;assembly=Syncfusion.Maui.Calendar"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
             xmlns:converters="clr-namespace:StockChart.Converters"
             xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:editors="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             xmlns:models="clr-namespace:StockChart.Models"
             xmlns:popup="clr-namespace:Syncfusion.Maui.Popup;assembly=Syncfusion.Maui.Popup"
             xmlns:sliders="clr-namespace:Syncfusion.Maui.Sliders;assembly=Syncfusion.Maui.Sliders"
             xmlns:input="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:tabView="clr-namespace:Syncfusion.Maui.TabView;assembly=Syncfusion.Maui.TabView"
             xmlns:vm="clr-namespace:StockChart.ViewModels"
             x:Name="RootPage"
             x:Class="StockChart.MainPage"
             x:DataType="vm:StockChartViewModel"
             Background="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <converters:StockEqualityConverter x:Key="EqualityConverter" />
        <converters:StockInequalityConverter x:Key="InequalityConverter" />
        <converters:StockSelectionBackgroundConverter x:Key="StockSelectionBackgroundConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converters:WatchlistStarColorConverter x:Key="WatchlistStarColorConverter" />
        <converters:MobilePickerItemAppearanceConverter x:Key="MobilePickerItemAppearanceConverter" />
        <converters:MobilePickerBackgroundConverter x:Key="MobilePickerBackgroundConverter" />
        <x:String x:Key="DisclaimerMessage">The stock data displayed here is for demonstration purposes only and represents the period from January 01, 2023 to January 01, 2025. This information does not reflect any actual market values or investment performances.</x:String>

        <DataTemplate x:Key="DisclaimerContentTemplate" x:DataType="vm:StockChartViewModel">
            <Border Margin="16,0" Padding="22,22,22,20" StrokeShape="RoundRectangle 28" Background="{AppThemeBinding Light=#F8F8FF, Dark=#1E293B}">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="28">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <Label Text="Disclaimer" FontSize="28" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F8FAFC}" VerticalOptions="Center" />
                        <buttons:SfButton Grid.Column="1" Text="&#xE5CD;" FontFamily="MaterialIcons" FontSize="24" WidthRequest="40" HeightRequest="40" Padding="0" Background="Transparent" TextColor="{AppThemeBinding Light=#374151, Dark=#CBD5E1}" Clicked="OnDisclaimerCloseClicked" AutomationId="DisclaimerCloseButton" />
                    </Grid>
                    <Label Grid.Row="1" Text="{StaticResource DisclaimerMessage}" FontSize="17" LineHeight="1.35" TextColor="{AppThemeBinding Light=#2F3440, Dark=#E5E7EB}" />
                </Grid>
            </Border>
        </DataTemplate>

        <Style TargetType="editors:SfComboBox">
            <Setter Property="DropDownBackground" Value="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" />
            <Setter Property="SelectedDropDownItemBackground" Value="{AppThemeBinding Light=#EFF6FF, Dark=#334155}" />
            <Setter Property="DropDownStroke" Value="{AppThemeBinding Light=#CBD5E1, Dark=#475569}" />
            <Setter Property="DropDownStrokeThickness" Value="1" />
            <Setter Property="DropDownCornerRadius" Value="8" />
            <Setter Property="IsDropDownShadowVisible" Value="True" />
        </Style>

        <popup:SfPopup x:Key="SettingsPopup" ShowHeader="False" ShowFooter="False" ShowCloseButton="False" StaysOpen="False">
            <popup:SfPopup.ContentTemplate>
                <DataTemplate x:DataType="vm:StockChartViewModel">
                    <Border Padding="28,24,28,20" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 28,28,0,0" Background="{AppThemeBinding Light=#F8F8FF, Dark=#1E293B}">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="18">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <Label Text="Settings" FontSize="28" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F8FAFC}" VerticalOptions="Center" />
                                <buttons:SfButton Grid.Column="1" Text="&#xE5CD;" FontFamily="MaterialIcons" FontSize="24" WidthRequest="36" HeightRequest="36" Padding="0" Background="Transparent" TextColor="{AppThemeBinding Light=#374151, Dark=#CBD5E1}" Clicked="OnSettingsCloseClicked" />
                            </Grid>
                            <Label Grid.Row="1" Text="Chart Interactions" FontFamily="OpenSansSemibold" FontSize="18" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F8FAFC}" />
                            <HorizontalStackLayout Grid.Row="2" Spacing="16">
                                <CheckBox IsChecked="{Binding SettingsDraft.IsTooltipEnabled, Mode=TwoWay}" Color="{AppThemeBinding Light=#49679D, Dark=#93A9D7}" VerticalOptions="Center" />
                                <Label Text="Enable Tooltip" FontSize="16" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#374151, Dark=#E5E7EB}" />
                            </HorizontalStackLayout>
                            <Label Grid.Row="3" Text="Chart Axis Type" FontFamily="OpenSansSemibold" FontSize="18" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F8FAFC}" />
                            <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="20">
                                <RadioButton Grid.Column="0" Content="Numeric Axis" GroupName="AxisType" IsChecked="{Binding SettingsDraft.IsLogarithmicAxis, Converter={StaticResource InverseBooleanConverter}, Mode=TwoWay}" FontSize="16" TextColor="{AppThemeBinding Light=#374151, Dark=#E5E7EB}" />
                                <RadioButton Grid.Column="1" Content="Log Axis" GroupName="AxisType" IsChecked="{Binding SettingsDraft.IsLogarithmicAxis, Mode=TwoWay}" FontSize="16" TextColor="{AppThemeBinding Light=#374151, Dark=#E5E7EB}" />
                            </Grid>
                            <Label Grid.Row="5" Text="Chart Axis Positioning" FontFamily="OpenSansSemibold" FontSize="18" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F8FAFC}" />
                            <VerticalStackLayout Grid.Row="6" Spacing="10">
                                <HorizontalStackLayout Spacing="16">
                                    <CheckBox IsChecked="{Binding SettingsDraft.IsAxisInverted, Mode=TwoWay}" Color="{AppThemeBinding Light=#49679D, Dark=#93A9D7}" />
                                    <Label Text="Inverted Axis" FontSize="16" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#374151, Dark=#E5E7EB}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="16">
                                    <CheckBox IsChecked="{Binding SettingsDraft.IsAxisOpposed, Mode=TwoWay}" Color="{AppThemeBinding Light=#49679D, Dark=#93A9D7}" />
                                    <Label Text="Opposed Y Axis" FontSize="16" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#374151, Dark=#E5E7EB}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="16">
                                    <CheckBox IsChecked="{Binding SettingsDraft.IsRangeControlEnabled, Mode=TwoWay}" Color="{AppThemeBinding Light=#49679D, Dark=#93A9D7}" />
                                    <Label Text="Enable Range Control" FontSize="16" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#374151, Dark=#E5E7EB}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout HorizontalOptions="End" Spacing="26" Margin="0,6,0,0">
                                    <buttons:SfButton Text="Cancel" FontSize="16" Background="Transparent" TextColor="{AppThemeBinding Light=#49679D, Dark=#93A9D7}" Clicked="OnSettingsCancelClicked" />
                                    <buttons:SfButton Text="Apply" FontSize="16" Background="Transparent" TextColor="{AppThemeBinding Light=#49679D, Dark=#93A9D7}" Clicked="OnSettingsApplyClicked" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </popup:SfPopup.ContentTemplate>
        </popup:SfPopup>

        <popup:SfPopup x:Key="DisclaimerPopup" WidthRequest="680" HeightRequest="250" ShowHeader="False" ShowFooter="False" ShowCloseButton="False" StaysOpen="False" ContentTemplate="{StaticResource DisclaimerContentTemplate}">
            <popup:SfPopup.PopupStyle>
                <popup:PopupStyle CornerRadius="0" PopupBackground="Transparent" Stroke="Transparent" StrokeThickness="0" />
            </popup:SfPopup.PopupStyle>
        </popup:SfPopup>

        <popup:SfPopup x:Key="InformationPopup" WidthRequest="350" HeightRequest="175" ShowHeader="False" ShowFooter="False" ShowCloseButton="False" StaysOpen="False">
            <popup:SfPopup.PopupStyle>
                <popup:PopupStyle CornerRadius="6" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" StrokeThickness="1" />
            </popup:SfPopup.PopupStyle>
            <popup:SfPopup.ContentTemplate>
                <DataTemplate x:DataType="vm:StockChartViewModel">
                    <Grid HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Margin="14,10" Text="{StaticResource DisclaimerMessage}" FontSize="16" LineHeight="1.3" TextColor="{AppThemeBinding Light=#2F3440, Dark=#E5E7EB}" />
                    </Grid>
                </DataTemplate>
            </popup:SfPopup.ContentTemplate>
        </popup:SfPopup>

        <popup:SfPopup x:Key="WatchlistMenuPopup" WidthRequest="240" HeightRequest="105" ShowHeader="False" ShowFooter="False" ShowCloseButton="False" StaysOpen="False">
            <popup:SfPopup.ContentTemplate>
                <DataTemplate x:DataType="vm:StockChartViewModel">
                    <Border Padding="0" StrokeShape="RoundRectangle 6" Background="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" StrokeThickness="1">
                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                            <buttons:SfButton FontSize="14" HorizontalOptions="Fill" Padding="16,0" HeightRequest="52" Background="Transparent" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F8FAFC}" Clicked="OnEditWatchlistFromMenuClicked" AutomationId="EditWatchlistMenuButton" SemanticProperties.Description="Edit watchlist">
                                <buttons:SfButton.Content>
                                    <DataTemplate>
                                        <HorizontalStackLayout Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label Text="&#xE3C9;" FontFamily="MaterialIcons" FontSize="18" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" VerticalOptions="Center" />
                                            <Label Text="Edit Watchlist" FontSize="14" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F8FAFC}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </DataTemplate>
                                </buttons:SfButton.Content>
                            </buttons:SfButton>
                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" IsVisible="{Binding CanDeleteSelectedWatchlist}" />
                            <buttons:SfButton FontSize="14" HorizontalOptions="Fill" Padding="16,0" HeightRequest="52" Background="Transparent" TextColor="{AppThemeBinding Light=#DC2626, Dark=#FCA5A5}" Clicked="OnDeleteWatchlistFromMenuClicked" IsVisible="{Binding CanDeleteSelectedWatchlist}" AutomationId="DeleteWatchlistMenuButton" SemanticProperties.Description="Delete watchlist">
                                <buttons:SfButton.Content>
                                    <DataTemplate>
                                        <HorizontalStackLayout Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label Text="&#xE872;" FontFamily="MaterialIcons" FontSize="18" TextColor="{AppThemeBinding Light=#DC2626, Dark=#FCA5A5}" VerticalOptions="Center" />
                                            <Label Text="Delete Watchlist" FontSize="14" TextColor="{AppThemeBinding Light=#DC2626, Dark=#FCA5A5}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </DataTemplate>
                                </buttons:SfButton.Content>
                            </buttons:SfButton>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </popup:SfPopup.ContentTemplate>
        </popup:SfPopup>

        <popup:SfPopup x:Key="DeleteWatchlistPopup" WidthRequest="530" HeightRequest="235" ShowHeader="False" ShowFooter="False" ShowCloseButton="False" StaysOpen="False">
            <popup:SfPopup.ContentTemplate>
                <DataTemplate x:DataType="vm:StockChartViewModel">
                    <Border Padding="30,26,30,24" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 6,6,0,0" Background="{AppThemeBinding Light=#F8F8FF, Dark=#1E293B}">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="18">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <Label Text="Delete Watchlist" FontSize="26" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F8FAFC}" VerticalOptions="Center" />
                                <buttons:SfButton Grid.Column="1" Text="&#xE5CD;" FontFamily="MaterialIcons" FontSize="24" WidthRequest="40" HeightRequest="40" Padding="0" Background="Transparent" TextColor="{AppThemeBinding Light=#374151, Dark=#CBD5E1}" Clicked="OnDeleteWatchlistCloseClicked" AutomationId="DeleteWatchlistCloseButton" />
                            </Grid>
                            <Label Grid.Row="1" Text="{Binding DeleteWatchlistConfirmationText}" FontSize="17" TextColor="{AppThemeBinding Light=#374151, Dark=#E5E7EB}" />
                            <HorizontalStackLayout Grid.Row="2" HorizontalOptions="End" Spacing="24">
                                <buttons:SfButton Text="Cancel" FontSize="16" Background="Transparent" TextColor="{AppThemeBinding Light=#49679D, Dark=#93A9D7}" Clicked="OnDeleteWatchlistCloseClicked" />
                                <buttons:SfButton Text="Delete" FontSize="16" Background="Transparent" TextColor="#DC2626" Clicked="OnDeleteWatchlistConfirmClicked" AutomationId="ConfirmDeleteWatchlistButton" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </popup:SfPopup.ContentTemplate>
        </popup:SfPopup>

        <popup:SfPopup x:Key="FavoritePopup" WidthRequest="420" HeightRequest="360" ShowHeader="False" ShowFooter="False" ShowCloseButton="False" StaysOpen="False">
            <popup:SfPopup.ContentTemplate>
                <DataTemplate x:DataType="vm:StockChartViewModel">
                    <Border Padding="28,24,28,20" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 24,24,0,0" Background="{AppThemeBinding Light=#F8F8FF, Dark=#1E293B}">
                        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <Label Text="Add stock to watchlist" FontSize="24" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F8FAFC}" VerticalOptions="Center" />
                                <buttons:SfButton Grid.Column="1" Text="&#xE5CD;" FontFamily="MaterialIcons" FontSize="24" WidthRequest="40" HeightRequest="40" Padding="0" Background="Transparent" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" Clicked="OnFavoriteCloseClicked" />
                            </Grid>
                            <Label Grid.Row="1" Text="Select watchlists" FontSize="14" TextColor="{AppThemeBinding Light=#4B5563, Dark=#CBD5E1}" />
                            <CollectionView Grid.Row="2" ItemsSource="{Binding AddStockWatchlists}" SelectionMode="None" VerticalScrollBarVisibility="Never" AutomationId="FavoriteWatchlists">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:WatchlistSelectionModel">
                                        <Grid HeightRequest="48" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Color="{AppThemeBinding Light=#49679D, Dark=#93A9D7}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding Name}" FontSize="15" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F8FAFC}" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <HorizontalStackLayout Grid.Row="3" HorizontalOptions="End" Spacing="16">
                                <buttons:SfButton Text="Cancel" FontSize="14" Background="Transparent" TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" Clicked="OnFavoriteCloseClicked" />
                                <buttons:SfButton Text="Save" FontSize="14" Background="Transparent" TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" Clicked="OnFavoriteApplyClicked" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </popup:SfPopup.ContentTemplate>
        </popup:SfPopup>

        <popup:SfPopup x:Key="RemoveStockPopup" WidthRequest="530" HeightRequest="360" ShowHeader="False" ShowFooter="False" ShowCloseButton="False" StaysOpen="False">
            <popup:SfPopup.ContentTemplate>
                <DataTemplate x:DataType="vm:StockChartViewModel">
                    <Border Padding="30,26,30,24" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 6,6,0,0" Background="{AppThemeBinding Light=#F8F8FF, Dark=#1E293B}">
                        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <Label Text="Remove Stock in Watchlist" FontSize="24" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F8FAFC}" VerticalOptions="Center" />
                                <buttons:SfButton Grid.Column="1" Text="&#xE5CD;" FontFamily="MaterialIcons" FontSize="24" WidthRequest="40" HeightRequest="40" Padding="0" Background="Transparent" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" Clicked="OnRemoveStockCloseClicked" />
                            </Grid>
                            <Label Grid.Row="1" Text="Select Watchlist to Remove From" FontSize="18" TextColor="{AppThemeBinding Light=#374151, Dark=#E5E7EB}" />
                            <CollectionView Grid.Row="2" ItemsSource="{Binding AddStockWatchlists}" SelectionMode="None" VerticalScrollBarVisibility="Never" AutomationId="RemoveStockWatchlists">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:WatchlistSelectionModel">
                                        <Grid HeightRequest="48" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Color="{AppThemeBinding Light=#49679D, Dark=#93A9D7}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding Name}" FontSize="15" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F8FAFC}" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <HorizontalStackLayout Grid.Row="3" HorizontalOptions="End" Spacing="16">
                                <buttons:SfButton Text="Cancel" FontSize="14" Background="Transparent" TextColor="{AppThemeBinding Light=#49679D, Dark=#93A9D7}" Clicked="OnRemoveStockCloseClicked" />
                                <buttons:SfButton Text="Remove" FontSize="14" Background="Transparent" TextColor="{AppThemeBinding Light=#49679D, Dark=#93A9D7}" Clicked="OnRemoveStockApplyClicked" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </popup:SfPopup.ContentTemplate>
        </popup:SfPopup>

        <popup:SfPopup x:Key="AddStockPopup" ShowHeader="False" ShowFooter="False" ShowCloseButton="False" StaysOpen="False">
            <popup:SfPopup.ContentTemplate>
                <DataTemplate x:DataType="vm:StockChartViewModel">
                    <Border Padding="28,24,28,24" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 20,20,0,0" Background="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <Label Text="Add stock" FontSize="26" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F8FAFC}" VerticalOptions="Center" />
                                <buttons:SfButton Grid.Column="1" Text="&#xE5CD;" FontFamily="MaterialIcons" FontSize="24" WidthRequest="40" HeightRequest="40" Padding="0" Background="Transparent" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" Clicked="OnAddStockCloseClicked" />
                            </Grid>
                            <Label Grid.Row="1" Text="Search stock" FontSize="14" TextColor="{AppThemeBinding Light=#4B5563, Dark=#CBD5E1}" />
                            <editors:SfComboBox Grid.Row="2" HeightRequest="48" ItemsSource="{Binding AddStockCandidates}" SelectedItem="{Binding PendingStock, Mode=TwoWay}" Text="{Binding AddStockSearchText, Mode=TwoWay}" DisplayMemberPath="Company" TextMemberPath="Company" Placeholder="Search stock" PlaceholderColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" IsEditable="True" IsFilteringEnabled="True" TextSearchMode="Contains" ShowSuggestionsOnFocus="True" IsClearButtonVisible="False" ShowBorder="True" Stroke="{AppThemeBinding Light=#64748B, Dark=#475569}" MaxDropDownHeight="170" NoResultsFoundText="No stocks found" AutomationId="AddStockSearch">
                                <editors:SfComboBox.DropDownButtonSettings>
                                    <editors:DropDownButtonSettings Width="42" Height="46">
                                        <editors:DropDownButtonSettings.View>
                                            <Grid WidthRequest="42" HeightRequest="46">
                                                <Label Text="&#xE8B6;" FontFamily="MaterialIcons" FontSize="20" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F8FAFC}" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Grid>
                                        </editors:DropDownButtonSettings.View>
                                    </editors:DropDownButtonSettings>
                                </editors:SfComboBox.DropDownButtonSettings>
                                <editors:SfComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:StockModel">
                                        <Grid HeightRequest="58" Padding="12,6" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Border WidthRequest="34" HeightRequest="34" Padding="6" StrokeShape="RoundRectangle 17" Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#475569}" Background="{AppThemeBinding Light=#FFFFFF, Dark=#0F172A}">
                                                <Image Source="{Binding LogoImageSource}" Aspect="AspectFit" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                <Label Text="{Binding Company}" FontSize="14" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F8FAFC}" />
                                                <Label Text="{Binding OfficialName}" FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding Symbol}" FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </editors:SfComboBox.ItemTemplate>
                            </editors:SfComboBox>
                            <Label Grid.Row="3" Text="Add to watchlists" FontSize="14" TextColor="{AppThemeBinding Light=#4B5563, Dark=#CBD5E1}" />
                            <CollectionView Grid.Row="4" ItemsSource="{Binding AddStockWatchlists}" SelectionMode="None" HeightRequest="112" AutomationId="AddStockWatchlists">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:WatchlistSelectionModel">
                                        <Grid HeightRequest="48" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Color="{AppThemeBinding Light=#49679D, Dark=#93A9D7}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding Name}" FontSize="14" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F8FAFC}" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <buttons:SfButton Grid.Row="5" FontSize="14" HorizontalOptions="Start" HeightRequest="40" Padding="12,8" CornerRadius="20" Background="Transparent" Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#64748B}" StrokeThickness="1" Clicked="OnAddWatchlistFromSelectorClicked" AutomationId="NewWatchlistFromAddStockButton" SemanticProperties.Description="New watchlist">
                                <buttons:SfButton.Content>
                                    <DataTemplate>
                                        <HorizontalStackLayout Spacing="8" Margin="8,0,8,0" VerticalOptions="Center">
                                            <Label Text="&#xE145;" FontFamily="MaterialIcons" FontSize="18" TextColor="{AppThemeBinding Light=#4B5563, Dark=#CBD5E1}" VerticalOptions="Center" />
                                            <Label Text="New Watchlist" FontSize="14" TextColor="{AppThemeBinding Light=#4B5563, Dark=#CBD5E1}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </DataTemplate>
                                </buttons:SfButton.Content>
                            </buttons:SfButton>
                            <HorizontalStackLayout Grid.Row="6" HorizontalOptions="End" Spacing="12" Margin="0,4,0,50">
                                <buttons:SfButton Text="Cancel" FontSize="14" Background="Transparent" TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" Clicked="OnAddStockCloseClicked" />
                                <buttons:SfButton Text="Add" FontSize="14" Background="Transparent" TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" Clicked="OnAddStockApplyClicked" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </popup:SfPopup.ContentTemplate>
        </popup:SfPopup>

        <popup:SfPopup x:Key="NewWatchlistPopup" ShowHeader="False" ShowFooter="False" ShowCloseButton="False" StaysOpen="False">
            <popup:SfPopup.ContentTemplate>
                <DataTemplate x:DataType="vm:StockChartViewModel">
                    <Border Padding="30,26,30,24" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 28,28,0,0" Background="{AppThemeBinding Light=#F8F8FF, Dark=#1E293B}">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="14">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <Label Text="New Watchlist" FontSize="26" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F8FAFC}" VerticalOptions="Center" />
                                <buttons:SfButton Grid.Column="1" Text="&#xE5CD;" FontFamily="MaterialIcons" FontSize="24" WidthRequest="40" HeightRequest="40" Padding="0" Background="Transparent" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" Clicked="OnNewWatchlistCloseClicked" />
                            </Grid>
                            <Label Grid.Row="1" Text="Watchlist name" FontSize="14" TextColor="{AppThemeBinding Light=#4B5563, Dark=#CBD5E1}" />
