                                <buttons:SfButton WidthRequest="40" HeightRequest="40" Padding="0" Background="Transparent" Clicked="OnMobileChartTypeClicked" AutomationId="MobileChartTypeButton" SemanticProperties.Description="Select chart type"><buttons:SfButton.Content><DataTemplate><Label Text="&#xE24B;" FontFamily="MaterialIcons" FontSize="20" TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}" HorizontalOptions="Center" VerticalOptions="Center" /></DataTemplate></buttons:SfButton.Content></buttons:SfButton>
                                <buttons:SfButton WidthRequest="40" HeightRequest="40" Padding="0" Background="Transparent" Clicked="OnMobileTrendlineClicked" AutomationId="MobileTrendlineButton" SemanticProperties.Description="Select trendline"><buttons:SfButton.Content><DataTemplate><Label Text="&#xE6E1;" FontFamily="MaterialIcons" FontSize="20" TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}" HorizontalOptions="Center" VerticalOptions="Center" /></DataTemplate></buttons:SfButton.Content></buttons:SfButton>
                                <buttons:SfButton WidthRequest="40" HeightRequest="40" Padding="0" Background="Transparent" Clicked="OnSettingsClicked" AutomationId="MobileSettingsButton" SemanticProperties.Description="Open chart settings"><buttons:SfButton.Content><DataTemplate><Label Text="&#xE8B8;" FontFamily="MaterialIcons" FontSize="20" TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}" HorizontalOptions="Center" VerticalOptions="Center" /></DataTemplate></buttons:SfButton.Content></buttons:SfButton>
                                <buttons:SfButton x:Name="MobileFullscreenButton" WidthRequest="40" HeightRequest="40" Padding="0" Background="Transparent" Clicked="OnFullscreenClicked" AutomationId="MobileFullscreenButton" SemanticProperties.Description="Enter chart fullscreen"><buttons:SfButton.Content><DataTemplate><Label Text="&#xE5D0;" FontFamily="MaterialIcons" FontSize="20" TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}" HorizontalOptions="Center" VerticalOptions="Center" /></DataTemplate></buttons:SfButton.Content></buttons:SfButton>
                            </HorizontalStackLayout>

                        </Grid>

                        <Grid Grid.Row="2">
                        <chart:SfCartesianChart x:Name="StockChartView" AutomationId="StockChart" Background="Transparent" ZoomEnd="OnChartZoomEnd">
                            <chart:SfCartesianChart.TooltipBehavior>
                                <chart:ChartTooltipBehavior Background="#172033" TextColor="White" FontSize="12" />
                            </chart:SfCartesianChart.TooltipBehavior>
                            <chart:SfCartesianChart.TrackballBehavior>
                                <chart:ChartTrackballBehavior ShowLine="False" ShowLabel="False" ShowMarkers="False" />
                            </chart:SfCartesianChart.TrackballBehavior>
                                <chart:SfCartesianChart.ZoomPanBehavior>
                                <chart:ChartZoomPanBehavior ZoomMode="X" EnablePanning="True" EnablePinchZooming="True" EnableDoubleTap="True" />
                            </chart:SfCartesianChart.ZoomPanBehavior>
                            <chart:SfCartesianChart.XAxes>
                                <chart:DateTimeAxis Interval="1" IntervalType="Months" ShowMajorGridLines="True">
                                    <chart:DateTimeAxis.LabelStyle>
                                        <chart:ChartAxisLabelStyle FontSize="11" TextColor="{AppThemeBinding Light=#64748B, Dark=#CBD5E1}" />
                                    </chart:DateTimeAxis.LabelStyle>
                                </chart:DateTimeAxis>
                            </chart:SfCartesianChart.XAxes>
                            <chart:SfCartesianChart.YAxes>
                                <chart:NumericalAxis IsVisible="False" ShowMajorGridLines="False" />
                                <chart:NumericalAxis Name="PriceAxis" ShowMajorGridLines="True" LabelCreated="OnPriceAxisLabelCreated">
                                    <chart:NumericalAxis.LabelStyle>
                                        <chart:ChartAxisLabelStyle FontSize="11" TextColor="{AppThemeBinding Light=#64748B, Dark=#CBD5E1}" />
                                    </chart:NumericalAxis.LabelStyle>
                                </chart:NumericalAxis>
                            </chart:SfCartesianChart.YAxes>
                        </chart:SfCartesianChart>
                            <CollectionView ZIndex="1" ItemsSource="{Binding ActiveTrendlines}" SelectionMode="None" VerticalScrollBarVisibility="Never" HorizontalOptions="Start" VerticalOptions="Start" WidthRequest="220" MaximumHeightRequest="220" AutomationId="TrendlineOverlays">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TrendlineViewModel">
                                        <Border Padding="10,0" HeightRequest="40" StrokeShape="RoundRectangle 6" Background="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" StrokeThickness="1">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                <Label Text="{Binding Name}" FontSize="15" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F8FAFC}" />
                                                <buttons:SfButton Grid.Column="1" Text="{Binding VisibilityIcon}" FontFamily="MaterialIcons" FontSize="18" WidthRequest="30" HeightRequest="34" Padding="0" Background="Transparent" TextColor="{AppThemeBinding Light=#64748B, Dark=#CBD5E1}" Clicked="OnTrendlineVisibilityClicked" SemanticProperties.Description="Toggle trendline visibility" />
                                                <buttons:SfButton Grid.Column="2" Text="&#xE5CD;" FontFamily="MaterialIcons" FontSize="18" WidthRequest="30" HeightRequest="34" Padding="0" Background="Transparent" TextColor="{AppThemeBinding Light=#64748B, Dark=#CBD5E1}" Clicked="OnTrendlineRemoveClicked" SemanticProperties.Description="Remove trendline" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <buttons:SfButton x:Name="ResetChartZoomButton" Text="&#xE5D5;" FontFamily="MaterialIcons" FontSize="22" WidthRequest="46" HeightRequest="46" Padding="0" CornerRadius="23" VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,8" Background="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" TextColor="{AppThemeBinding Light=#475569, Dark=#E2E8F0}" Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#475569}" StrokeThickness="1" IsVisible="False" Clicked="OnResetChartZoomClicked" AutomationId="ResetChartZoomButton" SemanticProperties.Description="Reset chart zoom" />
                        </Grid>
                        <sliders:SfRangeSelector x:Name="ChartRangeSelector" Grid.Row="3" HeightRequest="78" IsVisible="False" Minimum="{Binding RangeMinimum}" Maximum="{Binding RangeMaximum}" RangeStart="{Binding RangeStart, Mode=TwoWay}" RangeEnd="{Binding RangeEnd, Mode=TwoWay}" Interval="365" ShowLabels="True" ShowTicks="False" EdgeLabelsPlacement="Inside" LabelCreated="OnRangeSelectorLabelCreated" ValueChangeEnd="OnRangeSelectorValueChangeEnd" AutomationId="ChartRangeSelector">
                            <sliders:SfRangeSelector.TrackStyle>
                                <sliders:SliderTrackStyle ActiveFill="#10A7D4" InactiveFill="#D7EEF7" ActiveSize="5" InactiveSize="5" />
                            </sliders:SfRangeSelector.TrackStyle>
                            <sliders:SfRangeSelector.ThumbStyle>
                                <sliders:SliderThumbStyle Radius="10" Fill="#FFFFFF" Stroke="#64748B" StrokeThickness="2" />
                            </sliders:SfRangeSelector.ThumbStyle>
                        </sliders:SfRangeSelector>
                    </Grid>
                    <Label Text="{Binding ChartPlaceholderText}" Style="{StaticResource Muted}" HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" Margin="24,0" IsVisible="{Binding ShowChartPlaceholder}" />
                    </Grid>
                </Border>
            </Grid>

            <buttons:SfButton x:Name="OpenStocksButton" Grid.Row="1" Text="Stocks &amp; Watchlists" IsVisible="False" Background="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" TextColor="White" CornerRadius="20" AutomationId="OpenStocksButton" Clicked="OnOpenStocksClicked" />

            <Grid Grid.RowSpan="2" IsVisible="{Binding IsBusy}" Background="#660F172A">
                <core:SfBusyIndicator IsRunning="{Binding IsBusy}" IndicatorColor="#FFFFFF" WidthRequest="64" HeightRequest="64" />
            </Grid>

            <Border Grid.RowSpan="2" IsVisible="{Binding HasError}" Padding="24" VerticalOptions="Center" HorizontalOptions="Center" StrokeShape="RoundRectangle 12" Background="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Unable to load stock information." Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource Muted}" />
                    <buttons:SfButton Text="Retry" Command="{Binding RetryCommand}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid Grid.Row="1" IsVisible="{Binding IsCustomDateRangeVisible}" Background="#660F172A" Padding="12" InputTransparent="False">
            <Border Padding="30,26,30,24" MaximumWidthRequest="680" MaximumHeightRequest="580" HorizontalOptions="Center" VerticalOptions="Center" StrokeShape="RoundRectangle 24" Background="{AppThemeBinding Light=#F8F8FF, Dark=#1E293B}">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <Label Text="Custom Date Range" FontSize="26" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F8FAFC}" />
                        <buttons:SfButton Grid.Column="1" Text="&#xE5CD;" FontFamily="MaterialIcons" FontSize="24" WidthRequest="40" HeightRequest="40" Padding="0" Background="Transparent" TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" Command="{Binding CancelCustomDateRangeCommand}" AutomationId="CustomDateRangeCloseButton" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding IsDesktopToolbar}">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="From" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" />
                            <calendar:SfCalendar HeightRequest="360" View="Month" SelectionMode="Single" SelectedDate="{Binding CustomStartDate, Mode=TwoWay}" MinimumDate="{Binding AvailableDataStartDate}" MaximumDate="{Binding CustomEndDate}" SelectionBackground="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" Background="Transparent" AutomationId="CustomRangeStartCalendar">
                                <calendar:SfCalendar.MonthView>
                                    <calendar:CalendarMonthView FirstDayOfWeek="Monday">
                                        <calendar:CalendarMonthView.SelectionTextStyle>
                                            <calendar:CalendarTextStyle TextColor="White" FontAttributes="Bold" />
                                        </calendar:CalendarMonthView.SelectionTextStyle>
                                    </calendar:CalendarMonthView>
                                </calendar:SfCalendar.MonthView>
                            </calendar:SfCalendar>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="To" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" />
                            <calendar:SfCalendar HeightRequest="360" View="Month" SelectionMode="Single" SelectedDate="{Binding CustomEndDate, Mode=TwoWay}" MinimumDate="{Binding CustomStartDate}" MaximumDate="{Binding AvailableDataEndDate}" SelectionBackground="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" Background="Transparent" AutomationId="CustomRangeEndCalendar">
                                <calendar:SfCalendar.MonthView>
                                    <calendar:CalendarMonthView FirstDayOfWeek="Monday">
                                        <calendar:CalendarMonthView.SelectionTextStyle>
                                            <calendar:CalendarTextStyle TextColor="White" FontAttributes="Bold" />
                                        </calendar:CalendarMonthView.SelectionTextStyle>
                                    </calendar:CalendarMonthView>
                                </calendar:SfCalendar.MonthView>
                            </calendar:SfCalendar>
                        </VerticalStackLayout>
                    </Grid>
                    <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="8" IsVisible="{Binding IsMobileToolbar}">
                        <HorizontalStackLayout Grid.Row="0" HorizontalOptions="Center" Spacing="8">
                            <buttons:SfButton Text="From" FontSize="14" Padding="16,8" Background="Transparent" TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" Command="{Binding SelectCustomStartDateCommand}" />
                            <buttons:SfButton Text="To" FontSize="14" Padding="16,8" Background="Transparent" TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" Command="{Binding SelectCustomEndDateCommand}" />
                        </HorizontalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Spacing="6" IsVisible="{Binding IsCustomStartCalendarVisible}">
                            <Label Text="From" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" />
                            <calendar:SfCalendar HeightRequest="360" View="Month" SelectionMode="Single" SelectedDate="{Binding CustomStartDate, Mode=TwoWay}" MinimumDate="{Binding AvailableDataStartDate}" MaximumDate="{Binding CustomEndDate}" SelectionBackground="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" Background="Transparent" AutomationId="CustomRangeStartCalendarMobile" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Spacing="6" IsVisible="{Binding IsCustomEndCalendarVisible}">
                            <Label Text="To" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" />
                            <calendar:SfCalendar HeightRequest="360" View="Month" SelectionMode="Single" SelectedDate="{Binding CustomEndDate, Mode=TwoWay}" MinimumDate="{Binding CustomStartDate}" MaximumDate="{Binding AvailableDataEndDate}" SelectionBackground="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" Background="Transparent" AutomationId="CustomRangeEndCalendarMobile" />
                        </VerticalStackLayout>
                    </Grid>
                    <HorizontalStackLayout Grid.Row="2" HorizontalOptions="End" Spacing="22">
                        <buttons:SfButton Text="Cancel" FontSize="15" Background="Transparent" TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" Command="{Binding CancelCustomDateRangeCommand}" />
                        <buttons:SfButton Text="Apply" FontSize="15" Background="Transparent" TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" Command="{Binding ApplyCustomDateRangeCommand}" />
                    </HorizontalStackLayout>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1" ZIndex="20" IsVisible="{Binding IsMobilePickerVisible}" Background="#660F172A" VerticalOptions="Fill" InputTransparent="False">
            <Border VerticalOptions="End" StrokeThickness="0" StrokeShape="RoundRectangle 24,24,0,0" Background="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}">
                <Grid Padding="24,20,24,24" RowDefinitions="Auto,*" RowSpacing="12" MaximumHeightRequest="460">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <Label Text="{Binding MobilePickerTitle}" FontFamily="OpenSansSemibold" FontSize="20" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F8FAFC}" VerticalOptions="Center" />
                        <buttons:SfButton Grid.Column="1" Text="×" FontSize="26" WidthRequest="40" HeightRequest="40" Padding="0" Background="Transparent" TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" Command="{Binding CloseMobilePickerCommand}" AutomationId="CloseMobilePickerButton" />
                    </Grid>
                    <CollectionView Grid.Row="1" ItemsSource="{Binding MobilePickerItems}" SelectionMode="None" VerticalScrollBarVisibility="Never">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:MobilePickerItem">
                                <buttons:SfButton HorizontalOptions="Fill" HeightRequest="48" Padding="12,0" Clicked="OnMobilePickerItemClicked" Background="{Binding IsSelected, Converter={StaticResource MobilePickerBackgroundConverter}}">
                                    <buttons:SfButton.Content>
                                        <DataTemplate x:DataType="vm:MobilePickerItem">
                                            <Grid ColumnDefinitions="*,Auto" Padding="12,0">
                                                <Label Text="{Binding Value}" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F8FAFC}" />
                                                <Label Grid.Column="1" Text="&#xE5CA;" FontFamily="MaterialIcons" FontSize="20" VerticalOptions="Center" IsVisible="{Binding IsSelected}" TextColor="{AppThemeBinding Light=#2563EB, Dark=#93A9D7}" />
                                            </Grid>
                                        </DataTemplate>
                                    </buttons:SfButton.Content>
                                </buttons:SfButton>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
