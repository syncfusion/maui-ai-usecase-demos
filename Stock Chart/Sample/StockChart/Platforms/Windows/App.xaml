<maui:MauiWinUIApplication
    x:Class="StockChart.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maui="using:Microsoft.Maui"
    xmlns:local="using:StockChart.WinUI">

    <maui:MauiWinUIApplication.Resources>
        <ResourceDictionary>
            <!-- CollectionView's native WinUI selection indicator uses the system accent color;
                 override it so selected stock/watchlist cards show the app's blue instead of purple. -->
            <Color x:Key="SystemAccentColor">#FF2563EB</Color>
            <Color x:Key="SystemAccentColorLight1">#FF3B82F6</Color>
            <Color x:Key="SystemAccentColorLight2">#FF60A5FA</Color>
            <Color x:Key="SystemAccentColorLight3">#FF93C5FD</Color>
            <Color x:Key="SystemAccentColorDark1">#FF1D4ED8</Color>
            <Color x:Key="SystemAccentColorDark2">#FF1E40AF</Color>
            <Color x:Key="SystemAccentColorDark3">#FF1E3A8A</Color>
        </ResourceDictionary>
    </maui:MauiWinUIApplication.Resources>

</maui:MauiWinUIApplication>
